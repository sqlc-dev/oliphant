       WHEN ((i = 0) or (i = 0)) THEN 'zero'
       WHEN ((i = 1) or (i = 1)) THEN 'one'
       WHEN ((i = 2) or (i = 2)) THEN 'two'
       ELSE 'big'
  END AS "Category"
  FROM CASE_TBL
--
SELECT
  CASE WHEN ((i < $1) or (i < $2)) THEN $3
       WHEN ((i = $4) or (i = $5)) THEN $6
       WHEN ((i = $7) or (i = $8)) THEN $9
       WHEN ((i = $10) or (i = $11)) THEN $12
       ELSE $13
  END AS "Category"
  FROM CASE_TBL
