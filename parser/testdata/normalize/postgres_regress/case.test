  CASE WHEN (i < $1) THEN $2
       WHEN (i = $3) THEN $4
       WHEN (i = $5) THEN $6
       WHEN (i = $7) THEN $8
       ELSE $9
  END AS "Category"
  FROM CASE_TBL
