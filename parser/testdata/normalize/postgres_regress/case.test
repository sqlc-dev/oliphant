-- object (bug #18722)

SELECT NULLIF(make_ad(1,2), array[2,3]::arrdomain)
--
-- While we're here, also test handling of a NULLIF arg that is a read/write
-- object (bug #18722)

SELECT NULLIF(make_ad($1,$2), array[$3,$4]::arrdomain)
== 058
ROLLBACK
