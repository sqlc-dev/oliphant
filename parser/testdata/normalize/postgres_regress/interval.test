       eval(format($2, t, i)) AS plus,
       eval(format($3, t, i)) AS minus
FROM (VALUES (timestamptz $4),
             (timestamptz $5),
             (timestamptz $6)) AS t1(t),
     (VALUES (interval $7),
             (interval $8)) AS t2(i)
