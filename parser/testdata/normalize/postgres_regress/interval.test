       eval(format($1, i1, i2)) AS plus,
       eval(format($2, i1, i2)) AS minus
FROM (VALUES (interval $3),
             (interval $4),
             (interval $5)) AS t1(i1),
     (VALUES (interval $6),
             (interval $7),
             (interval $8)) AS t2(i2)
