-- date_part implementation is mostly the same as extract, so only
-- test a few cases for additional coverage.
SELECT f1,
    date_part('microsecond', f1) AS microsecond,
    date_part('millisecond', f1) AS millisecond,
    date_part('second', f1) AS second,
    date_part('epoch', f1) AS epoch
    FROM INTERVAL_TBL
--
-- date_part implementation is mostly the same as extract, so only
-- test a few cases for additional coverage.
SELECT f1,
    date_part($1, f1) AS microsecond,
    date_part($2, f1) AS millisecond,
    date_part($3, f1) AS second,
    date_part($4, f1) AS epoch
    FROM INTERVAL_TBL
== 371
