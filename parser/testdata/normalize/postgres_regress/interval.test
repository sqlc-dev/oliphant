|--
-- test EXTRACT
|--
SELECT f1,
    EXTRACT(MICROSECOND FROM f1) AS MICROSECOND,
    EXTRACT(MILLISECOND FROM f1) AS MILLISECOND,
    EXTRACT(SECOND FROM f1) AS SECOND,
    EXTRACT(MINUTE FROM f1) AS MINUTE,
    EXTRACT(HOUR FROM f1) AS HOUR,
    EXTRACT(DAY FROM f1) AS DAY,
    EXTRACT(MONTH FROM f1) AS MONTH,
    EXTRACT(QUARTER FROM f1) AS QUARTER,
    EXTRACT(YEAR FROM f1) AS YEAR,
    EXTRACT(DECADE FROM f1) AS DECADE,
    EXTRACT(CENTURY FROM f1) AS CENTURY,
    EXTRACT(MILLENNIUM FROM f1) AS MILLENNIUM,
    EXTRACT(EPOCH FROM f1) AS EPOCH
    FROM INTERVAL_TBL
--
|--
-- test EXTRACT
|--
SELECT f1,
    EXTRACT($1 FROM f1) AS MICROSECOND,
    EXTRACT($2 FROM f1) AS MILLISECOND,
    EXTRACT($3 FROM f1) AS SECOND,
    EXTRACT($4 FROM f1) AS MINUTE,
    EXTRACT($5 FROM f1) AS HOUR,
    EXTRACT($6 FROM f1) AS DAY,
    EXTRACT($7 FROM f1) AS MONTH,
    EXTRACT($8 FROM f1) AS QUARTER,
    EXTRACT($9 FROM f1) AS YEAR,
    EXTRACT($10 FROM f1) AS DECADE,
    EXTRACT($11 FROM f1) AS CENTURY,
    EXTRACT($12 FROM f1) AS MILLENNIUM,
    EXTRACT($13 FROM f1) AS EPOCH
    FROM INTERVAL_TBL
== 360
SELECT EXTRACT(FORTNIGHT FROM INTERVAL '2 days')
--
SELECT EXTRACT($1 FROM INTERVAL $2)
== 361
-- error
SELECT EXTRACT(TIMEZONE FROM INTERVAL '2 days')
--
-- error
SELECT EXTRACT($1 FROM INTERVAL $2)
== 362
-- error

SELECT EXTRACT(DECADE FROM INTERVAL '100 y')
