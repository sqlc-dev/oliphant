select  interval '0'                                AS "zero",
        interval '1-2'                              AS "a year 2 months",
        interval '1 2:03:04'                        AS "a bit over a day",
        interval '2:03:04.45679'                    AS "a bit over 2 hours",
        (interval '1-2' + interval '3 4:05:06.7')   AS "all fields",
        (interval '1-2' - interval '3 4:05:06.7')   AS "mixed sign",
        (- interval '1-2' + interval '3 4:05:06.7') AS "negative"
--
select  interval $1                                AS "zero",
        interval $2                              AS "a year 2 months",
        interval $3                        AS "a bit over a day",
        interval $4                    AS "a bit over 2 hours",
        (interval $5 + interval $6)   AS "all fields",
        (interval $7 - interval $8)   AS "mixed sign",
        (- interval $9 + interval $10) AS "negative"
