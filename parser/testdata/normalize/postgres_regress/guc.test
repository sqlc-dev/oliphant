  WHERE category = $1 AND NOT not_in_sample
  ORDER BY 1
== 213
-- NO_RESET implies NO_RESET_ALL.
SELECT name FROM tab_settings_flags
  WHERE no_reset AND NOT no_reset_all
  ORDER BY 1
