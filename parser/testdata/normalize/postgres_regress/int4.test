-- check rounding when casting from float
SELECT x, x::int4 AS int4_value
FROM (VALUES (-2.5::float8),
             (-1.5::float8),
             (-0.5::float8),
             (0.0::float8),
             (0.5::float8),
             (1.5::float8),
             (2.5::float8)) t(x)
--
-- check rounding when casting from float
SELECT x, x::int4 AS int4_value
FROM (VALUES (-$1::float8),
             (-$2::float8),
             (-$3::float8),
             ($4::float8),
             ($5::float8),
             ($6::float8),
             ($7::float8)) t(x)
== 062
-- check rounding when casting from numeric
SELECT x, x::int4 AS int4_value
FROM (VALUES (-2.5::numeric),
             (-1.5::numeric),
             (-0.5::numeric),
             (0.0::numeric),
             (0.5::numeric),
             (1.5::numeric),
             (2.5::numeric)) t(x)
--
-- check rounding when casting from numeric
SELECT x, x::int4 AS int4_value
FROM (VALUES (-$1::numeric),
             (-$2::numeric),
             (-$3::numeric),
             ($4::numeric),
             ($5::numeric),
             ($6::numeric),
             ($7::numeric)) t(x)
== 063
-- test gcd()
SELECT a, b, gcd(a, b), gcd(a, -b), gcd(b, a), gcd(-b, a)
FROM (VALUES (0::int4, 0::int4),
             (0::int4, 6410818::int4),
             (61866666::int4, 6410818::int4),
             (-61866666::int4, 6410818::int4),
             ((-2147483648)::int4, 1::int4),
             ((-2147483648)::int4, 2147483647::int4),
             ((-2147483648)::int4, 1073741824::int4)) AS v(a, b)
--
-- test gcd()
SELECT a, b, gcd(a, b), gcd(a, -b), gcd(b, a), gcd(-b, a)
FROM (VALUES ($1::int4, $2::int4),
             ($3::int4, $4::int4),
             ($5::int4, $6::int4),
             (-$7::int4, $8::int4),
             (($9)::int4, $10::int4),
             (($11)::int4, $12::int4),
             (($13)::int4, $14::int4)) AS v(a, b)
== 064
SELECT gcd((-2147483648)::int4, 0::int4)
--
SELECT gcd(($1)::int4, $2::int4)
== 065
