== 001
|--
-- encoding-sensitive tests for json and jsonb
|--

-- We provide expected-results files for UTF8 (json_encoding.out)
-- and for SQL_ASCII (json_encoding_1.out).  Skip otherwise.
SELECT getdatabaseencoding() NOT IN ('UTF8', 'SQL_ASCII')
       AS skip_test
--
|--
-- encoding-sensitive tests for json and jsonb
|--

-- We provide expected-results files for UTF8 (json_encoding.out)
-- and for SQL_ASCII (json_encoding_1.out).  Skip otherwise.
SELECT getdatabaseencoding() NOT IN ($1, $2)
       AS skip_test
== 002
SELECT getdatabaseencoding()
--
SELECT getdatabaseencoding()
== 003
-- just to label the results files

-- first json

-- basic unicode input
SELECT '"\u"'::json
--
-- just to label the results files

-- first json

-- basic unicode input
SELECT $1::json
== 004
-- ERROR, incomplete escape
SELECT '"\u00"'::json
--
-- ERROR, incomplete escape
SELECT $1::json
== 005
-- ERROR, incomplete escape
SELECT '"\u000g"'::json
--
-- ERROR, incomplete escape
SELECT $1::json
== 006
-- ERROR, g is not a hex digit
SELECT '"\u0000"'::json
--
-- ERROR, g is not a hex digit
SELECT $1::json
== 007
-- OK, legal escape
SELECT '"\uaBcD"'::json
--
-- OK, legal escape
SELECT $1::json
== 008
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

select json '{ "a":  "\ud83d\ude04\ud83d\udc36" }' -> 'a' as correct_in_utf8
--
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

select json $1 -> $2 as correct_in_utf8
== 009
select json '{ "a":  "\ud83d\ud83d" }' -> 'a'
--
select json $1 -> $2
== 010
-- 2 high surrogates in a row
select json '{ "a":  "\ude04\ud83d" }' -> 'a'
--
-- 2 high surrogates in a row
select json $1 -> $2
== 011
-- surrogates in wrong order
select json '{ "a":  "\ud83dX" }' -> 'a'
--
-- surrogates in wrong order
select json $1 -> $2
== 012
-- orphan high surrogate
select json '{ "a":  "\ude04X" }' -> 'a'
--
-- orphan high surrogate
select json $1 -> $2
== 013
-- orphan low surrogate

--handling of simple unicode escapes

select json '{ "a":  "the Copyright \u00a9 sign" }' as correct_in_utf8
--
-- orphan low surrogate

--handling of simple unicode escapes

select json $1 as correct_in_utf8
== 014
select json '{ "a":  "dollar \u0024 character" }' as correct_everywhere
--
select json $1 as correct_everywhere
== 015
select json '{ "a":  "dollar \\u0024 character" }' as not_an_escape
--
select json $1 as not_an_escape
== 016
select json '{ "a":  "null \u0000 escape" }' as not_unescaped
--
select json $1 as not_unescaped
== 017
select json '{ "a":  "null \\u0000 escape" }' as not_an_escape
--
select json $1 as not_an_escape
== 018
select json '{ "a":  "the Copyright \u00a9 sign" }' ->> 'a' as correct_in_utf8
--
select json $1 ->> $2 as correct_in_utf8
== 019
select json '{ "a":  "dollar \u0024 character" }' ->> 'a' as correct_everywhere
--
select json $1 ->> $2 as correct_everywhere
== 020
select json '{ "a":  "dollar \\u0024 character" }' ->> 'a' as not_an_escape
--
select json $1 ->> $2 as not_an_escape
== 021
select json '{ "a":  "null \u0000 escape" }' ->> 'a' as fails
--
select json $1 ->> $2 as fails
== 022
select json '{ "a":  "null \\u0000 escape" }' ->> 'a' as not_an_escape
--
select json $1 ->> $2 as not_an_escape
== 023
-- then jsonb

-- basic unicode input
SELECT '"\u"'::jsonb
--
-- then jsonb

-- basic unicode input
SELECT $1::jsonb
== 024
-- ERROR, incomplete escape
SELECT '"\u00"'::jsonb
--
-- ERROR, incomplete escape
SELECT $1::jsonb
== 025
-- ERROR, incomplete escape
SELECT '"\u000g"'::jsonb
--
-- ERROR, incomplete escape
SELECT $1::jsonb
== 026
-- ERROR, g is not a hex digit
SELECT '"\u0045"'::jsonb
--
-- ERROR, g is not a hex digit
SELECT $1::jsonb
== 027
-- OK, legal escape
SELECT '"\u0000"'::jsonb
--
-- OK, legal escape
SELECT $1::jsonb
== 028
-- ERROR, we don't support U+0000
-- use octet_length here so we don't get an odd unicode char in the
-- output
SELECT octet_length('"\uaBcD"'::jsonb::text)
--
-- ERROR, we don't support U+0000
-- use octet_length here so we don't get an odd unicode char in the
-- output
SELECT octet_length($1::jsonb::text)
== 029
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

SELECT octet_length((jsonb '{ "a":  "\ud83d\ude04\ud83d\udc36" }' -> 'a')::text) AS correct_in_utf8
--
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

SELECT octet_length((jsonb $1 -> $2)::text) AS correct_in_utf8
== 030
SELECT jsonb '{ "a":  "\ud83d\ud83d" }' -> 'a'
--
SELECT jsonb $1 -> $2
== 031
-- 2 high surrogates in a row
SELECT jsonb '{ "a":  "\ude04\ud83d" }' -> 'a'
--
-- 2 high surrogates in a row
SELECT jsonb $1 -> $2
== 032
-- surrogates in wrong order
SELECT jsonb '{ "a":  "\ud83dX" }' -> 'a'
--
-- surrogates in wrong order
SELECT jsonb $1 -> $2
== 033
-- orphan high surrogate
SELECT jsonb '{ "a":  "\ude04X" }' -> 'a'
--
-- orphan high surrogate
SELECT jsonb $1 -> $2
== 034
-- orphan low surrogate

-- handling of simple unicode escapes

SELECT jsonb '{ "a":  "the Copyright \u00a9 sign" }' as correct_in_utf8
--
-- orphan low surrogate

-- handling of simple unicode escapes

SELECT jsonb $1 as correct_in_utf8
== 035
SELECT jsonb '{ "a":  "dollar \u0024 character" }' as correct_everywhere
--
SELECT jsonb $1 as correct_everywhere
== 036
SELECT jsonb '{ "a":  "dollar \\u0024 character" }' as not_an_escape
--
SELECT jsonb $1 as not_an_escape
== 037
SELECT jsonb '{ "a":  "null \u0000 escape" }' as fails
--
SELECT jsonb $1 as fails
== 038
SELECT jsonb '{ "a":  "null \\u0000 escape" }' as not_an_escape
--
SELECT jsonb $1 as not_an_escape
== 039
SELECT jsonb '{ "a":  "the Copyright \u00a9 sign" }' ->> 'a' as correct_in_utf8
--
SELECT jsonb $1 ->> $2 as correct_in_utf8
== 040
SELECT jsonb '{ "a":  "dollar \u0024 character" }' ->> 'a' as correct_everywhere
--
SELECT jsonb $1 ->> $2 as correct_everywhere
== 041
SELECT jsonb '{ "a":  "dollar \\u0024 character" }' ->> 'a' as not_an_escape
--
SELECT jsonb $1 ->> $2 as not_an_escape
== 042
SELECT jsonb '{ "a":  "null \u0000 escape" }' ->> 'a' as fails
--
SELECT jsonb $1 ->> $2 as fails
== 043
SELECT jsonb '{ "a":  "null \\u0000 escape" }' ->> 'a' as not_an_escape
--
SELECT jsonb $1 ->> $2 as not_an_escape
== 044
-- soft error for input-time failure

select * from pg_input_error_info('{ "a":  "\ud83d\ude04\ud83d\udc36" }', 'jsonb')
--
-- soft error for input-time failure

select * from pg_input_error_info($1, $2)
