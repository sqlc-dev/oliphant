-- Test casting within a BETWEEN qualifier
SELECT d1 - timestamp with time zone '1997-01-02' AS diff
  FROM TIMESTAMPTZ_TBL
  WHERE d1 BETWEEN timestamp with time zone '1902-01-01' AND timestamp with time zone '2038-01-01'
--
-- Test casting within a BETWEEN qualifier
SELECT d1 - timestamp with time zone $1 AS diff
  FROM TIMESTAMPTZ_TBL
  WHERE d1 BETWEEN timestamp with time zone $2 AND timestamp with time zone $3
== 148
-- DATE_PART (timestamptz_part)
SELECT d1 as timestamptz,
   date_part( 'year', d1) AS year, date_part( 'month', d1) AS month,
   date_part( 'day', d1) AS day, date_part( 'hour', d1) AS hour,
   date_part( 'minute', d1) AS minute, date_part( 'second', d1) AS second
   FROM TIMESTAMPTZ_TBL
--
-- DATE_PART (timestamptz_part)
SELECT d1 as timestamptz,
   date_part( $1, d1) AS year, date_part( $2, d1) AS month,
   date_part( $3, d1) AS day, date_part( $4, d1) AS hour,
   date_part( $5, d1) AS minute, date_part( $6, d1) AS second
   FROM TIMESTAMPTZ_TBL
== 149
