select count(*) = 0 as ok from pg_stat_wal_receiver
--
-- We expect no walreceiver running in this test
select count(*) = $1 as ok from pg_stat_wal_receiver
== 020
-- This is to record the prevailing planner enable_foo settings during
-- a regression test run.
select name, setting from pg_settings where name like 'enable%'
--
-- This is to record the prevailing planner enable_foo settings during
-- a regression test run.
select name, setting from pg_settings where name like $1
== 021
-- There are always wait event descriptions for various types.  InjectionPoint
-- may be present or absent, depending on history since last postmaster start.
select type, count(*) > 0 as ok FROM pg_wait_events
  where type <> 'InjectionPoint' group by type order by type COLLATE "C"
--
-- There are always wait event descriptions for various types.  InjectionPoint
-- may be present or absent, depending on history since last postmaster start.
select type, count(*) > $1 as ok FROM pg_wait_events
  where type <> $2 group by type order by type COLLATE "C"
== 022
-- Test that the pg_timezone_names and pg_timezone_abbrevs views are
-- more-or-less working.  We can't test their contents in any great detail
-- without the outputs changing anytime IANA updates the underlying data,
-- but it seems reasonable to expect at least one entry per major meridian.
-- (At the time of writing, the actual counts are around 38 because of
-- zones using fractional GMT offsets, so this is a pretty loose test.)
select count(distinct utc_offset) >= 24 as ok from pg_timezone_names
--
-- Test that the pg_timezone_names and pg_timezone_abbrevs views are
-- more-or-less working.  We can't test their contents in any great detail
-- without the outputs changing anytime IANA updates the underlying data,
-- but it seems reasonable to expect at least one entry per major meridian.
-- (At the time of writing, the actual counts are around 38 because of
-- zones using fractional GMT offsets, so this is a pretty loose test.)
select count(distinct utc_offset) >= $1 as ok from pg_timezone_names
== 023
select count(distinct utc_offset) >= 24 as ok from pg_timezone_abbrevs
--
select count(distinct utc_offset) >= $1 as ok from pg_timezone_abbrevs
== 024
-- Let's check the non-default timezone abbreviation sets, too
set timezone_abbreviations = 'Australia'
--
-- Let's check the non-default timezone abbreviation sets, too
set timezone_abbreviations = $1
== 025
select count(distinct utc_offset) >= 24 as ok from pg_timezone_abbrevs
--
select count(distinct utc_offset) >= $1 as ok from pg_timezone_abbrevs
== 026
set timezone_abbreviations = 'India'
--
set timezone_abbreviations = $1
== 027
select count(distinct utc_offset) >= 24 as ok from pg_timezone_abbrevs
--
select count(distinct utc_offset) >= $1 as ok from pg_timezone_abbrevs
