== 011
-- SRF with a provably-dummy relation
explain (verbose, costs off)
SELECT unnest(ARRAY[1, 2]) FROM few WHERE false
--
-- SRF with a provably-dummy relation
explain (verbose, costs off)
SELECT unnest(ARRAY[$1, $2]) FROM few WHERE $3
== 012
SELECT unnest(ARRAY[1, 2]) FROM few WHERE false
--
SELECT unnest(ARRAY[$1, $2]) FROM few WHERE $3
== 013
-- SRF shouldn't prevent upper query from recognizing lower as dummy
explain (verbose, costs off)
SELECT * FROM few f1,
  (SELECT unnest(ARRAY[1,2]) FROM few f2 WHERE false OFFSET 0) ss
--
-- SRF shouldn't prevent upper query from recognizing lower as dummy
explain (verbose, costs off)
SELECT * FROM few f1,
  (SELECT unnest(ARRAY[$1,$2]) FROM few f2 WHERE $3 OFFSET $4) ss
== 014
SELECT * FROM few f1,
  (SELECT unnest(ARRAY[1,2]) FROM few f2 WHERE false OFFSET 0) ss
--
SELECT * FROM few f1,
  (SELECT unnest(ARRAY[$1,$2]) FROM few f2 WHERE $3 OFFSET $4) ss
== 015
-- SRF output order of sorting is maintained, if SRF is not referenced
SELECT few.id, generate_series(1,3) g FROM few ORDER BY id DESC
--
-- SRF output order of sorting is maintained, if SRF is not referenced
SELECT few.id, generate_series($1,$2) g FROM few ORDER BY id DESC
== 016
-- but SRFs can be referenced in sort
SELECT few.id, generate_series(1,3) g FROM few ORDER BY id, g DESC
--
-- but SRFs can be referenced in sort
SELECT few.id, generate_series($1,$2) g FROM few ORDER BY id, g DESC
== 017
SELECT few.id, generate_series(1,3) g FROM few ORDER BY id, generate_series(1,3) DESC
--
SELECT few.id, generate_series($1,$2) g FROM few ORDER BY id, generate_series($3,$4) DESC
== 018
-- it's weird to have ORDER BYs that increase the number of results
SELECT few.id FROM few ORDER BY id, generate_series(1,3) DESC
--
-- it's weird to have ORDER BYs that increase the number of results
SELECT few.id FROM few ORDER BY id, generate_series($1,$2) DESC
== 019
-- SRFs are computed after aggregation
SET enable_hashagg TO 0
--
-- SRFs are computed after aggregation
SET enable_hashagg TO $1
== 020
-- stable output order
SELECT few.dataa, count(*), min(id), max(id), unnest('{1,1,3}'::int[]) FROM few WHERE few.id = 1 GROUP BY few.dataa
--
-- stable output order
SELECT few.dataa, count(*), min(id), max(id), unnest($1::int[]) FROM few WHERE few.id = $2 GROUP BY few.dataa
== 021
-- unless referenced in GROUP BY clause
SELECT few.dataa, count(*), min(id), max(id), unnest('{1,1,3}'::int[]) FROM few WHERE few.id = 1 GROUP BY few.dataa, unnest('{1,1,3}'::int[])
--
-- unless referenced in GROUP BY clause
SELECT few.dataa, count(*), min(id), max(id), unnest($1::int[]) FROM few WHERE few.id = $2 GROUP BY few.dataa, unnest($1::int[])
== 022
SELECT few.dataa, count(*), min(id), max(id), unnest('{1,1,3}'::int[]) FROM few WHERE few.id = 1 GROUP BY few.dataa, 5
--
SELECT few.dataa, count(*), min(id), max(id), unnest($1::int[]) FROM few WHERE few.id = $2 GROUP BY few.dataa, 5
