== 020
-- check variadic labeled argument
select concat(variadic array[1,2,3])
--
-- check variadic labeled argument
select concat(variadic array[$1,$2,$3])
== 021
select concat_ws(',', variadic array[1,2,3])
--
select concat_ws($1, variadic array[$2,$3,$4])
== 022
select concat_ws(',', variadic NULL::int[])
--
select concat_ws($1, variadic $2::int[])
== 023
select concat(variadic NULL::int[]) is NULL
--
select concat(variadic $1::int[]) is NULL
== 024
select concat(variadic '{}'::int[]) = ''
--
select concat(variadic $1::int[]) = $2
== 025
--should fail
select concat_ws(',', variadic 10)
--
--should fail
select concat_ws($1, variadic $2)
