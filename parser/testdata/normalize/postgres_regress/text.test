== 001
|--
-- TEXT
|--

SELECT text 'this is a text string' = text 'this is a text string' AS true
--
|--
-- TEXT
|--

SELECT text $1 = text $2 AS true
== 002
SELECT text 'this is a text string' = text 'this is a text strin' AS false
--
SELECT text $1 = text $2 AS false
== 003
-- text_tbl was already created and filled in test_setup.sql.
SELECT * FROM TEXT_TBL
--
-- text_tbl was already created and filled in test_setup.sql.
SELECT * FROM TEXT_TBL
== 004
-- As of 8.3 we have removed most implicit casts to text, so that for example
-- this no longer works:

select length(42)
--
-- As of 8.3 we have removed most implicit casts to text, so that for example
-- this no longer works:

select length($1)
== 005
-- But as a special exception for usability's sake, we still allow implicit
-- casting to text in concatenations, so long as the other input is text or
-- an unknown literal.  So these work:

select 'four: '::text || 2+2
--
-- But as a special exception for usability's sake, we still allow implicit
-- casting to text in concatenations, so long as the other input is text or
-- an unknown literal.  So these work:

select $1::text || $2+$3
== 006
select 'four: ' || 2+2
--
select $1 || $2+$3
== 007
-- but not this:

select 3 || 4.0
--
-- but not this:

select $1 || $2
== 008
/*
 * various string functions
 */
select concat('one')
--
/*
 * various string functions
 */
select concat($1)
== 009
select concat(1,2,3,'hello',true, false, to_date('20100309','YYYYMMDD'))
--
select concat($1,$2,$3,$4,$5, $6, to_date($7,$8))
== 010
select concat_ws('#','one')
--
select concat_ws($1,$2)
== 011
select concat_ws('#',1,2,3,'hello',true, false, to_date('20100309','YYYYMMDD'))
--
select concat_ws($1,$2,$3,$4,$5,$6, $7, to_date($8,$9))
== 012
select concat_ws(',',10,20,null,30)
--
select concat_ws($1,$2,$3,$4,$5)
== 013
select concat_ws('',10,20,null,30)
--
select concat_ws($1,$2,$3,$4,$5)
== 014
select concat_ws(NULL,10,20,null,30) is null
--
select concat_ws($1,$2,$3,$4,$5) is null
== 015
select reverse('abcde')
--
select reverse($1)
