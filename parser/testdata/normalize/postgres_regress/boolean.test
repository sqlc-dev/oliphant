-- Test to make sure short-circuiting and NULL handling is
-- correct. Use a table as source to prevent constant simplification
-- from interfering.
CREATE TABLE booltbl4(isfalse bool, istrue bool, isnul bool)
--
-- Test to make sure short-circuiting and NULL handling is
