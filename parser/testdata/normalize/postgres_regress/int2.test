-- check rounding when casting from float
SELECT x, x::int2 AS int2_value
FROM (VALUES (-2.5::float8),
             (-1.5::float8),
             (-0.5::float8),
             (0.0::float8),
             (0.5::float8),
             (1.5::float8),
             (2.5::float8)) t(x)
--
-- check rounding when casting from float
SELECT x, x::int2 AS int2_value
FROM (VALUES (-$1::float8),
             (-$2::float8),
             (-$3::float8),
             ($4::float8),
             ($5::float8),
             ($6::float8),
             ($7::float8)) t(x)
== 050
-- check rounding when casting from numeric
SELECT x, x::int2 AS int2_value
FROM (VALUES (-2.5::numeric),
             (-1.5::numeric),
             (-0.5::numeric),
             (0.0::numeric),
             (0.5::numeric),
             (1.5::numeric),
             (2.5::numeric)) t(x)
--
-- check rounding when casting from numeric
SELECT x, x::int2 AS int2_value
FROM (VALUES (-$1::numeric),
             (-$2::numeric),
             (-$3::numeric),
             ($4::numeric),
             ($5::numeric),
             ($6::numeric),
             ($7::numeric)) t(x)
== 051
