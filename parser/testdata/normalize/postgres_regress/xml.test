                                  size float PATH 'SIZE',
                                  unit text PATH 'SIZE/@unit',
                                  premier_name text PATH 'PREMIER_NAME' DEFAULT 'not specified')
--
SELECT  xmltable.*
   FROM (SELECT data FROM xmldata) x,
        LATERAL XMLTABLE($1
                         PASSING data
                         COLUMNS id int PATH $2,
                                  _id FOR ORDINALITY,
                                  country_name text PATH $3 NOT NULL,
                                  country_id text PATH $4,
                                  region_id int PATH $5,
                                  size float PATH $6,
                                  unit text PATH $7,
                                  premier_name text PATH $8 DEFAULT $9)
