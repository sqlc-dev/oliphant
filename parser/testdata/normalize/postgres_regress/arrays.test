--
-- error cases
SELECT width_bucket($1::text, ARRAY[$2, $3]::integer[])
== 471
SELECT width_bucket(5, ARRAY[3, 4, NULL])
--
SELECT width_bucket($1, ARRAY[$2, $3, $4])
== 472
SELECT width_bucket(5, ARRAY[ARRAY[1, 2], ARRAY[3, 4]])
--
SELECT width_bucket($1, ARRAY[ARRAY[$2, $3], ARRAY[$4, $5]])
== 473
-- trim_array

SELECT arr, trim_array(arr, 2)
FROM
(VALUES ('{1,2,3,4,5,6}'::bigint[]),
        ('{1,2}'),
        ('[10:16]={1,2,3,4,5,6,7}'),
        ('[-15:-10]={1,2,3,4,5,6}'),
        ('{{1,10},{2,20},{3,30},{4,40}}')) v(arr)
--
-- trim_array

SELECT arr, trim_array(arr, $1)
FROM
(VALUES ($2::bigint[]),
        ($3),
        ($4),
        ($5),
        ($6)) v(arr)
== 474
SELECT trim_array(ARRAY[1, 2, 3], -1)
--
SELECT trim_array(ARRAY[$1, $2, $3], $4)
== 475
-- fail
SELECT trim_array(ARRAY[1, 2, 3], 10)
--
-- fail
SELECT trim_array(ARRAY[$1, $2, $3], $4)
== 476
-- fail
SELECT trim_array(ARRAY[]::int[], 1)
--
-- fail
SELECT trim_array(ARRAY[]::int[], $1)
== 477
-- fail

