-- bounds preservation tests
SELECT array_sort(a) FROM (VALUES ($1::int[])) v(a)
== 512
SELECT array_sort(a) FROM (VALUES ('[-1:0]={7,1}'::int[])) v(a)
--
SELECT array_sort(a) FROM (VALUES ($1::int[])) v(a)
== 513
