INSERT INTO mcv_lists (a, b, c, filler1)
     SELECT
         (CASE WHEN mod(i,100) = 1 THEN NULL ELSE mod(i,100) END),
         (CASE WHEN mod(i,50) = 1  THEN NULL ELSE mod(i,50) END),
         (CASE WHEN mod(i,25) = 1  THEN NULL ELSE mod(i,25) END),
         i
     FROM generate_series(1,5000) s(i)
--
INSERT INTO mcv_lists (a, b, c, filler1)
     SELECT
         (CASE WHEN mod(i,$1) = $2 THEN $3 ELSE mod(i,$4) END),
         (CASE WHEN mod(i,$5) = $6  THEN $7 ELSE mod(i,$8) END),
         (CASE WHEN mod(i,$9) = $10  THEN $11 ELSE mod(i,$12) END),
         i
     FROM generate_series($13,$14) s(i)
