|--
-- Tests for min_scale()
|--

select min_scale(numeric 'NaN') is NULL
--
|--
-- Tests for min_scale()
|--

select min_scale(numeric $1) is NULL
== 959
-- should be true
select min_scale(numeric 'inf') is NULL
--
-- should be true
select min_scale(numeric $1) is NULL
== 960
-- should be true
select min_scale(0)
--
-- should be true
select min_scale($1)
== 961
-- no digits
select min_scale(0.00)
--
-- no digits
select min_scale($1)
== 962
-- no digits again
select min_scale(1.0)
--
-- no digits again
select min_scale($1)
== 963
-- no scale
select min_scale(1.1)
--
-- no scale
select min_scale($1)
== 964
-- scale 1
select min_scale(1.12)
--
-- scale 1
select min_scale($1)
== 965
-- scale 2
select min_scale(1.123)
--
-- scale 2
select min_scale($1)
== 966
-- scale 3
select min_scale(1.1234)
--
-- scale 3
select min_scale($1)
== 967
-- scale 4, filled digit
select min_scale(1.12345)
--
-- scale 4, filled digit
select min_scale($1)
== 968
-- scale 5, 2 NDIGITS
select min_scale(1.1000)
--
-- scale 5, 2 NDIGITS
select min_scale($1)
== 969
-- 1 pos in NDIGITS
select min_scale(1e100)
--
-- 1 pos in NDIGITS
select min_scale($1)
== 970
-- very big number

