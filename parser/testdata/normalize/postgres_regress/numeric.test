-- Check rounding, it should round ties away from zero.
SELECT i as pow,
	round((-2.5 * 10 ^ i)::numeric, -i),
	round((-1.5 * 10 ^ i)::numeric, -i),
	round((-0.5 * 10 ^ i)::numeric, -i),
	round((0.5 * 10 ^ i)::numeric, -i),
	round((1.5 * 10 ^ i)::numeric, -i),
	round((2.5 * 10 ^ i)::numeric, -i)
FROM generate_series(-5,5) AS t(i)
--
-- Check rounding, it should round ties away from zero.
SELECT i as pow,
	round(($1 * $2 ^ i)::numeric, -i),
	round(($3 * $4 ^ i)::numeric, -i),
	round(($5 * $6 ^ i)::numeric, -i),
	round(($7 * $8 ^ i)::numeric, -i),
	round(($9 * $10 ^ i)::numeric, -i),
	round(($11 * $12 ^ i)::numeric, -i)
FROM generate_series($13,$14) AS t(i)
== 641
-- Check limits of rounding before the decimal point
SELECT round(4.4e131071, -131071) = 4e131071
--
-- Check limits of rounding before the decimal point
SELECT round($1, $2) = $3
== 642
SELECT round(4.5e131071, -131071) = 5e131071
--
SELECT round($1, $2) = $3
== 643
SELECT round(4.5e131071, -131072)
--
SELECT round($1, $2)
== 644
-- loses all digits
SELECT round(5.5e131071, -131072)
--
-- loses all digits
SELECT round($1, $2)
== 645
-- rounds up and overflows
SELECT round(5.5e131071, -131073)
--
-- rounds up and overflows
SELECT round($1, $2)
== 646
-- loses all digits
SELECT round(5.5e131071, -1000000)
--
-- loses all digits
SELECT round($1, $2)
== 647
-- loses all digits

-- Check limits of rounding after the decimal point
SELECT round(5e-16383, 1000000) = 5e-16383
--
-- loses all digits

-- Check limits of rounding after the decimal point
SELECT round($1, $2) = $3
== 648
SELECT round(5e-16383, 16383) = 5e-16383
--
