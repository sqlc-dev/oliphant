    width_bucket(operand_num, $7, $8, $9) AS wb_2,
    width_bucket(operand_f8, $10, $11, $12) AS wb_2f,
    width_bucket(operand_num, $13, $14, $15) AS wb_3,
    width_bucket(operand_f8, $16, $17, $18) AS wb_3f,
    width_bucket(operand_num, $19, $20, $21) AS wb_4,
    width_bucket(operand_f8, $22, $23, $24) AS wb_4f,
    width_bucket(operand_num, $25, $26, $27) AS wb_5,
    width_bucket(operand_f8, $28, $29, $30) AS wb_5f
    FROM width_bucket_test
