create function myinteq(myint, myint) returns bool as $$
begin
  if $1 is null and $2 is null then
    return true;
  else
    return $1::int = $2::int;
  end if;
end;
$$ language plpgsql immutable
--
create function myinteq(myint, myint) returns bool as $1 language plpgsql immutable
== 059
create function myintne(myint, myint) returns bool as $$
begin
  return not myinteq($1, $2);
end;
$$ language plpgsql immutable
--
create function myintne(myint, myint) returns bool as $1 language plpgsql immutable
== 060
