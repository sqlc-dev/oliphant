|--
-- Test Index-only plans on GiST indexes
|--

create table gist_tbl (b box, p point, c circle)
--
|--
-- Test Index-only plans on GiST indexes
|--

create table gist_tbl (b box, p point, c circle)
== 018
insert into gist_tbl
select box(point(0.05*i, 0.05*i), point(0.05*i, 0.05*i)),
       point(0.05*i, 0.05*i),
       circle(point(0.05*i, 0.05*i), 1.0)
from generate_series(0,10000) as i
--
insert into gist_tbl
select box(point($1*i, $2*i), point($3*i, $4*i)),
       point($5*i, $6*i),
       circle(point($7*i, $8*i), $9)
from generate_series($10,$11) as i
== 019
vacuum analyze gist_tbl
--
vacuum analyze gist_tbl
== 020
set enable_seqscan=off
--
set enable_seqscan=$1
== 021
set enable_bitmapscan=off
--
set enable_bitmapscan=$1
== 022
set enable_indexonlyscan=on
--
set enable_indexonlyscan=$1
== 023
-- Test index-only scan with point opclass
create index gist_tbl_point_index on gist_tbl using gist (p)
--
-- Test index-only scan with point opclass
create index gist_tbl_point_index on gist_tbl using gist (p)
== 024
-- check that the planner chooses an index-only scan
explain (costs off)
select p from gist_tbl where p <@ box(point(0,0), point(0.5, 0.5))
--
-- check that the planner chooses an index-only scan
explain (costs off)
select p from gist_tbl where p <@ box(point($1,$2), point($3, $4))
== 025
-- execute the same
select p from gist_tbl where p <@ box(point(0,0), point(0.5, 0.5))
--
-- execute the same
select p from gist_tbl where p <@ box(point($1,$2), point($3, $4))
== 026
-- Also test an index-only knn-search
explain (costs off)
select p from gist_tbl where p <@ box(point(0,0), point(0.5, 0.5))
order by p <-> point(0.201, 0.201)
--
-- Also test an index-only knn-search
explain (costs off)
select p from gist_tbl where p <@ box(point($1,$2), point($3, $4))
order by p <-> point($5, $6)
== 027
select p from gist_tbl where p <@ box(point(0,0), point(0.5, 0.5))
order by p <-> point(0.201, 0.201)
--
select p from gist_tbl where p <@ box(point($1,$2), point($3, $4))
order by p <-> point($5, $6)
== 028
-- Check commuted case as well
explain (costs off)
select p from gist_tbl where p <@ box(point(0,0), point(0.5, 0.5))
order by point(0.101, 0.101) <-> p
--
-- Check commuted case as well
explain (costs off)
select p from gist_tbl where p <@ box(point($1,$2), point($3, $4))
order by point($5, $6) <-> p
== 029
select p from gist_tbl where p <@ box(point(0,0), point(0.5, 0.5))
order by point(0.101, 0.101) <-> p
--
select p from gist_tbl where p <@ box(point($1,$2), point($3, $4))
order by point($5, $6) <-> p
== 030
-- Check case with multiple rescans (bug #14641)
explain (costs off)
select p from
  (values (box(point(0,0), point(0.5,0.5))),
          (box(point(0.5,0.5), point(0.75,0.75))),
          (box(point(0.8,0.8), point(1.0,1.0)))) as v(bb)
cross join lateral
  (select p from gist_tbl where p <@ bb order by p <-> bb[0] limit 2) ss
--
-- Check case with multiple rescans (bug #14641)
explain (costs off)
select p from
  (values (box(point($1,$2), point($3,$4))),
          (box(point($5,$6), point($7,$8))),
          (box(point($9,$10), point($11,$12)))) as v(bb)
cross join lateral
  (select p from gist_tbl where p <@ bb order by p <-> bb[$13] limit $14) ss
== 031
select p from
  (values (box(point(0,0), point(0.5,0.5))),
          (box(point(0.5,0.5), point(0.75,0.75))),
          (box(point(0.8,0.8), point(1.0,1.0)))) as v(bb)
cross join lateral
  (select p from gist_tbl where p <@ bb order by p <-> bb[0] limit 2) ss
--
