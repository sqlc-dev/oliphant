-- UNION DISTINCT requires hashable type
WITH RECURSIVE t(n) AS (
    VALUES ('01'::varbit)
UNION
    SELECT n || '10'::varbit FROM t WHERE n < '100'::varbit
)
SELECT n FROM t
--
-- UNION DISTINCT requires hashable type
WITH RECURSIVE t(n) AS (
    VALUES ($1::varbit)
UNION
    SELECT n || $2::varbit FROM t WHERE n < $3::varbit
)
SELECT n FROM t
