-- recursive term has sub-UNION
WITH RECURSIVE t(i,j) AS (
	VALUES (1,2)
	UNION ALL
	SELECT t2.i, t.j+1 FROM
		(SELECT 2 AS i UNION ALL SELECT 3 AS i) AS t2
		JOIN t ON (t2.i = t.i+1))

	SELECT * FROM t
--
-- recursive term has sub-UNION
WITH RECURSIVE t(i,j) AS (
	VALUES ($1,$2)
	UNION ALL
	SELECT t2.i, t.j+$3 FROM
		(SELECT $4 AS i UNION ALL SELECT $5 AS i) AS t2
		JOIN t ON (t2.i = t.i+$6))

	SELECT * FROM t
