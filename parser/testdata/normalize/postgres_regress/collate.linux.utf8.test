SELECT b,
       b ~ $1 AS is_alpha,
       b ~ $2 AS is_upper,
       b ~ $3 AS is_lower,
       b ~ $4 AS is_digit,
       b ~ $5 AS is_alnum,
       b ~ $6 AS is_graph,
       b ~ $7 AS is_print,
       b ~ $8 AS is_punct,
       b ~ $9 AS is_space
FROM collate_test6
