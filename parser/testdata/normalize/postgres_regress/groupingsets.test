-- GROUP BY DISTINCT

-- "normal" behavior...
select a, b, c
from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c)
group by all rollup(a, b), rollup(a, c)
order by a, b, c
--
-- GROUP BY DISTINCT

-- "normal" behavior...
select a, b, c
from (values ($1, $2, $3), ($4, $5, $6), ($7, $8, $9)) as t (a, b, c)
group by all rollup(a, b), rollup(a, c)
order by a, b, c
== 187
-- ...which is also the default
select a, b, c
from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c)
group by rollup(a, b), rollup(a, c)
order by a, b, c
--
-- ...which is also the default
select a, b, c
from (values ($1, $2, $3), ($4, $5, $6), ($7, $8, $9)) as t (a, b, c)
group by rollup(a, b), rollup(a, c)
order by a, b, c
