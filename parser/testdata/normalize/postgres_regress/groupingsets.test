-- check qual push-down rules for a subquery with grouping sets
explain (verbose, costs off)
select * from (
  select 1 as x, q1, sum(q2)
  from int8_tbl i1
  group by grouping sets(1, 2)
) ss
where x = 1 and q1 = 123
--
-- check qual push-down rules for a subquery with grouping sets
explain (verbose, costs off)
select * from (
  select $1 as x, q1, sum(q2)
  from int8_tbl i1
  group by grouping sets($2, $3)
) ss
where x = $4 and q1 = $5
