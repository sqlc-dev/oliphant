== 010
create function gstest_data(v integer, out a integer, out b integer)
  returns setof record
  as $f$
    begin
      return query select v, i from generate_series(1,3) i;
    end;
  $f$ language plpgsql
--
create function gstest_data(v integer, out a integer, out b integer)
  returns setof record
  as $1 language plpgsql
