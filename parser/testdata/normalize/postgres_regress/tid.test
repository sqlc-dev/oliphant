== 001
-- basic tests for the TID data type

SELECT
  '(0,0)'::tid as tid00,
  '(0,1)'::tid as tid01,
  '(-1,0)'::tid as tidm10,
  '(4294967295,65535)'::tid as tidmax
--
-- basic tests for the TID data type

SELECT
  $1::tid as tid00,
  $2::tid as tid01,
  $3::tid as tidm10,
  $4::tid as tidmax
