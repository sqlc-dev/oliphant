== 001
|--
-- encoding-sensitive tests for json and jsonb
|--

-- We provide expected-results files for UTF8 (json_encoding.out)
-- and for SQL_ASCII (json_encoding_1.out).  Skip otherwise.
SELECT getdatabaseencoding() NOT IN ('UTF8', 'SQL_ASCII')
       AS skip_test
--
0 2 SQL_COMMENT NO_KEYWORD
3 49 SQL_COMMENT NO_KEYWORD
50 52 SQL_COMMENT NO_KEYWORD
54 119 SQL_COMMENT NO_KEYWORD
120 180 SQL_COMMENT NO_KEYWORD
181 187 SELECT RESERVED_KEYWORD
188 207 IDENT NO_KEYWORD
207 208 ASCII_40 NO_KEYWORD
208 209 ASCII_41 NO_KEYWORD
210 213 NOT RESERVED_KEYWORD
214 216 IN_P RESERVED_KEYWORD
217 218 ASCII_40 NO_KEYWORD
218 224 SCONST NO_KEYWORD
224 225 ASCII_44 NO_KEYWORD
226 237 SCONST NO_KEYWORD
237 238 ASCII_41 NO_KEYWORD
246 248 AS RESERVED_KEYWORD
249 258 IDENT NO_KEYWORD
== 002
SELECT getdatabaseencoding()
--
0 6 SELECT RESERVED_KEYWORD
7 26 IDENT NO_KEYWORD
26 27 ASCII_40 NO_KEYWORD
27 28 ASCII_41 NO_KEYWORD
