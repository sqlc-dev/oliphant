== 028
-- ERROR, we don't support U+0000
-- use octet_length here so we don't get an odd unicode char in the
-- output
SELECT octet_length('"\uaBcD"'::jsonb::text)
--
0 33 SQL_COMMENT NO_KEYWORD
34 101 SQL_COMMENT NO_KEYWORD
102 111 SQL_COMMENT NO_KEYWORD
112 118 SELECT RESERVED_KEYWORD
119 131 IDENT NO_KEYWORD
131 132 ASCII_40 NO_KEYWORD
132 142 SCONST NO_KEYWORD
142 144 TYPECAST NO_KEYWORD
144 149 IDENT NO_KEYWORD
149 151 TYPECAST NO_KEYWORD
151 155 TEXT_P UNRESERVED_KEYWORD
155 156 ASCII_41 NO_KEYWORD
