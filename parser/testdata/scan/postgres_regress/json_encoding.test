41 79 SQL_COMMENT NO_KEYWORD
81 87 SELECT RESERVED_KEYWORD
88 92 JSON COL_NAME_KEYWORD
93 131 SCONST NO_KEYWORD
132 134 Op NO_KEYWORD
135 138 SCONST NO_KEYWORD
139 141 AS RESERVED_KEYWORD
142 157 IDENT NO_KEYWORD
