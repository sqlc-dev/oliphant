== 007
-- OK, legal escape
SELECT '"\uaBcD"'::json
--
0 19 SQL_COMMENT NO_KEYWORD
20 26 SELECT RESERVED_KEYWORD
27 37 SCONST NO_KEYWORD
37 39 TYPECAST NO_KEYWORD
39 43 JSON COL_NAME_KEYWORD
== 008
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

select json '{ "a":  "\ud83d\ude04\ud83d\udc36" }' -> 'a' as correct_in_utf8
