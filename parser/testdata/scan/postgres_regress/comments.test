== 005
/* This is an example of SQL which should not execute:
 * select 'multi-line';
 */
SELECT 'after multi-line' AS fifth
--
0 82 C_COMMENT NO_KEYWORD
83 89 SELECT RESERVED_KEYWORD
90 108 SCONST NO_KEYWORD
109 111 AS RESERVED_KEYWORD
112 117 IDENT NO_KEYWORD
== 006
|--
-- Nested comments
|--

/*
SELECT 'trailing' as x1; -- inside block comment
*/

/* This block comment surrounds a query which itself has a block comment...
SELECT /* embedded single line */ 'embedded' AS x2;
*/

SELECT -- continued after the following block comments...
/* Deeply nested comment.
   This includes a single apostrophe to make sure we aren't decoding this part as a string.
SELECT 'deep nest' AS n1;
/* Second level of nesting...
SELECT 'deeper nest' as n2;
/* Third level of nesting...
SELECT 'deepest nest' as n3;
*/
Hoo boy. Still two deep...
*/
Now just one deep...
*/
'deeply nested example' AS sixth
--
0 2 SQL_COMMENT NO_KEYWORD
3 21 SQL_COMMENT NO_KEYWORD
22 24 SQL_COMMENT NO_KEYWORD
26 80 C_COMMENT NO_KEYWORD
82 212 C_COMMENT NO_KEYWORD
214 220 SELECT RESERVED_KEYWORD
221 271 SQL_COMMENT NO_KEYWORD
272 588 C_COMMENT NO_KEYWORD
589 612 SCONST NO_KEYWORD
613 615 AS RESERVED_KEYWORD
616 621 IDENT NO_KEYWORD
