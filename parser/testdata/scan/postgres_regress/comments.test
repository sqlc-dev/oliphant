== 001
|--
-- COMMENTS
|--

SELECT 'trailing' AS first
--
0 2 SQL_COMMENT NO_KEYWORD
3 14 SQL_COMMENT NO_KEYWORD
15 17 SQL_COMMENT NO_KEYWORD
19 25 SELECT RESERVED_KEYWORD
26 36 SCONST NO_KEYWORD
37 39 AS RESERVED_KEYWORD
40 45 FIRST_P UNRESERVED_KEYWORD
== 002
-- trailing single line
SELECT /* embedded single line */ 'embedded' AS second
--
0 23 SQL_COMMENT NO_KEYWORD
24 30 SELECT RESERVED_KEYWORD
31 57 C_COMMENT NO_KEYWORD
58 68 SCONST NO_KEYWORD
69 71 AS RESERVED_KEYWORD
72 78 SECOND_P UNRESERVED_KEYWORD
== 003
SELECT /* both embedded and trailing single line */ 'both' AS third
--
0 6 SELECT RESERVED_KEYWORD
7 51 C_COMMENT NO_KEYWORD
52 58 SCONST NO_KEYWORD
59 61 AS RESERVED_KEYWORD
62 67 IDENT NO_KEYWORD
