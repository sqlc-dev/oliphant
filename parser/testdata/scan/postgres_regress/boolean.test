|--
-- SQL syntax
-- Try all combinations to ensure that we get nothing when we expect nothing
-- - thomas 2000-01-04
|--

SELECT f1
   FROM BOOLTBL1
   WHERE f1 IS TRUE
--
0 2 SQL_COMMENT NO_KEYWORD
