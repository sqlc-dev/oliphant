== 001
-- Check that stack depth detection mechanism works and
-- max_stack_depth is not set too high.

create function infinite_recurse() returns int as
'select infinite_recurse()' language sql
--
0 55 SQL_COMMENT NO_KEYWORD
56 95 SQL_COMMENT NO_KEYWORD
97 103 CREATE RESERVED_KEYWORD
104 112 FUNCTION UNRESERVED_KEYWORD
113 129 IDENT NO_KEYWORD
129 130 ASCII_40 NO_KEYWORD
130 131 ASCII_41 NO_KEYWORD
132 139 RETURNS UNRESERVED_KEYWORD
140 143 INT_P COL_NAME_KEYWORD
144 146 AS RESERVED_KEYWORD
147 174 SCONST NO_KEYWORD
175 183 LANGUAGE UNRESERVED_KEYWORD
184 187 SQL_P UNRESERVED_KEYWORD
== 002
-- Unfortunately, up till mid 2020 the Linux kernel had a bug in PPC64
-- signal handling that would cause this test to crash if it happened
-- to receive an sinval catchup interrupt while the stack is deep:
-- https://bugzilla.kernel.org/show_bug.cgi?id=205183
-- It is likely to be many years before that bug disappears from all
-- production kernels, so disable this test on such platforms.
-- (We still create the function, so as not to have a cross-platform
-- difference in the end state of the regression database.)

SELECT version() ~ 'powerpc64[^,]*-linux-gnu'
       AS skip_test
--
0 70 SQL_COMMENT NO_KEYWORD
71 140 SQL_COMMENT NO_KEYWORD
141 207 SQL_COMMENT NO_KEYWORD
208 261 SQL_COMMENT NO_KEYWORD
262 330 SQL_COMMENT NO_KEYWORD
331 393 SQL_COMMENT NO_KEYWORD
394 462 SQL_COMMENT NO_KEYWORD
463 522 SQL_COMMENT NO_KEYWORD
524 530 SELECT RESERVED_KEYWORD
531 538 VERSION_P UNRESERVED_KEYWORD
538 539 ASCII_40 NO_KEYWORD
539 540 ASCII_41 NO_KEYWORD
541 542 Op NO_KEYWORD
543 569 SCONST NO_KEYWORD
577 579 AS RESERVED_KEYWORD
580 589 IDENT NO_KEYWORD
