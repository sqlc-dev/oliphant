200 206 SCHEMA UNRESERVED_KEYWORD
207 220 AUTHORIZATION TYPE_FUNC_NAME_KEYWORD
221 247 IDENT NO_KEYWORD
250 256 CREATE RESERVED_KEYWORD
257 265 SEQUENCE UNRESERVED_KEYWORD
266 285 IDENT NO_KEYWORD
285 286 ASCII_46 NO_KEYWORD
286 289 IDENT NO_KEYWORD
