== 009
DROP TABLE past_inh_db_child
--
0 4 DROP UNRESERVED_KEYWORD
5 10 TABLE RESERVED_KEYWORD
11 28 IDENT NO_KEYWORD
== 010
SET client_min_messages = error
--
0 3 SET UNRESERVED_KEYWORD
4 23 IDENT NO_KEYWORD
24 25 ASCII_61 NO_KEYWORD
26 31 ERROR_P UNRESERVED_KEYWORD
== 011
-- hide WARNINGs for other users' tables
ANALYZE
--
0 40 SQL_COMMENT NO_KEYWORD
41 48 ANALYZE RESERVED_KEYWORD
== 012
RESET client_min_messages
--
0 5 RESET UNRESERVED_KEYWORD
6 25 IDENT NO_KEYWORD
