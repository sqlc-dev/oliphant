== 001
-- Test maintenance commands that visit every eligible relation.  Run as a
-- non-superuser, to skip other users' tables.

CREATE ROLE regress_maintain
--
0 74 SQL_COMMENT NO_KEYWORD
75 121 SQL_COMMENT NO_KEYWORD
123 129 CREATE RESERVED_KEYWORD
130 134 ROLE UNRESERVED_KEYWORD
135 151 IDENT NO_KEYWORD
== 002
SET ROLE regress_maintain
--
0 3 SET UNRESERVED_KEYWORD
4 8 ROLE UNRESERVED_KEYWORD
9 25 IDENT NO_KEYWORD
== 003
-- Test database-wide ANALYZE ("use_own_xacts" mode) setting relhassubclass=f
-- for non-partitioning inheritance, w/ ON COMMIT DELETE ROWS building an
-- empty index.
CREATE TEMP TABLE past_inh_db_other ()
--
0 77 SQL_COMMENT NO_KEYWORD
78 151 SQL_COMMENT NO_KEYWORD
152 167 SQL_COMMENT NO_KEYWORD
168 174 CREATE RESERVED_KEYWORD
175 179 TEMP UNRESERVED_KEYWORD
180 185 TABLE RESERVED_KEYWORD
186 203 IDENT NO_KEYWORD
204 205 ASCII_40 NO_KEYWORD
205 206 ASCII_41 NO_KEYWORD
== 004
-- need 2 tables for "use_own_xacts"
CREATE TEMP TABLE past_inh_db_parent () ON COMMIT DELETE ROWS
--
0 36 SQL_COMMENT NO_KEYWORD
37 43 CREATE RESERVED_KEYWORD
44 48 TEMP UNRESERVED_KEYWORD
49 54 TABLE RESERVED_KEYWORD
55 73 IDENT NO_KEYWORD
74 75 ASCII_40 NO_KEYWORD
75 76 ASCII_41 NO_KEYWORD
77 79 ON RESERVED_KEYWORD
80 86 COMMIT UNRESERVED_KEYWORD
87 93 DELETE_P UNRESERVED_KEYWORD
94 98 ROWS UNRESERVED_KEYWORD
