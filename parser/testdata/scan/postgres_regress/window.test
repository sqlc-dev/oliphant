== 123
-- There is a syntactic ambiguity in the SQL standard.  Since
-- UNBOUNDED is a non-reserved word, it could be the name of a
-- function parameter and be used as an expression.  There is a
-- grammar hack to resolve such cases as the keyword.  The following
-- tests record this behavior.

CREATE FUNCTION unbounded_syntax_test1a(x int) RETURNS TABLE (a int, b int, c int)
LANGUAGE SQL
BEGIN ATOMIC
  SELECT sum(unique1) over (rows between x preceding and x following),
         unique1, four
  FROM tenk1 WHERE unique1 < 10
--
0 61 SQL_COMMENT NO_KEYWORD
62 124 SQL_COMMENT NO_KEYWORD
125 188 SQL_COMMENT NO_KEYWORD
189 257 SQL_COMMENT NO_KEYWORD
258 288 SQL_COMMENT NO_KEYWORD
290 296 CREATE RESERVED_KEYWORD
297 305 FUNCTION UNRESERVED_KEYWORD
306 329 IDENT NO_KEYWORD
329 330 ASCII_40 NO_KEYWORD
330 331 IDENT NO_KEYWORD
332 335 INT_P COL_NAME_KEYWORD
335 336 ASCII_41 NO_KEYWORD
337 344 RETURNS UNRESERVED_KEYWORD
345 350 TABLE RESERVED_KEYWORD
351 352 ASCII_40 NO_KEYWORD
352 353 IDENT NO_KEYWORD
354 357 INT_P COL_NAME_KEYWORD
357 358 ASCII_44 NO_KEYWORD
359 360 IDENT NO_KEYWORD
361 364 INT_P COL_NAME_KEYWORD
364 365 ASCII_44 NO_KEYWORD
366 367 IDENT NO_KEYWORD
368 371 INT_P COL_NAME_KEYWORD
371 372 ASCII_41 NO_KEYWORD
373 381 LANGUAGE UNRESERVED_KEYWORD
382 385 SQL_P UNRESERVED_KEYWORD
386 391 BEGIN_P UNRESERVED_KEYWORD
392 398 ATOMIC UNRESERVED_KEYWORD
401 407 SELECT RESERVED_KEYWORD
408 411 IDENT NO_KEYWORD
411 412 ASCII_40 NO_KEYWORD
412 419 IDENT NO_KEYWORD
419 420 ASCII_41 NO_KEYWORD
421 425 OVER UNRESERVED_KEYWORD
426 427 ASCII_40 NO_KEYWORD
427 431 ROWS UNRESERVED_KEYWORD
432 439 BETWEEN COL_NAME_KEYWORD
440 441 IDENT NO_KEYWORD
442 451 PRECEDING UNRESERVED_KEYWORD
452 455 AND RESERVED_KEYWORD
456 457 IDENT NO_KEYWORD
458 467 FOLLOWING UNRESERVED_KEYWORD
467 468 ASCII_41 NO_KEYWORD
468 469 ASCII_44 NO_KEYWORD
479 486 IDENT NO_KEYWORD
486 487 ASCII_44 NO_KEYWORD
488 492 IDENT NO_KEYWORD
495 499 FROM RESERVED_KEYWORD
500 505 IDENT NO_KEYWORD
506 511 WHERE RESERVED_KEYWORD
512 519 IDENT NO_KEYWORD
520 521 ASCII_60 NO_KEYWORD
522 524 ICONST NO_KEYWORD
== 124
END
--
0 3 END_P RESERVED_KEYWORD
== 125
CREATE FUNCTION unbounded_syntax_test1b(x int) RETURNS TABLE (a int, b int, c int)
LANGUAGE SQL
AS $$
  SELECT sum(unique1) over (rows between x preceding and x following),
         unique1, four
  FROM tenk1 WHERE unique1 < 10;
$$
