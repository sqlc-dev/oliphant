0 40 SQL_COMMENT NO_KEYWORD
41 47 SELECT RESERVED_KEYWORD
48 49 ASCII_42 NO_KEYWORD
50 54 FROM RESERVED_KEYWORD
55 69 IDENT NO_KEYWORD
70 75 WHERE RESERVED_KEYWORD
76 78 IDENT NO_KEYWORD
79 80 ASCII_61 NO_KEYWORD
81 82 ICONST NO_KEYWORD
83 86 FOR RESERVED_KEYWORD
87 93 UPDATE UNRESERVED_KEYWORD
94 100 NOWAIT UNRESERVED_KEYWORD
== 088
-- Test prepared transactions that participate in multixacts. For
-- that, lock the same row again, creating a multixid.
BEGIN
--
0 65 SQL_COMMENT NO_KEYWORD
66 120 SQL_COMMENT NO_KEYWORD
121 126 BEGIN_P UNRESERVED_KEYWORD
== 089
SELECT * FROM pxtest_rowlock WHERE id = 1 FOR SHARE
--
0 6 SELECT RESERVED_KEYWORD
7 8 ASCII_42 NO_KEYWORD
9 13 FROM RESERVED_KEYWORD
14 28 IDENT NO_KEYWORD
29 34 WHERE RESERVED_KEYWORD
35 37 IDENT NO_KEYWORD
38 39 ASCII_61 NO_KEYWORD
40 41 ICONST NO_KEYWORD
42 45 FOR RESERVED_KEYWORD
46 51 SHARE UNRESERVED_KEYWORD
== 090
PREPARE TRANSACTION 'regress_p2'
--
0 7 PREPARE UNRESERVED_KEYWORD
8 19 TRANSACTION UNRESERVED_KEYWORD
20 32 SCONST NO_KEYWORD
== 091
-- Should fail because the row is locked
SELECT * FROM pxtest_rowlock WHERE id = 1 FOR UPDATE NOWAIT
--
0 40 SQL_COMMENT NO_KEYWORD
41 47 SELECT RESERVED_KEYWORD
48 49 ASCII_42 NO_KEYWORD
50 54 FROM RESERVED_KEYWORD
55 69 IDENT NO_KEYWORD
70 75 WHERE RESERVED_KEYWORD
76 78 IDENT NO_KEYWORD
79 80 ASCII_61 NO_KEYWORD
81 82 ICONST NO_KEYWORD
83 86 FOR RESERVED_KEYWORD
87 93 UPDATE UNRESERVED_KEYWORD
94 100 NOWAIT UNRESERVED_KEYWORD
== 092
ROLLBACK PREPARED 'regress_p1'
--
0 8 ROLLBACK UNRESERVED_KEYWORD
9 17 PREPARED UNRESERVED_KEYWORD
18 30 SCONST NO_KEYWORD
== 093
ROLLBACK PREPARED 'regress_p2'
--
0 8 ROLLBACK UNRESERVED_KEYWORD
9 17 PREPARED UNRESERVED_KEYWORD
18 30 SCONST NO_KEYWORD
== 094
-- Clean up
DROP TABLE pxtest2
--
0 11 SQL_COMMENT NO_KEYWORD
12 16 DROP UNRESERVED_KEYWORD
17 22 TABLE RESERVED_KEYWORD
23 30 IDENT NO_KEYWORD
== 095
-- pxtest3 was already dropped
DROP TABLE pxtest4
--
0 30 SQL_COMMENT NO_KEYWORD
31 35 DROP UNRESERVED_KEYWORD
36 41 TABLE RESERVED_KEYWORD
42 49 IDENT NO_KEYWORD
== 096
DROP TABLE pxtest_rowlock
