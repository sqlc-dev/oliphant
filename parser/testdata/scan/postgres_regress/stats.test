----
-- Basic tests for track_functions
---
CREATE FUNCTION stats_test_func1() RETURNS VOID LANGUAGE plpgsql AS $$BEGIN END;$$
--
0 4 SQL_COMMENT NO_KEYWORD
5 39 SQL_COMMENT NO_KEYWORD
40 43 SQL_COMMENT NO_KEYWORD
44 50 CREATE RESERVED_KEYWORD
51 59 FUNCTION UNRESERVED_KEYWORD
60 76 IDENT NO_KEYWORD
