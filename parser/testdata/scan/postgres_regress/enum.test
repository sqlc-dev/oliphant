== 057
-- The exact values of enumsortorder will now depend on the local properties
-- of float4, but in any reasonable implementation we should get at least
-- 20 splits before having to renumber; so only hide values > 20.

SELECT enumlabel,
       case when enumsortorder > 20 then null else enumsortorder end as so
FROM pg_enum
WHERE enumtypid = 'insenum'::regtype
ORDER BY enumsortorder
--
0 76 SQL_COMMENT NO_KEYWORD
77 150 SQL_COMMENT NO_KEYWORD
151 216 SQL_COMMENT NO_KEYWORD
218 224 SELECT RESERVED_KEYWORD
225 234 IDENT NO_KEYWORD
234 235 ASCII_44 NO_KEYWORD
243 247 CASE RESERVED_KEYWORD
248 252 WHEN RESERVED_KEYWORD
253 266 IDENT NO_KEYWORD
267 268 ASCII_62 NO_KEYWORD
269 271 ICONST NO_KEYWORD
272 276 THEN RESERVED_KEYWORD
277 281 NULL_P RESERVED_KEYWORD
282 286 ELSE RESERVED_KEYWORD
287 300 IDENT NO_KEYWORD
301 304 END_P RESERVED_KEYWORD
305 307 AS RESERVED_KEYWORD
308 310 IDENT NO_KEYWORD
311 315 FROM RESERVED_KEYWORD
316 323 IDENT NO_KEYWORD
324 329 WHERE RESERVED_KEYWORD
330 339 IDENT NO_KEYWORD
340 341 ASCII_61 NO_KEYWORD
342 351 SCONST NO_KEYWORD
351 353 TYPECAST NO_KEYWORD
