340 347 IDENT NO_KEYWORD
347 348 ASCII_44 NO_KEYWORD
349 360 IDENT NO_KEYWORD
360 361 ASCII_44 NO_KEYWORD
362 374 IDENT NO_KEYWORD
378 382 FROM RESERVED_KEYWORD
383 390 IDENT NO_KEYWORD
394 399 WHERE RESERVED_KEYWORD
400 401 ASCII_40 NO_KEYWORD
401 408 IDENT NO_KEYWORD
408 409 ASCII_44 NO_KEYWORD
410 422 IDENT NO_KEYWORD
422 423 ASCII_41 NO_KEYWORD
424 425 ASCII_62 NO_KEYWORD
426 427 ASCII_40 NO_KEYWORD
427 432 SCONST NO_KEYWORD
