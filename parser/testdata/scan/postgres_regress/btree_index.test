== 029
|--
-- Add coverage for optimization of backwards scan index descents
|--
-- Here we expect _bt_search to descend straight to a leaf page containing a
-- non-pivot tuple with the value '47', which comes last (after 11 similar
-- non-pivot tuples).  Query execution should only need to visit a single
-- leaf page here.
|--
-- Test case relies on tenk1_hundred index having a leaf page whose high key
-- is '(48, -inf)'.  We use a low cardinality index to make our test case less
-- sensitive to implementation details that may change in the future.
set enable_seqscan to false
--
0 2 SQL_COMMENT NO_KEYWORD
3 68 SQL_COMMENT NO_KEYWORD
69 71 SQL_COMMENT NO_KEYWORD
72 148 SQL_COMMENT NO_KEYWORD
149 223 SQL_COMMENT NO_KEYWORD
224 297 SQL_COMMENT NO_KEYWORD
298 316 SQL_COMMENT NO_KEYWORD
317 319 SQL_COMMENT NO_KEYWORD
320 396 SQL_COMMENT NO_KEYWORD
397 475 SQL_COMMENT NO_KEYWORD
476 545 SQL_COMMENT NO_KEYWORD
546 549 SET UNRESERVED_KEYWORD
550 564 IDENT NO_KEYWORD
565 567 TO RESERVED_KEYWORD
568 573 FALSE_P RESERVED_KEYWORD
== 030
set enable_indexscan to true
--
0 3 SET UNRESERVED_KEYWORD
4 20 IDENT NO_KEYWORD
21 23 TO RESERVED_KEYWORD
24 28 TRUE_P RESERVED_KEYWORD
== 031
set enable_bitmapscan to false
--
0 3 SET UNRESERVED_KEYWORD
4 21 IDENT NO_KEYWORD
22 24 TO RESERVED_KEYWORD
25 30 FALSE_P RESERVED_KEYWORD
