== 013
|--
-- BTREE ascending/descending cases
|--
-- we load int4/text from pure descending data (each key is a new
-- low key) and name/f8 from pure ascending data (each key is a new
-- high key).  we had a bug where new low keys would sometimes be
-- "lost".
|--
CREATE INDEX bt_i4_index ON bt_i4_heap USING btree (seqno int4_ops)
--
0 2 SQL_COMMENT NO_KEYWORD
3 38 SQL_COMMENT NO_KEYWORD
39 41 SQL_COMMENT NO_KEYWORD
42 107 SQL_COMMENT NO_KEYWORD
108 175 SQL_COMMENT NO_KEYWORD
176 241 SQL_COMMENT NO_KEYWORD
242 252 SQL_COMMENT NO_KEYWORD
253 255 SQL_COMMENT NO_KEYWORD
256 262 CREATE RESERVED_KEYWORD
263 268 INDEX UNRESERVED_KEYWORD
269 280 IDENT NO_KEYWORD
281 283 ON RESERVED_KEYWORD
284 294 IDENT NO_KEYWORD
295 300 USING RESERVED_KEYWORD
301 306 IDENT NO_KEYWORD
307 308 ASCII_40 NO_KEYWORD
308 313 IDENT NO_KEYWORD
314 322 IDENT NO_KEYWORD
322 323 ASCII_41 NO_KEYWORD
