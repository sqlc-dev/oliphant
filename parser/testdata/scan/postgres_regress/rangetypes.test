== 001
-- Tests for range data types.

|--
-- test input parser
-- (type textrange was already made in test_setup.sql)
|--

-- negative tests; should fail
select ''::textrange
--
0 30 SQL_COMMENT NO_KEYWORD
32 34 SQL_COMMENT NO_KEYWORD
35 55 SQL_COMMENT NO_KEYWORD
56 110 SQL_COMMENT NO_KEYWORD
111 113 SQL_COMMENT NO_KEYWORD
115 145 SQL_COMMENT NO_KEYWORD
146 152 SELECT RESERVED_KEYWORD
153 155 SCONST NO_KEYWORD
155 157 TYPECAST NO_KEYWORD
157 166 IDENT NO_KEYWORD
