-- Test assorted behaviors around the implicit transaction block created
-- when multiple SQL commands are sent in a single Query message.  These
-- tests rely on the fact that psql will not break SQL commands apart at a
-- backslash-quoted semicolon, but will send them as one Query.

create temp table i_table (f1 int)
--
0 72 SQL_COMMENT NO_KEYWORD
73 145 SQL_COMMENT NO_KEYWORD
146 220 SQL_COMMENT NO_KEYWORD
221 284 SQL_COMMENT NO_KEYWORD
286 292 CREATE RESERVED_KEYWORD
293 297 TEMP UNRESERVED_KEYWORD
298 303 TABLE RESERVED_KEYWORD
304 311 IDENT NO_KEYWORD
312 313 ASCII_40 NO_KEYWORD
313 315 IDENT NO_KEYWORD
316 319 INT_P COL_NAME_KEYWORD
319 320 ASCII_41 NO_KEYWORD
