-- Helper functions to track changes of relfilenodes in a partition tree.
-- Create a table tracking the relfilenode state.
CREATE OR REPLACE FUNCTION create_relfilenode_part(relname text, indname text)
  RETURNS VOID AS
  $func$
  BEGIN
  EXECUTE format('
    CREATE TABLE %I AS
      SELECT oid, relname, relfilenode, relkind, reltoastrelid
      FROM pg_class
      WHERE oid IN
         (SELECT relid FROM pg_partition_tree(''%I''));',
	 relname, indname);
  END
  $func$ LANGUAGE plpgsql
--
0 73 SQL_COMMENT NO_KEYWORD
74 123 SQL_COMMENT NO_KEYWORD
124 130 CREATE RESERVED_KEYWORD
131 133 OR RESERVED_KEYWORD
134 141 REPLACE UNRESERVED_KEYWORD
142 150 FUNCTION UNRESERVED_KEYWORD
151 174 IDENT NO_KEYWORD
174 175 ASCII_40 NO_KEYWORD
175 182 IDENT NO_KEYWORD
183 187 TEXT_P UNRESERVED_KEYWORD
187 188 ASCII_44 NO_KEYWORD
189 196 IDENT NO_KEYWORD
197 201 TEXT_P UNRESERVED_KEYWORD
201 202 ASCII_41 NO_KEYWORD
205 212 RETURNS UNRESERVED_KEYWORD
213 217 IDENT NO_KEYWORD
218 220 AS RESERVED_KEYWORD
223 475 SCONST NO_KEYWORD
476 484 LANGUAGE UNRESERVED_KEYWORD
485 492 IDENT NO_KEYWORD
== 536
CREATE OR REPLACE FUNCTION compare_relfilenode_part(tabname text)
  RETURNS TABLE (relname name, relkind "char", state text) AS
  $func$
  BEGIN
    RETURN QUERY EXECUTE
      format(
        'SELECT  b.relname,
                 b.relkind,
                 CASE WHEN a.relfilenode = b.relfilenode THEN ''relfilenode is unchanged''
                 ELSE ''relfilenode has changed'' END
           -- Do not join with OID here as CONCURRENTLY changes it.
           FROM %I b JOIN pg_class a ON b.relname = a.relname
           ORDER BY 1;', tabname);
  END
  $func$ LANGUAGE plpgsql
--
