== 005
-- We want to use bitmapscans. With default settings, the planner currently
-- chooses a bitmap scan for the queries below anyway, but let's make sure.
set enable_indexscan=false
--
0 75 SQL_COMMENT NO_KEYWORD
76 151 SQL_COMMENT NO_KEYWORD
152 155 SET UNRESERVED_KEYWORD
156 172 IDENT NO_KEYWORD
172 173 ASCII_61 NO_KEYWORD
173 178 FALSE_P RESERVED_KEYWORD
== 006
