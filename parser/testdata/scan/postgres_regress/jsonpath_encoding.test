== 001
|--
-- encoding-sensitive tests for jsonpath
|--

-- We provide expected-results files for UTF8 (jsonpath_encoding.out)
-- and for SQL_ASCII (jsonpath_encoding_1.out).  Skip otherwise.
SELECT getdatabaseencoding() NOT IN ('UTF8', 'SQL_ASCII')
       AS skip_test
--
0 2 SQL_COMMENT NO_KEYWORD
3 43 SQL_COMMENT NO_KEYWORD
44 46 SQL_COMMENT NO_KEYWORD
48 117 SQL_COMMENT NO_KEYWORD
118 182 SQL_COMMENT NO_KEYWORD
183 189 SELECT RESERVED_KEYWORD
190 209 IDENT NO_KEYWORD
209 210 ASCII_40 NO_KEYWORD
210 211 ASCII_41 NO_KEYWORD
212 215 NOT RESERVED_KEYWORD
216 218 IN_P RESERVED_KEYWORD
219 220 ASCII_40 NO_KEYWORD
220 226 SCONST NO_KEYWORD
226 227 ASCII_44 NO_KEYWORD
228 239 SCONST NO_KEYWORD
239 240 ASCII_41 NO_KEYWORD
248 250 AS RESERVED_KEYWORD
251 260 IDENT NO_KEYWORD
== 002
SELECT getdatabaseencoding()
--
0 6 SELECT RESERVED_KEYWORD
7 26 IDENT NO_KEYWORD
26 27 ASCII_40 NO_KEYWORD
27 28 ASCII_41 NO_KEYWORD
== 003
-- just to label the results files

-- checks for double-quoted values

-- basic unicode input
SELECT '"\u"'::jsonpath
--
0 34 SQL_COMMENT NO_KEYWORD
36 70 SQL_COMMENT NO_KEYWORD
72 94 SQL_COMMENT NO_KEYWORD
95 101 SELECT RESERVED_KEYWORD
102 108 SCONST NO_KEYWORD
108 110 TYPECAST NO_KEYWORD
110 118 IDENT NO_KEYWORD
== 004
-- ERROR, incomplete escape
SELECT '"\u00"'::jsonpath
--
0 27 SQL_COMMENT NO_KEYWORD
28 34 SELECT RESERVED_KEYWORD
35 43 SCONST NO_KEYWORD
43 45 TYPECAST NO_KEYWORD
45 53 IDENT NO_KEYWORD
== 005
-- ERROR, incomplete escape
SELECT '"\u000g"'::jsonpath
--
0 27 SQL_COMMENT NO_KEYWORD
28 34 SELECT RESERVED_KEYWORD
35 45 SCONST NO_KEYWORD
45 47 TYPECAST NO_KEYWORD
47 55 IDENT NO_KEYWORD
== 006
-- ERROR, g is not a hex digit
SELECT '"\u0000"'::jsonpath
--
0 30 SQL_COMMENT NO_KEYWORD
31 37 SELECT RESERVED_KEYWORD
38 48 SCONST NO_KEYWORD
48 50 TYPECAST NO_KEYWORD
50 58 IDENT NO_KEYWORD
== 007
-- OK, legal escape
SELECT '"\uaBcD"'::jsonpath
--
0 19 SQL_COMMENT NO_KEYWORD
20 26 SELECT RESERVED_KEYWORD
27 37 SCONST NO_KEYWORD
37 39 TYPECAST NO_KEYWORD
39 47 IDENT NO_KEYWORD
== 008
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs
select '"\ud83d\ude04\ud83d\udc36"'::jsonpath as correct_in_utf8
--
0 39 SQL_COMMENT NO_KEYWORD
41 79 SQL_COMMENT NO_KEYWORD
80 86 SELECT RESERVED_KEYWORD
87 115 SCONST NO_KEYWORD
115 117 TYPECAST NO_KEYWORD
117 125 IDENT NO_KEYWORD
126 128 AS RESERVED_KEYWORD
129 144 IDENT NO_KEYWORD
== 009
select '"\ud83d\ud83d"'::jsonpath
--
0 6 SELECT RESERVED_KEYWORD
7 23 SCONST NO_KEYWORD
23 25 TYPECAST NO_KEYWORD
25 33 IDENT NO_KEYWORD
== 010
-- 2 high surrogates in a row
select '"\ude04\ud83d"'::jsonpath
--
0 29 SQL_COMMENT NO_KEYWORD
30 36 SELECT RESERVED_KEYWORD
37 53 SCONST NO_KEYWORD
53 55 TYPECAST NO_KEYWORD
55 63 IDENT NO_KEYWORD
== 011
-- surrogates in wrong order
select '"\ud83dX"'::jsonpath
--
0 28 SQL_COMMENT NO_KEYWORD
29 35 SELECT RESERVED_KEYWORD
36 47 SCONST NO_KEYWORD
47 49 TYPECAST NO_KEYWORD
49 57 IDENT NO_KEYWORD
== 012
-- orphan high surrogate
select '"\ude04X"'::jsonpath
--
0 24 SQL_COMMENT NO_KEYWORD
25 31 SELECT RESERVED_KEYWORD
32 43 SCONST NO_KEYWORD
43 45 TYPECAST NO_KEYWORD
45 53 IDENT NO_KEYWORD
== 013
-- orphan low surrogate

--handling of simple unicode escapes
select '"the Copyright \u00a9 sign"'::jsonpath as correct_in_utf8
--
0 23 SQL_COMMENT NO_KEYWORD
25 61 SQL_COMMENT NO_KEYWORD
62 68 SELECT RESERVED_KEYWORD
69 98 SCONST NO_KEYWORD
98 100 TYPECAST NO_KEYWORD
100 108 IDENT NO_KEYWORD
109 111 AS RESERVED_KEYWORD
112 127 IDENT NO_KEYWORD
== 014
select '"dollar \u0024 character"'::jsonpath as correct_everywhere
