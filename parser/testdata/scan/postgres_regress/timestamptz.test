== 001
|--
-- TIMESTAMPTZ
|--

CREATE TABLE TIMESTAMPTZ_TBL (d1 timestamp(2) with time zone)
--
0 2 SQL_COMMENT NO_KEYWORD
3 17 SQL_COMMENT NO_KEYWORD
18 20 SQL_COMMENT NO_KEYWORD
22 28 CREATE RESERVED_KEYWORD
29 34 TABLE RESERVED_KEYWORD
35 50 IDENT NO_KEYWORD
51 52 ASCII_40 NO_KEYWORD
52 54 IDENT NO_KEYWORD
55 64 TIMESTAMP COL_NAME_KEYWORD
64 65 ASCII_40 NO_KEYWORD
65 66 ICONST NO_KEYWORD
66 67 ASCII_41 NO_KEYWORD
68 72 WITH RESERVED_KEYWORD
73 77 TIME COL_NAME_KEYWORD
78 82 ZONE UNRESERVED_KEYWORD
82 83 ASCII_41 NO_KEYWORD
== 002
-- Test shorthand input values
-- We can't just "select" the results since they aren't constants; test for
-- equality instead.  We can do that by running the test inside a transaction
-- block, within which the value of 'now' shouldn't change, and so these
-- related values shouldn't either.

BEGIN
--
0 30 SQL_COMMENT NO_KEYWORD
31 106 SQL_COMMENT NO_KEYWORD
107 184 SQL_COMMENT NO_KEYWORD
185 257 SQL_COMMENT NO_KEYWORD
258 293 SQL_COMMENT NO_KEYWORD
295 300 BEGIN_P UNRESERVED_KEYWORD
