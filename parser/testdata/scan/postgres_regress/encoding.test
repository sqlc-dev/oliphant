212 226 IDENT NO_KEYWORD
227 228 ASCII_40 NO_KEYWORD
228 236 ENCODING UNRESERVED_KEYWORD
237 241 TEXT_P UNRESERVED_KEYWORD
241 242 ASCII_44 NO_KEYWORD
243 254 IDENT NO_KEYWORD
255 259 TEXT_P UNRESERVED_KEYWORD
259 260 ASCII_44 NO_KEYWORD
