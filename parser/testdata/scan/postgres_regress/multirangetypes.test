== 001
-- Tests for multirange data types.

|--
-- test input parser
|--

-- negative tests; should fail
select ''::textmultirange
--
0 35 SQL_COMMENT NO_KEYWORD
37 39 SQL_COMMENT NO_KEYWORD
40 60 SQL_COMMENT NO_KEYWORD
61 63 SQL_COMMENT NO_KEYWORD
65 95 SQL_COMMENT NO_KEYWORD
96 102 SELECT RESERVED_KEYWORD
103 105 SCONST NO_KEYWORD
105 107 TYPECAST NO_KEYWORD
107 121 IDENT NO_KEYWORD
