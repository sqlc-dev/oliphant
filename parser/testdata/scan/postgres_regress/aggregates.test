84 451 SCONST NO_KEYWORD
452 460 LANGUAGE UNRESERVED_KEYWORD
461 468 IDENT NO_KEYWORD
== 370
create function avg_finalfn(state avg_state) returns int4 as
$$
begin
	if state is null then
		return NULL;
	else
		return state.total / state.count;
	end if;
end
$$ language plpgsql
