== 001
|--
-- TIMESTAMP
|--

CREATE TABLE TIMESTAMP_TBL (d1 timestamp(2) without time zone)
--
0 2 SQL_COMMENT NO_KEYWORD
3 15 SQL_COMMENT NO_KEYWORD
16 18 SQL_COMMENT NO_KEYWORD
20 26 CREATE RESERVED_KEYWORD
27 32 TABLE RESERVED_KEYWORD
33 46 IDENT NO_KEYWORD
47 48 ASCII_40 NO_KEYWORD
48 50 IDENT NO_KEYWORD
51 60 TIMESTAMP COL_NAME_KEYWORD
60 61 ASCII_40 NO_KEYWORD
61 62 ICONST NO_KEYWORD
62 63 ASCII_41 NO_KEYWORD
64 71 WITHOUT UNRESERVED_KEYWORD
72 76 TIME COL_NAME_KEYWORD
77 81 ZONE UNRESERVED_KEYWORD
81 82 ASCII_41 NO_KEYWORD
== 002
-- Test shorthand input values
-- We can't just "select" the results since they aren't constants; test for
-- equality instead.  We can do that by running the test inside a transaction
-- block, within which the value of 'now' shouldn't change, and so these
-- related values shouldn't either.

BEGIN
--
0 30 SQL_COMMENT NO_KEYWORD
31 106 SQL_COMMENT NO_KEYWORD
107 184 SQL_COMMENT NO_KEYWORD
185 257 SQL_COMMENT NO_KEYWORD
258 293 SQL_COMMENT NO_KEYWORD
295 300 BEGIN_P UNRESERVED_KEYWORD
