== 001
|--
-- PARTITION_AGGREGATE
-- Test partitionwise aggregation on partitioned tables
|--
-- Note: to ensure plan stability, it's a good idea to make the partitions of
-- any one partitioned table in this test all have different numbers of rows.
|--

-- Enable partitionwise aggregate, which by default is disabled.
SET enable_partitionwise_aggregate TO true
--
0 2 SQL_COMMENT NO_KEYWORD
3 25 SQL_COMMENT NO_KEYWORD
26 81 SQL_COMMENT NO_KEYWORD
82 84 SQL_COMMENT NO_KEYWORD
85 162 SQL_COMMENT NO_KEYWORD
163 240 SQL_COMMENT NO_KEYWORD
241 243 SQL_COMMENT NO_KEYWORD
245 309 SQL_COMMENT NO_KEYWORD
310 313 SET UNRESERVED_KEYWORD
314 344 IDENT NO_KEYWORD
345 347 TO RESERVED_KEYWORD
348 352 TRUE_P RESERVED_KEYWORD
