== 003
-- Bug #17245: Make sure that we don't totally fail to VACUUM individual indexes that
-- happen to be below min_parallel_index_scan_size during parallel VACUUM:
CREATE TABLE parallel_vacuum_table (a int) WITH (autovacuum_enabled = off)
--
0 85 SQL_COMMENT NO_KEYWORD
86 160 SQL_COMMENT NO_KEYWORD
161 167 CREATE RESERVED_KEYWORD
168 173 TABLE RESERVED_KEYWORD
174 195 IDENT NO_KEYWORD
196 197 ASCII_40 NO_KEYWORD
197 198 IDENT NO_KEYWORD
199 202 INT_P COL_NAME_KEYWORD
202 203 ASCII_41 NO_KEYWORD
204 208 WITH RESERVED_KEYWORD
209 210 ASCII_40 NO_KEYWORD
210 228 IDENT NO_KEYWORD
229 230 ASCII_61 NO_KEYWORD
231 234 OFF UNRESERVED_KEYWORD
234 235 ASCII_41 NO_KEYWORD
