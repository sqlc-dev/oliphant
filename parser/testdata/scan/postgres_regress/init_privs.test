== 001
-- Test initial privileges

-- There should always be some initial privileges, set up by initdb
SELECT count(*) > 0 FROM pg_init_privs
--
0 26 SQL_COMMENT NO_KEYWORD
28 95 SQL_COMMENT NO_KEYWORD
96 102 SELECT RESERVED_KEYWORD
103 108 IDENT NO_KEYWORD
108 109 ASCII_40 NO_KEYWORD
109 110 ASCII_42 NO_KEYWORD
110 111 ASCII_41 NO_KEYWORD
112 113 ASCII_62 NO_KEYWORD
114 115 ICONST NO_KEYWORD
116 120 FROM RESERVED_KEYWORD
121 134 IDENT NO_KEYWORD
== 002
-- Intentionally include some non-initial privs for pg_dump to dump out
GRANT SELECT ON pg_proc TO CURRENT_USER
--
0 71 SQL_COMMENT NO_KEYWORD
72 77 GRANT RESERVED_KEYWORD
78 84 SELECT RESERVED_KEYWORD
85 87 ON RESERVED_KEYWORD
88 95 IDENT NO_KEYWORD
96 98 TO RESERVED_KEYWORD
99 111 CURRENT_USER RESERVED_KEYWORD
