== 001
|--
-- CHAR
|--

-- Per SQL standard, CHAR means character(1), that is a varlena type
-- with a constraint restricting it to one character (not byte)

SELECT char 'c' = char 'c' AS true
--
0 2 SQL_COMMENT NO_KEYWORD
3 10 SQL_COMMENT NO_KEYWORD
11 13 SQL_COMMENT NO_KEYWORD
15 83 SQL_COMMENT NO_KEYWORD
84 147 SQL_COMMENT NO_KEYWORD
149 155 SELECT RESERVED_KEYWORD
156 160 CHAR_P COL_NAME_KEYWORD
161 164 SCONST NO_KEYWORD
165 166 ASCII_61 NO_KEYWORD
167 171 CHAR_P COL_NAME_KEYWORD
172 175 SCONST NO_KEYWORD
176 178 AS RESERVED_KEYWORD
179 183 TRUE_P RESERVED_KEYWORD
