== 024
|--
-- Also test "char", which is an ad-hoc one-byte type.  It can only
-- really store ASCII characters, but we allow high-bit-set characters
-- to be accessed via bytea-like escapes.
|--

SELECT 'a'::"char"
--
0 2 SQL_COMMENT NO_KEYWORD
3 70 SQL_COMMENT NO_KEYWORD
71 141 SQL_COMMENT NO_KEYWORD
142 183 SQL_COMMENT NO_KEYWORD
184 186 SQL_COMMENT NO_KEYWORD
188 194 SELECT RESERVED_KEYWORD
195 198 SCONST NO_KEYWORD
198 200 TYPECAST NO_KEYWORD
200 206 IDENT NO_KEYWORD
