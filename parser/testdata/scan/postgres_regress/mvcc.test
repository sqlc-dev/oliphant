== 001
|--
-- Verify that index scans encountering dead rows produced by an
-- aborted subtransaction of the current transaction can utilize the
-- kill_prior_tuple optimization
|--
-- NB: The table size is currently *not* expected to stay the same, we
-- don't have logic to trigger opportunistic pruning in cases like
-- this.
BEGIN
--
0 2 SQL_COMMENT NO_KEYWORD
3 67 SQL_COMMENT NO_KEYWORD
68 136 SQL_COMMENT NO_KEYWORD
137 169 SQL_COMMENT NO_KEYWORD
170 172 SQL_COMMENT NO_KEYWORD
173 243 SQL_COMMENT NO_KEYWORD
244 310 SQL_COMMENT NO_KEYWORD
311 319 SQL_COMMENT NO_KEYWORD
320 325 BEGIN_P UNRESERVED_KEYWORD
== 002
SET LOCAL enable_seqscan = false
--
0 3 SET UNRESERVED_KEYWORD
4 9 LOCAL UNRESERVED_KEYWORD
10 24 IDENT NO_KEYWORD
25 26 ASCII_61 NO_KEYWORD
27 32 FALSE_P RESERVED_KEYWORD
== 003
