65 133 SQL_COMMENT NO_KEYWORD
134 201 SQL_COMMENT NO_KEYWORD
202 231 SQL_COMMENT NO_KEYWORD
232 238 CREATE RESERVED_KEYWORD
239 243 TEMP UNRESERVED_KEYWORD
244 249 TABLE RESERVED_KEYWORD
250 268 IDENT NO_KEYWORD
269 270 ASCII_40 NO_KEYWORD
275 277 IDENT NO_KEYWORD
278 284 IDENT NO_KEYWORD
285 288 NOT RESERVED_KEYWORD
289 293 NULL_P RESERVED_KEYWORD
293 294 ASCII_44 NO_KEYWORD
