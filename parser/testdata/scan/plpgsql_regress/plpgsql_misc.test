== 001
|--
-- Miscellaneous topics
|--

-- Verify that we can parse new-style CREATE FUNCTION/PROCEDURE
do
$$
  declare procedure int;  -- check we still recognize non-keywords as vars
  begin
  create function test1() returns int
    begin atomic
      select 2 + 2;
    end;
  create or replace procedure test2(x int)
    begin atomic
      select x + 2;
    end;
  end
$$
--
0 2 SQL_COMMENT NO_KEYWORD
3 26 SQL_COMMENT NO_KEYWORD
27 29 SQL_COMMENT NO_KEYWORD
31 94 SQL_COMMENT NO_KEYWORD
95 97 DO RESERVED_KEYWORD
98 365 SCONST NO_KEYWORD
== 002
