== 001
-- directory paths are passed to us in environment variables

-- set up file names to use

CREATE TABLE copy1 (a int, b float);

-- COPY TO/FROM not authorized from client.
DO LANGUAGE plpgsql $$
BEGIN
  COPY copy1 TO stdout;
END;
$$;
DO LANGUAGE plpgsql $$
BEGIN
  COPY copy1 FROM stdin;
--
ERROR: "unterminated dollar-quoted string at or near \"$$\nBEGIN\n  COPY copy1 FROM stdin;\""
CURSORPOS: 256
FILENAME: scan.l
FUNCNAME: scanner_yyerror
