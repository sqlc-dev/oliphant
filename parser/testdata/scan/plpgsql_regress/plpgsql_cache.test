== 006
-- currently, this fails due to cached plan for "r.f1 + 1" expression
-- (but if debug_discard_caches is on, it will succeed)
select c_sillyaddone(42)
--
0 69 SQL_COMMENT NO_KEYWORD
70 125 SQL_COMMENT NO_KEYWORD
126 132 SELECT RESERVED_KEYWORD
133 146 IDENT NO_KEYWORD
146 147 ASCII_40 NO_KEYWORD
147 149 ICONST NO_KEYWORD
149 150 ASCII_41 NO_KEYWORD
== 007
-- but it's OK if we force plan rebuilding
discard plans
--
0 42 SQL_COMMENT NO_KEYWORD
43 50 DISCARD UNRESERVED_KEYWORD
51 56 PLANS UNRESERVED_KEYWORD
== 008
select c_sillyaddone(42)
--
