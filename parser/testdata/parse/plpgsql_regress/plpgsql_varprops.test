== 026
-- Check that variables are reinitialized on block re-entry.

do $$
begin
  for i in 1..3 loop
    declare
      x int;
      y int := i;
      r record;
      c var_record;
    begin
      if i = 1 then
        x := 42;
        r := row(i, i+1);
        c := row(i, i+1);
      end if;
      raise notice 'x = %', x;
      raise notice 'y = %', y;
      raise notice 'r = %', r;
      raise notice 'c = %', c;
    end;
  end loop;
end$$
--
{"version":170007,"stmts":[{"stmt":{"DoStmt":{"args":[{"DefElem":{"defname":"as","arg":{"String":{"sval":"\nbegin\n  for i in 1..3 loop\n    declare\n      x int;\n      y int := i;\n      r record;\n      c var_record;\n    begin\n      if i = 1 then\n        x := 42;\n        r := row(i, i+1);\n        c := row(i, i+1);\n      end if;\n      raise notice 'x = %', x;\n      raise notice 'y = %', y;\n      raise notice 'r = %', r;\n      raise notice 'c = %', c;\n    end;\n  end loop;\nend"}},"defaction":"DEFELEM_UNSPEC","location":65}}]}}}]}
