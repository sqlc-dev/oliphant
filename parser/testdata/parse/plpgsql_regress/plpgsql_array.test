== 029
-- check functionality
do $$
declare
  v1 int;
  v2 varchar;
  a1 v1%type[];
  a2 v2%type[];
begin
  v1 := 10;
  v2 := 'Hi';
  a1 := array[v1,v1];
  a2 := array[v2,v2];
  raise notice '% %', a1, a2;
end;
$$
--
{"version":180004,"stmts":[{"stmt":{"DoStmt":{"args":[{"DefElem":{"defname":"as","arg":{"String":{"sval":"\ndeclare\n  v1 int;\n  v2 varchar;\n  a1 v1%type[];\n  a2 v2%type[];\nbegin\n  v1 := 10;\n  v2 := 'Hi';\n  a1 := array[v1,v1];\n  a2 := array[v2,v2];\n  raise notice '% %', a1, a2;\nend;\n"}},"defaction":"DEFELEM_UNSPEC","location":26}}]}},"stmt_location":23}]}
