== 016
do $$ declare a int[] := array[1,2,3];
begin
  -- test scenarios for optimization of updates of R/W expanded objects
  a := array_append(a, 42);  -- optimizable using "transfer" method
  a := a || a[3];  -- optimizable using "inplace" method
  a := a[1] || a;  -- ditto, but let's test array_prepend
  a := a || a;     -- not optimizable
  raise notice 'a = %', a;
end$$
--
{"version":180004,"stmts":[{"stmt":{"DoStmt":{"args":[{"DefElem":{"defname":"as","arg":{"String":{"sval":" declare a int[] := array[1,2,3];\nbegin\n  -- test scenarios for optimization of updates of R/W expanded objects\n  a := array_append(a, 42);  -- optimizable using \"transfer\" method\n  a := a || a[3];  -- optimizable using \"inplace\" method\n  a := a[1] || a;  -- ditto, but let's test array_prepend\n  a := a || a;     -- not optimizable\n  raise notice 'a = %', a;\nend"}},"defaction":"DEFELEM_UNSPEC","location":3}}]}}}]}
