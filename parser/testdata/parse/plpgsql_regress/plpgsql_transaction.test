== 113
DO LANGUAGE plpgsql $$
BEGIN
    ROLLBACK;
    SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
    FOR i IN 0..3 LOOP
        RAISE INFO 'transaction_isolation = %', current_setting('transaction_isolation');
        INSERT INTO test1 (a) VALUES (i);
        IF i % 2 = 0 THEN
            COMMIT AND CHAIN;
        ELSE
            ROLLBACK AND CHAIN;
        END IF;
    END LOOP;
END
$$
--
{"version":170007,"stmts":[{"stmt":{"DoStmt":{"args":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":3}},{"DefElem":{"defname":"as","arg":{"String":{"sval":"\nBEGIN\n    ROLLBACK;\n    SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;\n    FOR i IN 0..3 LOOP\n        RAISE INFO 'transaction_isolation = %', current_setting('transaction_isolation');\n        INSERT INTO test1 (a) VALUES (i);\n        IF i % 2 = 0 THEN\n            COMMIT AND CHAIN;\n        ELSE\n            ROLLBACK AND CHAIN;\n        END IF;\n    END LOOP;\nEND\n"}},"defaction":"DEFELEM_UNSPEC","location":20}}]}}}]}
