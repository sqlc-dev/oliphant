== 524
-- DO UPDATE with a WHERE clause
CREATE RULE hat_upsert AS ON INSERT TO hats
    DO INSTEAD
    INSERT INTO hat_data VALUES (
           NEW.hat_name,
           NEW.hat_color)
        ON CONFLICT (hat_name)
        DO UPDATE
           SET hat_name = hat_data.hat_name, hat_color = excluded.hat_color
           WHERE excluded.hat_color <>  'forbidden' AND hat_data.* != excluded.*
        RETURNING *
--
{"version":170007,"stmts":[{"stmt":{"RuleStmt":{"relation":{"relname":"hats","inh":true,"relpersistence":"p","location":72},"rulename":"hat_upsert","event":"CMD_INSERT","instead":true,"actions":[{"InsertStmt":{"relation":{"relname":"hat_data","inh":true,"relpersistence":"p","location":108},"selectStmt":{"SelectStmt":{"valuesLists":[{"List":{"items":[{"ColumnRef":{"fields":[{"String":{"sval":"new"}},{"String":{"sval":"hat_name"}}],"location":137}},{"ColumnRef":{"fields":[{"String":{"sval":"new"}},{"String":{"sval":"hat_color"}}],"location":162}}]}}],"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"onConflictClause":{"action":"ONCONFLICT_UPDATE","infer":{"indexElems":[{"IndexElem":{"name":"hat_name","ordering":"SORTBY_DEFAULT","nulls_ordering":"SORTBY_NULLS_DEFAULT"}}],"location":197},"targetList":[{"ResTarget":{"name":"hat_name","val":{"ColumnRef":{"fields":[{"String":{"sval":"hat_data"}},{"String":{"sval":"hat_name"}}],"location":252}},"location":241}},{"ResTarget":{"name":"hat_color","val":{"ColumnRef":{"fields":[{"String":{"sval":"excluded"}},{"String":{"sval":"hat_color"}}],"location":283}},"location":271}}],"whereClause":{"BoolExpr":{"boolop":"AND_EXPR","args":[{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"\u003c\u003e"}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"excluded"}},{"String":{"sval":"hat_color"}}],"location":319}},"rexpr":{"A_Const":{"sval":{"sval":"forbidden"},"location":342}},"location":338}},{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"\u003c\u003e"}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"hat_data"}},{"A_Star":{}}],"location":358}},"rexpr":{"ColumnRef":{"fields":[{"String":{"sval":"excluded"}},{"A_Star":{}}],"location":372}},"location":369}}],"location":354}},"location":185},"returningList":[{"ResTarget":{"val":{"ColumnRef":{"fields":[{"A_Star":{}}],"location":401}},"location":401}}],"override":"OVERRIDING_NOT_SET"}}]}}}]}
