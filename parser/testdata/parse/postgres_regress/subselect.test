== 244
create function explain_sq_limit() returns setof text language plpgsql as
$$
declare ln text;
begin
    for ln in
        explain (analyze, summary off, timing off, costs off, buffers off)
        select * from (select pk,c2 from sq_limit order by c1,pk) as x limit 3
    loop
        ln := regexp_replace(ln, 'Memory: \S*',  'Memory: xxx');
        return next ln;
    end loop;
end;
$$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"explain_sq_limit"}}],"returnType":{"names":[{"String":{"sval":"text"}}],"setof":true,"typemod":-1,"location":49},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":54}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\ndeclare ln text;\nbegin\n    for ln in\n        explain (analyze, summary off, timing off, costs off, buffers off)\n        select * from (select pk,c2 from sq_limit order by c1,pk) as x limit 3\n    loop\n        ln := regexp_replace(ln, 'Memory: \\S*',  'Memory: xxx');\n        return next ln;\n    end loop;\nend;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":71}}]}}}]}
