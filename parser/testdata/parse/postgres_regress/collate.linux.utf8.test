== 001
/*
 * This test is for Linux/glibc systems and assumes that a full set of
 * locales is installed.  It must be run in a database with UTF-8 encoding,
 * because other encodings don't support all the characters used.
 */

SELECT getdatabaseencoding() <> 'UTF8' OR
       (SELECT count(*) FROM pg_collation WHERE collname IN ('de_DE', 'en_US', 'sv_SE', 'tr_TR') AND collencoding = pg_char_to_encoding('UTF8')) <> 4 OR
       version() !~ 'linux-gnu'
       AS skip_test
--
{"version":170007,"stmts":[{"stmt":{"SelectStmt":{"targetList":[{"ResTarget":{"name":"skip_test","val":{"BoolExpr":{"boolop":"OR_EXPR","args":[{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"\u003c\u003e"}}],"lexpr":{"FuncCall":{"funcname":[{"String":{"sval":"getdatabaseencoding"}}],"funcformat":"COERCE_EXPLICIT_CALL","location":228}},"rexpr":{"A_Const":{"sval":{"sval":"UTF8"},"location":253}},"location":250}},{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"\u003c\u003e"}}],"lexpr":{"SubLink":{"subLinkType":"EXPR_SUBLINK","subselect":{"SelectStmt":{"targetList":[{"ResTarget":{"val":{"FuncCall":{"funcname":[{"String":{"sval":"count"}}],"agg_star":true,"funcformat":"COERCE_EXPLICIT_CALL","location":278}},"location":278}}],"fromClause":[{"RangeVar":{"relname":"pg_collation","inh":true,"relpersistence":"p","location":292}}],"whereClause":{"BoolExpr":{"boolop":"AND_EXPR","args":[{"A_Expr":{"kind":"AEXPR_IN","name":[{"String":{"sval":"="}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"collname"}}],"location":311}},"rexpr":{"List":{"items":[{"A_Const":{"sval":{"sval":"de_DE"},"location":324}},{"A_Const":{"sval":{"sval":"en_US"},"location":333}},{"A_Const":{"sval":{"sval":"sv_SE"},"location":342}},{"A_Const":{"sval":{"sval":"tr_TR"},"location":351}}]}},"location":320}},{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"="}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"collencoding"}}],"location":364}},"rexpr":{"FuncCall":{"funcname":[{"String":{"sval":"pg_char_to_encoding"}}],"args":[{"A_Const":{"sval":{"sval":"UTF8"},"location":399}}],"funcformat":"COERCE_EXPLICIT_CALL","location":379}},"location":377}}],"location":360}},"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"location":270}},"rexpr":{"A_Const":{"ival":{"ival":4},"location":411}},"location":408}},{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"!~"}}],"lexpr":{"FuncCall":{"funcname":[{"String":{"sval":"version"}}],"funcformat":"COERCE_EXPLICIT_CALL","location":423}