|--
-- Test the interaction between transition tables and both kinds of
-- inheritance.  We'll dump the contents of the transition tables in a
-- format that shows the attribute order, so that we can distinguish
-- tuple formats (though not dropped attributes).
|--

create or replace function dump_insert() returns trigger language plpgsql as
$$
  begin
    raise notice 'trigger = %, new table = %',
                 TG_NAME,
                 (select string_agg(new_table::text, ', ' order by a) from new_table);
    return null;
  end;
$$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"replace":true,"funcname":[{"String":{"sval":"dump_insert"}}],"returnType":{"names":[{"String":{"sval":"trigger"}}],"typemod":-1,"location":314},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":322}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\n  begin\n    raise notice 'trigger = %, new table = %',\n                 TG_NAME,\n                 (select string_agg(new_table::text, ', ' order by a) from new_table);\n    return null;\n  end;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":339}}]}},"stmt_location":265}]}
