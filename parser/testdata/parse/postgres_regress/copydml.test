== 052
-- triggers
create function qqq_trig() returns trigger as $$
begin
if tg_op in ('INSERT', 'UPDATE') then
    raise notice '% % %', tg_when, tg_op, new.id;
    return new;
else
    raise notice '% % %', tg_when, tg_op, old.id;
    return old;
end if;
end
$$ language plpgsql
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"qqq_trig"}}],"returnType":{"names":[{"String":{"sval":"trigger"}}],"typemod":-1,"location":47},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nbegin\nif tg_op in ('INSERT', 'UPDATE') then\n    raise notice '% % %', tg_when, tg_op, new.id;\n    return new;\nelse\n    raise notice '% % %', tg_when, tg_op, old.id;\n    return old;\nend if;\nend\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":55}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":257}}]}},"stmt_location":12}]}
