-- Check the GUC for disabling event triggers
CREATE FUNCTION test_event_trigger_guc() RETURNS event_trigger
LANGUAGE plpgsql AS $$
DECLARE
	obj record;
BEGIN
	FOR obj IN SELECT * FROM pg_event_trigger_dropped_objects()
	LOOP
		RAISE NOTICE '% dropped %', tg_tag, obj.object_type;
	END LOOP;
END;
$$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"test_event_trigger_guc"}}],"returnType":{"names":[{"String":{"sval":"event_trigger"}}],"typemod":-1,"location":95},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":109}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nDECLARE\n\tobj record;\nBEGIN\n\tFOR obj IN SELECT * FROM pg_event_trigger_dropped_objects()\n\tLOOP\n\t\tRAISE NOTICE '% dropped %', tg_tag, obj.object_type;\n\tEND LOOP;\nEND;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":126}}]}},"stmt_location":46}]}
