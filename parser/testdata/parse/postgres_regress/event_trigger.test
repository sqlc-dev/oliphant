== 161
CREATE FUNCTION reindex_end_command()
RETURNS event_trigger AS $$
DECLARE
    obj record;
BEGIN
    FOR obj IN SELECT * FROM pg_event_trigger_ddl_commands()
    LOOP
        RAISE NOTICE 'REINDEX END: command_tag=% type=% identity=%',
	    obj.command_tag, obj.object_type, obj.object_identity;
    END LOOP;
END;
$$ LANGUAGE plpgsql
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"reindex_end_command"}}],"returnType":{"names":[{"String":{"sval":"event_trigger"}}],"typemod":-1,"location":46},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nDECLARE\n    obj record;\nBEGIN\n    FOR obj IN SELECT * FROM pg_event_trigger_ddl_commands()\n    LOOP\n        RAISE NOTICE 'REINDEX END: command_tag=% type=% identity=%',\n\t    obj.command_tag, obj.object_type, obj.object_identity;\n    END LOOP;\nEND;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":60}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":317}}]}}}]}
