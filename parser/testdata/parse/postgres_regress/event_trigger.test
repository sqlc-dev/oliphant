-- check unfiltered results, too
CREATE OR REPLACE FUNCTION event_trigger_report_dropped()
 RETURNS event_trigger
 LANGUAGE plpgsql
AS $$
DECLARE r record;
BEGIN
    FOR r IN SELECT * from pg_event_trigger_dropped_objects()
    LOOP
    RAISE NOTICE 'DROP: orig=% normal=% istemp=% type=% identity=% schema=% name=% addr=% args=%',
        r.original, r.normal, r.is_temporary, r.object_type,
        r.object_identity, r.schema_name, r.object_name,
        r.address_names, r.address_args;
    END LOOP;
END; $$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"replace":true,"funcname":[{"String":{"sval":"event_trigger_report_dropped"}}],"returnType":{"names":[{"String":{"sval":"event_trigger"}}],"typemod":-1,"location":100},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":115}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nDECLARE r record;\nBEGIN\n    FOR r IN SELECT * from pg_event_trigger_dropped_objects()\n    LOOP\n    RAISE NOTICE 'DROP: orig=% normal=% istemp=% type=% identity=% schema=% name=% addr=% args=%',\n        r.original, r.normal, r.is_temporary, r.object_type,\n        r.object_identity, r.schema_name, r.object_name,\n        r.address_names, r.address_args;\n    END LOOP;\nEND; "}}]}},"defaction":"DEFELEM_UNSPEC","location":132}}]}},"stmt_location":33}]}
