== 001
|--
-- Test partitioning planner code
|--

-- Helper function which can be used for masking out portions of EXPLAIN
-- ANALYZE which could contain information that's not consistent on all
-- platforms.
create function explain_analyze(query text) returns setof text
language plpgsql as
$$
declare
    ln text;
begin
    for ln in
        execute format('explain (analyze, costs off, summary off, timing off, buffers off) %s',
            query)
    loop
        ln := regexp_replace(ln, 'Maximum Storage: \d+', 'Maximum Storage: N');
        return next ln;
    end loop;
end;
$$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"explain_analyze"}}],"parameters":[{"FunctionParameter":{"name":"query","argType":{"names":[{"String":{"sval":"text"}}],"typemod":-1,"location":238},"mode":"FUNC_PARAM_DEFAULT","location":232}}],"returnType":{"names":[{"String":{"sval":"text"}}],"setof":true,"typemod":-1,"location":258},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":263}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\ndeclare\n    ln text;\nbegin\n    for ln in\n        execute format('explain (analyze, costs off, summary off, timing off, buffers off) %s',\n            query)\n    loop\n        ln := regexp_replace(ln, 'Maximum Storage: \\d+', 'Maximum Storage: N');\n        return next ln;\n    end loop;\nend;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":280}}]}},"stmt_location":200}]}
