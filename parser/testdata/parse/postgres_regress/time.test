== 031
|--
-- TIME simple math
|--
-- We now make a distinction between time and intervals,
-- and adding two times together makes no sense at all.
-- Leave in one query to show that it is rejected,
-- and do the rest of the testing in horology.sql
-- where we do mixed-type arithmetic. - thomas 2000-12-02

SELECT f1 + time '00:01' AS "Illegal" FROM TIME_TBL
--
{"version":180004,"stmts":[{"stmt":{"SelectStmt":{"targetList":[{"ResTarget":{"name":"Illegal","val":{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"+"}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"f1"}}],"location":306}},"rexpr":{"TypeCast":{"arg":{"A_Const":{"sval":{"sval":"00:01"},"location":316}},"typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"time"}}],"typemod":-1,"location":311},"location":-1}},"location":309}},"location":306}}],"fromClause":[{"RangeVar":{"relname":"time_tbl","inh":true,"relpersistence":"p","location":342}}],"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"stmt_location":299}]}
