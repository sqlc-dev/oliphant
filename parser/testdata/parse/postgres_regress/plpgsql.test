|--
-- The following tests are unrelated to the scenario outlined above;
-- they merely exercise specific parts of PL/pgSQL
|--

|--
-- Test recursion, per bug report 7-Sep-01
|--
CREATE FUNCTION recursion_test(int,int) RETURNS text AS '
DECLARE rslt text;
BEGIN
    IF $1 <= 0 THEN
        rslt = CAST($2 AS TEXT);
    ELSE
        rslt = CAST($1 AS TEXT) || '','' || recursion_test($1 - 1, $2);
    END IF;
    RETURN rslt;
END;' LANGUAGE plpgsql
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"recursion_test"}}],"parameters":[{"FunctionParameter":{"argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":207},"mode":"FUNC_PARAM_DEFAULT","location":207}},{"FunctionParameter":{"argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":211},"mode":"FUNC_PARAM_DEFAULT","location":211}}],"returnType":{"names":[{"String":{"sval":"text"}}],"typemod":-1,"location":224},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nDECLARE rslt text;\nBEGIN\n    IF $1 \u003c= 0 THEN\n        rslt = CAST($2 AS TEXT);\n    ELSE\n        rslt = CAST($1 AS TEXT) || ',' || recursion_test($1 - 1, $2);\n    END IF;\n    RETURN rslt;\nEND;"}}]}},"defaction":"DEFELEM_UNSPEC","location":229}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":428}}]}},"stmt_location":176}]}
