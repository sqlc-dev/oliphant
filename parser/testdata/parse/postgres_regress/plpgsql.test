== 768
-- Check handling of errors thrown from/into anonymous code blocks.
do $outer$
begin
  for i in 1..10 loop
   begin
    execute $ex$
      do $$
      declare x int = 0;
      begin
        x := 1 / x;
      end;
      $$;
    $ex$;
  exception when division_by_zero then
    raise notice 'caught division by zero';
  end;
  end loop;
end;
$outer$
--
{"version":180004,"stmts":[{"stmt":{"DoStmt":{"args":[{"DefElem":{"defname":"as","arg":{"String":{"sval":"\nbegin\n  for i in 1..10 loop\n   begin\n    execute $ex$\n      do $$\n      declare x int = 0;\n      begin\n        x := 1 / x;\n      end;\n      $$;\n    $ex$;\n  exception when division_by_zero then\n    raise notice 'caught division by zero';\n  end;\n  end loop;\nend;\n"}},"defaction":"DEFELEM_UNSPEC","location":71}}]}},"stmt_location":68}]}
