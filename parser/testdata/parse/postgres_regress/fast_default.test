== 007
CREATE FUNCTION log_rewrite() RETURNS event_trigger
LANGUAGE plpgsql as
$func$

declare
   this_schema text;
begin
    select into this_schema relnamespace::regnamespace::text
    from pg_class
    where oid = pg_event_trigger_table_rewrite_oid();
    if this_schema = 'fast_default'
    then
        RAISE NOTICE 'rewriting table % for reason %',
          pg_event_trigger_table_rewrite_oid()::regclass,
          pg_event_trigger_table_rewrite_reason();
    end if;
end;
$func$
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"log_rewrite"}}],"returnType":{"names":[{"String":{"sval":"event_trigger"}}],"typemod":-1,"location":38},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":52}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\n\ndeclare\n   this_schema text;\nbegin\n    select into this_schema relnamespace::regnamespace::text\n    from pg_class\n    where oid = pg_event_trigger_table_rewrite_oid();\n    if this_schema = 'fast_default'\n    then\n        RAISE NOTICE 'rewriting table % for reason %',\n          pg_event_trigger_table_rewrite_oid()::regclass,\n          pg_event_trigger_table_rewrite_reason();\n    end if;\nend;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":69}}]}}}]}
