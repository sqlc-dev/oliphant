== 139
-- test that we account for missing columns without defaults correctly
-- in expand_tuple, and that rows are correctly expanded for triggers

CREATE FUNCTION test_trigger()
RETURNS trigger
LANGUAGE plpgsql
AS $$

begin
    raise notice 'old tuple: %', to_json(OLD)::text;
    if TG_OP = 'DELETE'
    then
       return OLD;
    else
       return NEW;
    end if;
end;

$$
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"test_trigger"}}],"returnType":{"names":[{"String":{"sval":"trigger"}}],"typemod":-1,"location":181},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":189}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\n\nbegin\n    raise notice 'old tuple: %', to_json(OLD)::text;\n    if TG_OP = 'DELETE'\n    then\n       return OLD;\n    else\n       return NEW;\n    end if;\nend;\n\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":206}}]}}}]}
