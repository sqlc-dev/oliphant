== 116
create function explain_parallel_sort_stats() returns setof text
language plpgsql as
$$
declare ln text;
begin
    for ln in
        explain (analyze, timing off, summary off, costs off, buffers off)
          select * from
          (select ten from tenk1 where ten < 100 order by ten) ss
          right join (values (1),(2),(3)) v(x) on true
    loop
        ln := regexp_replace(ln, 'Memory: \S*',  'Memory: xxx');
        return next ln;
    end loop;
end;
$$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"explain_parallel_sort_stats"}}],"returnType":{"names":[{"String":{"sval":"text"}}],"setof":true,"typemod":-1,"location":60},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":65}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\ndeclare ln text;\nbegin\n    for ln in\n        explain (analyze, timing off, summary off, costs off, buffers off)\n          select * from\n          (select ten from tenk1 where ten \u003c 100 order by ten) ss\n          right join (values (1),(2),(3)) v(x) on true\n    loop\n        ln := regexp_replace(ln, 'Memory: \\S*',  'Memory: xxx');\n        return next ln;\n    end loop;\nend;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":82}}]}}}]}
