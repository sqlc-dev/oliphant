cation":697}},{"A_Expr":{"kind":"AEXPR_DISTINCT","name":[{"String":{"sval":"="}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"mapped_oid"}}],"location":710}},"rexpr":{"ColumnRef":{"fields":[{"String":{"sval":"oid"}}],"location":738}},"location":721}}],"location":678}},"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"into":{"rel":{"relname":"filenode_mapping","inh":true,"relpersistence":"t","location":453},"onCommit":"ONCOMMIT_NOOP"},"objtype":"OBJECT_TABLE"}},"stmt_location":435}]}
