-- Check basic SPI plan invalidation

create function cache_test(int) returns int as $$
declare total int;
begin
	create temp table t1(f1 int);
	insert into t1 values($1);
	insert into t1 values(11);
	insert into t1 values(12);
	insert into t1 values(13);
	select sum(f1) into total from t1;
	drop table t1;
	return total;
end
$$ language plpgsql
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"cache_test"}}],"parameters":[{"FunctionParameter":{"argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":65},"mode":"FUNC_PARAM_DEFAULT","location":65}}],"returnType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":78},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\ndeclare total int;\nbegin\n\tcreate temp table t1(f1 int);\n\tinsert into t1 values($1);\n\tinsert into t1 values(11);\n\tinsert into t1 values(12);\n\tinsert into t1 values(13);\n\tselect sum(f1) into total from t1;\n\tdrop table t1;\n\treturn total;\nend\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":82}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":330}}]}},"stmt_location":38}]}
