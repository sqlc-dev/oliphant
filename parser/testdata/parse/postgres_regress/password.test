== 013
-- check list of created entries
|--
-- The scram secret will look something like:
-- SCRAM-SHA-256$4096:E4HxLGtnRzsYwg==$6YtlR4t69SguDiwFvbVgVZtuz6gpJQQqUMZ7IQJK5yI=:ps75jrHeYU4lXCcXI4O8oIdJ3eO8o2jirjruw9phBTo=
|--
-- Since the salt is random, the exact value stored will be different on every test
-- run. Use a regular expression to mask the changing parts.
SELECT rolname, regexp_replace(rolpassword, '(SCRAM-SHA-256)\$(\d+):([a-zA-Z0-9+/=]+)\$([a-zA-Z0-9+=/]+):([a-zA-Z0-9+/=]+)', '\1$\2:<salt>$<storedkey>:<serverkey>') as rolpassword_masked
    FROM pg_authid
    WHERE rolname LIKE 'regress_passwd%'
    ORDER BY rolname, rolpassword
--
{"version":180004,"stmts":[{"stmt":{"SelectStmt":{"targetList":[{"ResTarget":{"val":{"ColumnRef":{"fields":[{"String":{"sval":"rolname"}}],"location":366}},"location":366}},{"ResTarget":{"name":"rolpassword_masked","val":{"FuncCall":{"funcname":[{"String":{"sval":"regexp_replace"}}],"args":[{"ColumnRef":{"fields":[{"String":{"sval":"rolpassword"}}],"location":390}},{"A_Const":{"sval":{"sval":"(SCRAM-SHA-256)\\$(\\d+):([a-zA-Z0-9+/=]+)\\$([a-zA-Z0-9+=/]+):([a-zA-Z0-9+/=]+)"},"location":403}},{"A_Const":{"sval":{"sval":"\\1$\\2:\u003csalt\u003e$\u003cstoredkey\u003e:\u003cserverkey\u003e"},"location":484}}],"funcformat":"COERCE_EXPLICIT_CALL","location":375}},"location":375}}],"fromClause":[{"RangeVar":{"relname":"pg_authid","inh":true,"relpersistence":"p","location":555}}],"whereClause":{"A_Expr":{"kind":"AEXPR_LIKE","name":[{"String":{"sval":"~~"}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"rolname"}}],"location":575}},"rexpr":{"A_Const":{"sval":{"sval":"regress_passwd%"},"location":588}},"location":583}},"sortClause":[{"SortBy":{"node":{"ColumnRef":{"fields":[{"String":{"sval":"rolname"}}],"location":619}},"sortby_dir":"SORTBY_DEFAULT","sortby_nulls":"SORTBY_NULLS_DEFAULT","location":-1}},{"SortBy":{"node":{"ColumnRef":{"fields":[{"String":{"sval":"rolpassword"}}],"location":628}},"sortby_dir":"SORTBY_DEFAULT","sortby_nulls":"SORTBY_NULLS_DEFAULT","location":-1}}],"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"stmt_location":359}]}
