create function explain_query_json(query_sql text)
returns table (explain_line json)
language plpgsql as
$$
begin
  set enable_seqscan = off;
  set enable_bitmapscan = on;
  return query execute 'EXPLAIN (ANALYZE, FORMAT json) ' || query_sql;
end;
$$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"explain_query_json"}}],"parameters":[{"FunctionParameter":{"name":"query_sql","argType":{"names":[{"String":{"sval":"text"}}],"typemod":-1,"location":45},"mode":"FUNC_PARAM_DEFAULT","location":35}},{"FunctionParameter":{"name":"explain_line","argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"json"}}],"typemod":-1,"location":79},"mode":"FUNC_PARAM_TABLE","location":66}}],"returnType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"json"}}],"setof":true,"typemod":-1,"location":59},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":85}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nbegin\n  set enable_seqscan = off;\n  set enable_bitmapscan = on;\n  return query execute 'EXPLAIN (ANALYZE, FORMAT json) ' || query_sql;\nend;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":102}}]}}}]}
== 032
create function execute_text_query_index(query_sql text)
returns setof text
language plpgsql
as
$$
begin
  set enable_seqscan = off;
  set enable_bitmapscan = on;
  return query execute query_sql;
end;
