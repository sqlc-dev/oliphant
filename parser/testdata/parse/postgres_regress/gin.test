== 011
-- Disable fastupdate, and do more insertions. With fastupdate enabled, most
-- insertions (by flushing the list pages) cause page splits. Without
-- fastupdate, we get more churn in the GIN data leaf pages, and exercise the
-- recompression codepaths.
alter index gin_test_idx set (fastupdate = off)
--
{"version":180004,"stmts":[{"stmt":{"AlterTableStmt":{"relation":{"relname":"gin_test_idx","inh":true,"relpersistence":"p","location":265},"cmds":[{"AlterTableCmd":{"subtype":"AT_SetRelOptions","def":{"List":{"items":[{"DefElem":{"defname":"fastupdate","arg":{"TypeName":{"names":[{"String":{"sval":"off"}}],"typemod":-1,"location":296}},"defaction":"DEFELEM_UNSPEC","location":283}}]}},"behavior":"DROP_RESTRICT"}}],"objtype":"OBJECT_INDEX"}},"stmt_location":253}]}
