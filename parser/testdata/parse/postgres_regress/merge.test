== 335
CREATE FUNCTION explain_merge(query text) RETURNS SETOF text
LANGUAGE plpgsql AS
$$
DECLARE ln text;
BEGIN
    FOR ln IN
        EXECUTE 'explain (analyze, timing off, summary off, costs off) ' ||
		  query
    LOOP
        ln := regexp_replace(ln, '(Memory( Usage)?|Buckets|Batches): \S*',  '\1: xxx', 'g');
        RETURN NEXT ln;
    END LOOP;
END;
$$
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"explain_merge"}}],"parameters":[{"FunctionParameter":{"name":"query","argType":{"names":[{"String":{"sval":"text"}}],"typemod":-1,"location":36},"mode":"FUNC_PARAM_DEFAULT"}}],"returnType":{"names":[{"String":{"sval":"text"}}],"setof":true,"typemod":-1,"location":56},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":61}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nDECLARE ln text;\nBEGIN\n    FOR ln IN\n        EXECUTE 'explain (analyze, timing off, summary off, costs off) ' ||\n\t\t  query\n    LOOP\n        ln := regexp_replace(ln, '(Memory( Usage)?|Buckets|Batches): \\S*',  '\\1: xxx', 'g');\n        RETURN NEXT ln;\n    END LOOP;\nEND;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":78}}]}}}]}
