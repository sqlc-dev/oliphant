== 054
---------------------------
-- UPDATE with row movement
---------------------------

-- When a partitioned table receives an UPDATE to the partitioned key and the
-- new values no longer meet the partition's bound, the row must be moved to
-- the correct partition for the new partition key (if one exists). We must
-- also ensure that updatable views on partitioned tables properly enforce any
-- WITH CHECK OPTION that is defined. The situation with triggers in this case
-- also requires thorough testing as partition key updates causing row
-- movement convert UPDATEs into DELETE+INSERT.

CREATE TABLE range_parted (
	a text,
	b bigint,
	c numeric,
	d int,
	e varchar
) PARTITION BY RANGE (a, b)
--
{"version":170007,"stmts":[{"stmt":{"CreateStmt":{"relation":{"relname":"range_parted","inh":true,"relpersistence":"p","location":607},"tableElts":[{"ColumnDef":{"colname":"a","typeName":{"names":[{"String":{"sval":"text"}}],"typemod":-1,"location":625},"is_local":true,"location":623}},{"ColumnDef":{"colname":"b","typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int8"}}],"typemod":-1,"location":634},"is_local":true,"location":632}},{"ColumnDef":{"colname":"c","typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"numeric"}}],"typemod":-1,"location":645},"is_local":true,"location":643}},{"ColumnDef":{"colname":"d","typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":657},"is_local":true,"location":655}},{"ColumnDef":{"colname":"e","typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"varchar"}}],"typemod":-1,"location":665},"is_local":true,"location":663}}],"partspec":{"strategy":"PARTITION_STRATEGY_RANGE","partParams":[{"PartitionElem":{"name":"a","location":695}},{"PartitionElem":{"name":"b","location":698}}],"location":675},"oncommit":"ONCOMMIT_NOOP"}}}]}
