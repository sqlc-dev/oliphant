-- If BR DELETE trigger prevented DELETE from happening, we should also skip
-- the INSERT if that delete is part of UPDATE=>DELETE+INSERT.
CREATE OR REPLACE FUNCTION func_parted_mod_b() returns trigger as $$
BEGIN
   raise notice 'Trigger: Got OLD row %, but returning NULL', OLD;
   return NULL;
END $$ LANGUAGE plpgsql
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"replace":true,"funcname":[{"String":{"sval":"func_parted_mod_b"}}],"returnType":{"names":[{"String":{"sval":"trigger"}}],"typemod":-1,"location":195},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nBEGIN\n   raise notice 'Trigger: Got OLD row %, but returning NULL', OLD;\n   return NULL;\nEND "}}]}},"defaction":"DEFELEM_UNSPEC","location":203}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":305}}]}}}]}
