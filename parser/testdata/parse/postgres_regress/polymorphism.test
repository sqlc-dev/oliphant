== 179
-- another kind of polymorphic aggregate

create function add_group(grp anyarray, ad anyelement, size integer)
  returns anyarray
  as $$
begin
  if grp is null then
    return array[ad];
  end if;
  if array_upper(grp, 1) < size then
    return grp || ad;
  end if;
  return grp;
end;
$$
  language plpgsql immutable
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"add_group"}}],"parameters":[{"FunctionParameter":{"name":"grp","argType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":72},"mode":"FUNC_PARAM_DEFAULT","location":68}},{"FunctionParameter":{"name":"ad","argType":{"names":[{"String":{"sval":"anyelement"}}],"typemod":-1,"location":85},"mode":"FUNC_PARAM_DEFAULT","location":82}},{"FunctionParameter":{"name":"size","argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":102},"mode":"FUNC_PARAM_DEFAULT","location":97}}],"returnType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":121},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nbegin\n  if grp is null then\n    return array[ad];\n  end if;\n  if array_upper(grp, 1) \u003c size then\n    return grp || ad;\n  end if;\n  return grp;\nend;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":132}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":291}},{"DefElem":{"defname":"volatility","arg":{"String":{"sval":"immutable"}},"defaction":"DEFELEM_UNSPEC","location":308}}]}},"stmt_location":42}]}
