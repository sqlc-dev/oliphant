|--
-- Polymorphic aggregate tests
|--
-- Legend:
-----------
-- A = type is ANY
-- P = type is polymorphic
-- N = type is non-polymorphic
-- B = aggregate base type
-- S = aggregate state type
-- R = aggregate return type
-- 1 = arg1 of a function
-- 2 = arg2 of a function
-- ag = aggregate
-- tf = trans (state) function
-- ff = final function
-- rt = return type of a function
-- -> = implies
-- => = allowed
-- !> = not allowed
-- E  = exists
-- NE = not-exists
|--
-- Possible states:
-- ----------------
-- B = (A || P || N)
--   when (B = A) -> (tf2 = NE)
-- S = (P || N)
-- ff = (E || NE)
-- tf1 = (P || N)
-- tf2 = (NE || P || N)
-- R = (P || N)

-- create functions for use as tf and ff with the needed combinations of
-- argument polymorphism, but within the constraints of valid aggregate
-- functions, i.e. tf arg1 and tf return type must match

-- polymorphic single arg transfn
CREATE FUNCTION stfp(anyarray) RETURNS anyarray AS
'select $1' LANGUAGE SQL
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"stfp"}}],"parameters":[{"FunctionParameter":{"argType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":912},"mode":"FUNC_PARAM_DEFAULT","location":912}}],"returnType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":930},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"select $1"}}]}},"defaction":"DEFELEM_UNSPEC","location":939}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"sql"}},"defaction":"DEFELEM_UNSPEC","location":954}}]}},"stmt_location":891}]}
