== 005
-- Parallel VACUUM will never be used unless there are at least two indexes
-- that exceed min_parallel_index_scan_size.  Create two such indexes, and
-- a third index that is smaller than min_parallel_index_scan_size.
CREATE INDEX regular_sized_index ON parallel_vacuum_table(a)
--
{"version":180004,"stmts":[{"stmt":{"IndexStmt":{"idxname":"regular_sized_index","relation":{"relname":"parallel_vacuum_table","inh":true,"relpersistence":"p","location":255},"accessMethod":"btree","indexParams":[{"IndexElem":{"name":"a","ordering":"SORTBY_DEFAULT","nulls_ordering":"SORTBY_NULLS_DEFAULT"}}]}},"stmt_location":219}]}
