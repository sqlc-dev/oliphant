== 007
-- Note: vacuum_in_leader_small_index can apply deduplication, making it ~3x
-- smaller than the other indexes
CREATE INDEX vacuum_in_leader_small_index ON parallel_vacuum_table((1))
--
{"version":180004,"stmts":[{"stmt":{"IndexStmt":{"idxname":"vacuum_in_leader_small_index","relation":{"relname":"parallel_vacuum_table","inh":true,"relpersistence":"p","location":156},"accessMethod":"btree","indexParams":[{"IndexElem":{"expr":{"A_Const":{"ival":{"ival":1},"location":179}},"ordering":"SORTBY_DEFAULT","nulls_ordering":"SORTBY_NULLS_DEFAULT"}}]}},"stmt_location":111}]}
== 008
-- Verify (as best we can) that the cost model for parallel VACUUM
-- will make our VACUUM run in parallel, while always leaving it up to the
-- parallel leader to handle the vacuum_in_leader_small_index index:
SELECT EXISTS (
SELECT 1
FROM pg_class
WHERE oid = 'vacuum_in_leader_small_index'::regclass AND
  pg_relation_size(oid) <
  pg_size_bytes(current_setting('min_parallel_index_scan_size'))
) as leader_will_handle_small_index
--
{"version":180004,"stmts":[{"stmt":{"SelectStmt":{"targetList":[{"ResTarget":{"name":"leader_will_handle_small_index","val":{"SubLink":{"subLinkType":"EXISTS_SUBLINK","subselect":{"SelectStmt":{"targetList":[{"ResTarget":{"val":{"A_Const":{"ival":{"ival":1},"location":234}},"location":234}}],"fromClause":[{"RangeVar":{"relname":"pg_class","inh":true,"relpersistence":"p","location":241}}],"whereClause":{"BoolExpr":{"boolop":"AND_EXPR","args":[{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"="}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"oid"}}],"location":256}},"rexpr":{"TypeCast":{"arg":{"A_Const":{"sval":{"sval":"vacuum_in_leader_small_index"},"location":262}},"typeName":{"names":[{"String":{"sval":"regclass"}}],"typemod":-1,"location":294},"location":292}},"location":260}},{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"\u003c"}}],"lexpr":{"FuncCall":{"funcname":[{"String":{"sval":"pg_relation_size"}}],"args":[{"ColumnRef":{"fields":[{"String":{"sval":"oid"}}],"location":326}}],"funcformat":"COERCE_EXPLICIT_CALL","location":309}},"rexpr":{"FuncCall":{"funcname":[{"String":{"sval":"pg_size_bytes"}}],"args":[{"FuncCall":{"funcname":[{"String":{"sval":"current_setting"}}],"args":[{"A_Const":{"sval":{"sval":"min_parallel_index_scan_size"},"location":365}}],"funcformat":"COERCE_EXPLICIT_CALL","location":349}}],"funcformat":"COERCE_EXPLICIT_CALL","location":335}},"location":331}}],"location":303}},"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"location":218}},"location":218}}],"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"stmt_location":211}]}
== 009
SELECT count(*) as trigger_parallel_vacuum_nindexes
FROM pg_class
WHERE oid in ('regular_sized_index'::regclass, 'typically_sized_index'::regclass) AND
  pg_relation_size(oid) >=
  pg_size_bytes(current_setting('min_parallel_index_scan_size'))
--
