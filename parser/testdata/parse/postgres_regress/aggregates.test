== 448
CREATE FUNCTION rwagg_sfunc(x anyarray, y anyarray) RETURNS anyarray
LANGUAGE plpgsql IMMUTABLE AS $$
BEGIN
    RETURN array_fill(y[1], ARRAY[4]);
END;
$$
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"rwagg_sfunc"}}],"parameters":[{"FunctionParameter":{"name":"x","argType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":30},"mode":"FUNC_PARAM_DEFAULT"}},{"FunctionParameter":{"name":"y","argType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":42},"mode":"FUNC_PARAM_DEFAULT"}}],"returnType":{"names":[{"String":{"sval":"anyarray"}}],"typemod":-1,"location":60},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":69}},{"DefElem":{"defname":"volatility","arg":{"String":{"sval":"immutable"}},"defaction":"DEFELEM_UNSPEC","location":86}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nBEGIN\n    RETURN array_fill(y[1], ARRAY[4]);\nEND;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":96}}]}}}]}
== 449
CREATE FUNCTION rwagg_finalfunc(x anyarray) RETURNS anyarray
LANGUAGE plpgsql STRICT IMMUTABLE AS $$
DECLARE
    res x%TYPE;
BEGIN
    -- assignment is essential for this test, it expands the array to R/W
    res := array_fill(x[1], ARRAY[4]);
    RETURN res;
END;
$$
--
