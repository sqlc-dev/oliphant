--
{"version":170007,"stmts":[{"stmt":{"CompositeTypeStmt":{"typevar":{"relname":"avg_state","relpersistence":"p","location":12},"coldeflist":[{"ColumnDef":{"colname":"total","typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int8"}}],"typemod":-1,"location":32},"is_local":true,"location":26}},{"ColumnDef":{"colname":"count","typeName":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int8"}}],"typemod":-1,"location":46},"is_local":true,"location":40}}]}}}]}
== 369
create or replace function avg_transfn(state avg_state, n int) returns avg_state as
$$
declare new_state avg_state;
begin
	raise notice 'avg_transfn called with %', n;
	if state is null then
		if n is not null then
			new_state.total := n;
			new_state.count := 1;
			return new_state;
		end if;
		return null;
	elsif n is not null then
		state.total := state.total + n;
		state.count := state.count + 1;
		return state;
	end if;

	return null;
end
$$ language plpgsql
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"replace":true,"funcname":[{"String":{"sval":"avg_transfn"}}],"parameters":[{"FunctionParameter":{"name":"state","argType":{"names":[{"String":{"sval":"avg_state"}}],"typemod":-1,"location":45},"mode":"FUNC_PARAM_DEFAULT"}},{"FunctionParameter":{"name":"n","argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":58},"mode":"FUNC_PARAM_DEFAULT"}}],"returnType":{"names":[{"String":{"sval":"avg_state"}}],"typemod":-1,"location":71},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\ndeclare new_state avg_state;\nbegin\n\traise notice 'avg_transfn called with %', n;\n\tif state is null then\n\t\tif n is not null then\n\t\t\tnew_state.total := n;\n\t\t\tnew_state.count := 1;\n\t\t\treturn new_state;\n\t\tend if;\n\t\treturn null;\n\telsif n is not null then\n\t\tstate.total := state.total + n;\n\t\tstate.count := state.count + 1;\n\t\treturn state;\n\tend if;\n\n\treturn null;\nend\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":81}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":452}}]}}}]}
== 370
create function avg_finalfn(state avg_state) returns int4 as
$$
begin
	if state is null then
		return NULL;
	else
		return state.total / state.count;
	end if;
end
$$ language plpgsql
--
