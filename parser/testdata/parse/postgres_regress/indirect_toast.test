== 016
-- now create a trigger that forces all Datums to be indirect ones
CREATE FUNCTION update_using_indirect()
        RETURNS trigger
        LANGUAGE plpgsql AS $$
BEGIN
    NEW := make_tuple_indirect(NEW);
    RETURN NEW;
END$$
--
{"version":170007,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"update_using_indirect"}}],"returnType":{"names":[{"String":{"sval":"trigger"}}],"typemod":-1,"location":123},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":139}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nBEGIN\n    NEW := make_tuple_indirect(NEW);\n    RETURN NEW;\nEND"}}]}},"defaction":"DEFELEM_UNSPEC","location":156}}]}}}]}
