{"version":170007,"stmts":[{"stmt":{"SelectStmt":{"targetList":[{"ResTarget":{"val":{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"="}}],"lexpr":{"A_Const":{"sval":{"sval":"ὀδυσσεύς"},"location":240}},"rexpr":{"CollateClause":{"arg":{"A_Const":{"sval":{"sval":"ὈΔΥΣΣΕΎΣ"},"location":262}},"collname":[{"String":{"sval":"case_sensitive"}}],"location":282}},"location":260}},"location":240}}],"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}}}]}
