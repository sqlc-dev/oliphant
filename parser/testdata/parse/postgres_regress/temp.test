== 167
-- Don't want cursor names and plpgsql function lines in the error messages

/* helper function to create cursors for each page in [p_start, p_end] */
CREATE FUNCTION test_temp_pin(p_start int, p_end int)
RETURNS void
LANGUAGE plpgsql
AS $f$
  DECLARE
      cursorname text;
      query text;
  BEGIN
    FOR i IN p_start..p_end LOOP
       cursorname = 'c_'||i;
       query = format($q$DECLARE %I CURSOR FOR SELECT ctid FROM test_temp WHERE ctid >= '( %s, 1)'::tid $q$, cursorname, i);
       EXECUTE query;
       EXECUTE 'FETCH NEXT FROM '||cursorname;
       -- for test development
       -- RAISE NOTICE '%: %', cursorname, query;
    END LOOP;
  END;
$f$
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"test_temp_pin"}}],"parameters":[{"FunctionParameter":{"name":"p_start","argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":189},"mode":"FUNC_PARAM_DEFAULT","location":181}},{"FunctionParameter":{"name":"p_end","argType":{"names":[{"String":{"sval":"pg_catalog"}},{"String":{"sval":"int4"}}],"typemod":-1,"location":200},"mode":"FUNC_PARAM_DEFAULT","location":194}}],"returnType":{"names":[{"String":{"sval":"void"}}],"typemod":-1,"location":213},"options":[{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":218}},{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\n  DECLARE\n      cursorname text;\n      query text;\n  BEGIN\n    FOR i IN p_start..p_end LOOP\n       cursorname = 'c_'||i;\n       query = format($q$DECLARE %I CURSOR FOR SELECT ctid FROM test_temp WHERE ctid \u003e= '( %s, 1)'::tid $q$, cursorname, i);\n       EXECUTE query;\n       EXECUTE 'FETCH NEXT FROM '||cursorname;\n       -- for test development\n       -- RAISE NOTICE '%: %', cursorname, query;\n    END LOOP;\n  END;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":235}}]}},"stmt_location":151}]}
