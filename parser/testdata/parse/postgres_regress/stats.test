== 449
CREATE FUNCTION wait_for_hot_stats() RETURNS void AS $$
DECLARE
  start_time timestamptz := clock_timestamp();
  updated bool;
BEGIN
  -- we don't want to wait forever; loop will exit after 30 seconds
  FOR i IN 1 .. 300 LOOP
    SELECT (pg_stat_get_tuples_hot_updated('brin_hot'::regclass::oid) > 0) INTO updated;
    EXIT WHEN updated;

    -- wait a little
    PERFORM pg_sleep_for('100 milliseconds');
    -- reset stats snapshot so we can test again
    PERFORM pg_stat_clear_snapshot();
  END LOOP;
  -- report time waited in postmaster log (where it won't change test output)
  RAISE log 'wait_for_hot_stats delayed % seconds',
    EXTRACT(epoch FROM clock_timestamp() - start_time);
END
$$ LANGUAGE plpgsql
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"wait_for_hot_stats"}}],"returnType":{"names":[{"String":{"sval":"void"}}],"typemod":-1,"location":45},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nDECLARE\n  start_time timestamptz := clock_timestamp();\n  updated bool;\nBEGIN\n  -- we don't want to wait forever; loop will exit after 30 seconds\n  FOR i IN 1 .. 300 LOOP\n    SELECT (pg_stat_get_tuples_hot_updated('brin_hot'::regclass::oid) \u003e 0) INTO updated;\n    EXIT WHEN updated;\n\n    -- wait a little\n    PERFORM pg_sleep_for('100 milliseconds');\n    -- reset stats snapshot so we can test again\n    PERFORM pg_stat_clear_snapshot();\n  END LOOP;\n  -- report time waited in postmaster log (where it won't change test output)\n  RAISE log 'wait_for_hot_stats delayed % seconds',\n    EXTRACT(epoch FROM clock_timestamp() - start_time);\nEND\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":50}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":698}}]}}}]}
