== 184
CREATE FUNCTION rw_view1_trig_fn()
RETURNS trigger AS
$$
BEGIN
  IF TG_OP = 'INSERT' THEN
    INSERT INTO base_tbl VALUES (NEW.a, NEW.b);
    NEW.c1 = 'Trigger Const1';
    RETURN NEW;
  ELSIF TG_OP = 'UPDATE' THEN
    UPDATE base_tbl SET b=NEW.b WHERE a=OLD.a;
    NEW.c1 = 'Trigger Const1';
    RETURN NEW;
  ELSIF TG_OP = 'DELETE' THEN
    DELETE FROM base_tbl WHERE a=OLD.a;
    RETURN OLD;
  END IF;
END;
$$
LANGUAGE plpgsql
--
{"version":180004,"stmts":[{"stmt":{"CreateFunctionStmt":{"funcname":[{"String":{"sval":"rw_view1_trig_fn"}}],"returnType":{"names":[{"String":{"sval":"trigger"}}],"typemod":-1,"location":43},"options":[{"DefElem":{"defname":"as","arg":{"List":{"items":[{"String":{"sval":"\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    INSERT INTO base_tbl VALUES (NEW.a, NEW.b);\n    NEW.c1 = 'Trigger Const1';\n    RETURN NEW;\n  ELSIF TG_OP = 'UPDATE' THEN\n    UPDATE base_tbl SET b=NEW.b WHERE a=OLD.a;\n    NEW.c1 = 'Trigger Const1';\n    RETURN NEW;\n  ELSIF TG_OP = 'DELETE' THEN\n    DELETE FROM base_tbl WHERE a=OLD.a;\n    RETURN OLD;\n  END IF;\nEND;\n"}}]}},"defaction":"DEFELEM_UNSPEC","location":51}},{"DefElem":{"defname":"language","arg":{"String":{"sval":"plpgsql"}},"defaction":"DEFELEM_UNSPEC","location":413}}]}}}]}
