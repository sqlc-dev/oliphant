== 005
|--
-- Test the planner's ability to use a LIMIT 1 instead of a Unique node when
-- all of the distinct_pathkeys have been marked as redundant
|--

-- Ensure we also get a LIMIT plan with DISTINCT ON
EXPLAIN (COSTS OFF)
SELECT DISTINCT ON (four) four,two
   FROM tenk1 WHERE four = 0 ORDER BY 1
--
{"version":170007,"stmts":[{"stmt":{"ExplainStmt":{"query":{"SelectStmt":{"distinctClause":[{"ColumnRef":{"fields":[{"String":{"sval":"four"}}],"location":238}}],"targetList":[{"ResTarget":{"val":{"ColumnRef":{"fields":[{"String":{"sval":"four"}}],"location":244}},"location":244}},{"ResTarget":{"val":{"ColumnRef":{"fields":[{"String":{"sval":"two"}}],"location":249}},"location":249}}],"fromClause":[{"RangeVar":{"relname":"tenk1","inh":true,"relpersistence":"p","location":261}}],"whereClause":{"A_Expr":{"kind":"AEXPR_OP","name":[{"String":{"sval":"="}}],"lexpr":{"ColumnRef":{"fields":[{"String":{"sval":"four"}}],"location":273}},"rexpr":{"A_Const":{"ival":{},"location":280}},"location":278}},"sortClause":[{"SortBy":{"node":{"A_Const":{"ival":{"ival":1},"location":291}},"sortby_dir":"SORTBY_DEFAULT","sortby_nulls":"SORTBY_NULLS_DEFAULT","location":-1}}],"limitOption":"LIMIT_OPTION_DEFAULT","op":"SETOP_NONE"}},"options":[{"DefElem":{"defname":"costs","arg":{"String":{"sval":"off"}},"defaction":"DEFELEM_UNSPEC","location":207}}]}}}]}
