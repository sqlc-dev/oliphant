== 001
SELECT *
FROM a
ORDER BY
    b, c ASC, d DESC, e NULLS FIRST, f NULLS LAST, g ASC NULLS FIRST,
    h DESC NULLS FIRST, i ASC NULLS LAST, j DESC NULLS LAST
