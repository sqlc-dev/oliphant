|--
-- Test WITH attached to a data-modifying statement
|--

CREATE TEMPORARY TABLE y (a INTEGER)
--
TABLE: name="y" schema="" table="y" ctx=DDL
STMT: CreateStmt
== 110
INSERT INTO y SELECT generate_series(1, 10)
--
TABLE: name="y" schema="" table="y" ctx=DML
FUNCTION: name="generate_series" function="generate_series" schema="" ctx=Call
STMT: InsertStmt
STMT: SelectStmt
== 111
WITH t AS (
	SELECT a FROM y
)
INSERT INTO y
