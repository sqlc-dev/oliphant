CTE: "a"
CTE: "b"
CTE: "c"
FUNCTION: name="row_number" function="row_number" schema="" ctx=Call
FILTER: schema="" table="b" column="id"
FILTER: schema="" table="a" column="id"
STMT: SelectStmt
