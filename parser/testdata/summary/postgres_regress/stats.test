-- Changing stats_fetch_consistency in a transaction.
----
BEGIN
--
STMT: TransactionStmt
== 307
-- Stats filled under the cache mode
SET LOCAL stats_fetch_consistency = cache
--
STMT: VariableSetStmt
== 308
SELECT pg_stat_get_function_calls(0)
