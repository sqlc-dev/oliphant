SELECT pg_stat_get_snapshot_timestamp() IS NOT NULL AS snapshot_ok
--
FUNCTION: name="pg_stat_get_snapshot_timestamp" function="pg_stat_get_snapshot_timestamp" schema="" ctx=Call
STMT: SelectStmt
== 314
-- Snapshot cleared.
SET LOCAL stats_fetch_consistency = none
--
STMT: VariableSetStmt
== 315
SELECT pg_stat_get_snapshot_timestamp() IS NOT NULL AS snapshot_ok
--
