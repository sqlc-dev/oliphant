-- test inlining of polymorphic SQL functions
create function bleat(int) returns int as $$
begin
  raise notice 'bleat %', $1;
  return $1;
end$$ language plpgsql
--
FUNCTION: name="bleat" function="bleat" schema="" ctx=DDL
