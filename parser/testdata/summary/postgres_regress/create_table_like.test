STMT: CreateStmt
== 171
SELECT s.stxrelid::regclass AS relation,
       array_agg(a.attname ORDER BY u.ord) AS stats_columns
FROM pg_statistic_ext s
CROSS JOIN LATERAL
  unnest(s.stxkeys::int2[]) WITH ORDINALITY AS u(attnum, ord)
JOIN pg_attribute a
  ON a.attrelid = s.stxrelid AND a.attnum = u.attnum
WHERE s.stxrelid IN ('ctl_stats3_child'::regclass,
                     'ctl_stats4_child'::regclass)
GROUP BY s.stxrelid
ORDER BY s.stxrelid::regclass::text
--
TABLE: name="pg_statistic_ext" schema="" table="pg_statistic_ext" ctx=Select
TABLE: name="pg_attribute" schema="" table="pg_attribute" ctx=Select
ALIAS: "a"="pg_attribute"
ALIAS: "s"="pg_statistic_ext"
FUNCTION: name="array_agg" function="array_agg" schema="" ctx=Call
FUNCTION: name="unnest" function="unnest" schema="" ctx=Call
FILTER: schema="" table="s" column="stxrelid"
STMT: SelectStmt
