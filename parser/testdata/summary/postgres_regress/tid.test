== 001
-- basic tests for the TID data type

SELECT
  '(0,0)'::tid as tid00,
  '(0,1)'::tid as tid01,
  '(-1,0)'::tid as tidm10,
  '(4294967295,65535)'::tid as tidmax
--
STMT: SelectStmt
== 002
SELECT '(4294967296,1)'::tid
--
STMT: SelectStmt
== 003
-- error
SELECT '(1,65536)'::tid
--
STMT: SelectStmt
== 004
-- error

-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('(0)', 'tid')
