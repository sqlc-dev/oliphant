-- Tests for currtid2() with various relation kinds

-- Materialized view
CREATE MATERIALIZED VIEW tid_matview AS SELECT a FROM tid_tab
--
TABLE: name="tid_matview" schema="" table="tid_matview" ctx=DDL
TABLE: name="tid_tab" schema="" table="tid_tab" ctx=Select
STMT: CreateTableAsStmt
STMT: SelectStmt
== 014
SELECT currtid2('tid_matview'::text, '(0,1)'::tid)
--
FUNCTION: name="currtid2" function="currtid2" schema="" ctx=Call
STMT: SelectStmt
== 015
-- fails
INSERT INTO tid_tab VALUES (1)
--
TABLE: name="tid_tab" schema="" table="tid_tab" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 016
