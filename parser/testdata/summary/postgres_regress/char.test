== 024
|--
-- Also test "char", which is an ad-hoc one-byte type.  It can only
-- really store ASCII characters, but we allow high-bit-set characters
-- to be accessed via bytea-like escapes.
|--

SELECT 'a'::"char"
--
STMT: SelectStmt
== 025
SELECT '\101'::"char"
--
STMT: SelectStmt
== 026
SELECT '\377'::"char"
--
STMT: SelectStmt
== 027
SELECT 'a'::"char"::text
--
STMT: SelectStmt
== 028
SELECT '\377'::"char"::text
--
STMT: SelectStmt
== 029
SELECT '\000'::"char"::text
--
STMT: SelectStmt
== 030
SELECT 'a'::text::"char"
--
STMT: SelectStmt
== 031
SELECT '\377'::text::"char"
--
STMT: SelectStmt
== 032
SELECT ''::text::"char"
--
STMT: SelectStmt
