== 001
-- Regression tests for prepareable statements. We query the content
-- of the pg_prepared_statements view as prepared statements are
-- created and removed.

SELECT name, statement, parameter_types, result_types FROM pg_prepared_statements
--
TABLE: name="pg_prepared_statements" schema="" table="pg_prepared_statements" ctx=Select
STMT: SelectStmt
== 002
PREPARE q1 AS SELECT 1 AS a
--
STMT: PrepareStmt
STMT: SelectStmt
== 003
EXECUTE q1
--
STMT: ExecuteStmt
== 004
SELECT name, statement, parameter_types, result_types FROM pg_prepared_statements
--
TABLE: name="pg_prepared_statements" schema="" table="pg_prepared_statements" ctx=Select
STMT: SelectStmt
== 005
-- should fail
PREPARE q1 AS SELECT 2
--
STMT: PrepareStmt
STMT: SelectStmt
== 006
-- should succeed
DEALLOCATE q1
--
STMT: DeallocateStmt
== 007
PREPARE q1 AS SELECT 2
--
STMT: PrepareStmt
STMT: SelectStmt
== 008
EXECUTE q1
--
STMT: ExecuteStmt
== 009
PREPARE q2 AS SELECT 2 AS b
--
STMT: PrepareStmt
STMT: SelectStmt
== 010
SELECT name, statement, parameter_types, result_types FROM pg_prepared_statements
--
TABLE: name="pg_prepared_statements" schema="" table="pg_prepared_statements" ctx=Select
STMT: SelectStmt
== 011
-- sql92 syntax
DEALLOCATE PREPARE q1
--
STMT: DeallocateStmt
== 012
SELECT name, statement, parameter_types, result_types FROM pg_prepared_statements
--
TABLE: name="pg_prepared_statements" schema="" table="pg_prepared_statements" ctx=Select
STMT: SelectStmt
== 013
DEALLOCATE PREPARE q2
--
STMT: DeallocateStmt
== 014
-- the view should return the empty set again
SELECT name, statement, parameter_types, result_types FROM pg_prepared_statements
--
TABLE: name="pg_prepared_statements" schema="" table="pg_prepared_statements" ctx=Select
STMT: SelectStmt
== 015
-- parameterized queries
PREPARE q2(text) AS
	SELECT datname, datistemplate, datallowconn
	FROM pg_database WHERE datname = $1
--
TABLE: name="pg_database" schema="" table="pg_database" ctx=Select
FILTER: schema="" table="" column="datname"
STMT: PrepareStmt
STMT: SelectStmt
== 016
EXECUTE q2('postgres')
--
STMT: ExecuteStmt
== 017
PREPARE q3(text, int, float, boolean, smallint) AS
	SELECT * FROM tenk1 WHERE string4 = $1 AND (four = $2 OR
	ten = $3::bigint OR true = $4 OR odd = $5::int)
	ORDER BY unique1
--
TABLE: name="tenk1" schema="" table="tenk1" ctx=Select
FILTER: schema="" table="" column="string4"
FILTER: schema="" table="" column="four"
FILTER: schema="" table="" column="ten"
FILTER: schema="" table="" column="odd"
STMT: PrepareStmt
STMT: SelectStmt
== 018
EXECUTE q3('AAAAxx', 5::smallint, 10.5::float, false, 4::bigint)
--
STMT: ExecuteStmt
== 019
-- too few params
EXECUTE q3('bool')
--
STMT: ExecuteStmt
== 020
-- too many params
EXECUTE q3('bytea', 5::smallint, 10.5::float, false, 4::bigint, true)
--
STMT: ExecuteStmt
== 021
-- wrong param types
EXECUTE q3(5::smallint, 10.5::float, false, 4::bigint, 'bytea')
--
STMT: ExecuteStmt
== 022
-- invalid type
PREPARE q4(nonexistenttype) AS SELECT $1
--
STMT: PrepareStmt
STMT: SelectStmt
== 023
-- create table as execute
PREPARE q5(int, text) AS
	SELECT * FROM tenk1 WHERE unique1 = $1 OR stringu1 = $2
	ORDER BY unique1
--
TABLE: name="tenk1" schema="" table="tenk1" ctx=Select
FILTER: schema="" table="" column="unique1"
FILTER: schema="" table="" column="stringu1"
STMT: PrepareStmt
STMT: SelectStmt
== 024
CREATE TEMPORARY TABLE q5_prep_results AS EXECUTE q5(200, 'DTAAAA')
--
TABLE: name="q5_prep_results" schema="" table="q5_prep_results" ctx=DDL
STMT: CreateTableAsStmt
STMT: ExecuteStmt
== 025
SELECT * FROM q5_prep_results
--
TABLE: name="q5_prep_results" schema="" table="q5_prep_results" ctx=Select
STMT: SelectStmt
== 026
CREATE TEMPORARY TABLE q5_prep_nodata AS EXECUTE q5(200, 'DTAAAA')
    WITH NO DATA
--
TABLE: name="q5_prep_nodata" schema="" table="q5_prep_nodata" ctx=DDL
STMT: CreateTableAsStmt
STMT: ExecuteStmt
== 027
SELECT * FROM q5_prep_nodata
--
TABLE: name="q5_prep_nodata" schema="" table="q5_prep_nodata" ctx=Select
STMT: SelectStmt
== 028
-- unknown or unspecified parameter types: should succeed
PREPARE q6 AS
    SELECT * FROM tenk1 WHERE unique1 = $1 AND stringu1 = $2
--
TABLE: name="tenk1" schema="" table="tenk1" ctx=Select
FILTER: schema="" table="" column="unique1"
FILTER: schema="" table="" column="stringu1"
STMT: PrepareStmt
STMT: SelectStmt
== 029
PREPARE q7(unknown) AS
    SELECT * FROM road WHERE thepath = $1
--
TABLE: name="road" schema="" table="road" ctx=Select
FILTER: schema="" table="" column="thepath"
STMT: PrepareStmt
STMT: SelectStmt
== 030
