-- privileges tests

CREATE USER regress_seq_user
--
STMT: CreateRoleStmt
== 168
-- nextval
BEGIN
--
STMT: TransactionStmt
== 169
SET LOCAL SESSION AUTHORIZATION regress_seq_user
--
STMT: VariableSetStmt
== 170
CREATE SEQUENCE seq3
--
STMT: CreateSeqStmt
== 171
REVOKE ALL ON seq3 FROM regress_seq_user
--
TABLE: name="seq3" schema="" table="seq3" ctx=DDL
STMT: GrantStmt
== 172
GRANT SELECT ON seq3 TO regress_seq_user
--
TABLE: name="seq3" schema="" table="seq3" ctx=DDL
STMT: GrantStmt
== 173
SELECT nextval('seq3')
--
FUNCTION: name="nextval" function="nextval" schema="" ctx=Call
STMT: SelectStmt
== 174
ROLLBACK
--
STMT: TransactionStmt
