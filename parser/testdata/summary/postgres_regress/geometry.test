STMT: SelectStmt
== 016
-- Divide by point
SELECT p1.f1, p2.f1, p1.f1 / p2.f1 FROM POINT_TBL p1, POINT_TBL p2 WHERE p2.f1[0] BETWEEN 1 AND 1000
--
TABLE: name="point_tbl" schema="" table="point_tbl" ctx=Select
