== 019
-- Distance to line
SELECT p.f1, l.s, p.f1 <-> l.s AS dist_pl, l.s <-> p.f1 AS dist_lp FROM POINT_TBL p, LINE_TBL l
--
TABLE: name="point_tbl" schema="" table="point_tbl" ctx=Select
TABLE: name="line_tbl" schema="" table="line_tbl" ctx=Select
ALIAS: "l"="line_tbl"
ALIAS: "p"="point_tbl"
STMT: SelectStmt
== 020
-- Distance to line segment
SELECT p.f1, l.s, p.f1 <-> l.s AS dist_ps, l.s <-> p.f1 AS dist_sp FROM POINT_TBL p, LSEG_TBL l
--
TABLE: name="point_tbl" schema="" table="point_tbl" ctx=Select
TABLE: name="lseg_tbl" schema="" table="lseg_tbl" ctx=Select
ALIAS: "l"="lseg_tbl"
ALIAS: "p"="point_tbl"
STMT: SelectStmt
== 021
