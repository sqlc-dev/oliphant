== 018
-- Division by 0 error
SELECT p1.f1, p2.f1, p1.f1 / p2.f1 FROM POINT_TBL p1, POINT_TBL p2 WHERE p2.f1 ~= '(0,0)'::point
--
TABLE: name="point_tbl" schema="" table="point_tbl" ctx=Select
