|--
-- semijoin selectivity for <>
|--
explain (costs off)
select * from int4_tbl i4, tenk1 a
where exists(select * from tenk1 b
             where a.twothousand = b.twothousand and a.fivethous <> b.fivethous)
      and i4.f1 = a.tenthous
--
TABLE: name="int4_tbl" schema="" table="int4_tbl" ctx=Select
TABLE: name="tenk1" schema="" table="tenk1" ctx=Select
TABLE: name="tenk1" schema="" table="tenk1" ctx=Select
ALIAS: "a"="tenk1"
ALIAS: "b"="tenk1"
ALIAS: "i4"="int4_tbl"
FILTER: schema="" table="a" column="twothousand"
FILTER: schema="" table="b" column="twothousand"
FILTER: schema="" table="a" column="fivethous"
FILTER: schema="" table="b" column="fivethous"
