== 068
-- Daylight saving time for timestamps beyond 32-bit time_t range.
SELECT '20500710 173201 Europe/Helsinki'::timestamptz
--
STMT: SelectStmt
== 069
-- DST
SELECT '20500110 173201 Europe/Helsinki'::timestamptz
--
STMT: SelectStmt
== 070
-- non-DST

SELECT '205000-07-10 17:32:01 Europe/Helsinki'::timestamptz
--
STMT: SelectStmt
== 071
-- DST
SELECT '205000-01-10 17:32:01 Europe/Helsinki'::timestamptz
--
STMT: SelectStmt
== 072
-- non-DST

-- Recognize "LMT" as whatever it means in the current zone
SELECT 'Jan 01 00:00:00 1000 LMT'::timestamptz
--
STMT: SelectStmt
== 073
SELECT 'Jan 01 00:00:00 2024 LMT'::timestamptz
--
STMT: SelectStmt
== 074
SET timezone = 'Europe/London'
--
STMT: VariableSetStmt
== 075
SELECT 'Jan 01 00:00:00 1000 LMT'::timestamptz
--
STMT: SelectStmt
== 076
SELECT 'Jan 01 00:00:00 2024 LMT'::timestamptz
--
STMT: SelectStmt
== 077
-- which might be nothing
SET timezone = 'UTC'
--
STMT: VariableSetStmt
== 078
SELECT 'Jan 01 00:00:00 2024 LMT'::timestamptz
--
STMT: SelectStmt
== 079
-- fail
-- Another example of an abbrev that varies across zones
SELECT '1912-01-01 00:00 MMT'::timestamptz
--
STMT: SelectStmt
== 080
-- from timezone_abbreviations
SET timezone = 'America/Montevideo'
--
STMT: VariableSetStmt
== 081
SELECT '1912-01-01 00:00'::timestamptz
--
STMT: SelectStmt
== 082
SELECT '1912-01-01 00:00 MMT'::timestamptz
--
STMT: SelectStmt
== 083
SELECT '1912-01-01 00:00 MMT'::timestamptz AT TIME ZONE 'UTC'
--
FUNCTION: name="pg_catalog.timezone" function="timezone" schema="pg_catalog" ctx=Call
STMT: SelectStmt
