--
STMT: FetchStmt
== 089
FETCH BACKWARD 1 FROM foo24
--
STMT: FetchStmt
== 090
-- should fail

END
--
STMT: TransactionStmt
== 091
BEGIN
--
STMT: TransactionStmt
== 092
