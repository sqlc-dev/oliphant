-- Check insensitive cursor with INSERT
-- (The above tests don't test the SQL notion of an insensitive cursor
-- correctly, because per SQL standard, changes from WHERE CURRENT OF
-- commands should be visible in the cursor.  So here we make the
-- changes with a command that is independent of the cursor.)
BEGIN
--
STMT: TransactionStmt
== 216
DECLARE c1 INSENSITIVE CURSOR FOR SELECT * FROM uctest
--
STMT: DeclareCursorStmt
== 217
INSERT INTO uctest VALUES (10, 'ten')
--
TABLE: name="uctest" schema="" table="uctest" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 218
FETCH NEXT FROM c1
--
STMT: FetchStmt
== 219
FETCH NEXT FROM c1
--
STMT: FetchStmt
== 220
FETCH NEXT FROM c1
--
STMT: FetchStmt
== 221
-- insert not visible
COMMIT
--
STMT: TransactionStmt
== 222
SELECT * FROM uctest
--
TABLE: name="uctest" schema="" table="uctest" ctx=Select
STMT: SelectStmt
== 223
DELETE FROM uctest WHERE f1 = 10
--
TABLE: name="uctest" schema="" table="uctest" ctx=DML
STMT: DeleteStmt
== 224
-- restore test table state

-- Check inheritance cases
CREATE TEMP TABLE ucchild () inherits (uctest)
--
TABLE: name="ucchild" schema="" table="ucchild" ctx=DDL
STMT: CreateStmt
== 225
INSERT INTO ucchild values(100, 'hundred')
--
TABLE: name="ucchild" schema="" table="ucchild" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
