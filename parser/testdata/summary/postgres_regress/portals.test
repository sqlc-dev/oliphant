--
STMT: DeclareCursorStmt
== 133
insert into tt1 values(2)
--
TABLE: name="tt1" schema="" table="tt1" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 134
fetch all from c1
--
STMT: FetchStmt
== 135
rollback
