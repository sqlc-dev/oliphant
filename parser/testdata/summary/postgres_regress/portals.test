CREATE TEMP TABLE uctest(f1 int, f2 text)
--
TABLE: name="uctest" schema="" table="uctest" ctx=DDL
STMT: CreateStmt
== 163
INSERT INTO uctest VALUES (1, 'one'), (2, 'two'), (3, 'three')
--
TABLE: name="uctest" schema="" table="uctest" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 164
SELECT * FROM uctest
--
TABLE: name="uctest" schema="" table="uctest" ctx=Select
STMT: SelectStmt
== 165
-- Check DELETE WHERE CURRENT
BEGIN
--
STMT: TransactionStmt
== 166
DECLARE c1 CURSOR FOR SELECT * FROM uctest
--
STMT: DeclareCursorStmt
== 167
FETCH 2 FROM c1
--
STMT: FetchStmt
== 168
DELETE FROM uctest WHERE CURRENT OF c1
--
TABLE: name="uctest" schema="" table="uctest" ctx=DML
STMT: DeleteStmt
== 169
-- should show deletion
SELECT * FROM uctest
--
TABLE: name="uctest" schema="" table="uctest" ctx=Select
STMT: SelectStmt
== 170
-- cursor did not move
FETCH ALL FROM c1
--
STMT: FetchStmt
== 171
-- cursor is insensitive
MOVE BACKWARD ALL IN c1
--
STMT: FetchStmt
== 172
FETCH ALL FROM c1
--
STMT: FetchStmt
== 173
COMMIT
--
STMT: TransactionStmt
== 174
-- should still see deletion
SELECT * FROM uctest
--
TABLE: name="uctest" schema="" table="uctest" ctx=Select
STMT: SelectStmt
== 175
