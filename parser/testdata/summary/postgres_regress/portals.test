SELECT name FROM pg_cursors ORDER BY 1
--
TABLE: name="pg_cursors" schema="" table="pg_cursors" ctx=Select
STMT: SelectStmt
== 153
CLOSE ALL
--
STMT: ClosePortalStmt
== 154
SELECT name FROM pg_cursors ORDER BY 1
--
TABLE: name="pg_cursors" schema="" table="pg_cursors" ctx=Select
STMT: SelectStmt
== 155
