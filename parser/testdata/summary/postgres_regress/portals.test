--
STMT: FetchStmt
== 094
FETCH ABSOLUTE 2 FROM foo24
--
STMT: FetchStmt
== 095
-- allowed

FETCH ABSOLUTE 1 FROM foo24
--
STMT: FetchStmt
== 096
-- should fail

END
