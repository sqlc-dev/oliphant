== 020
-- the really degenerate case: need not scan table at all
SELECT 1 AS one FROM test_having HAVING 1 > 2
--
TABLE: name="test_having" schema="" table="test_having" ctx=Select
STMT: SelectStmt
== 021
SELECT 1 AS one FROM test_having HAVING 1 < 2
