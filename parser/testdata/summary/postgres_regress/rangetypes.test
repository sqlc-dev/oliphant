== 001
-- Tests for range data types.

|--
-- test input parser
-- (type textrange was already made in test_setup.sql)
|--

-- negative tests; should fail
select ''::textrange
--
STMT: SelectStmt
== 002
select '-[a,z)'::textrange
--
STMT: SelectStmt
== 003
select '[a,z) - '::textrange
--
STMT: SelectStmt
== 004
select '(",a)'::textrange
--
STMT: SelectStmt
== 005
