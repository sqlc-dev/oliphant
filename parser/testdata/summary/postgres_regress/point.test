-- Test that GiST indexes provide same behavior as sequential scan
CREATE TEMP TABLE point_gist_tbl(f1 point)
--
TABLE: name="point_gist_tbl" schema="" table="point_gist_tbl" ctx=DDL
STMT: CreateStmt
== 024
INSERT INTO point_gist_tbl SELECT '(0,0)' FROM generate_series(0,1000)
--
TABLE: name="point_gist_tbl" schema="" table="point_gist_tbl" ctx=DML
FUNCTION: name="generate_series" function="generate_series" schema="" ctx=Call
STMT: InsertStmt
STMT: SelectStmt
== 025
CREATE INDEX point_gist_tbl_index ON point_gist_tbl USING gist (f1)
