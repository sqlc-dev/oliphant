STMT: SelectStmt
== 293
create function test_ret_set_scalar(int,int) returns setof int as '
DECLARE
	i int;
BEGIN
	FOR i IN $1 .. $2 LOOP
		RETURN NEXT i + 1;
	END LOOP;
	RETURN;
END;' language plpgsql
--
FUNCTION: name="test_ret_set_scalar" function="test_ret_set_scalar" schema="" ctx=DDL
