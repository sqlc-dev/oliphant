  open c scroll for select f1 from int4_tbl;
  fetch last from c into x;
  while found loop
    return next x;
    fetch prior from c into x;
  end loop;
  close c;
end;
$$ language plpgsql
--
FUNCTION: name="sc_test" function="sc_test" schema="" ctx=DDL
