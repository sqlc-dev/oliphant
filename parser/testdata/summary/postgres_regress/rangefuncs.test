--
FUNCTION: name="array_to_set" function="array_to_set" schema="" ctx=Call
STMT: SelectStmt
== 311
select * from array_to_set(array['one', 'two'])
--
FUNCTION: name="array_to_set" function="array_to_set" schema="" ctx=Call
STMT: SelectStmt
== 312
