CREATE TEMP TABLE pcachetest AS SELECT * FROM int8_tbl ORDER BY 2
--
TABLE: name="pcachetest" schema="" table="pcachetest" ctx=DDL
TABLE: name="int8_tbl" schema="" table="int8_tbl" ctx=Select
STMT: CreateTableAsStmt
STMT: SelectStmt
== 010
EXECUTE prepstmt
--
STMT: ExecuteStmt
== 011
EXECUTE prepstmt2(123)
--
STMT: ExecuteStmt
== 012
-- prepared statements should prevent change in output tupdesc,
