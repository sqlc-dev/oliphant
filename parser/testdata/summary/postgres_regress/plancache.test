STMT: SelectStmt
== 037
insert into s2.abc values(456)
--
TABLE: name="s2.abc" schema="s2" table="abc" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 038
set search_path = s1
--
STMT: VariableSetStmt
== 039
prepare p1 as select f1 from abc
