-- Check basic SPI plan invalidation

create function cache_test(int) returns int as $$
declare total int;
begin
	create temp table t1(f1 int);
	insert into t1 values($1);
	insert into t1 values(11);
	insert into t1 values(12);
	insert into t1 values(13);
	select sum(f1) into total from t1;
	drop table t1;
	return total;
end
$$ language plpgsql
--
FUNCTION: name="cache_test" function="cache_test" schema="" ctx=DDL
STMT: CreateFunctionStmt
== 024
select cache_test(1)
--
FUNCTION: name="cache_test" function="cache_test" schema="" ctx=Call
STMT: SelectStmt
== 025
select cache_test(2)
--
FUNCTION: name="cache_test" function="cache_test" schema="" ctx=Call
STMT: SelectStmt
== 026
select cache_test(3)
--
FUNCTION: name="cache_test" function="cache_test" schema="" ctx=Call
STMT: SelectStmt
== 027
