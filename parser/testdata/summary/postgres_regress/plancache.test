ALTER TABLE pcachetest ADD COLUMN q3 bigint
--
TABLE: name="pcachetest" schema="" table="pcachetest" ctx=DDL
STMT: AlterTableStmt
== 013
EXECUTE prepstmt
--
STMT: ExecuteStmt
== 014
EXECUTE prepstmt2(123)
--
STMT: ExecuteStmt
== 015
-- but we're nice guys and will let you undo your mistake
ALTER TABLE pcachetest DROP COLUMN q3
--
TABLE: name="pcachetest" schema="" table="pcachetest" ctx=DDL
STMT: AlterTableStmt
== 016
EXECUTE prepstmt
--
STMT: ExecuteStmt
== 017
EXECUTE prepstmt2(123)
