TABLE: name="abc" schema="" table="abc" ctx=Select
STMT: PrepareStmt
STMT: SelectStmt
== 040
execute p1
--
STMT: ExecuteStmt
== 041
set search_path = s2
--
STMT: VariableSetStmt
== 042
select f1 from abc
