--- Check that change of search_path is honored when re-using cached plan

create schema s1
  create table abc (f1 int)
--
STMT: CreateSchemaStmt
== 035
create schema s2
  create table abc (f1 int)
--
STMT: CreateSchemaStmt
== 036
insert into s1.abc values(123)
