ALIAS: "t1"="tenk1"
ALIAS: "t2"="tenk1"
FILTER: schema="" table="" column="unique1"
FILTER: schema="" table="t0" column="ten"
FILTER: schema="" table="t1" column="twenty"
FILTER: schema="" table="t0" column="two"
FILTER: schema="" table="t2" column="four"
STMT: ExplainStmt
STMT: SelectStmt
