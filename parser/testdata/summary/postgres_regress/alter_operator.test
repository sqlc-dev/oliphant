DROP OPERATOR === (boolean, boolean)
--
STMT: DropStmt
== 057
DROP OPERATOR === (boolean, real)
--
STMT: DropStmt
== 058
DROP OPERATOR ==== (real, boolean)
--
STMT: DropStmt
== 059
DROP OPERATOR !==== (boolean, real)
--
STMT: DropStmt
== 060
