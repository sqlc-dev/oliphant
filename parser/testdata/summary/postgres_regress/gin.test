--
FUNCTION: name="gin_clean_pending_list" function="gin_clean_pending_list" schema="" ctx=Call
STMT: SelectStmt
== 009
-- nothing to flush

-- Test vacuuming
delete from gin_test_tbl where i @> array[2]
--
TABLE: name="gin_test_tbl" schema="" table="gin_test_tbl" ctx=DML
STMT: DeleteStmt
== 010
vacuum gin_test_tbl
--
TABLE: name="gin_test_tbl" schema="" table="gin_test_tbl" ctx=DDL
STMT: VacuumStmt
== 011
-- Disable fastupdate, and do more insertions. With fastupdate enabled, most
-- insertions (by flushing the list pages) cause page splits. Without
-- fastupdate, we get more churn in the GIN data leaf pages, and exercise the
-- recompression codepaths.
alter index gin_test_idx set (fastupdate = off)
--
STMT: AlterTableStmt
== 012
insert into gin_test_tbl select array[1, 2, g] from generate_series(1, 1000) g
