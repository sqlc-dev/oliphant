FUNCTION: name="circle" function="circle" schema="" ctx=Call
FUNCTION: name="point" function="point" schema="" ctx=Call
FUNCTION: name="generate_series" function="generate_series" schema="" ctx=Call
STMT: InsertStmt
STMT: SelectStmt
== 019
