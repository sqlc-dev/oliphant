|--
-- test PRIMARY KEY and UNIQUE constraints' interaction with domains
|--

-- range over domain:
CREATE DOMAIN int4_d as integer check (value <> 10)
--
STMT: CreateDomainStmt
== 052
CREATE TYPE int4_d_range as range (subtype = int4_d)
--
STMT: CreateRangeStmt
== 053
CREATE TABLE temporal_rng4 (
  id int4range,
  valid_at int4_d_range,
  CONSTRAINT temporal_rng4_pk PRIMARY KEY(id, valid_at WITHOUT OVERLAPS)
)
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DDL
STMT: CreateStmt
== 054
INSERT INTO temporal_rng4 VALUES ('[1,11)', '[9,10)')
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 055
-- start bound violates domain
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[10,11)')
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 056
-- end bound violates domain
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[1,13)'), ('[1,2)', '[2,5)')
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 057
-- overlaps
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[1,13)'), ('[1,2)', '[20,23)')
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 058
-- okay
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[30,)')
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 059
-- null bound is okay
DROP TABLE temporal_rng4
--
TABLE: name="temporal_rng4" schema="" table="temporal_rng4" ctx=DDL
STMT: DropStmt
== 060
