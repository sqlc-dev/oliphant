--
STMT: SelectStmt
== 204
SAVEPOINT two
--
STMT: TransactionStmt
== 205
-- ignored till the end of ...
  RELEASE SAVEPOINT one
--
STMT: TransactionStmt
== 206
-- ignored till the end of ...
  ROLLBACK TO SAVEPOINT one
--
STMT: TransactionStmt
== 207
SELECT 1
--
STMT: SelectStmt
== 208
COMMIT
--
STMT: TransactionStmt
== 209
SELECT 1
--
STMT: SelectStmt
== 210
