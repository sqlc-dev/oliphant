--
STMT: DeclareCursorStmt
== 295
FETCH ok
--
STMT: FetchStmt
== 296
SAVEPOINT s1
--
STMT: TransactionStmt
== 297
FETCH ok
--
STMT: FetchStmt
== 298
-- should work
FETCH ctt
--
STMT: FetchStmt
== 299
-- error occurs here
ROLLBACK TO s1
--
STMT: TransactionStmt
== 300
FETCH ok
--
STMT: FetchStmt
== 301
-- should work
FETCH ctt
--
STMT: FetchStmt
== 302
-- must be rejected
COMMIT
