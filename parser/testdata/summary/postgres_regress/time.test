-- Check edge cases
SELECT '23:59:59.999999'::time
--
STMT: SelectStmt
== 019
SELECT '23:59:59.9999999'::time
--
STMT: SelectStmt
== 020
-- rounds up
SELECT '23:59:60'::time
--
STMT: SelectStmt
== 021
-- rounds up
SELECT '24:00:00'::time
--
STMT: SelectStmt
== 022
-- allowed
SELECT '24:00:00.01'::time
--
STMT: SelectStmt
== 023
-- not allowed
SELECT '23:59:60.01'::time
--
STMT: SelectStmt
== 024
-- not allowed
SELECT '24:01:00'::time
--
STMT: SelectStmt
== 025
-- not allowed
SELECT '25:00:00'::time
