SELECT relname, spcname FROM pg_catalog.pg_class c
    JOIN pg_catalog.pg_namespace n ON (c.relnamespace = n.oid)
    LEFT JOIN pg_catalog.pg_tablespace t ON c.reltablespace = t.oid
    where c.relname LIKE 'part%' AND n.nspname = 'testschema' order by relname
--
TABLE: name="pg_catalog.pg_class" schema="pg_catalog" table="pg_class" ctx=Select
TABLE: name="pg_catalog.pg_namespace" schema="pg_catalog" table="pg_namespace" ctx=Select
TABLE: name="pg_catalog.pg_tablespace" schema="pg_catalog" table="pg_tablespace" ctx=Select
