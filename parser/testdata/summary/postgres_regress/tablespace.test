-- Track the original tablespace, relfilenode and OID of each index
-- in the tree.
CREATE TEMP TABLE reindex_temp_before AS
  SELECT oid, relname, relfilenode, reltablespace
  FROM pg_class
    WHERE relname ~ 'tbspace_reindex_part_index'
--
TABLE: name="reindex_temp_before" schema="" table="reindex_temp_before" ctx=DDL
TABLE: name="pg_class" schema="" table="pg_class" ctx=Select
FILTER: schema="" table="" column="relname"
STMT: CreateTableAsStmt
STMT: SelectStmt
== 063
