== 001
|--
-- PREPARED TRANSACTIONS (two-phase commit)
|--
-- We can't readily test persistence of prepared xacts within the
-- regression script framework, unfortunately.  Note that a crash
-- isn't really needed ... stopping and starting the postmaster would
-- be enough, but we can't even do that here.


-- create a simple table that we'll use in the tests
CREATE TABLE pxtest1 (foobar VARCHAR(10))
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DDL
STMT: CreateStmt
== 002
INSERT INTO pxtest1 VALUES ('aaa')
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 003
-- Test PREPARE TRANSACTION
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 004
UPDATE pxtest1 SET foobar = 'bbb' WHERE foobar = 'aaa'
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: UpdateStmt
== 005
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 006
PREPARE TRANSACTION 'regress_foo1'
--
STMT: TransactionStmt
== 007
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 008
-- Test pg_prepared_xacts system view
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 009
-- Test ROLLBACK PREPARED
ROLLBACK PREPARED 'regress_foo1'
--
STMT: TransactionStmt
== 010
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 011
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 012
-- Test COMMIT PREPARED
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 013
INSERT INTO pxtest1 VALUES ('ddd')
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 014
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 015
PREPARE TRANSACTION 'regress_foo2'
--
STMT: TransactionStmt
== 016
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 017
COMMIT PREPARED 'regress_foo2'
--
STMT: TransactionStmt
== 018
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 019
-- Test duplicate gids
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 020
UPDATE pxtest1 SET foobar = 'eee' WHERE foobar = 'ddd'
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: UpdateStmt
== 021
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 022
PREPARE TRANSACTION 'regress_foo3'
--
STMT: TransactionStmt
== 023
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 024
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 025
INSERT INTO pxtest1 VALUES ('fff')
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 026
-- This should fail, because the gid foo3 is already in use
PREPARE TRANSACTION 'regress_foo3'
--
STMT: TransactionStmt
== 027
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 028
ROLLBACK PREPARED 'regress_foo3'
--
STMT: TransactionStmt
== 029
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 030
-- Test serialization failure (SSI)
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 031
UPDATE pxtest1 SET foobar = 'eee' WHERE foobar = 'ddd'
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: UpdateStmt
== 032
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 033
PREPARE TRANSACTION 'regress_foo4'
--
STMT: TransactionStmt
== 034
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 035
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 036
SELECT * FROM pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=Select
STMT: SelectStmt
== 037
-- This should fail, because the two transactions have a write-skew anomaly
INSERT INTO pxtest1 VALUES ('fff')
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 038
PREPARE TRANSACTION 'regress_foo5'
--
STMT: TransactionStmt
== 039
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 040
ROLLBACK PREPARED 'regress_foo4'
--
STMT: TransactionStmt
== 041
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 042
-- Clean up
DROP TABLE pxtest1
--
TABLE: name="pxtest1" schema="" table="pxtest1" ctx=DDL
STMT: DropStmt
== 043
-- Test detection of session-level and xact-level locks on same object
BEGIN
--
STMT: TransactionStmt
== 044
SELECT pg_advisory_lock(1)
--
FUNCTION: name="pg_advisory_lock" function="pg_advisory_lock" schema="" ctx=Call
STMT: SelectStmt
== 045
SELECT pg_advisory_xact_lock_shared(1)
--
FUNCTION: name="pg_advisory_xact_lock_shared" function="pg_advisory_xact_lock_shared" schema="" ctx=Call
STMT: SelectStmt
== 046
PREPARE TRANSACTION 'regress_foo6'
--
STMT: TransactionStmt
== 047
-- fails

-- Test subtransactions
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 048
CREATE TABLE pxtest2 (a int)
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=DDL
STMT: CreateStmt
== 049
INSERT INTO pxtest2 VALUES (1)
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 050
SAVEPOINT a
--
STMT: TransactionStmt
== 051
INSERT INTO pxtest2 VALUES (2)
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 052
ROLLBACK TO a
--
STMT: TransactionStmt
== 053
SAVEPOINT b
--
STMT: TransactionStmt
== 054
INSERT INTO pxtest2 VALUES (3)
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 055
PREPARE TRANSACTION 'regress_sub1'
--
STMT: TransactionStmt
== 056
CREATE TABLE pxtest3(fff int)
--
TABLE: name="pxtest3" schema="" table="pxtest3" ctx=DDL
STMT: CreateStmt
== 057
-- Test shared invalidation
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
STMT: TransactionStmt
== 058
DROP TABLE pxtest3
--
TABLE: name="pxtest3" schema="" table="pxtest3" ctx=DDL
STMT: DropStmt
== 059
CREATE TABLE pxtest4 (a int)
--
TABLE: name="pxtest4" schema="" table="pxtest4" ctx=DDL
STMT: CreateStmt
== 060
INSERT INTO pxtest4 VALUES (1)
--
TABLE: name="pxtest4" schema="" table="pxtest4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 061
INSERT INTO pxtest4 VALUES (2)
--
TABLE: name="pxtest4" schema="" table="pxtest4" ctx=DML
STMT: InsertStmt
STMT: SelectStmt
== 062
DECLARE foo CURSOR FOR SELECT * FROM pxtest4
--
STMT: DeclareCursorStmt
== 063
-- Fetch 1 tuple, keeping the cursor open
  FETCH 1 FROM foo
--
STMT: FetchStmt
== 064
PREPARE TRANSACTION 'regress_sub2'
--
STMT: TransactionStmt
== 065
-- No such cursor
FETCH 1 FROM foo
--
STMT: FetchStmt
== 066
-- Table doesn't exist, the creation hasn't been committed yet
SELECT * FROM pxtest2
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=Select
STMT: SelectStmt
== 067
-- There should be two prepared transactions
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 068
-- pxtest3 should be locked because of the pending DROP
begin
--
STMT: TransactionStmt
== 069
lock table pxtest3 in access share mode nowait
--
TABLE: name="pxtest3" schema="" table="pxtest3" ctx=DDL
STMT: LockStmt
== 070
rollback
--
STMT: TransactionStmt
== 071
-- Disconnect, we will continue testing in a different backend

-- There should still be two prepared transactions
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 072
-- pxtest3 should still be locked because of the pending DROP
begin
--
STMT: TransactionStmt
== 073
lock table pxtest3 in access share mode nowait
--
TABLE: name="pxtest3" schema="" table="pxtest3" ctx=DDL
STMT: LockStmt
== 074
rollback
--
STMT: TransactionStmt
== 075
-- Commit table creation
COMMIT PREPARED 'regress_sub1'
--
STMT: TransactionStmt
== 076
SELECT * FROM pxtest2
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=Select
STMT: SelectStmt
== 077
-- There should be one prepared transaction
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 078
-- Commit table drop
COMMIT PREPARED 'regress_sub2'
--
STMT: TransactionStmt
== 079
SELECT * FROM pxtest3
--
TABLE: name="pxtest3" schema="" table="pxtest3" ctx=Select
STMT: SelectStmt
== 080
-- There should be no prepared transactions
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
TABLE: name="pg_prepared_xacts" schema="" table="pg_prepared_xacts" ctx=Select
FILTER: schema="" table="" column="gid"
STMT: SelectStmt
== 081
-- Clean up
DROP TABLE pxtest2
--
TABLE: name="pxtest2" schema="" table="pxtest2" ctx=DDL
STMT: DropStmt
== 082
DROP TABLE pxtest3
--
TABLE: name="pxtest3" schema="" table="pxtest3" ctx=DDL
STMT: DropStmt
== 083
-- will still be there if prepared xacts are disabled
DROP TABLE pxtest4
--
TABLE: name="pxtest4" schema="" table="pxtest4" ctx=DDL
STMT: DropStmt
