create index cluster_sort on clstr_4 (hundred, thousand, tenthous)
--
TABLE: name="clstr_4" schema="" table="clstr_4" ctx=DDL
STMT: IndexStmt
== 163
-- ensure we don't use the index in CLUSTER nor the checking SELECTs
