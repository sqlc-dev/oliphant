== 001
/*
 * This test is for ICU collations.
 */

/* skip test if not UTF8 server encoding or no ICU collations installed */
SELECT getdatabaseencoding() <> 'UTF8' OR
       (SELECT count(*) FROM pg_collation WHERE collprovider = 'i' AND collname <> 'unicode') = 0
       AS skip_test
--
TABLE: name="pg_collation" schema="" table="pg_collation" ctx=Select
FUNCTION: name="getdatabaseencoding" function="getdatabaseencoding" schema="" ctx=Call
FUNCTION: name="count" function="count" schema="" ctx=Call
FILTER: schema="" table="" column="collprovider"
FILTER: schema="" table="" column="collname"
STMT: SelectStmt
== 002
