-- collation override in plpgsql

CREATE FUNCTION mylt2 (x text, y text) RETURNS boolean LANGUAGE plpgsql AS $$
declare
  xx text := x;
  yy text := y;
begin
  return xx < yy;
end
$$
--
FUNCTION: name="mylt2" function="mylt2" schema="" ctx=DDL
STMT: CreateFunctionStmt
