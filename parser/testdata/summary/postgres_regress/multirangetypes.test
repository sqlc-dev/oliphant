== 001
-- Tests for multirange data types.

|--
-- test input parser
|--

-- negative tests; should fail
select ''::textmultirange
--
STMT: SelectStmt
== 002
select '{,}'::textmultirange
--
STMT: SelectStmt
== 003
select '{(,)}.'::textmultirange
--
STMT: SelectStmt
== 004
select '{[a,c),}'::textmultirange
--
STMT: SelectStmt
== 005
select '{,[a,c)}'::textmultirange
--
STMT: SelectStmt
== 006
