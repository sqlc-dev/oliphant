STMT: DoStmt
== 026
-- Check that variables are reinitialized on block re-entry.

do $$
begin
  for i in 1..3 loop
    declare
      x int;
      y int := i;
      r record;
      c var_record;
    begin
      if i = 1 then
        x := 42;
        r := row(i, i+1);
        c := row(i, i+1);
      end if;
      raise notice 'x = %', x;
      raise notice 'y = %', y;
      raise notice 'r = %', r;
      raise notice 'c = %', c;
    end;
  end loop;
end$$
--
STMT: DoStmt
== 027
-- Check enforcement of domain constraints during initialization

do $$
declare x int_nn;  -- fail
begin
  raise notice 'x = %', x;
end$$
