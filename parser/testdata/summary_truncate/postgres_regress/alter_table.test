STMT: CreateStmt
TRUNCATED: "CREATE TABLE attach_parted_part1 PARTITION OF attach_parted FOR VALUES IN (1)"
== 1661
-- truncate_limit: 100
-- insert a row directly into the leaf partition so that its partition
