FILTER: schema="" table="" column="relkind"
FILTER: schema="" table="" column="relpersistence"
FILTER: schema="" table="" column="mapped_oid"
FILTER: schema="" table="" column="oid"
STMT: CreateTableAsStmt
STMT: SelectStmt
TRUNCATED: "CREATE TEMPORARY TABLE filenode_mapping AS SELECT oid, mapped_oid, reltablespace, relfilenode, re..."
