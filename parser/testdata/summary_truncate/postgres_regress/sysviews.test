== 009
-- truncate_limit: 100
-- Further sanity checks on pg_backend_memory_contexts.  We expect
-- CacheMemoryContext to have multiple children.  Ensure that's the case.
with contexts as (
  select * from pg_backend_memory_contexts
)
select count(*) > 1
from contexts c1, contexts c2
where c2.name = 'CacheMemoryContext'
and c1.path[c2.level] = c2.path[c2.level]
--
TABLE: name="pg_backend_memory_contexts" schema="" table="pg_backend_memory_contexts" ctx=Select
ALIAS: "c1"="contexts"
ALIAS: "c2"="contexts"
CTE: "contexts"
FUNCTION: name="count" function="count" schema="" ctx=Call
FILTER: schema="" table="c2" column="name"
FILTER: schema="" table="c1" column="path"
FILTER: schema="" table="c2" column="level"
FILTER: schema="" table="c2" column="path"
FILTER: schema="" table="c2" column="level"
STMT: SelectStmt
TRUNCATED: "WITH contexts AS (...) SELECT count(*) > 1 FROM contexts c1, contexts c2 WHERE ..."
