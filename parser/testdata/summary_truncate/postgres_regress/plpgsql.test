-- truncate_limit: 100
create function perform_simple_func(int) returns boolean as '
BEGIN
	IF $1 < 20 THEN
		INSERT INTO perform_test VALUES ($1, $1 + 10);
		RETURN TRUE;
	ELSE
		RETURN FALSE;
	END IF;
END;' language plpgsql
--
FUNCTION: name="perform_simple_func" function="perform_simple_func" schema="" ctx=DDL
