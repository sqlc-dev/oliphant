FILTER: schema="" table="k" column="castmethod"
FILTER: schema="" table="k" column="castsource"
FILTER: schema="" table="c" column="casttarget"
FILTER: schema="" table="k" column="casttarget"
FILTER: schema="" table="c" column="castsource"
