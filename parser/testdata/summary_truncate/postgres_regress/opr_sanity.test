== 120
-- truncate_limit: 100
-- Operators that are primary members of opclasses must be immutable (else
-- it suggests that the index ordering isn't fixed).  Operators that are
-- cross-type members need only be stable, since they are just shorthands
-- for index probe queries.

SELECT a1.amopfamily, a1.amopopr, o1.oprname, p1.prosrc
FROM pg_amop AS a1, pg_operator AS o1, pg_proc AS p1
WHERE a1.amopopr = o1.oid AND o1.oprcode = p1.oid AND
    a1.amoplefttype = a1.amoprighttype AND
    p1.provolatile != 'i'
--
TABLE: name="pg_amop" schema="" table="pg_amop" ctx=Select
TABLE: name="pg_operator" schema="" table="pg_operator" ctx=Select
TABLE: name="pg_proc" schema="" table="pg_proc" ctx=Select
