FILTER: schema="" table="rsl" column="sl_color"
FILTER: schema="" table="rsh" column="slcolor"
FILTER: schema="" table="rsl" column="sl_len_cm"
FILTER: schema="" table="rsh" column="slminlen_cm"
FILTER: schema="" table="rsl" column="sl_len_cm"
FILTER: schema="" table="rsh" column="slmaxlen_cm"
STMT: ViewStmt
