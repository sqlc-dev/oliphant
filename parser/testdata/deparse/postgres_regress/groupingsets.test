  from gstest2 group by rollup (a,b) order by rsum, a, b
--
SELECT a, b, sum(c), sum(sum(c)) OVER (ORDER BY a, b) AS rsum FROM gstest2 GROUP BY ROLLUP (a, b) ORDER BY rsum, a, b
