|--
-- Compare results between plans using sorting and plans using hash
-- aggregation. Force spilling in both cases by setting work_mem low
-- and altering the statistics.
|--

create table gs_data_1 as
select g%1000 as g1000, g%100 as g100, g%10 as g10, g
   from generate_series(0,1999) g
--
CREATE TABLE gs_data_1 AS SELECT g % 1000 AS g1000, g % 100 AS g100, g % 10 AS g10, g FROM generate_series(0, 1999) g
== 167
analyze gs_data_1
--
ANALYZE gs_data_1
== 168
alter table gs_data_1 set (autovacuum_enabled = 'false')
--
ALTER TABLE gs_data_1 SET (autovacuum_enabled=false)
== 169
update pg_class set reltuples = 10 where relname='gs_data_1'
--
UPDATE pg_class SET reltuples = 10 WHERE relname = 'gs_data_1'
== 170
set work_mem='64kB'
--
SET work_mem TO "64kB"
== 171
-- Produce results with sorting.

set enable_sort = true
--
SET enable_sort TO TRUE
== 172
set enable_hashagg = false
--
SET enable_hashagg TO FALSE
== 173
set jit_above_cost = 0
--
SET jit_above_cost TO 0
== 174
explain (costs off)
select g100, g10, sum(g::numeric), count(*), max(g::text)
from gs_data_1 group by cube (g1000, g100,g10)
--
EXPLAIN (COSTS OFF) SELECT g100, g10, sum(g::numeric), count(*), max(g::text) FROM gs_data_1 GROUP BY CUBE (g1000, g100, g10)
== 175
create table gs_group_1 as
select g100, g10, sum(g::numeric), count(*), max(g::text)
from gs_data_1 group by cube (g1000, g100,g10)
--
CREATE TABLE gs_group_1 AS SELECT g100, g10, sum(g::numeric), count(*), max(g::text) FROM gs_data_1 GROUP BY CUBE (g1000, g100, g10)
== 176
-- Produce results with hash aggregation.

set enable_hashagg = true
--
SET enable_hashagg TO TRUE
== 177
set enable_sort = false
--
SET enable_sort TO FALSE
== 178
explain (costs off)
select g100, g10, sum(g::numeric), count(*), max(g::text)
from gs_data_1 group by cube (g1000, g100,g10)
--
EXPLAIN (COSTS OFF) SELECT g100, g10, sum(g::numeric), count(*), max(g::text) FROM gs_data_1 GROUP BY CUBE (g1000, g100, g10)
== 179
create table gs_hash_1 as
select g100, g10, sum(g::numeric), count(*), max(g::text)
from gs_data_1 group by cube (g1000, g100,g10)
--
CREATE TABLE gs_hash_1 AS SELECT g100, g10, sum(g::numeric), count(*), max(g::text) FROM gs_data_1 GROUP BY CUBE (g1000, g100, g10)
== 180
set enable_sort = true
--
SET enable_sort TO TRUE
== 181
set work_mem to default
--
SET work_mem TO DEFAULT
== 182
set hash_mem_multiplier to default
--
SET hash_mem_multiplier TO DEFAULT
== 183
-- Compare results

(select * from gs_hash_1 except select * from gs_group_1)
  union all
(select * from gs_group_1 except select * from gs_hash_1)
--
(SELECT * FROM gs_hash_1 EXCEPT SELECT * FROM gs_group_1) UNION ALL (SELECT * FROM gs_group_1 EXCEPT SELECT * FROM gs_hash_1)
== 184
drop table gs_group_1
--
DROP TABLE gs_group_1
== 185
drop table gs_hash_1
--
DROP TABLE gs_hash_1
== 186
-- GROUP BY DISTINCT

-- "normal" behavior...
select a, b, c
from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c)
group by all rollup(a, b), rollup(a, c)
order by a, b, c
--
SELECT a, b, c FROM (VALUES (1, 2, 3), (4, NULL, 6), (7, 8, 9)) t(a, b, c) GROUP BY ROLLUP (a, b), ROLLUP (a, c) ORDER BY a, b, c
== 187
-- ...which is also the default
select a, b, c
from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c)
group by rollup(a, b), rollup(a, c)
order by a, b, c
--
SELECT a, b, c FROM (VALUES (1, 2, 3), (4, NULL, 6), (7, 8, 9)) t(a, b, c) GROUP BY ROLLUP (a, b), ROLLUP (a, c) ORDER BY a, b, c
== 188
-- "group by distinct" behavior...
select a, b, c
from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c)
group by distinct rollup(a, b), rollup(a, c)
order by a, b, c
--
SELECT a, b, c FROM (VALUES (1, 2, 3), (4, NULL, 6), (7, 8, 9)) t(a, b, c) GROUP BY DISTINCT ROLLUP (a, b), ROLLUP (a, c) ORDER BY a, b, c
== 189
-- ...which is not the same as "select distinct"
select distinct a, b, c
from (values (1, 2, 3), (4, null, 6), (7, 8, 9)) as t (a, b, c)
group by rollup(a, b), rollup(a, c)
order by a, b, c
--
SELECT DISTINCT a, b, c FROM (VALUES (1, 2, 3), (4, NULL, 6), (7, 8, 9)) t(a, b, c) GROUP BY ROLLUP (a, b), ROLLUP (a, c) ORDER BY a, b, c
== 190
