-- check qual push-down rules for a subquery with grouping sets
explain (verbose, costs off)
select * from (
  select 1 as x, q1, sum(q2)
  from int8_tbl i1
  group by grouping sets(1, 2)
) ss
where x = 1 and q1 = 123
--
EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM (SELECT 1 AS x, q1, sum(q2) FROM int8_tbl i1 GROUP BY GROUPING SETS (1, 2)) ss WHERE x = 1 AND q1 = 123
