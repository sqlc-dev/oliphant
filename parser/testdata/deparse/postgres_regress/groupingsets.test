  from gstest1 t1, gstest2 t2
 group by grouping sets ((t1.a, t2.b), ())
--
SELECT t1.a, t2.b, GROUPING(t1.a, t2.b), sum(t1.v), max(t2.a) FROM gstest1 t1, gstest2 t2 GROUP BY GROUPING SETS ((t1.a, t2.b), ())
