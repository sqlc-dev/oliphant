-- check that pulled-up subquery outputs still go to null when appropriate
select four, x
  from (select four, ten, 'foo'::text as x from tenk1) as t
  group by grouping sets (four, x)
  having x = 'foo'
--
SELECT four, x FROM (SELECT four, ten, 'foo'::text AS x FROM tenk1) t GROUP BY GROUPING SETS (four, x) HAVING x = 'foo'
