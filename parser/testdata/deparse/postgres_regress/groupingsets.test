select g as alias1, g as alias2
  from generate_series(1,3) g
 group by alias1, rollup(alias2)
--
EXPLAIN (COSTS OFF) SELECT g AS alias1, g AS alias2 FROM generate_series(1, 3) g GROUP BY alias1, ROLLUP (alias2)
