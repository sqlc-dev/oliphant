CREATE TABLE brinopers_multi (colname name, typ text,
	op text[], value text[], matches int[],
	check (cardinality(op) = cardinality(value)),
	check (cardinality(op) = cardinality(matches)))
--
CREATE TABLE brinopers_multi (colname name, typ text, op text[], value text[], matches int[], CHECK (cardinality(op) = cardinality(value)), CHECK (cardinality(op) = cardinality(matches)))
