    partid int not null,
    shdata int not null,
    CONSTRAINT shdata_small CHECK(shdata < 3)
)
--
CREATE TABLE errtst_child_fastdef (partid int NOT NULL, shdata int NOT NULL, CONSTRAINT shdata_small CHECK (shdata < 3))
== 829
-- no remapping in either direction necessary
CREATE TABLE errtst_child_plaindef (
    partid int not null,
    shdata int not null,
    data int NOT NULL DEFAULT 0,
    CONSTRAINT shdata_small CHECK(shdata < 3),
    CHECK(data < 10)
)
--
CREATE TABLE errtst_child_plaindef (partid int NOT NULL, shdata int NOT NULL, data int NOT NULL DEFAULT 0, CONSTRAINT shdata_small CHECK (shdata < 3), CHECK (data < 10))
== 830
-- remapping in both direction
CREATE TABLE errtst_child_reorder (
    data int NOT NULL DEFAULT 0,
    shdata int not null,
    partid int not null,
    CONSTRAINT shdata_small CHECK(shdata < 3),
    CHECK(data < 10)
)
--
