CREATE FUNCTION int8alias1eq(int8alias1, int8alias1) RETURNS bool RETURNS NULL ON NULL INPUT IMMUTABLE LANGUAGE internal AS $$int8eq$$
== 014
create operator = (
    procedure = int8alias1eq,
    leftarg = int8alias1, rightarg = int8alias1,
    commutator = =,
    restrict = eqsel, join = eqjoinsel,
    merges
)
--
CREATE OPERATOR = (procedure = int8alias1eq, leftarg = int8alias1, rightarg = int8alias1, commutator = =, restrict = eqsel, "join" = eqjoinsel, merges)
