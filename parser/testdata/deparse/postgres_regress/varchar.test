-- zero-length char
INSERT INTO VARCHAR_TBL (f1) VALUES ('')
--
INSERT INTO varchar_tbl (f1) VALUES ('')
== 008
-- try varchar's of greater than 1 length
INSERT INTO VARCHAR_TBL (f1) VALUES ('cd')
--
INSERT INTO varchar_tbl (f1) VALUES ('cd')
== 009
INSERT INTO VARCHAR_TBL (f1) VALUES ('c     ')
--
INSERT INTO varchar_tbl (f1) VALUES ('c     ')
== 010
SELECT * FROM VARCHAR_TBL
--
SELECT * FROM varchar_tbl
== 011
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 <> 'a'
--
SELECT c.* FROM varchar_tbl c WHERE c.f1 <> 'a'
== 012
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 = 'a'
--
SELECT c.* FROM varchar_tbl c WHERE c.f1 = 'a'
== 013
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 < 'a'
--
SELECT c.* FROM varchar_tbl c WHERE c.f1 < 'a'
== 014
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 <= 'a'
--
SELECT c.* FROM varchar_tbl c WHERE c.f1 <= 'a'
== 015
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 > 'a'
--
SELECT c.* FROM varchar_tbl c WHERE c.f1 > 'a'
== 016
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 >= 'a'
--
SELECT c.* FROM varchar_tbl c WHERE c.f1 >= 'a'
== 017
DROP TABLE VARCHAR_TBL
--
DROP TABLE varchar_tbl
== 018
