CREATE TABLE ctl_stats4_child (LIKE ctl_stats4_parent INCLUDING STATISTICS)
== 171
SELECT s.stxrelid::regclass AS relation,
       array_agg(a.attname ORDER BY u.ord) AS stats_columns
FROM pg_statistic_ext s
CROSS JOIN LATERAL
  unnest(s.stxkeys::int2[]) WITH ORDINALITY AS u(attnum, ord)
JOIN pg_attribute a
  ON a.attrelid = s.stxrelid AND a.attnum = u.attnum
WHERE s.stxrelid IN ('ctl_stats3_child'::regclass,
                     'ctl_stats4_child'::regclass)
GROUP BY s.stxrelid
ORDER BY s.stxrelid::regclass::text
--
SELECT s.stxrelid::regclass AS relation, array_agg(a.attname ORDER BY u.ord) AS stats_columns FROM pg_statistic_ext s CROSS JOIN LATERAL unnest(s.stxkeys::int2[]) WITH ORDINALITY u(attnum, ord) JOIN pg_attribute a ON a.attrelid = s.stxrelid AND a.attnum = u.attnum WHERE s.stxrelid IN ('ctl_stats3_child'::regclass, 'ctl_stats4_child'::regclass) GROUP BY s.stxrelid ORDER BY s.stxrelid::regclass::text
== 172
