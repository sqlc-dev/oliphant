explain (verbose, costs off)
select p from gist_tbl order by circle(p,1) <-> point(0,0) limit 1
--
EXPLAIN (VERBOSE, COSTS OFF) SELECT p FROM gist_tbl ORDER BY circle(p, 1) <-> point(0, 0) LIMIT 1
== 053
select p from gist_tbl order by circle(p,1) <-> point(0,0) limit 1
