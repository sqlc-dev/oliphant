-- n-distinct tests
CREATE TABLE ndistinct (
    filler1 TEXT,
    filler2 NUMERIC,
    a INT,
    b INT,
    filler3 DATE,
    c INT,
    d INT
)
WITH (autovacuum_enabled = off)
--
CREATE TABLE ndistinct (filler1 text, filler2 numeric, a int, b int, filler3 date, c int, d int) WITH (autovacuum_enabled=off)
