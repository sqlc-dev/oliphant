-- functional dependencies tests
CREATE TABLE functional_dependencies (
    filler1 TEXT,
    filler2 NUMERIC,
    a INT,
    b TEXT,
    filler3 DATE,
    c INT,
    d TEXT
)
WITH (autovacuum_enabled = off)
--
CREATE TABLE functional_dependencies (filler1 text, filler2 numeric, a int, b text, filler3 date, c int, d text) WITH (autovacuum_enabled=off)
