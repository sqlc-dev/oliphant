--
SELECT '''w'':4A,3B,2C,1D,5 a:8'
== 015
SELECT 'a:3A b:2a'::tsvector || 'ba:1234 a:1B'
--
SELECT 'a:3A b:2a'::tsvector || 'ba:1234 a:1B'
== 016
SELECT $$'' '1' '2'$$::tsvector
--
SELECT ''''' ''1'' ''2'''::tsvector
== 017
