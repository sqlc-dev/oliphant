--phrase search
SELECT to_tsvector('simple', '1 2 3 1') @@ '1 <-> 2' AS "true"
--
SELECT to_tsvector('simple', '1 2 3 1') @@ '1 <-> 2' AS "true"
== 116
SELECT to_tsvector('simple', '1 2 3 1') @@ '1 <2> 2' AS "false"
--
SELECT to_tsvector('simple', '1 2 3 1') @@ '1 <2> 2' AS "false"
== 117
SELECT to_tsvector('simple', '1 2 3 1') @@ '1 <-> 3' AS "false"
--
SELECT to_tsvector('simple', '1 2 3 1') @@ '1 <-> 3' AS "false"
== 118
