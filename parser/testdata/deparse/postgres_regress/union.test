SELECT q1 FROM int8_tbl INTERSECT SELECT q2 FROM int8_tbl UNION ALL SELECT q2 FROM int8_tbl  ORDER BY 1
--
(SELECT q1 FROM int8_tbl INTERSECT SELECT q2 FROM int8_tbl) UNION ALL SELECT q2 FROM int8_tbl ORDER BY 1
