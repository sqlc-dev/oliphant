--
EXPLAIN (COSTS OFF) SELECT x FROM (VALUES (ROW('10'::varbit)), (ROW('11'::varbit))) _(x) UNION SELECT x FROM (VALUES (ROW('10'::varbit)), (ROW('01'::varbit))) _(x)
