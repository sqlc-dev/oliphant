-- check rounding when casting from float
SELECT x, x::int2 AS int2_value
FROM (VALUES (-2.5::float8),
             (-1.5::float8),
             (-0.5::float8),
             (0.0::float8),
             (0.5::float8),
             (1.5::float8),
             (2.5::float8)) t(x)
--
SELECT x, x::int2 AS int2_value FROM (VALUES (- (2.5)::float8), (- (1.5)::float8), (- (0.5)::float8), ((0.0)::float8), ((0.5)::float8), ((1.5)::float8), ((2.5)::float8)) t(x)
== 050
-- check rounding when casting from numeric
SELECT x, x::int2 AS int2_value
FROM (VALUES (-2.5::numeric),
             (-1.5::numeric),
             (-0.5::numeric),
             (0.0::numeric),
             (0.5::numeric),
             (1.5::numeric),
             (2.5::numeric)) t(x)
--
SELECT x, x::int2 AS int2_value FROM (VALUES (- (2.5)::numeric), (- (1.5)::numeric), (- (0.5)::numeric), ((0.0)::numeric), ((0.5)::numeric), ((1.5)::numeric), ((2.5)::numeric)) t(x)
== 051
