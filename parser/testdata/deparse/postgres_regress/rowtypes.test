|--
-- Test case derived from bug #5716: check multiple uses of a rowtype result
|--

BEGIN
--
BEGIN
== 162
CREATE TABLE price (
    id SERIAL PRIMARY KEY,
    active BOOLEAN NOT NULL,
    price NUMERIC
)
--
CREATE TABLE price (id serial PRIMARY KEY, active boolean NOT NULL, price numeric)
== 163
CREATE TYPE price_input AS (
    id INTEGER,
    price NUMERIC
)
--
CREATE TYPE price_input AS (id int, price numeric)
== 164
CREATE TYPE price_key AS (
    id INTEGER
)
--
CREATE TYPE price_key AS (id int)
== 165
CREATE FUNCTION price_key_from_table(price) RETURNS price_key AS $$
    SELECT $1.id
$$ LANGUAGE SQL
--
CREATE FUNCTION price_key_from_table(price) RETURNS price_key AS $$
    SELECT $1.id
$$ LANGUAGE sql
== 166
CREATE FUNCTION price_key_from_input(price_input) RETURNS price_key AS $$
    SELECT $1.id
$$ LANGUAGE SQL
--
CREATE FUNCTION price_key_from_input(price_input) RETURNS price_key AS $$
    SELECT $1.id
$$ LANGUAGE sql
== 167
insert into price values (1,false,42), (10,false,100), (11,true,17.99)
--
INSERT INTO price VALUES (1, false, 42), (10, false, 100), (11, true, 17.99)
== 168
UPDATE price
    SET active = true, price = input_prices.price
    FROM unnest(ARRAY[(10, 123.00), (11, 99.99)]::price_input[]) input_prices
    WHERE price_key_from_table(price.*) = price_key_from_input(input_prices.*)
--
UPDATE price SET active = true, price = input_prices.price FROM unnest(ARRAY[(10, 123.00), (11, 99.99)]::price_input[]) input_prices WHERE price_key_from_table(price.*) = price_key_from_input(input_prices.*)
== 169
select * from price
--
SELECT * FROM price
== 170
rollback
--
ROLLBACK
== 171
|--
-- Test case derived from bug #9085: check * qualification of composite
-- parameters for SQL functions
|--

create temp table compos (f1 int, f2 text)
--
CREATE TEMPORARY TABLE compos (f1 int, f2 text)
== 172
create function fcompos1(v compos) returns void as $$
insert into compos values (v);  -- fail
$$ language sql
--
CREATE FUNCTION fcompos1(v compos) RETURNS void AS $$
insert into compos values (v);  -- fail
$$ LANGUAGE sql
== 173
create function fcompos1(v compos) returns void as $$
insert into compos values (v.*);
$$ language sql
--
CREATE FUNCTION fcompos1(v compos) RETURNS void AS $$
insert into compos values (v.*);
$$ LANGUAGE sql
== 174
create function fcompos2(v compos) returns void as $$
select fcompos1(v);
$$ language sql
--
CREATE FUNCTION fcompos2(v compos) RETURNS void AS $$
select fcompos1(v);
$$ LANGUAGE sql
== 175
create function fcompos3(v compos) returns void as $$
select fcompos1(fcompos3.v.*);
$$ language sql
--
CREATE FUNCTION fcompos3(v compos) RETURNS void AS $$
select fcompos1(fcompos3.v.*);
$$ LANGUAGE sql
== 176
select fcompos1(row(1,'one'))
--
SELECT fcompos1(ROW(1, 'one'))
== 177
select fcompos2(row(2,'two'))
--
SELECT fcompos2(ROW(2, 'two'))
== 178
select fcompos3(row(3,'three'))
--
SELECT fcompos3(ROW(3, 'three'))
== 179
select * from compos
--
SELECT * FROM compos
== 180
|--
-- We allow I/O conversion casts from composite types to strings to be
-- invoked via cast syntax, but not functional syntax.  This is because
-- the latter is too prone to be invoked unintentionally.
|--
select cast (fullname as text) from fullname
--
SELECT fullname::text FROM fullname
== 181
select fullname::text from fullname
--
SELECT fullname::text FROM fullname
== 182
select text(fullname) from fullname
--
SELECT text(fullname) FROM fullname
== 183
-- error
select fullname.text from fullname
--
SELECT fullname.text FROM fullname
== 184
-- error
-- same, but RECORD instead of named composite type:
select cast (row('Jim', 'Beam') as text)
--
SELECT ROW('Jim', 'Beam')::text
== 185
select (row('Jim', 'Beam'))::text
--
SELECT ROW('Jim', 'Beam')::text
== 186
select text(row('Jim', 'Beam'))
--
SELECT text(ROW('Jim', 'Beam'))
== 187
-- error
select (row('Jim', 'Beam')).text
--
SELECT (ROW('Jim', 'Beam')).text
== 188
-- error

|--
-- Check the equivalence of functional and column notation
|--
insert into fullname values ('Joe', 'Blow')
--
INSERT INTO fullname VALUES ('Joe', 'Blow')
== 189
select f.last from fullname f
--
SELECT f.last FROM fullname f
== 190
select last(f) from fullname f
--
SELECT last(f) FROM fullname f
== 191
create function longname(fullname) returns text language sql
as $$select $1.first || ' ' || $1.last$$
--
CREATE FUNCTION longname(fullname) RETURNS text LANGUAGE sql AS $$select $1.first || ' ' || $1.last$$
== 192
select f.longname from fullname f
--
SELECT f.longname FROM fullname f
== 193
select longname(f) from fullname f
--
SELECT longname(f) FROM fullname f
== 194
-- Starting in v11, the notational form does matter if there's ambiguity
alter table fullname add column longname text
--
ALTER TABLE fullname ADD COLUMN longname text
== 195
select f.longname from fullname f
--
SELECT f.longname FROM fullname f
== 196
select longname(f) from fullname f
--
SELECT longname(f) FROM fullname f
== 197
