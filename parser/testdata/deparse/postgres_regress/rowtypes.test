create type testtype1 as (a int, b int)
--
CREATE TYPE testtype1 AS (a int, b int)
== 124
-- all true
select row(1, 2)::testtype1 *< row(1, 3)::testtype1
--
SELECT ROW(1, 2)::testtype1 *< ROW(1, 3)::testtype1
== 125
select row(1, 2)::testtype1 *<= row(1, 3)::testtype1
--
SELECT ROW(1, 2)::testtype1 *<= ROW(1, 3)::testtype1
== 126
select row(1, 2)::testtype1 *= row(1, 2)::testtype1
--
SELECT ROW(1, 2)::testtype1 *= ROW(1, 2)::testtype1
== 127
select row(1, 2)::testtype1 *<> row(1, 3)::testtype1
--
SELECT ROW(1, 2)::testtype1 *<> ROW(1, 3)::testtype1
== 128
select row(1, 3)::testtype1 *>= row(1, 2)::testtype1
--
SELECT ROW(1, 3)::testtype1 *>= ROW(1, 2)::testtype1
== 129
select row(1, 3)::testtype1 *> row(1, 2)::testtype1
--
SELECT ROW(1, 3)::testtype1 *> ROW(1, 2)::testtype1
== 130
-- all false
select row(1, -2)::testtype1 *< row(1, -3)::testtype1
--
SELECT ROW(1, -2)::testtype1 *< ROW(1, -3)::testtype1
== 131
select row(1, -2)::testtype1 *<= row(1, -3)::testtype1
--
SELECT ROW(1, -2)::testtype1 *<= ROW(1, -3)::testtype1
== 132
select row(1, -2)::testtype1 *= row(1, -3)::testtype1
--
SELECT ROW(1, -2)::testtype1 *= ROW(1, -3)::testtype1
== 133
select row(1, -2)::testtype1 *<> row(1, -2)::testtype1
--
SELECT ROW(1, -2)::testtype1 *<> ROW(1, -2)::testtype1
== 134
select row(1, -3)::testtype1 *>= row(1, -2)::testtype1
