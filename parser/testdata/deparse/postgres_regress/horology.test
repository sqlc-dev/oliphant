  OVERLAPS (timestamp without time zone '2000-11-27', interval '12 hours') AS "True"
--
SELECT ('2000-11-27'::timestamp, '12 hours'::interval) overlaps ('2000-11-27'::timestamp, '12 hours'::interval)  AS "True"
