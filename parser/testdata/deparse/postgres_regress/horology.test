|--
-- date, time arithmetic
|--

SELECT date '1981-02-03' + time '04:05:06' AS "Date + Time"
--
SELECT '1981-02-03'::date + '04:05:06'::time AS "Date + Time"
== 107
SELECT date '1991-02-03' + time with time zone '04:05:06 PST' AS "Date + Time PST"
--
SELECT '1991-02-03'::date + '04:05:06 PST'::time with time zone AS "Date + Time PST"
== 108
SELECT date '2001-02-03' + time with time zone '04:05:06 UTC' AS "Date + Time UTC"
--
SELECT '2001-02-03'::date + '04:05:06 UTC'::time with time zone AS "Date + Time UTC"
== 109
SELECT date '1991-02-03' + interval '2 years' AS "Add Two Years"
--
SELECT '1991-02-03'::date + '2 years'::interval AS "Add Two Years"
== 110
SELECT date '2001-12-13' - interval '2 years' AS "Subtract Two Years"
--
SELECT '2001-12-13'::date - '2 years'::interval AS "Subtract Two Years"
== 111
-- subtract time from date should not make sense; use interval instead
SELECT date '1991-02-03' - time '04:05:06' AS "Subtract Time"
--
SELECT '1991-02-03'::date - '04:05:06'::time AS "Subtract Time"
== 112
SELECT date '1991-02-03' - time with time zone '04:05:06 UTC' AS "Subtract Time UTC"
--
SELECT '1991-02-03'::date - '04:05:06 UTC'::time with time zone AS "Subtract Time UTC"
== 113
