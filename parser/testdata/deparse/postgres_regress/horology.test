== 200
SELECT d.f1 AS "timestamp",
   timestamp with time zone '1980-01-06 00:00 GMT' AS gpstime_zero,
   d.f1 - timestamp with time zone '1980-01-06 00:00 GMT' AS difference
  FROM TEMP_TIMESTAMP d
  ORDER BY difference
--
SELECT d.f1 AS "timestamp", '1980-01-06 00:00 GMT'::timestamp with time zone AS gpstime_zero, d.f1 - '1980-01-06 00:00 GMT'::timestamp with time zone AS difference FROM temp_timestamp d ORDER BY difference
== 201
SELECT d1.f1 AS timestamp1, d2.f1 AS timestamp2, d1.f1 - d2.f1 AS difference
  FROM TEMP_TIMESTAMP d1, TEMP_TIMESTAMP d2
  ORDER BY timestamp1, timestamp2, difference
--
SELECT d1.f1 AS timestamp1, d2.f1 AS timestamp2, d1.f1 - d2.f1 AS difference FROM temp_timestamp d1, temp_timestamp d2 ORDER BY timestamp1, timestamp2, difference
