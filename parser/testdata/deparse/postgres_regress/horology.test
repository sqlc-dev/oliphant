SELECT CAST(time '01:02' AS interval) AS "+01:02"
--
SELECT '01:02'::time::interval AS "+01:02"
== 163
SELECT CAST(interval '02:03' AS time) AS "02:03:00"
--
SELECT '02:03'::interval::time AS "02:03:00"
== 164
SELECT CAST(interval '-02:03' AS time) AS "21:57:00"
--
SELECT '-02:03'::interval::time AS "21:57:00"
== 165
SELECT CAST(interval '-9223372022400000000 us' AS time) AS "00:00:00"
--
SELECT '-9223372022400000000 us'::interval::time AS "00:00:00"
== 166
SELECT time '01:30' + interval '02:01' AS "03:31:00"
--
SELECT '01:30'::time + '02:01'::interval AS "03:31:00"
== 167
SELECT time '01:30' - interval '02:01' AS "23:29:00"
--
SELECT '01:30'::time - '02:01'::interval AS "23:29:00"
== 168
SELECT time '02:30' + interval '36:01' AS "14:31:00"
--
SELECT '02:30'::time + '36:01'::interval AS "14:31:00"
== 169
SELECT time '03:30' + interval '1 month 04:01' AS "07:31:00"
--
SELECT '03:30'::time + '1 month 04:01'::interval AS "07:31:00"
== 170
