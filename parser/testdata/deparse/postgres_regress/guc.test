-- SET LOCAL is restricted by a function SET option
create or replace function myfunc(int) returns text as $$
begin
  set local work_mem = '2MB';
  return current_setting('work_mem');
end $$
language plpgsql
set work_mem = '1MB'
--
CREATE OR REPLACE FUNCTION myfunc(int) RETURNS text AS $$
begin
  set local work_mem = '2MB';
  return current_setting('work_mem');
end $$ LANGUAGE plpgsql SET work_mem TO "1MB"
