-- Test optimization of single-chr-or-bracket-expression lookaround constraints
select 'xz' ~ 'x(?=[xy])'
--
SELECT 'xz' ~ 'x(?=[xy])'
== 042
select 'xy' ~ 'x(?=[xy])'
--
SELECT 'xy' ~ 'x(?=[xy])'
== 043
select 'xz' ~ 'x(?![xy])'
--
SELECT 'xz' ~ 'x(?![xy])'
== 044
select 'xy' ~ 'x(?![xy])'
--
SELECT 'xy' ~ 'x(?![xy])'
== 045
select 'x'  ~ 'x(?![xy])'
--
SELECT 'x' ~ 'x(?![xy])'
== 046
select 'xyy' ~ '(?<=[xy])yy+'
--
SELECT 'xyy' ~ '(?<=[xy])yy+'
== 047
select 'zyy' ~ '(?<=[xy])yy+'
--
SELECT 'zyy' ~ '(?<=[xy])yy+'
== 048
select 'xyy' ~ '(?<![xy])yy+'
--
SELECT 'xyy' ~ '(?<![xy])yy+'
== 049
select 'zyy' ~ '(?<![xy])yy+'
--
SELECT 'zyy' ~ '(?<![xy])yy+'
== 050
-- Test conversion of regex patterns to indexable conditions
explain (costs off) select * from pg_proc where proname ~ 'abc'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ 'abc'
== 051
explain (costs off) select * from pg_proc where proname ~ '^abc'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^abc'
== 052
explain (costs off) select * from pg_proc where proname ~ '^abc$'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^abc$'
== 053
explain (costs off) select * from pg_proc where proname ~ '^abcd*e'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^abcd*e'
== 054
explain (costs off) select * from pg_proc where proname ~ '^abc+d'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^abc+d'
== 055
explain (costs off) select * from pg_proc where proname ~ '^(abc)(def)'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^(abc)(def)'
== 056
explain (costs off) select * from pg_proc where proname ~ '^(abc)$'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^(abc)$'
== 057
explain (costs off) select * from pg_proc where proname ~ '^(abc)?d'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ '^(abc)?d'
== 058
explain (costs off) select * from pg_proc where proname ~ '^abcd(x|(?=\w\w)q)'
--
EXPLAIN (COSTS OFF) SELECT * FROM pg_proc WHERE proname ~ E'^abcd(x|(?=\\w\\w)q)'
== 059
-- Test for infinite loop in pullback() (CVE-2007-4772)
select 'a' ~ '($|^)*'
--
SELECT 'a' ~ '($|^)*'
== 060
-- These cases expose a bug in the original fix for CVE-2007-4772
select 'a' ~ '(^)+^'
--
SELECT 'a' ~ '(^)+^'
== 061
select 'a' ~ '$($$)+'
--
SELECT 'a' ~ '$($$)+'
== 062
-- More cases of infinite loop in pullback(), not fixed by CVE-2007-4772 fix
select 'a' ~ '($^)+'
--
SELECT 'a' ~ '($^)+'
== 063
select 'a' ~ '(^$)*'
--
SELECT 'a' ~ '(^$)*'
== 064
select 'aa bb cc' ~ '(^(?!aa))+'
--
SELECT 'aa bb cc' ~ '(^(?!aa))+'
