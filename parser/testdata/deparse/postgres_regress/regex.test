== 001
|--
-- Regular expression tests
|--

-- Don't want to have to double backslashes in regexes
set standard_conforming_strings = on
--
SET standard_conforming_strings TO ON
== 002
-- Test simple quantified backrefs
select 'bbbbb' ~ '^([bc])\1*$' as t
--
SELECT 'bbbbb' ~ E'^([bc])\\1*$' AS t
== 003
select 'ccc' ~ '^([bc])\1*$' as t
--
SELECT 'ccc' ~ E'^([bc])\\1*$' AS t
== 004
select 'xxx' ~ '^([bc])\1*$' as f
--
SELECT 'xxx' ~ E'^([bc])\\1*$' AS f
== 005
select 'bbc' ~ '^([bc])\1*$' as f
--
SELECT 'bbc' ~ E'^([bc])\\1*$' AS f
== 006
select 'b' ~ '^([bc])\1*$' as t
--
SELECT 'b' ~ E'^([bc])\\1*$' AS t
== 007
-- Test quantified backref within a larger expression
select 'abc abc abc' ~ '^(\w+)( \1)+$' as t
--
SELECT 'abc abc abc' ~ E'^(\\w+)( \\1)+$' AS t
== 008
select 'abc abd abc' ~ '^(\w+)( \1)+$' as f
--
SELECT 'abc abd abc' ~ E'^(\\w+)( \\1)+$' AS f
== 009
select 'abc abc abd' ~ '^(\w+)( \1)+$' as f
--
SELECT 'abc abc abd' ~ E'^(\\w+)( \\1)+$' AS f
== 010
select 'abc abc abc' ~ '^(.+)( \1)+$' as t
--
SELECT 'abc abc abc' ~ E'^(.+)( \\1)+$' AS t
== 011
select 'abc abd abc' ~ '^(.+)( \1)+$' as f
--
SELECT 'abc abd abc' ~ E'^(.+)( \\1)+$' AS f
== 012
select 'abc abc abd' ~ '^(.+)( \1)+$' as f
--
SELECT 'abc abc abd' ~ E'^(.+)( \\1)+$' AS f
== 013
-- Test some cases that crashed in 9.2beta1 due to pmatch[] array overrun
select substring('asd TO foo' from ' TO (([a-z0-9._]+|"([^"]+|"")+")+)')
--
SELECT SUBSTRING('asd TO foo' FROM ' TO (([a-z0-9._]+|"([^"]+|"")+")+)')
== 014
select substring('a' from '((a))+')
--
SELECT SUBSTRING('a' FROM '((a))+')
== 015
select substring('a' from '((a)+)')
--
SELECT SUBSTRING('a' FROM '((a)+)')
== 016
-- Test regexp_match()
select regexp_match('abc', '')
--
SELECT regexp_match('abc', '')
== 017
select regexp_match('abc', 'bc')
--
SELECT regexp_match('abc', 'bc')
== 018
select regexp_match('abc', 'd') is null
--
SELECT regexp_match('abc', 'd') IS NULL
== 019
select regexp_match('abc', '(B)(c)', 'i')
--
SELECT regexp_match('abc', '(B)(c)', 'i')
== 020
select regexp_match('abc', 'Bd', 'ig')
--
SELECT regexp_match('abc', 'Bd', 'ig')
== 021
-- error

-- Test lookahead constraints
select regexp_matches('ab', 'a(?=b)b*')
--
SELECT regexp_matches('ab', 'a(?=b)b*')
== 022
select regexp_matches('a', 'a(?=b)b*')
--
SELECT regexp_matches('a', 'a(?=b)b*')
== 023
select regexp_matches('abc', 'a(?=b)b*(?=c)c*')
--
SELECT regexp_matches('abc', 'a(?=b)b*(?=c)c*')
== 024
select regexp_matches('ab', 'a(?=b)b*(?=c)c*')
--
SELECT regexp_matches('ab', 'a(?=b)b*(?=c)c*')
== 025
select regexp_matches('ab', 'a(?!b)b*')
--
SELECT regexp_matches('ab', 'a(?!b)b*')
== 026
select regexp_matches('a', 'a(?!b)b*')
--
SELECT regexp_matches('a', 'a(?!b)b*')
== 027
select regexp_matches('b', '(?=b)b')
--
SELECT regexp_matches('b', '(?=b)b')
== 028
select regexp_matches('a', '(?=b)b')
--
SELECT regexp_matches('a', '(?=b)b')
== 029
