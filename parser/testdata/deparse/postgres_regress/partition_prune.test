-- Runtime pruning on MERGE using a stable function
create function stable_one() returns int as $$ begin return 1; end; $$ language plpgsql stable
--
CREATE FUNCTION stable_one() RETURNS int AS $$ begin return 1; end; $$ LANGUAGE plpgsql STABLE
