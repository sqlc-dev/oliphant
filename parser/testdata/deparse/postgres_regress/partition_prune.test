when matched then delete returning pt.a
--
EXPLAIN (COSTS OFF) MERGE INTO part_abc_view pt USING (SELECT stable_one() AS pid) q JOIN part_abc_1 pt1 ON q.pid = pt1.a ON pt.a = pt1.a WHEN MATCHED THEN DELETE RETURNING pt.a
