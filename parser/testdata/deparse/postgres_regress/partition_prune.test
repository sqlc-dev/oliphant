== 238
-- ensure we detect contradictions in clauses; a can't be NULL and NOT NULL.
explain (costs off) select * from lp where a <> 'a' and a is null
--
EXPLAIN (COSTS OFF) SELECT * FROM lp WHERE a <> 'a' AND a IS NULL
== 239
explain (costs off) select * from lp where (a <> 'a' and a <> 'd') or a is null
--
