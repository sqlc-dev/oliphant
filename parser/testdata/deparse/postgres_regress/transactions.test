-- check non-transactional behavior of cursors
BEGIN
--
BEGIN
== 211
DECLARE c CURSOR FOR SELECT unique2 FROM tenk1 ORDER BY unique2
--
DECLARE c CURSOR FOR SELECT unique2 FROM tenk1 ORDER BY unique2
== 212
SAVEPOINT one
--
SAVEPOINT one
== 213
FETCH 10 FROM c
--
FETCH FORWARD 10 c
== 214
ROLLBACK TO SAVEPOINT one
--
ROLLBACK TO SAVEPOINT one
== 215
FETCH 10 FROM c
--
FETCH FORWARD 10 c
== 216
RELEASE SAVEPOINT one
--
RELEASE one
== 217
FETCH 10 FROM c
--
FETCH FORWARD 10 c
== 218
CLOSE c
--
CLOSE c
== 219
DECLARE c CURSOR FOR SELECT unique2/0 FROM tenk1 ORDER BY unique2
--
DECLARE c CURSOR FOR SELECT unique2 / 0 FROM tenk1 ORDER BY unique2
== 220
SAVEPOINT two
--
SAVEPOINT two
== 221
FETCH 10 FROM c
--
FETCH FORWARD 10 c
== 222
ROLLBACK TO SAVEPOINT two
--
ROLLBACK TO SAVEPOINT two
== 223
-- c is now dead to the world ...
		FETCH 10 FROM c
--
FETCH FORWARD 10 c
== 224
ROLLBACK TO SAVEPOINT two
--
ROLLBACK TO SAVEPOINT two
== 225
RELEASE SAVEPOINT two
--
RELEASE two
== 226
FETCH 10 FROM c
--
FETCH FORWARD 10 c
== 227
COMMIT
