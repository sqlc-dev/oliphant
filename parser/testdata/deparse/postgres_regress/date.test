|--
-- Simple math
-- Leave most of it for the horology tests
|--

SELECT f1 - date '2000-01-01' AS "Days From 2K" FROM DATE_TBL
--
SELECT f1 - '2000-01-01'::date AS "Days From 2K" FROM date_tbl
== 169
SELECT f1 - date 'epoch' AS "Days From Epoch" FROM DATE_TBL
--
SELECT f1 - 'epoch'::date AS "Days From Epoch" FROM date_tbl
== 170
SELECT date 'yesterday' - date 'today' AS "One day"
--
SELECT 'yesterday'::date - 'today'::date AS "One day"
== 171
SELECT date 'today' - date 'tomorrow' AS "One day"
--
SELECT 'today'::date - 'tomorrow'::date AS "One day"
== 172
SELECT date 'yesterday' - date 'tomorrow' AS "Two days"
--
SELECT 'yesterday'::date - 'tomorrow'::date AS "Two days"
== 173
SELECT date 'tomorrow' - date 'today' AS "One day"
--
SELECT 'tomorrow'::date - 'today'::date AS "One day"
== 174
SELECT date 'today' - date 'yesterday' AS "One day"
--
SELECT 'today'::date - 'yesterday'::date AS "One day"
== 175
SELECT date 'tomorrow' - date 'yesterday' AS "Two days"
--
SELECT 'tomorrow'::date - 'yesterday'::date AS "Two days"
== 176
|--
-- test extract!
|--
SELECT f1 as "date",
    date_part('year', f1) AS year,
    date_part('month', f1) AS month,
    date_part('day', f1) AS day,
    date_part('quarter', f1) AS quarter,
    date_part('decade', f1) AS decade,
    date_part('century', f1) AS century,
    date_part('millennium', f1) AS millennium,
    date_part('isoyear', f1) AS isoyear,
    date_part('week', f1) AS week,
    date_part('dow', f1) AS dow,
    date_part('isodow', f1) AS isodow,
    date_part('doy', f1) AS doy,
    date_part('julian', f1) AS julian,
    date_part('epoch', f1) AS epoch
    FROM date_tbl
--
SELECT f1 AS date, date_part('year', f1) AS year, date_part('month', f1) AS month, date_part('day', f1) AS day, date_part('quarter', f1) AS quarter, date_part('decade', f1) AS decade, date_part('century', f1) AS century, date_part('millennium', f1) AS millennium, date_part('isoyear', f1) AS isoyear, date_part('week', f1) AS week, date_part('dow', f1) AS dow, date_part('isodow', f1) AS isodow, date_part('doy', f1) AS doy, date_part('julian', f1) AS julian, date_part('epoch', f1) AS epoch FROM date_tbl
== 177
|--
-- epoch
|--
SELECT EXTRACT(EPOCH FROM DATE        '1970-01-01')
--
SELECT extract ('epoch' FROM '1970-01-01'::date)
== 178
--  0
|--
-- century
|--
SELECT EXTRACT(CENTURY FROM DATE '0101-12-31 BC')
--
SELECT extract ('century' FROM '0101-12-31 BC'::date)
== 179
-- -2
SELECT EXTRACT(CENTURY FROM DATE '0100-12-31 BC')
--
SELECT extract ('century' FROM '0100-12-31 BC'::date)
== 180
-- -1
SELECT EXTRACT(CENTURY FROM DATE '0001-12-31 BC')
--
SELECT extract ('century' FROM '0001-12-31 BC'::date)
== 181
-- -1
SELECT EXTRACT(CENTURY FROM DATE '0001-01-01')
--
SELECT extract ('century' FROM '0001-01-01'::date)
== 182
--  1
SELECT EXTRACT(CENTURY FROM DATE '0001-01-01 AD')
--
SELECT extract ('century' FROM '0001-01-01 AD'::date)
== 183
--  1
SELECT EXTRACT(CENTURY FROM DATE '1900-12-31')
--
SELECT extract ('century' FROM '1900-12-31'::date)
== 184
-- 19
SELECT EXTRACT(CENTURY FROM DATE '1901-01-01')
--
SELECT extract ('century' FROM '1901-01-01'::date)
== 185
-- 20
SELECT EXTRACT(CENTURY FROM DATE '2000-12-31')
--
SELECT extract ('century' FROM '2000-12-31'::date)
== 186
-- 20
SELECT EXTRACT(CENTURY FROM DATE '2001-01-01')
--
SELECT extract ('century' FROM '2001-01-01'::date)
== 187
-- 21
SELECT EXTRACT(CENTURY FROM CURRENT_DATE)>=21 AS True
--
SELECT extract ('century' FROM current_date) >= 21 AS "true"
== 188
-- true
|--
-- millennium
|--
SELECT EXTRACT(MILLENNIUM FROM DATE '0001-12-31 BC')
--
SELECT extract ('millennium' FROM '0001-12-31 BC'::date)
== 189
-- -1
SELECT EXTRACT(MILLENNIUM FROM DATE '0001-01-01 AD')
--
SELECT extract ('millennium' FROM '0001-01-01 AD'::date)
== 190
--  1
SELECT EXTRACT(MILLENNIUM FROM DATE '1000-12-31')
--
SELECT extract ('millennium' FROM '1000-12-31'::date)
== 191
--  1
SELECT EXTRACT(MILLENNIUM FROM DATE '1001-01-01')
--
SELECT extract ('millennium' FROM '1001-01-01'::date)
== 192
--  2
SELECT EXTRACT(MILLENNIUM FROM DATE '2000-12-31')
--
SELECT extract ('millennium' FROM '2000-12-31'::date)
== 193
--  2
SELECT EXTRACT(MILLENNIUM FROM DATE '2001-01-01')
--
SELECT extract ('millennium' FROM '2001-01-01'::date)
== 194
--  3
-- next test to be fixed on the turn of the next millennium;-)
SELECT EXTRACT(MILLENNIUM FROM CURRENT_DATE)
--
SELECT extract ('millennium' FROM current_date)
== 195
--  3
