SELECT EXTRACT(DOW           FROM DATE '2020-08-11')
--
SELECT extract ('dow' FROM '2020-08-11'::date)
== 219
SELECT EXTRACT(DOW           FROM DATE '2020-08-16')
--
SELECT extract ('dow' FROM '2020-08-16'::date)
== 220
SELECT EXTRACT(ISODOW        FROM DATE '2020-08-11')
--
SELECT extract ('isodow' FROM '2020-08-11'::date)
== 221
SELECT EXTRACT(ISODOW        FROM DATE '2020-08-16')
--
SELECT extract ('isodow' FROM '2020-08-16'::date)
== 222
SELECT EXTRACT(DOY           FROM DATE '2020-08-11')
--
SELECT extract ('doy' FROM '2020-08-11'::date)
== 223
SELECT EXTRACT(TIMEZONE      FROM DATE '2020-08-11')
--
SELECT extract ('timezone' FROM '2020-08-11'::date)
== 224
SELECT EXTRACT(TIMEZONE_M    FROM DATE '2020-08-11')
--
SELECT extract ('timezone_m' FROM '2020-08-11'::date)
== 225
SELECT EXTRACT(TIMEZONE_H    FROM DATE '2020-08-11')
--
SELECT extract ('timezone_h' FROM '2020-08-11'::date)
== 226
SELECT EXTRACT(EPOCH         FROM DATE '2020-08-11')
--
SELECT extract ('epoch' FROM '2020-08-11'::date)
== 227
SELECT EXTRACT(JULIAN        FROM DATE '2020-08-11')
--
SELECT extract ('julian' FROM '2020-08-11'::date)
== 228
|--
-- test trunc function!
|--
SELECT DATE_TRUNC('MILLENNIUM', TIMESTAMP '1970-03-20 04:30:00.00000')
--
SELECT date_trunc('MILLENNIUM', '1970-03-20 04:30:00.00000'::timestamp)
== 229
-- 1001
SELECT DATE_TRUNC('MILLENNIUM', DATE '1970-03-20')
--
SELECT date_trunc('MILLENNIUM', '1970-03-20'::date)
== 230
-- 1001-01-01
SELECT DATE_TRUNC('CENTURY', TIMESTAMP '1970-03-20 04:30:00.00000')
--
SELECT date_trunc('CENTURY', '1970-03-20 04:30:00.00000'::timestamp)
== 231
-- 1901
SELECT DATE_TRUNC('CENTURY', DATE '1970-03-20')
--
SELECT date_trunc('CENTURY', '1970-03-20'::date)
== 232
-- 1901
SELECT DATE_TRUNC('CENTURY', DATE '2004-08-10')
--
SELECT date_trunc('CENTURY', '2004-08-10'::date)
== 233
-- 2001-01-01
SELECT DATE_TRUNC('CENTURY', DATE '0002-02-04')
--
SELECT date_trunc('CENTURY', '0002-02-04'::date)
== 234
-- 0001-01-01
SELECT DATE_TRUNC('CENTURY', DATE '0055-08-10 BC')
--
SELECT date_trunc('CENTURY', '0055-08-10 BC'::date)
== 235
-- 0100-01-01 BC
SELECT DATE_TRUNC('DECADE', DATE '1993-12-25')
--
SELECT date_trunc('DECADE', '1993-12-25'::date)
== 236
-- 1990-01-01
SELECT DATE_TRUNC('DECADE', DATE '0004-12-25')
--
SELECT date_trunc('DECADE', '0004-12-25'::date)
== 237
-- 0001-01-01 BC
SELECT DATE_TRUNC('DECADE', DATE '0002-12-31 BC')
--
SELECT date_trunc('DECADE', '0002-12-31 BC'::date)
== 238
-- 0011-01-01 BC
|--
-- test infinity
|--
select 'infinity'::date, '-infinity'::date
--
SELECT 'infinity'::date, '-infinity'::date
== 239
select 'infinity'::date > 'today'::date as t
--
SELECT 'infinity'::date > 'today'::date AS t
== 240
select '-infinity'::date < 'today'::date as t
--
SELECT '-infinity'::date < 'today'::date AS t
== 241
select isfinite('infinity'::date), isfinite('-infinity'::date), isfinite('today'::date)
--
SELECT isfinite('infinity'::date), isfinite('-infinity'::date), isfinite('today'::date)
== 242
select 'infinity'::date = '+infinity'::date as t
--
SELECT 'infinity'::date = '+infinity'::date AS t
== 243
|--
-- oscillating fields from non-finite date:
|--
SELECT EXTRACT(DAY FROM DATE 'infinity')
--
SELECT extract ('day' FROM 'infinity'::date)
== 244
-- NULL
SELECT EXTRACT(DAY FROM DATE '-infinity')
--
SELECT extract ('day' FROM '-infinity'::date)
== 245
-- NULL
-- all supported fields
SELECT EXTRACT(DAY           FROM DATE 'infinity')
--
SELECT extract ('day' FROM 'infinity'::date)
== 246
-- NULL
SELECT EXTRACT(MONTH         FROM DATE 'infinity')
--
SELECT extract ('month' FROM 'infinity'::date)
== 247
-- NULL
SELECT EXTRACT(QUARTER       FROM DATE 'infinity')
--
SELECT extract ('quarter' FROM 'infinity'::date)
== 248
-- NULL
SELECT EXTRACT(WEEK          FROM DATE 'infinity')
--
SELECT extract ('week' FROM 'infinity'::date)
== 249
-- NULL
SELECT EXTRACT(DOW           FROM DATE 'infinity')
--
SELECT extract ('dow' FROM 'infinity'::date)
== 250
-- NULL
SELECT EXTRACT(ISODOW        FROM DATE 'infinity')
--
SELECT extract ('isodow' FROM 'infinity'::date)
== 251
-- NULL
SELECT EXTRACT(DOY           FROM DATE 'infinity')
--
SELECT extract ('doy' FROM 'infinity'::date)
== 252
-- NULL
|--
-- monotonic fields from non-finite date:
|--
SELECT EXTRACT(EPOCH FROM DATE 'infinity')
--
SELECT extract ('epoch' FROM 'infinity'::date)
== 253
--  Infinity
SELECT EXTRACT(EPOCH FROM DATE '-infinity')
--
SELECT extract ('epoch' FROM '-infinity'::date)
== 254
-- -Infinity
-- all supported fields
SELECT EXTRACT(YEAR       FROM DATE 'infinity')
--
SELECT extract ('year' FROM 'infinity'::date)
== 255
--  Infinity
SELECT EXTRACT(DECADE     FROM DATE 'infinity')
--
SELECT extract ('decade' FROM 'infinity'::date)
== 256
--  Infinity
SELECT EXTRACT(CENTURY    FROM DATE 'infinity')
--
SELECT extract ('century' FROM 'infinity'::date)
== 257
--  Infinity
SELECT EXTRACT(MILLENNIUM FROM DATE 'infinity')
--
SELECT extract ('millennium' FROM 'infinity'::date)
== 258
--  Infinity
SELECT EXTRACT(JULIAN     FROM DATE 'infinity')
--
SELECT extract ('julian' FROM 'infinity'::date)
== 259
--  Infinity
SELECT EXTRACT(ISOYEAR    FROM DATE 'infinity')
--
SELECT extract ('isoyear' FROM 'infinity'::date)
== 260
--  Infinity
SELECT EXTRACT(EPOCH      FROM DATE 'infinity')
--
SELECT extract ('epoch' FROM 'infinity'::date)
== 261
--  Infinity
|--
-- wrong fields from non-finite date:
|--
SELECT EXTRACT(MICROSEC  FROM DATE 'infinity')
--
SELECT extract ('microsec' FROM 'infinity'::date)
== 262
-- error

-- test constructors
select make_date(2013, 7, 15)
--
SELECT make_date(2013, 7, 15)
== 263
select make_date(-44, 3, 15)
--
SELECT make_date(-44, 3, 15)
== 264
select make_time(8, 20, 0.0)
--
SELECT make_time(8, 20, 0.0)
== 265
-- should fail
select make_date(0, 7, 15)
--
SELECT make_date(0, 7, 15)
== 266
select make_date(2013, 2, 30)
--
SELECT make_date(2013, 2, 30)
== 267
select make_date(2013, 13, 1)
--
SELECT make_date(2013, 13, 1)
== 268
select make_date(2013, 11, -1)
--
SELECT make_date(2013, 11, -1)
== 269
SELECT make_date(-2147483648, 1, 1)
--
SELECT make_date(-2147483648, 1, 1)
== 270
select make_time(10, 55, 100.1)
--
SELECT make_time(10, 55, 100.1)
== 271
select make_time(24, 0, 2.1)
--
SELECT make_time(24, 0, 2.1)
