--
SELECT count(*) AS one FROM timestamp_tbl WHERE d1 = 'today'::timestamp
== 009
SELECT count(*) AS Three FROM TIMESTAMP_TBL WHERE d1 = timestamp without time zone 'tomorrow'
--
SELECT count(*) AS three FROM timestamp_tbl WHERE d1 = 'tomorrow'::timestamp
== 010
SELECT count(*) AS One FROM TIMESTAMP_TBL WHERE d1 = timestamp without time zone 'yesterday'
--
SELECT count(*) AS one FROM timestamp_tbl WHERE d1 = 'yesterday'::timestamp
== 011
COMMIT
