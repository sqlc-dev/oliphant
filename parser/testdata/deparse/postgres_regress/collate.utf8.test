== 018
-- symbols are punctuation in posix
SELECT 'a8a' ~ '[[:digit:]]' COLLATE PG_C_UTF8
--
SELECT 'a8a' ~ '[[:digit:]]' COLLATE pg_c_utf8
== 019
SELECT '൧' !~ '\d' COLLATE PG_C_UTF8
--
SELECT '൧' !~ E'\\d' COLLATE pg_c_utf8
== 020
-- only 0-9 considered digits in posix

-- case mapping

SELECT 'xYz' ~* 'XyZ' COLLATE PG_C_UTF8
--
SELECT 'xYz' ~* 'XyZ' COLLATE pg_c_utf8
