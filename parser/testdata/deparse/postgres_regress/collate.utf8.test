== 011
-- negative test: Final_Sigma not used for builtin locale C.UTF-8
SELECT lower('ΑΣ' COLLATE PG_C_UTF8)
--
SELECT lower('ΑΣ' COLLATE pg_c_utf8)
== 012
SELECT lower('ΑͺΣͺ' COLLATE PG_C_UTF8)
--
SELECT lower('ΑͺΣͺ' COLLATE pg_c_utf8)
== 013
