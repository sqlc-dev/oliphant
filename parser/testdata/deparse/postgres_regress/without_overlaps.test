SET     valid_at = '{[2020-01-01,2021-01-01)}'
WHERE   id = '[11,12)'
AND     valid_at @> '2018-01-15'::date
--
UPDATE temporal_mltrng3 SET valid_at = '{[2020-01-01,2021-01-01)}' WHERE id = '[11,12)' AND valid_at @> '2018-01-15'::date
== 225
-- update both at once
UPDATE  temporal_mltrng3
SET     id = '[21,22)',
        valid_at = '{[2018-01-02,2018-02-03)}'
WHERE   id = '[11,12)'
AND     valid_at @> '2020-01-15'::date
--
UPDATE temporal_mltrng3 SET id = '[21,22)', valid_at = '{[2018-01-02,2018-02-03)}' WHERE id = '[11,12)' AND valid_at @> '2020-01-15'::date
== 226
-- set the scalar part to NULL
UPDATE  temporal_mltrng3
SET     id = NULL,
        valid_at = datemultirange(daterange('2020-01-01', '2021-01-01'))
WHERE   id = '[21,22)'
--
UPDATE temporal_mltrng3 SET id = NULL, valid_at = datemultirange(daterange('2020-01-01', '2021-01-01')) WHERE id = '[21,22)'
== 227
-- set the multirange part to NULL
UPDATE  temporal_mltrng3
SET     id = '[1,2)',
        valid_at = NULL
WHERE   id IS NULL AND valid_at @> '2020-06-01'::date
--
UPDATE temporal_mltrng3 SET id = '[1,2)', valid_at = NULL WHERE id IS NULL AND valid_at @> '2020-06-01'::date
== 228
SELECT * FROM temporal_mltrng3 ORDER BY id, valid_at
--
SELECT * FROM temporal_mltrng3 ORDER BY id, valid_at
== 229
