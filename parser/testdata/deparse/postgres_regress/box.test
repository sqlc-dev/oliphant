SELECT * FROM box_tbl
== 013
SELECT b.*, area(b.f1) as barea
   FROM BOX_TBL b
--
SELECT b.*, area(b.f1) AS barea FROM box_tbl b
== 014
-- overlap
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 && box '(2.5,2.5,1.0,1.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 && '(2.5,2.5,1.0,1.0)'::box
== 015
-- left-or-overlap (x only)
SELECT b1.*
   FROM BOX_TBL b1
   WHERE b1.f1 &< box '(2.0,2.0,2.5,2.5)'
--
SELECT b1.* FROM box_tbl b1 WHERE b1.f1 &< '(2.0,2.0,2.5,2.5)'::box
== 016
-- right-or-overlap (x only)
SELECT b1.*
   FROM BOX_TBL b1
   WHERE b1.f1 &> box '(2.0,2.0,2.5,2.5)'
--
SELECT b1.* FROM box_tbl b1 WHERE b1.f1 &> '(2.0,2.0,2.5,2.5)'::box
== 017
-- left of
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 << box '(3.0,3.0,5.0,5.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 << '(3.0,3.0,5.0,5.0)'::box
== 018
-- area <=
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 <= box '(3.0,3.0,5.0,5.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 <= '(3.0,3.0,5.0,5.0)'::box
== 019
-- area <
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 < box '(3.0,3.0,5.0,5.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 < '(3.0,3.0,5.0,5.0)'::box
== 020
-- area =
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 = box '(3.0,3.0,5.0,5.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 = '(3.0,3.0,5.0,5.0)'::box
== 021
-- area >
SELECT b.f1
   FROM BOX_TBL b				-- zero area
   WHERE b.f1 > box '(3.5,3.0,4.5,3.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 > '(3.5,3.0,4.5,3.0)'::box
== 022
-- area >=
SELECT b.f1
   FROM BOX_TBL b				-- zero area
   WHERE b.f1 >= box '(3.5,3.0,4.5,3.0)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 >= '(3.5,3.0,4.5,3.0)'::box
== 023
-- right of
SELECT b.f1
   FROM BOX_TBL b
   WHERE box '(3.0,3.0,5.0,5.0)' >> b.f1
--
SELECT b.f1 FROM box_tbl b WHERE '(3.0,3.0,5.0,5.0)'::box >> b.f1
== 024
-- contained in
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 <@ box '(0,0,3,3)'
--
SELECT b.f1 FROM box_tbl b WHERE b.f1 <@ '(0,0,3,3)'::box
== 025
-- contains
SELECT b.f1
   FROM BOX_TBL b
   WHERE box '(0,0,3,3)' @> b.f1
--
SELECT b.f1 FROM box_tbl b WHERE '(0,0,3,3)'::box @> b.f1
== 026
-- box equality
SELECT b.f1
   FROM BOX_TBL b
   WHERE box '(1,1,3,3)' ~= b.f1
--
SELECT b.f1 FROM box_tbl b WHERE '(1,1,3,3)'::box ~= b.f1
== 027
-- center of box, left unary operator
SELECT @@(b1.f1) AS p
   FROM BOX_TBL b1
--
SELECT @@ b1.f1 AS p FROM box_tbl b1
== 028
-- wholly-contained
SELECT b1.*, b2.*
   FROM BOX_TBL b1, BOX_TBL b2
   WHERE b1.f1 @> b2.f1 and not b1.f1 ~= b2.f1
--
SELECT b1.*, b2.* FROM box_tbl b1, box_tbl b2 WHERE b1.f1 @> b2.f1 AND NOT b1.f1 ~= b2.f1
== 029
SELECT height(f1), width(f1) FROM BOX_TBL
--
SELECT height(f1), width(f1) FROM box_tbl
