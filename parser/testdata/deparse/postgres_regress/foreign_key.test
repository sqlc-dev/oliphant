--
ALTER TABLE fkpart2.fk_part DETACH PARTITION fkpart2.fk_part_1
== 850
alter table fkpart2.fk_part_1 drop constraint fkey
--
ALTER TABLE fkpart2.fk_part_1 DROP CONSTRAINT fkey
== 851
-- ok
alter table fkpart2.fk_part_1_1 drop constraint my_fkey
--
ALTER TABLE fkpart2.fk_part_1_1 DROP CONSTRAINT my_fkey
== 852
