with recursive search_graph(f, t, label, is_cycle, path) as (
	select *, false, array[row(g.f, g.t)] from graph g
	union all
	select g.*, row(g.f, g.t) = any(path), path || row(g.f, g.t)
	from graph g, search_graph sg
	where g.f = sg.t and not is_cycle
)
select * from search_graph
--
WITH RECURSIVE search_graph(f, t, label, is_cycle, path) AS (SELECT *, false, ARRAY[ROW(g.f, g.t)] FROM graph g UNION ALL SELECT g.*, ROW(g.f, g.t) = ANY(path), path || ROW(g.f, g.t) FROM graph g, search_graph sg WHERE g.f = sg.t AND NOT is_cycle) SELECT * FROM search_graph
== 077
-- UNION DISTINCT exercises row type hashing support
with recursive search_graph(f, t, label, is_cycle, path) as (
	select *, false, array[row(g.f, g.t)] from graph g
	union distinct
	select g.*, row(g.f, g.t) = any(path), path || row(g.f, g.t)
	from graph g, search_graph sg
	where g.f = sg.t and not is_cycle
)
select * from search_graph
--
WITH RECURSIVE search_graph(f, t, label, is_cycle, path) AS (SELECT *, false, ARRAY[ROW(g.f, g.t)] FROM graph g UNION SELECT g.*, ROW(g.f, g.t) = ANY(path), path || ROW(g.f, g.t) FROM graph g, search_graph sg WHERE g.f = sg.t AND NOT is_cycle) SELECT * FROM search_graph
