    return null;
  end;
$$
--
CREATE OR REPLACE FUNCTION dump_delete() RETURNS trigger LANGUAGE plpgsql AS $$
  begin
    raise notice 'trigger = %, old table = %',
                 TG_NAME,
                 (select string_agg(old_table::text, ', ' order by a) from old_table);
    return null;
  end;
$$
