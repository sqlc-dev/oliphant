CREATE TRIGGER check_fkeys2_fkey_restrict BEFORE DELETE OR UPDATE ON fkeys2 FOR EACH ROW EXECUTE FUNCTION check_foreign_key('1', 'restrict', 'pkey23', 'fkeys', 'fkey3')
