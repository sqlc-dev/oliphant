== 012
-- lexing of <=, >=, <>, != has a number of edge cases
-- (=> is tested elsewhere)

-- this is legal because ! is not allowed in sql ops
CREATE OPERATOR !=- (
   rightarg = int8,
   procedure = factorial
)
--
CREATE OPERATOR !=- (rightarg = int8, procedure = factorial)
== 013
