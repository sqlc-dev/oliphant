== 015
-- make sure lexer returns != as <> even in edge cases
SELECT 2 !=/**/ 1, 2 !=/**/ 2
--
SELECT 2 <> 1, 2 <> 2
== 016
SELECT 2 !=-- comment to be removed by psql
