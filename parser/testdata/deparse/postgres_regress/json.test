-- json_object

-- empty object, one dimension
SELECT json_object('{}')
--
SELECT pg_catalog."json_object"('{}')
== 384
-- empty object, two dimensions
SELECT json_object('{}', '{}')
--
SELECT pg_catalog."json_object"('{}', '{}')
== 385
-- one dimension
SELECT json_object('{a,1,b,2,3,NULL,"d e f","a b c"}')
--
SELECT pg_catalog."json_object"('{a,1,b,2,3,NULL,"d e f","a b c"}')
== 386
-- same but with two dimensions
SELECT json_object('{{a,1},{b,2},{3,NULL},{"d e f","a b c"}}')
--
SELECT pg_catalog."json_object"('{{a,1},{b,2},{3,NULL},{"d e f","a b c"}}')
== 387
-- odd number error
SELECT json_object('{a,b,c}')
--
SELECT pg_catalog."json_object"('{a,b,c}')
== 388
-- one column error
SELECT json_object('{{a},{b}}')
--
SELECT pg_catalog."json_object"('{{a},{b}}')
== 389
-- too many columns error
SELECT json_object('{{a,b,c},{b,c,d}}')
--
SELECT pg_catalog."json_object"('{{a,b,c},{b,c,d}}')
== 390
-- too many dimensions error
SELECT json_object('{{{a,b},{c,d}},{{b,c},{d,e}}}')
--
SELECT pg_catalog."json_object"('{{{a,b},{c,d}},{{b,c},{d,e}}}')
== 391
--two argument form of json_object

select json_object('{a,b,c,"d e f"}','{1,2,3,"a b c"}')
--
SELECT pg_catalog."json_object"('{a,b,c,"d e f"}', '{1,2,3,"a b c"}')
== 392
-- too many dimensions
SELECT json_object('{{a,1},{b,2},{3,NULL},{"d e f","a b c"}}', '{{a,1},{b,2},{3,NULL},{"d e f","a b c"}}')
--
SELECT pg_catalog."json_object"('{{a,1},{b,2},{3,NULL},{"d e f","a b c"}}', '{{a,1},{b,2},{3,NULL},{"d e f","a b c"}}')
== 393
-- mismatched dimensions

select json_object('{a,b,c,"d e f",g}','{1,2,3,"a b c"}')
--
SELECT pg_catalog."json_object"('{a,b,c,"d e f",g}', '{1,2,3,"a b c"}')
== 394
select json_object('{a,b,c,"d e f"}','{1,2,3,"a b c",g}')
--
SELECT pg_catalog."json_object"('{a,b,c,"d e f"}', '{1,2,3,"a b c",g}')
== 395
-- null key error

select json_object('{a,b,NULL,"d e f"}','{1,2,3,"a b c"}')
--
SELECT pg_catalog."json_object"('{a,b,NULL,"d e f"}', '{1,2,3,"a b c"}')
== 396
-- empty key is allowed

select json_object('{a,b,"","d e f"}','{1,2,3,"a b c"}')
--
SELECT pg_catalog."json_object"('{a,b,"","d e f"}', '{1,2,3,"a b c"}')
== 397
-- json_object_agg_unique requires unique keys
select json_object_agg_unique(mod(i,100), i) from generate_series(0, 199) i
--
SELECT json_object_agg_unique(mod(i, 100), i) FROM generate_series(0, 199) i
== 398
-- json_to_record and json_to_recordset

select * from json_to_record('{"a":1,"b":"foo","c":"bar"}')
    as x(a int, b text, d text)
--
SELECT * FROM json_to_record('{"a":1,"b":"foo","c":"bar"}') x (a int, b text, d text)
== 399
select * from json_to_recordset('[{"a":1,"b":"foo","d":false},{"a":2,"b":"bar","c":true}]')
    as x(a int, b text, c boolean)
--
SELECT * FROM json_to_recordset('[{"a":1,"b":"foo","d":false},{"a":2,"b":"bar","c":true}]') x (a int, b text, c boolean)
== 400
select * from json_to_recordset('[{"a":1,"b":{"d":"foo"},"c":true},{"a":2,"c":false,"b":{"d":"bar"}}]')
    as x(a int, b json, c boolean)
--
SELECT * FROM json_to_recordset('[{"a":1,"b":{"d":"foo"},"c":true},{"a":2,"c":false,"b":{"d":"bar"}}]') x (a int, b pg_catalog.json, c boolean)
== 401
select *, c is null as c_is_null
from json_to_record('{"a":1, "b":{"c":16, "d":2}, "x":8, "ca": ["1 2", 3], "ia": [[1,2],[3,4]], "r": {"a": "aaa", "b": 123}}'::json)
    as t(a int, b json, c text, x int, ca char(5)[], ia int[][], r jpop)
--
SELECT *, c IS NULL AS c_is_null FROM json_to_record('{"a":1, "b":{"c":16, "d":2}, "x":8, "ca": ["1 2", 3], "ia": [[1,2],[3,4]], "r": {"a": "aaa", "b": 123}}'::pg_catalog.json) t (a int, b pg_catalog.json, c text, x int, ca char(5)[], ia int[][], r jpop)
== 402
select *, c is null as c_is_null
from json_to_recordset('[{"a":1, "b":{"c":16, "d":2}, "x":8}]'::json)
    as t(a int, b json, c text, x int)
--
SELECT *, c IS NULL AS c_is_null FROM json_to_recordset('[{"a":1, "b":{"c":16, "d":2}, "x":8}]'::pg_catalog.json) t (a int, b pg_catalog.json, c text, x int)
== 403
select * from json_to_record('{"ia": null}') as x(ia _int4)
--
SELECT * FROM json_to_record('{"ia": null}') x (ia _int4)
== 404
select * from json_to_record('{"ia": 123}') as x(ia _int4)
--
SELECT * FROM json_to_record('{"ia": 123}') x (ia _int4)
== 405
select * from json_to_record('{"ia": [1, "2", null, 4]}') as x(ia _int4)
--
SELECT * FROM json_to_record('{"ia": [1, "2", null, 4]}') x (ia _int4)
== 406
select * from json_to_record('{"ia": [[1, 2], [3, 4]]}') as x(ia _int4)
--
SELECT * FROM json_to_record('{"ia": [[1, 2], [3, 4]]}') x (ia _int4)
== 407
select * from json_to_record('{"ia": [[1], 2]}') as x(ia _int4)
--
SELECT * FROM json_to_record('{"ia": [[1], 2]}') x (ia _int4)
== 408
select * from json_to_record('{"ia": [[1], [2, 3]]}') as x(ia _int4)
--
SELECT * FROM json_to_record('{"ia": [[1], [2, 3]]}') x (ia _int4)
== 409
select * from json_to_record('{"ia2": [1, 2, 3]}') as x(ia2 int[][])
--
SELECT * FROM json_to_record('{"ia2": [1, 2, 3]}') x (ia2 int[][])
== 410
select * from json_to_record('{"ia2": [[1, 2], [3, 4]]}') as x(ia2 int4[][])
--
SELECT * FROM json_to_record('{"ia2": [[1, 2], [3, 4]]}') x (ia2 int4[][])
== 411
select * from json_to_record('{"ia2": [[[1], [2], [3]]]}') as x(ia2 int4[][])
--
SELECT * FROM json_to_record('{"ia2": [[[1], [2], [3]]]}') x (ia2 int4[][])
== 412
select * from json_to_record('{"out": {"key": 1}}') as x(out json)
--
SELECT * FROM json_to_record('{"out": {"key": 1}}') x ("out" pg_catalog.json)
== 413
select * from json_to_record('{"out": [{"key": 1}]}') as x(out json)
--
SELECT * FROM json_to_record('{"out": [{"key": 1}]}') x ("out" pg_catalog.json)
== 414
select * from json_to_record('{"out": "{\"key\": 1}"}') as x(out json)
--
SELECT * FROM json_to_record(E'{"out": "{\\"key\\": 1}"}') x ("out" pg_catalog.json)
== 415
select * from json_to_record('{"out": {"key": 1}}') as x(out jsonb)
--
SELECT * FROM json_to_record('{"out": {"key": 1}}') x ("out" jsonb)
== 416
select * from json_to_record('{"out": [{"key": 1}]}') as x(out jsonb)
--
SELECT * FROM json_to_record('{"out": [{"key": 1}]}') x ("out" jsonb)
