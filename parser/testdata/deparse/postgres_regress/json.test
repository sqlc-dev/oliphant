== 424
select json_strip_nulls('[1,{"a":1,"b":null,"c":2},3]')
--
SELECT json_strip_nulls('[1,{"a":1,"b":null,"c":2},3]')
== 425
-- an empty object is not null and should not be stripped
select json_strip_nulls('{"a": {"b": null, "c": null}, "d": {} }')
--
SELECT json_strip_nulls('{"a": {"b": null, "c": null}, "d": {} }')
== 426
