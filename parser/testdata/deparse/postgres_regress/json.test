== 001
-- Strings.
SELECT '""'::json
--
SELECT '""'::pg_catalog.json
== 002
-- OK.
SELECT $$''$$::json
--
SELECT ''''''::pg_catalog.json
== 003
-- ERROR, single quotes are not allowed
SELECT '"abc"'::json
--
SELECT '"abc"'::pg_catalog.json
== 004
-- OK
SELECT '"abc'::json
--
SELECT '"abc'::pg_catalog.json
== 005
-- ERROR, quotes not closed
SELECT '"abc
def"'::json
--
SELECT '"abc
def"'::pg_catalog.json
== 006
-- ERROR, unescaped newline in string constant
SELECT '"\n\"\\"'::json
--
SELECT E'"\\n\\"\\\\"'::pg_catalog.json
== 007
-- OK, legal escapes
SELECT '"\v"'::json
--
SELECT E'"\\v"'::pg_catalog.json
== 008
-- ERROR, not a valid JSON escape

-- Check fast path for longer strings (at least 16 bytes long)
SELECT ('"'||repeat('.', 12)||'abc"')::json
--
SELECT (('"' || repeat('.', 12)) || 'abc"')::pg_catalog.json
== 009
-- OK
SELECT ('"'||repeat('.', 12)||'abc\n"')::json
--
SELECT (('"' || repeat('.', 12)) || E'abc\\n"')::pg_catalog.json
== 010
-- OK, legal escapes

-- Test various lengths of strings to validate SIMD processing to escape
-- special chars in the JSON.
SELECT row_to_json(j)::jsonb FROM (
  SELECT left(E'abcdefghijklmnopqrstuv"\twxyz012345678', a) AS a
  FROM generate_series(0,37) a
) j
--
SELECT row_to_json(j)::jsonb FROM (SELECT "left"('abcdefghijklmnopqrstuv"	wxyz012345678', a) AS a FROM generate_series(0, 37) a) j
== 011
-- see json_encoding test for input with unicode escapes

