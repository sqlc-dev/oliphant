-- Objects.
SELECT '{}'::json
--
SELECT '{}'::pg_catalog.json
== 028
-- OK
SELECT '{"abc"}'::json
--
SELECT '{"abc"}'::pg_catalog.json
== 029
-- ERROR, no value
