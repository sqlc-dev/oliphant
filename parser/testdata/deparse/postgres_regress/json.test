--
SELECT json_strip_nulls('1')
== 420
select json_strip_nulls('"a string"')
--
SELECT json_strip_nulls('"a string"')
== 421
select json_strip_nulls('null')
--
SELECT json_strip_nulls('null')
== 422
select json_strip_nulls('[1,2,null,3,4]')
--
SELECT json_strip_nulls('[1,2,null,3,4]')
== 423
