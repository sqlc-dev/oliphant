== 460
select json_to_tsvector('english', '{"a": "aaa in bbb", "b": 123, "c": 456, "d": true, "f": false, "g": null}'::json, '[]')
--
SELECT json_to_tsvector('english', '{"a": "aaa in bbb", "b": 123, "c": 456, "d": true, "f": false, "g": null}'::pg_catalog.json, '[]')
== 461
select json_to_tsvector('english', '{"a": "aaa in bbb", "b": 123, "c": 456, "d": true, "f": false, "g": null}'::json, 'null')
--
SELECT json_to_tsvector('english', '{"a": "aaa in bbb", "b": 123, "c": 456, "d": true, "f": false, "g": null}'::pg_catalog.json, 'null')
== 462
select json_to_tsvector('english', '{"a": "aaa in bbb", "b": 123, "c": 456, "d": true, "f": false, "g": null}'::json, '["all", null]')
--
SELECT json_to_tsvector('english', '{"a": "aaa in bbb", "b": 123, "c": 456, "d": true, "f": false, "g": null}'::pg_catalog.json, '["all", null]')
== 463
-- ts_headline for json
select ts_headline('{"a": "aaa bbb", "b": {"c": "ccc ddd fff", "c1": "ccc1 ddd1"}, "d": ["ggg hhh", "iii jjj"]}'::json, tsquery('bbb & ddd & hhh'))
--
SELECT ts_headline('{"a": "aaa bbb", "b": {"c": "ccc ddd fff", "c1": "ccc1 ddd1"}, "d": ["ggg hhh", "iii jjj"]}'::pg_catalog.json, tsquery('bbb & ddd & hhh'))
== 464
select ts_headline('english', '{"a": "aaa bbb", "b": {"c": "ccc ddd fff"}, "d": ["ggg hhh", "iii jjj"]}'::json, tsquery('bbb & ddd & hhh'))
--
SELECT ts_headline('english', '{"a": "aaa bbb", "b": {"c": "ccc ddd fff"}, "d": ["ggg hhh", "iii jjj"]}'::pg_catalog.json, tsquery('bbb & ddd & hhh'))
== 465
select ts_headline('{"a": "aaa bbb", "b": {"c": "ccc ddd fff", "c1": "ccc1 ddd1"}, "d": ["ggg hhh", "iii jjj"]}'::json, tsquery('bbb & ddd & hhh'), 'StartSel = <, StopSel = >')
--
SELECT ts_headline('{"a": "aaa bbb", "b": {"c": "ccc ddd fff", "c1": "ccc1 ddd1"}, "d": ["ggg hhh", "iii jjj"]}'::pg_catalog.json, tsquery('bbb & ddd & hhh'), 'StartSel = <, StopSel = >')
== 466
select ts_headline('english', '{"a": "aaa bbb", "b": {"c": "ccc ddd fff", "c1": "ccc1 ddd1"}, "d": ["ggg hhh", "iii jjj"]}'::json, tsquery('bbb & ddd & hhh'), 'StartSel = <, StopSel = >')
--
SELECT ts_headline('english', '{"a": "aaa bbb", "b": {"c": "ccc ddd fff", "c1": "ccc1 ddd1"}, "d": ["ggg hhh", "iii jjj"]}'::pg_catalog.json, tsquery('bbb & ddd & hhh'), 'StartSel = <, StopSel = >')
== 467
-- corner cases for ts_headline with json
select ts_headline('null'::json, tsquery('aaa & bbb'))
--
SELECT ts_headline('null'::pg_catalog.json, tsquery('aaa & bbb'))
== 468
select ts_headline('{}'::json, tsquery('aaa & bbb'))
--
SELECT ts_headline('{}'::pg_catalog.json, tsquery('aaa & bbb'))
== 469
select ts_headline('[]'::json, tsquery('aaa & bbb'))
--
SELECT ts_headline('[]'::pg_catalog.json, tsquery('aaa & bbb'))
