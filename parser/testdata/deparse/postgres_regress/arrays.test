-- Insert/update on a column that is array of composite

create temp table t1 (f1 int8_tbl[])
--
CREATE TEMPORARY TABLE t1 (f1 int8_tbl[])
== 445
insert into t1 (f1[5].q1) values(42)
--
INSERT INTO t1 (f1[5].q1) VALUES (42)
== 446
select * from t1
--
SELECT * FROM t1
== 447
update t1 set f1[5].q2 = 43
--
UPDATE t1 SET f1[5].q2 = 43
== 448
select * from t1
--
SELECT * FROM t1
== 449
-- Check that arrays of composites are safely detoasted when needed

create temp table src (f1 text)
--
CREATE TEMPORARY TABLE src (f1 text)
== 450
insert into src
  select string_agg(random()::text,'') from generate_series(1,10000)
--
INSERT INTO src SELECT string_agg(random()::text, '') FROM generate_series(1, 10000)
== 451
create type textandtext as (c1 text, c2 text)
--
CREATE TYPE textandtext AS (c1 text, c2 text)
== 452
create temp table dest (f1 textandtext[])
--
CREATE TEMPORARY TABLE dest (f1 textandtext[])
== 453
insert into dest select array[row(f1,f1)::textandtext] from src
--
INSERT INTO dest SELECT ARRAY[ROW(f1, f1)::textandtext] FROM src
== 454
select length(fipshash((f1[1]).c2)) from dest
--
SELECT length(fipshash((f1[1]).c2)) FROM dest
== 455
delete from src
--
DELETE FROM src
== 456
select length(fipshash((f1[1]).c2)) from dest
--
SELECT length(fipshash((f1[1]).c2)) FROM dest
== 457
truncate table src
--
TRUNCATE src
== 458
drop table src
--
DROP TABLE src
== 459
select length(fipshash((f1[1]).c2)) from dest
--
SELECT length(fipshash((f1[1]).c2)) FROM dest
== 460
drop table dest
--
DROP TABLE dest
== 461
drop type textandtext
--
DROP TYPE textandtext
== 462
-- Tests for polymorphic-array form of width_bucket()

-- this exercises the varwidth and float8 code paths
SELECT
    op,
    width_bucket(op::numeric, ARRAY[1, 3, 5, 10.0]::numeric[]) AS wb_n1,
    width_bucket(op::numeric, ARRAY[0, 5.5, 9.99]::numeric[]) AS wb_n2,
    width_bucket(op::numeric, ARRAY[-6, -5, 2.0]::numeric[]) AS wb_n3,
    width_bucket(op::float8, ARRAY[1, 3, 5, 10.0]::float8[]) AS wb_f1,
    width_bucket(op::float8, ARRAY[0, 5.5, 9.99]::float8[]) AS wb_f2,
    width_bucket(op::float8, ARRAY[-6, -5, 2.0]::float8[]) AS wb_f3
FROM (VALUES
  (-5.2),
  (-0.0000000001),
  (0.000000000001),
  (1),
  (1.99999999999999),
  (2),
  (2.00000000000001),
  (3),
  (4),
  (4.5),
  (5),
  (5.5),
  (6),
  (7),
  (8),
  (9),
  (9.99999999999999),
  (10),
  (10.0000000000001)
) v(op)
--
SELECT op, width_bucket(op::numeric, ARRAY[1, 3, 5, 10.0]::numeric[]) AS wb_n1, width_bucket(op::numeric, ARRAY[0, 5.5, 9.99]::numeric[]) AS wb_n2, width_bucket(op::numeric, ARRAY[-6, -5, 2.0]::numeric[]) AS wb_n3, width_bucket(op::float8, ARRAY[1, 3, 5, 10.0]::float8[]) AS wb_f1, width_bucket(op::float8, ARRAY[0, 5.5, 9.99]::float8[]) AS wb_f2, width_bucket(op::float8, ARRAY[-6, -5, 2.0]::float8[]) AS wb_f3 FROM (VALUES (-5.2), (-0.0000000001), (0.000000000001), (1), (1.99999999999999), (2), (2.00000000000001), (3), (4), (4.5), (5), (5.5), (6), (7), (8), (9), (9.99999999999999), (10), (10.0000000000001)) v(op)
== 463
-- ensure float8 path handles NaN properly
SELECT
    op,
    width_bucket(op, ARRAY[1, 3, 9, 'NaN', 'NaN']::float8[]) AS wb
FROM (VALUES
  (-5.2::float8),
  (4::float8),
  (77::float8),
  ('NaN'::float8)
) v(op)
--
SELECT op, width_bucket(op, ARRAY[1, 3, 9, 'NaN', 'NaN']::float8[]) AS wb FROM (VALUES (- (5.2)::float8), (4::float8), (77::float8), ('NaN'::float8)) v(op)
== 464
-- these exercise the generic fixed-width code path
SELECT
    op,
    width_bucket(op, ARRAY[1, 3, 5, 10]) AS wb_1
FROM generate_series(0,11) as op
--
SELECT op, width_bucket(op, ARRAY[1, 3, 5, 10]) AS wb_1 FROM generate_series(0, 11) op
== 465
SELECT width_bucket(now(),
                    array['yesterday', 'today', 'tomorrow']::timestamptz[])
--
SELECT width_bucket(now(), ARRAY['yesterday', 'today', 'tomorrow']::timestamptz[])
== 466
-- corner cases
SELECT width_bucket(5, ARRAY[3])
--
SELECT width_bucket(5, ARRAY[3])
== 467
SELECT width_bucket(5, '{}')
--
SELECT width_bucket(5, '{}')
== 468
-- error cases
SELECT width_bucket('5'::text, ARRAY[3, 4]::integer[])
--
SELECT width_bucket('5'::text, ARRAY[3, 4]::int[])
== 469
SELECT width_bucket(5, ARRAY[3, 4, NULL])
--
SELECT width_bucket(5, ARRAY[3, 4, NULL])
== 470
SELECT width_bucket(5, ARRAY[ARRAY[1, 2], ARRAY[3, 4]])
--
SELECT width_bucket(5, ARRAY[ARRAY[1, 2], ARRAY[3, 4]])
== 471
-- trim_array

SELECT arr, trim_array(arr, 2)
FROM
(VALUES ('{1,2,3,4,5,6}'::bigint[]),
        ('{1,2}'),
        ('[10:16]={1,2,3,4,5,6,7}'),
        ('[-15:-10]={1,2,3,4,5,6}'),
        ('{{1,10},{2,20},{3,30},{4,40}}')) v(arr)
--
SELECT arr, trim_array(arr, 2) FROM (VALUES ('{1,2,3,4,5,6}'::bigint[]), ('{1,2}'), ('[10:16]={1,2,3,4,5,6,7}'), ('[-15:-10]={1,2,3,4,5,6}'), ('{{1,10},{2,20},{3,30},{4,40}}')) v(arr)
== 472
SELECT trim_array(ARRAY[1, 2, 3], -1)
--
SELECT trim_array(ARRAY[1, 2, 3], -1)
== 473
-- fail
SELECT trim_array(ARRAY[1, 2, 3], 10)
--
SELECT trim_array(ARRAY[1, 2, 3], 10)
== 474
-- fail
SELECT trim_array(ARRAY[]::int[], 1)
--
SELECT trim_array(ARRAY[]::int[], 1)
== 475
-- fail

