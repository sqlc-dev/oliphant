== 001
|--
-- SELECT_IMPLICIT
-- Test cases for queries with ordering terms missing from the target list.
-- This used to be called "junkfilter.sql".
-- The parser uses the term "resjunk" to handle these cases.
-- - thomas 1998-07-09
|--

-- load test data
CREATE TABLE test_missing_target (a int, b int, c char(8), d char)
--
CREATE TABLE test_missing_target (a int, b int, c char(8), d char(1))
== 002
INSERT INTO test_missing_target VALUES (0, 1, 'XXXX', 'A')
--
INSERT INTO test_missing_target VALUES (0, 1, 'XXXX', 'A')
== 003
INSERT INTO test_missing_target VALUES (1, 2, 'ABAB', 'b')
--
INSERT INTO test_missing_target VALUES (1, 2, 'ABAB', 'b')
== 004
INSERT INTO test_missing_target VALUES (2, 2, 'ABAB', 'c')
--
INSERT INTO test_missing_target VALUES (2, 2, 'ABAB', 'c')
== 005
INSERT INTO test_missing_target VALUES (3, 3, 'BBBB', 'D')
--
INSERT INTO test_missing_target VALUES (3, 3, 'BBBB', 'D')
== 006
INSERT INTO test_missing_target VALUES (4, 3, 'BBBB', 'e')
--
INSERT INTO test_missing_target VALUES (4, 3, 'BBBB', 'e')
== 007
INSERT INTO test_missing_target VALUES (5, 3, 'bbbb', 'F')
--
INSERT INTO test_missing_target VALUES (5, 3, 'bbbb', 'F')
== 008
INSERT INTO test_missing_target VALUES (6, 4, 'cccc', 'g')
--
INSERT INTO test_missing_target VALUES (6, 4, 'cccc', 'g')
== 009
INSERT INTO test_missing_target VALUES (7, 4, 'cccc', 'h')
--
INSERT INTO test_missing_target VALUES (7, 4, 'cccc', 'h')
== 010
INSERT INTO test_missing_target VALUES (8, 4, 'CCCC', 'I')
--
INSERT INTO test_missing_target VALUES (8, 4, 'CCCC', 'I')
== 011
INSERT INTO test_missing_target VALUES (9, 4, 'CCCC', 'j')
--
INSERT INTO test_missing_target VALUES (9, 4, 'CCCC', 'j')
== 012
--   w/ existing GROUP BY target
SELECT c, count(*) FROM test_missing_target GROUP BY test_missing_target.c ORDER BY c
--
SELECT c, count(*) FROM test_missing_target GROUP BY test_missing_target.c ORDER BY c
== 013
--   w/o existing GROUP BY target using a relation name in GROUP BY clause
SELECT count(*) FROM test_missing_target GROUP BY test_missing_target.c ORDER BY c
--
SELECT count(*) FROM test_missing_target GROUP BY test_missing_target.c ORDER BY c
== 014
--   w/o existing GROUP BY target and w/o existing a different ORDER BY target
--   failure expected
SELECT count(*) FROM test_missing_target GROUP BY a ORDER BY b
--
SELECT count(*) FROM test_missing_target GROUP BY a ORDER BY b
== 015
--   w/o existing GROUP BY target and w/o existing same ORDER BY target
SELECT count(*) FROM test_missing_target GROUP BY b ORDER BY b
--
SELECT count(*) FROM test_missing_target GROUP BY b ORDER BY b
== 016
--   w/ existing GROUP BY target using a relation name in target
SELECT test_missing_target.b, count(*)
  FROM test_missing_target GROUP BY b ORDER BY b
--
SELECT test_missing_target.b, count(*) FROM test_missing_target GROUP BY b ORDER BY b
== 017
--   w/o existing GROUP BY target
SELECT c FROM test_missing_target ORDER BY a
--
SELECT c FROM test_missing_target ORDER BY a
== 018
--   w/o existing ORDER BY target
SELECT count(*) FROM test_missing_target GROUP BY b ORDER BY b desc
--
SELECT count(*) FROM test_missing_target GROUP BY b ORDER BY b DESC
== 019
--   group using reference number
SELECT count(*) FROM test_missing_target ORDER BY 1 desc
--
SELECT count(*) FROM test_missing_target ORDER BY 1 DESC
== 020
--   order using reference number
SELECT c, count(*) FROM test_missing_target GROUP BY 1 ORDER BY 1
--
SELECT c, count(*) FROM test_missing_target GROUP BY 1 ORDER BY 1
== 021
--   group using reference number out of range
--   failure expected
SELECT c, count(*) FROM test_missing_target GROUP BY 3
--
SELECT c, count(*) FROM test_missing_target GROUP BY 3
== 022
--   group w/o existing GROUP BY and ORDER BY target under ambiguous condition
--   failure expected
SELECT count(*) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY b ORDER BY b
--
SELECT count(*) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY b ORDER BY b
== 023
--   order w/ target under ambiguous condition
--   failure NOT expected
SELECT a, a FROM test_missing_target
	ORDER BY a
--
SELECT a, a FROM test_missing_target ORDER BY a
== 024
--   order expression w/ target under ambiguous condition
--   failure NOT expected
SELECT a/2, a/2 FROM test_missing_target
	ORDER BY a/2
--
SELECT a / 2, a / 2 FROM test_missing_target ORDER BY a / 2
== 025
--   group expression w/ target under ambiguous condition
--   failure NOT expected
SELECT a/2, a/2 FROM test_missing_target
	GROUP BY a/2 ORDER BY a/2
--
SELECT a / 2, a / 2 FROM test_missing_target GROUP BY a / 2 ORDER BY a / 2
== 026
--   group w/ existing GROUP BY target under ambiguous condition
SELECT x.b, count(*) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b ORDER BY x.b
--
SELECT x.b, count(*) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY x.b ORDER BY x.b
== 027
--   group w/o existing GROUP BY target under ambiguous condition
SELECT count(*) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b ORDER BY x.b
--
SELECT count(*) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY x.b ORDER BY x.b
== 028
--   group w/o existing GROUP BY target under ambiguous condition
--   into a table
CREATE TABLE test_missing_target2 AS
SELECT count(*)
FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b ORDER BY x.b
--
CREATE TABLE test_missing_target2 AS SELECT count(*) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY x.b ORDER BY x.b
== 029
SELECT * FROM test_missing_target2
--
SELECT * FROM test_missing_target2
== 030
--  Functions and expressions

--   w/ existing GROUP BY target
SELECT a%2, count(b) FROM test_missing_target
GROUP BY test_missing_target.a%2
ORDER BY test_missing_target.a%2
--
SELECT a % 2, count(b) FROM test_missing_target GROUP BY test_missing_target.a % 2 ORDER BY test_missing_target.a % 2
== 031
--   w/o existing GROUP BY target using a relation name in GROUP BY clause
SELECT count(c) FROM test_missing_target
GROUP BY lower(test_missing_target.c)
ORDER BY lower(test_missing_target.c)
--
SELECT count(c) FROM test_missing_target GROUP BY lower(test_missing_target.c) ORDER BY lower(test_missing_target.c)
== 032
--   w/o existing GROUP BY target and w/o existing a different ORDER BY target
--   failure expected
SELECT count(a) FROM test_missing_target GROUP BY a ORDER BY b
--
SELECT count(a) FROM test_missing_target GROUP BY a ORDER BY b
== 033
--   w/o existing GROUP BY target and w/o existing same ORDER BY target
SELECT count(b) FROM test_missing_target GROUP BY b/2 ORDER BY b/2
--
SELECT count(b) FROM test_missing_target GROUP BY b / 2 ORDER BY b / 2
== 034
--   w/ existing GROUP BY target using a relation name in target
SELECT lower(test_missing_target.c), count(c)
  FROM test_missing_target GROUP BY lower(c) ORDER BY lower(c)
--
SELECT lower(test_missing_target.c), count(c) FROM test_missing_target GROUP BY lower(c) ORDER BY lower(c)
== 035
--   w/o existing GROUP BY target
SELECT a FROM test_missing_target ORDER BY upper(d)
--
SELECT a FROM test_missing_target ORDER BY upper(d)
== 036
--   w/o existing ORDER BY target
SELECT count(b) FROM test_missing_target
	GROUP BY (b + 1) / 2 ORDER BY (b + 1) / 2 desc
--
SELECT count(b) FROM test_missing_target GROUP BY (b + 1) / 2 ORDER BY (b + 1) / 2 DESC
== 037
--   group w/o existing GROUP BY and ORDER BY target under ambiguous condition
--   failure expected
SELECT count(x.a) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY b/2 ORDER BY b/2
--
SELECT count(x.a) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY b / 2 ORDER BY b / 2
== 038
--   group w/ existing GROUP BY target under ambiguous condition
SELECT x.b/2, count(x.b) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b/2 ORDER BY x.b/2
--
SELECT x.b / 2, count(x.b) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY x.b / 2 ORDER BY x.b / 2
== 039
--   group w/o existing GROUP BY target under ambiguous condition
--   failure expected due to ambiguous b in count(b)
SELECT count(b) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b/2
--
SELECT count(b) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY x.b / 2
== 040
--   group w/o existing GROUP BY target under ambiguous condition
--   into a table
CREATE TABLE test_missing_target3 AS
SELECT count(x.b)
FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b/2 ORDER BY x.b/2
--
CREATE TABLE test_missing_target3 AS SELECT count(x.b) FROM test_missing_target x, test_missing_target y WHERE x.a = y.a GROUP BY x.b / 2 ORDER BY x.b / 2
== 041
SELECT * FROM test_missing_target3
--
SELECT * FROM test_missing_target3
== 042
