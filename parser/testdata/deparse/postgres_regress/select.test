    order by i asc limit 1))) bar (i)
  where onek.unique1 = bar.i
--
SELECT * FROM onek, (VALUES ((SELECT i FROM (VALUES (10000), (2), (389), (1000), (2000), ((SELECT 10029))) foo(i) ORDER BY i ASC LIMIT 1))) bar(i) WHERE onek.unique1 = bar.i
