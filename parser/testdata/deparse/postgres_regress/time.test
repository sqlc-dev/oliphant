|--
-- TIME simple math
|--
-- We now make a distinction between time and intervals,
-- and adding two times together makes no sense at all.
-- Leave in one query to show that it is rejected,
-- and do the rest of the testing in horology.sql
-- where we do mixed-type arithmetic. - thomas 2000-12-02

SELECT f1 + time '00:01' AS "Illegal" FROM TIME_TBL
--
SELECT f1 + '00:01'::time AS "Illegal" FROM time_tbl
== 032
|--
-- test EXTRACT
|--
SELECT EXTRACT(MICROSECOND FROM TIME '2020-05-26 13:30:25.575401')
--
SELECT extract ('microsecond' FROM '2020-05-26 13:30:25.575401'::time)
== 033
SELECT EXTRACT(MILLISECOND FROM TIME '2020-05-26 13:30:25.575401')
--
SELECT extract ('millisecond' FROM '2020-05-26 13:30:25.575401'::time)
== 034
SELECT EXTRACT(SECOND      FROM TIME '2020-05-26 13:30:25.575401')
--
SELECT extract ('second' FROM '2020-05-26 13:30:25.575401'::time)
== 035
