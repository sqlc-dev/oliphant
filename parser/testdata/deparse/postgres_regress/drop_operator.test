== 001
CREATE OPERATOR === (
        PROCEDURE = int8eq,
        LEFTARG = bigint,
        RIGHTARG = bigint,
        COMMUTATOR = ===
)
--
CREATE OPERATOR === (procedure = int8eq, leftarg = bigint, rightarg = bigint, commutator = ===)
== 002
CREATE OPERATOR !== (
        PROCEDURE = int8ne,
        LEFTARG = bigint,
        RIGHTARG = bigint,
        NEGATOR = ===,
        COMMUTATOR = !==
)
--
CREATE OPERATOR !== (procedure = int8ne, leftarg = bigint, rightarg = bigint, negator = ===, commutator = !==)
== 003
DROP OPERATOR !==(bigint, bigint)
--
DROP OPERATOR !==(bigint, bigint)
== 004
SELECT  ctid, oprcom
FROM    pg_catalog.pg_operator fk
WHERE   oprcom != 0 AND
        NOT EXISTS(SELECT 1 FROM pg_catalog.pg_operator pk WHERE pk.oid = fk.oprcom)
--
SELECT ctid, oprcom FROM pg_catalog.pg_operator fk WHERE oprcom <> 0 AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_operator pk WHERE pk.oid = fk.oprcom)
== 005
SELECT  ctid, oprnegate
FROM    pg_catalog.pg_operator fk
WHERE   oprnegate != 0 AND
        NOT EXISTS(SELECT 1 FROM pg_catalog.pg_operator pk WHERE pk.oid = fk.oprnegate)
--
SELECT ctid, oprnegate FROM pg_catalog.pg_operator fk WHERE oprnegate <> 0 AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_operator pk WHERE pk.oid = fk.oprnegate)
== 006
DROP OPERATOR ===(bigint, bigint)
--
DROP OPERATOR ===(bigint, bigint)
== 007
CREATE OPERATOR <| (
        PROCEDURE = int8lt,
        LEFTARG = bigint,
        RIGHTARG = bigint
)
--
CREATE OPERATOR <| (procedure = int8lt, leftarg = bigint, rightarg = bigint)
== 008
CREATE OPERATOR |> (
        PROCEDURE = int8gt,
        LEFTARG = bigint,
        RIGHTARG = bigint,
        NEGATOR = <|,
        COMMUTATOR = <|
)
--
CREATE OPERATOR |> (procedure = int8gt, leftarg = bigint, rightarg = bigint, negator = <|, commutator = <|)
== 009
DROP OPERATOR |>(bigint, bigint)
--
DROP OPERATOR |>(bigint, bigint)
