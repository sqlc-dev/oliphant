== 001
|--
-- encoding-sensitive tests for json and jsonb
|--

-- We provide expected-results files for UTF8 (json_encoding.out)
-- and for SQL_ASCII (json_encoding_1.out).  Skip otherwise.
SELECT getdatabaseencoding() NOT IN ('UTF8', 'SQL_ASCII')
       AS skip_test
--
SELECT getdatabaseencoding() NOT IN ('UTF8', 'SQL_ASCII') AS skip_test
== 002
SELECT getdatabaseencoding()
--
SELECT getdatabaseencoding()
== 003
-- just to label the results files

-- first json

-- basic unicode input
SELECT '"\u"'::json
--
SELECT E'"\\u"'::pg_catalog.json
== 004
-- ERROR, incomplete escape
SELECT '"\u00"'::json
--
SELECT E'"\\u00"'::pg_catalog.json
== 005
-- ERROR, incomplete escape
SELECT '"\u000g"'::json
--
SELECT E'"\\u000g"'::pg_catalog.json
== 006
-- ERROR, g is not a hex digit
SELECT '"\u0000"'::json
--
SELECT E'"\\u0000"'::pg_catalog.json
== 007
-- OK, legal escape
SELECT '"\uaBcD"'::json
--
SELECT E'"\\uaBcD"'::pg_catalog.json
== 008
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

select json '{ "a":  "\ud83d\ude04\ud83d\udc36" }' -> 'a' as correct_in_utf8
--
SELECT E'{ "a":  "\\ud83d\\ude04\\ud83d\\udc36" }'::pg_catalog.json -> 'a' AS correct_in_utf8
== 009
select json '{ "a":  "\ud83d\ud83d" }' -> 'a'
--
SELECT E'{ "a":  "\\ud83d\\ud83d" }'::pg_catalog.json -> 'a'
== 010
-- 2 high surrogates in a row
select json '{ "a":  "\ude04\ud83d" }' -> 'a'
--
SELECT E'{ "a":  "\\ude04\\ud83d" }'::pg_catalog.json -> 'a'
== 011
-- surrogates in wrong order
select json '{ "a":  "\ud83dX" }' -> 'a'
--
SELECT E'{ "a":  "\\ud83dX" }'::pg_catalog.json -> 'a'
== 012
-- orphan high surrogate
select json '{ "a":  "\ude04X" }' -> 'a'
--
SELECT E'{ "a":  "\\ude04X" }'::pg_catalog.json -> 'a'
== 013
-- orphan low surrogate

--handling of simple unicode escapes

select json '{ "a":  "the Copyright \u00a9 sign" }' as correct_in_utf8
--
SELECT E'{ "a":  "the Copyright \\u00a9 sign" }'::pg_catalog.json AS correct_in_utf8
== 014
select json '{ "a":  "dollar \u0024 character" }' as correct_everywhere
--
SELECT E'{ "a":  "dollar \\u0024 character" }'::pg_catalog.json AS correct_everywhere
== 015
select json '{ "a":  "dollar \\u0024 character" }' as not_an_escape
--
SELECT E'{ "a":  "dollar \\\\u0024 character" }'::pg_catalog.json AS not_an_escape
== 016
select json '{ "a":  "null \u0000 escape" }' as not_unescaped
--
SELECT E'{ "a":  "null \\u0000 escape" }'::pg_catalog.json AS not_unescaped
== 017
select json '{ "a":  "null \\u0000 escape" }' as not_an_escape
--
SELECT E'{ "a":  "null \\\\u0000 escape" }'::pg_catalog.json AS not_an_escape
== 018
select json '{ "a":  "the Copyright \u00a9 sign" }' ->> 'a' as correct_in_utf8
--
SELECT E'{ "a":  "the Copyright \\u00a9 sign" }'::pg_catalog.json ->> 'a' AS correct_in_utf8
== 019
select json '{ "a":  "dollar \u0024 character" }' ->> 'a' as correct_everywhere
--
SELECT E'{ "a":  "dollar \\u0024 character" }'::pg_catalog.json ->> 'a' AS correct_everywhere
== 020
select json '{ "a":  "dollar \\u0024 character" }' ->> 'a' as not_an_escape
--
SELECT E'{ "a":  "dollar \\\\u0024 character" }'::pg_catalog.json ->> 'a' AS not_an_escape
== 021
select json '{ "a":  "null \u0000 escape" }' ->> 'a' as fails
--
SELECT E'{ "a":  "null \\u0000 escape" }'::pg_catalog.json ->> 'a' AS fails
== 022
select json '{ "a":  "null \\u0000 escape" }' ->> 'a' as not_an_escape
--
SELECT E'{ "a":  "null \\\\u0000 escape" }'::pg_catalog.json ->> 'a' AS not_an_escape
== 023
-- then jsonb

-- basic unicode input
SELECT '"\u"'::jsonb
--
SELECT E'"\\u"'::jsonb
== 024
-- ERROR, incomplete escape
SELECT '"\u00"'::jsonb
--
SELECT E'"\\u00"'::jsonb
== 025
-- ERROR, incomplete escape
SELECT '"\u000g"'::jsonb
--
SELECT E'"\\u000g"'::jsonb
== 026
-- ERROR, g is not a hex digit
SELECT '"\u0045"'::jsonb
--
SELECT E'"\\u0045"'::jsonb
== 027
-- OK, legal escape
SELECT '"\u0000"'::jsonb
--
SELECT E'"\\u0000"'::jsonb
== 028
-- ERROR, we don't support U+0000
-- use octet_length here so we don't get an odd unicode char in the
-- output
SELECT octet_length('"\uaBcD"'::jsonb::text)
--
SELECT octet_length(E'"\\uaBcD"'::jsonb::text)
== 029
-- OK, uppercase and lower case both OK

-- handling of unicode surrogate pairs

SELECT octet_length((jsonb '{ "a":  "\ud83d\ude04\ud83d\udc36" }' -> 'a')::text) AS correct_in_utf8
--
SELECT octet_length((E'{ "a":  "\\ud83d\\ude04\\ud83d\\udc36" }'::jsonb -> 'a')::text) AS correct_in_utf8
== 030
SELECT jsonb '{ "a":  "\ud83d\ud83d" }' -> 'a'
--
SELECT E'{ "a":  "\\ud83d\\ud83d" }'::jsonb -> 'a'
== 031
-- 2 high surrogates in a row
SELECT jsonb '{ "a":  "\ude04\ud83d" }' -> 'a'
--
SELECT E'{ "a":  "\\ude04\\ud83d" }'::jsonb -> 'a'
== 032
-- surrogates in wrong order
SELECT jsonb '{ "a":  "\ud83dX" }' -> 'a'
--
SELECT E'{ "a":  "\\ud83dX" }'::jsonb -> 'a'
== 033
-- orphan high surrogate
SELECT jsonb '{ "a":  "\ude04X" }' -> 'a'
--
SELECT E'{ "a":  "\\ude04X" }'::jsonb -> 'a'
== 034
-- orphan low surrogate

-- handling of simple unicode escapes

SELECT jsonb '{ "a":  "the Copyright \u00a9 sign" }' as correct_in_utf8
--
SELECT E'{ "a":  "the Copyright \\u00a9 sign" }'::jsonb AS correct_in_utf8
== 035
SELECT jsonb '{ "a":  "dollar \u0024 character" }' as correct_everywhere
--
SELECT E'{ "a":  "dollar \\u0024 character" }'::jsonb AS correct_everywhere
== 036
SELECT jsonb '{ "a":  "dollar \\u0024 character" }' as not_an_escape
--
SELECT E'{ "a":  "dollar \\\\u0024 character" }'::jsonb AS not_an_escape
== 037
SELECT jsonb '{ "a":  "null \u0000 escape" }' as fails
--
SELECT E'{ "a":  "null \\u0000 escape" }'::jsonb AS fails
== 038
SELECT jsonb '{ "a":  "null \\u0000 escape" }' as not_an_escape
--
SELECT E'{ "a":  "null \\\\u0000 escape" }'::jsonb AS not_an_escape
== 039
SELECT jsonb '{ "a":  "the Copyright \u00a9 sign" }' ->> 'a' as correct_in_utf8
--
SELECT E'{ "a":  "the Copyright \\u00a9 sign" }'::jsonb ->> 'a' AS correct_in_utf8
== 040
SELECT jsonb '{ "a":  "dollar \u0024 character" }' ->> 'a' as correct_everywhere
--
SELECT E'{ "a":  "dollar \\u0024 character" }'::jsonb ->> 'a' AS correct_everywhere
== 041
SELECT jsonb '{ "a":  "dollar \\u0024 character" }' ->> 'a' as not_an_escape
--
SELECT E'{ "a":  "dollar \\\\u0024 character" }'::jsonb ->> 'a' AS not_an_escape
== 042
SELECT jsonb '{ "a":  "null \u0000 escape" }' ->> 'a' as fails
--
SELECT E'{ "a":  "null \\u0000 escape" }'::jsonb ->> 'a' AS fails
== 043
SELECT jsonb '{ "a":  "null \\u0000 escape" }' ->> 'a' as not_an_escape
--
SELECT E'{ "a":  "null \\\\u0000 escape" }'::jsonb ->> 'a' AS not_an_escape
== 044
-- soft error for input-time failure

select * from pg_input_error_info('{ "a":  "\ud83d\ude04\ud83d\udc36" }', 'jsonb')
--
SELECT * FROM pg_input_error_info(E'{ "a":  "\\ud83d\\ude04\\ud83d\\udc36" }', 'jsonb')
