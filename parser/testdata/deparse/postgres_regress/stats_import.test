== 001
CREATE SCHEMA stats_import
--
CREATE SCHEMA stats_import
== 002
CREATE TYPE stats_import.complex_type AS (
    a integer,
    b real,
    c text,
    d date,
    e jsonb)
--
CREATE TYPE stats_import.complex_type AS (a int, b real, c text, d date, e jsonb)
== 003
CREATE TABLE stats_import.test(
    id INTEGER PRIMARY KEY,
    name text,
    comp stats_import.complex_type,
    arange int4range,
    tags text[]
) WITH (autovacuum_enabled = false)
--
CREATE TABLE stats_import.test (id int PRIMARY KEY, name text, comp stats_import.complex_type, arange int4range, tags text[]) WITH (autovacuum_enabled=false)
== 004
SELECT
    pg_catalog.pg_restore_relation_stats(
        'schemaname', 'stats_import',
        'relname', 'test',
        'relpages', 18::integer,
        'reltuples', 21::real,
        'relallvisible', 24::integer,
	'relallfrozen', 27::integer)
--
SELECT pg_catalog.pg_restore_relation_stats('schemaname', 'stats_import', 'relname', 'test', 'relpages', 18::int, 'reltuples', 21::real, 'relallvisible', 24::int, 'relallfrozen', 27::int)
== 005
-- CREATE INDEX on a table with autovac disabled should not overwrite
