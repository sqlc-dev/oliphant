|--
-- Test behavior of both volatile and stable functions inside a cursor;
-- in particular we want to see what happens during commit of a holdable
-- cursor
|--

create temp table tt1(f1 int)
--
CREATE TEMPORARY TABLE tt1 (f1 int)
== 128
create function count_tt1_v() returns int8 as
'select count(*) from tt1' language sql volatile
--
CREATE FUNCTION count_tt1_v() RETURNS int8 AS $$select count(*) from tt1$$ LANGUAGE sql VOLATILE
== 129
create function count_tt1_s() returns int8 as
'select count(*) from tt1' language sql stable
--
CREATE FUNCTION count_tt1_s() RETURNS int8 AS $$select count(*) from tt1$$ LANGUAGE sql STABLE
== 130
begin
--
BEGIN
== 131
insert into tt1 values(1)
--
INSERT INTO tt1 VALUES (1)
== 132
declare c1 cursor for select count_tt1_v(), count_tt1_s()
--
DECLARE c1 CURSOR FOR SELECT count_tt1_v(), count_tt1_s()
== 133
insert into tt1 values(2)
--
INSERT INTO tt1 VALUES (2)
== 134
fetch all from c1
--
FETCH ALL c1
== 135
rollback
--
ROLLBACK
== 136
begin
--
BEGIN
== 137
insert into tt1 values(1)
--
INSERT INTO tt1 VALUES (1)
== 138
declare c2 cursor with hold for select count_tt1_v(), count_tt1_s()
--
