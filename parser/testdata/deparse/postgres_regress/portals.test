|--
-- NO SCROLL disallows backward fetching
|--

BEGIN
--
BEGIN
== 087
DECLARE foo24 NO SCROLL CURSOR FOR SELECT * FROM tenk1 ORDER BY unique2
--
DECLARE foo24 NO SCROLL CURSOR FOR SELECT * FROM tenk1 ORDER BY unique2
== 088
FETCH 1 FROM foo24
--
FETCH foo24
== 089
FETCH BACKWARD 1 FROM foo24
--
FETCH PRIOR foo24
== 090
-- should fail

END
--
COMMIT
== 091
BEGIN
--
BEGIN
== 092
DECLARE foo24 NO SCROLL CURSOR FOR SELECT * FROM tenk1 ORDER BY unique2
--
DECLARE foo24 NO SCROLL CURSOR FOR SELECT * FROM tenk1 ORDER BY unique2
== 093
FETCH 1 FROM foo24
--
FETCH foo24
== 094
FETCH ABSOLUTE 2 FROM foo24
--
FETCH ABSOLUTE 2 foo24
== 095
-- allowed

FETCH ABSOLUTE 1 FROM foo24
--
FETCH FIRST foo24
== 096
-- should fail

END
--
COMMIT
== 097
