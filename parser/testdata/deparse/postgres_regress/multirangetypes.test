== 001
-- Tests for multirange data types.

|--
-- test input parser
|--

-- negative tests; should fail
select ''::textmultirange
--
SELECT ''::textmultirange
== 002
select '{,}'::textmultirange
--
SELECT '{,}'::textmultirange
== 003
select '{(,)}.'::textmultirange
--
SELECT '{(,)}.'::textmultirange
== 004
select '{[a,c),}'::textmultirange
--
SELECT '{[a,c),}'::textmultirange
== 005
select '{,[a,c)}'::textmultirange
--
SELECT '{,[a,c)}'::textmultirange
== 006
select '{-[a,z)}'::textmultirange
--
SELECT '{-[a,z)}'::textmultirange
== 007
select '{[a,z) - }'::textmultirange
--
SELECT '{[a,z) - }'::textmultirange
== 008
select '{(",a)}'::textmultirange
--
SELECT '{(",a)}'::textmultirange
== 009
select '{(,,a)}'::textmultirange
--
SELECT '{(,,a)}'::textmultirange
== 010
select '{(),a)}'::textmultirange
--
SELECT '{(),a)}'::textmultirange
== 011
select '{(a,))}'::textmultirange
--
SELECT '{(a,))}'::textmultirange
== 012
select '{(],a)}'::textmultirange
--
SELECT '{(],a)}'::textmultirange
== 013
select '{(a,])}'::textmultirange
--
SELECT '{(a,])}'::textmultirange
== 014
select '{[z,a]}'::textmultirange
--
SELECT '{[z,a]}'::textmultirange
== 015
