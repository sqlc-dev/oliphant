-- Check that DEFAULT expressions in SQL/JSON functions use the same collation
-- as the RETURNING type.  Mismatched collations should raise an error.
CREATE DOMAIN d1 AS text COLLATE case_insensitive
--
CREATE DOMAIN d1 AS text COLLATE case_insensitive
== 487
CREATE DOMAIN d2 AS text COLLATE "C"
--
CREATE DOMAIN d2 AS text COLLATE "C"
== 488
SELECT JSON_VALUE('{"a": "A"}', '$.a' RETURNING d1 DEFAULT ('C' COLLATE "C") COLLATE case_insensitive ON EMPTY) = 'a'
--
SELECT JSON_VALUE('{"a": "A"}' , '$.a' RETURNING d1  DEFAULT 'C' COLLATE "C" COLLATE case_insensitive ON EMPTY) = 'a'
== 489
-- true
SELECT JSON_VALUE('{"a": "A"}', '$.a' RETURNING d1 DEFAULT 'C' ON EMPTY) = 'a'
--
SELECT JSON_VALUE('{"a": "A"}' , '$.a' RETURNING d1  DEFAULT 'C' ON EMPTY) = 'a'
== 490
-- true
SELECT JSON_VALUE('{"a": "A"}', '$.a' RETURNING d1 DEFAULT 'C'::d2 ON EMPTY) = 'a'
--
SELECT JSON_VALUE('{"a": "A"}' , '$.a' RETURNING d1  DEFAULT 'C'::d2 ON EMPTY) = 'a'
== 491
-- error
