WITH RECURSIVE x(a) AS (VALUES ('a'), ('b') UNION ALL (WITH z AS NOT MATERIALIZED (SELECT * FROM x) SELECT z.a || z.a AS a FROM z WHERE length(z.a || z.a) < 5)) SELECT * FROM x
== 289
-- Check handling of outer references
explain (verbose, costs off)
with x as (select * from int4_tbl)
select * from (with y as (select * from x) select * from y) ss
--
EXPLAIN (VERBOSE, COSTS OFF) WITH x AS (SELECT * FROM int4_tbl) SELECT * FROM (WITH y AS (SELECT * FROM x) SELECT * FROM y) ss
== 290
explain (verbose, costs off)
with x as materialized (select * from int4_tbl)
select * from (with y as (select * from x) select * from y) ss
--
EXPLAIN (VERBOSE, COSTS OFF) WITH x AS MATERIALIZED (SELECT * FROM int4_tbl) SELECT * FROM (WITH y AS (SELECT * FROM x) SELECT * FROM y) ss
== 291
-- Ensure that we inline the correct CTE when there are
-- multiple CTEs with the same name
explain (verbose, costs off)
with x as (select 1 as y)
select * from (with x as (select 2 as y) select * from x) ss
--
EXPLAIN (VERBOSE, COSTS OFF) WITH x AS (SELECT 1 AS y) SELECT * FROM (WITH x AS (SELECT 2 AS y) SELECT * FROM x) ss
== 292
-- Row marks are not pushed into CTEs
explain (verbose, costs off)
with x as (select * from subselect_tbl)
select * from x for update
--
EXPLAIN (VERBOSE, COSTS OFF) WITH x AS (SELECT * FROM subselect_tbl) SELECT * FROM x FOR UPDATE
== 293
-- Pull up direct-correlated ANY_SUBLINKs
explain (costs off)
select * from tenk1 A where hundred in (select hundred from tenk2 B where B.odd = A.odd)
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a WHERE hundred IN (SELECT hundred FROM tenk2 b WHERE b.odd = a.odd)
== 294
explain (costs off)
select * from tenk1 A where exists
(select 1 from tenk2 B
where A.hundred in (select C.hundred FROM tenk2 C
WHERE c.odd = b.odd))
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a WHERE EXISTS (SELECT 1 FROM tenk2 b WHERE a.hundred IN (SELECT c.hundred FROM tenk2 c WHERE c.odd = b.odd))
== 295
-- we should only try to pull up the sublink into RHS of a left join
-- but a.hundred is not available.
explain (costs off)
SELECT * FROM tenk1 A LEFT JOIN tenk2 B
ON A.hundred in (SELECT c.hundred FROM tenk2 C WHERE c.odd = b.odd)
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a LEFT JOIN tenk2 b ON a.hundred IN (SELECT c.hundred FROM tenk2 c WHERE c.odd = b.odd)
== 296
-- we should only try to pull up the sublink into RHS of a left join
-- but a.odd is not available for this.
explain (costs off)
SELECT * FROM tenk1 A LEFT JOIN tenk2 B
ON B.hundred in (SELECT c.hundred FROM tenk2 C WHERE c.odd = a.odd)
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a LEFT JOIN tenk2 b ON b.hundred IN (SELECT c.hundred FROM tenk2 c WHERE c.odd = a.odd)
== 297
-- should be able to pull up since all the references are available.
explain (costs off)
SELECT * FROM tenk1 A LEFT JOIN tenk2 B
ON B.hundred in (SELECT c.hundred FROM tenk2 C WHERE c.odd = b.odd)
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a LEFT JOIN tenk2 b ON b.hundred IN (SELECT c.hundred FROM tenk2 c WHERE c.odd = b.odd)
== 298
-- we can pull up the sublink into the inner JoinExpr.
explain (costs off)
SELECT * FROM tenk1 A INNER JOIN tenk2 B
ON A.hundred in (SELECT c.hundred FROM tenk2 C WHERE c.odd = b.odd)
WHERE a.thousand < 750
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a JOIN tenk2 b ON a.hundred IN (SELECT c.hundred FROM tenk2 c WHERE c.odd = b.odd) WHERE a.thousand < 750
== 299
-- we can pull up the aggregate sublink into RHS of a left join.
explain (costs off)
SELECT * FROM tenk1 A LEFT JOIN tenk2 B
ON B.hundred in (SELECT min(c.hundred) FROM tenk2 C WHERE c.odd = b.odd)
--
EXPLAIN (COSTS OFF) SELECT * FROM tenk1 a LEFT JOIN tenk2 b ON b.hundred IN (SELECT min(c.hundred) FROM tenk2 c WHERE c.odd = b.odd)
== 300
|--
-- Test VALUES to ARRAY (VtA) transformation
|--

-- VtA transformation for joined VALUES is not supported
EXPLAIN (COSTS OFF)
SELECT * FROM onek, (VALUES('RFAAAA'), ('VJAAAA')) AS v (i)
  WHERE onek.stringu1 = v.i
--
EXPLAIN (COSTS OFF) SELECT * FROM onek, (VALUES ('RFAAAA'), ('VJAAAA')) v(i) WHERE onek.stringu1 = v.i
== 301
-- VtA transformation for a composite argument is not supported
EXPLAIN (COSTS OFF)
SELECT * FROM onek
  WHERE (unique1,ten) IN (VALUES (1,1), (20,0), (99,9), (17,99))
  ORDER BY unique1
--
EXPLAIN (COSTS OFF) SELECT * FROM onek WHERE (unique1, ten) IN (VALUES (1, 1), (20, 0), (99, 9), (17, 99)) ORDER BY unique1
== 302
EXPLAIN (COSTS OFF)
SELECT * FROM onek
    WHERE unique1 IN (VALUES(10000), (2), (389), (1000), (2000), (10029))
    ORDER BY unique1
--
EXPLAIN (COSTS OFF) SELECT * FROM onek WHERE unique1 IN (VALUES (10000), (2), (389), (1000), (2000), (10029)) ORDER BY unique1
== 303
EXPLAIN (COSTS OFF)
SELECT * FROM onek
    WHERE unique1 IN (VALUES(1200), (1))
--
EXPLAIN (COSTS OFF) SELECT * FROM onek WHERE unique1 IN (VALUES (1200), (1))
== 304
-- Recursive evaluation of constant queries is not yet supported
EXPLAIN (COSTS OFF)
SELECT * FROM onek
  WHERE unique1 IN (SELECT x * x FROM (VALUES(1200), (1)) AS x(x))
--
EXPLAIN (COSTS OFF) SELECT * FROM onek WHERE unique1 IN (SELECT x * x FROM (VALUES (1200), (1)) x(x))
== 305
EXPLAIN (COSTS OFF)
SELECT unique1, stringu1 FROM onek WHERE stringu1::name IN (VALUES('RFAAAA'), ('VJAAAA'))
--
EXPLAIN (COSTS OFF) SELECT unique1, stringu1 FROM onek WHERE stringu1::name IN (VALUES ('RFAAAA'), ('VJAAAA'))
== 306
EXPLAIN (COSTS OFF)
SELECT unique1, stringu1 FROM onek WHERE stringu1::text IN (VALUES('RFAAAA'), ('VJAAAA'))
--
EXPLAIN (COSTS OFF) SELECT unique1, stringu1 FROM onek WHERE stringu1::text IN (VALUES ('RFAAAA'), ('VJAAAA'))
== 307
EXPLAIN (COSTS OFF)
SELECT * from onek WHERE unique1 in (VALUES(1200::bigint), (1))
--
EXPLAIN (COSTS OFF) SELECT * FROM onek WHERE unique1 IN (VALUES (1200::bigint), (1))
== 308
-- VtA shouldn't depend on the side of the join probing with the VALUES expression.
EXPLAIN (COSTS OFF)
SELECT c.unique1,c.ten FROM tenk1 c JOIN onek a USING (ten)
WHERE a.ten IN (VALUES (1), (2))
--
EXPLAIN (COSTS OFF) SELECT c.unique1, c.ten FROM tenk1 c JOIN onek a USING (ten) WHERE a.ten IN (VALUES (1), (2))
== 309
EXPLAIN (COSTS OFF)
SELECT c.unique1,c.ten FROM tenk1 c JOIN onek a USING (ten)
WHERE c.ten IN (VALUES (1), (2))
--
EXPLAIN (COSTS OFF) SELECT c.unique1, c.ten FROM tenk1 c JOIN onek a USING (ten) WHERE c.ten IN (VALUES (1), (2))
== 310
-- Constant expressions are simplified
EXPLAIN (COSTS OFF)
SELECT ten FROM onek WHERE sin(two ) +four IN (VALUES (sin(0.5)), (2))
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek WHERE sin(two) + four IN (VALUES (sin(0.5)), (2))
== 311
EXPLAIN (COSTS OFF)

-- VtA allows NULLs in the list
SELECT ten FROM onek WHERE sin(two)+four IN (VALUES (sin(0.5)), (NULL), (2))
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek WHERE sin(two) + four IN (VALUES (sin(0.5)), (NULL), (2))
== 312
-- VtA is supported for custom plans where params are substituted with
-- constants.  VtA is not supported with generic plans where params prevent
-- us from building a constant array.
PREPARE test (int, numeric, text) AS
  SELECT ten FROM onek WHERE sin(two) * four / ($3::real) IN (VALUES (sin($2)), (2), ($1))
--
PREPARE test(int, numeric, text) AS SELECT ten FROM onek WHERE (sin(two) * four) / $3::real IN (VALUES (sin($2)), (2), ($1))
== 313
EXPLAIN (COSTS OFF) EXECUTE test(42, 3.14, '-1.5')
--
EXPLAIN (COSTS OFF) EXECUTE test(42, 3.14, '-1.5')
== 314
EXPLAIN (COSTS OFF) EXECUTE test(NULL, 3.14, NULL)
--
EXPLAIN (COSTS OFF) EXECUTE test(NULL, 3.14, NULL)
== 315
EXPLAIN (COSTS OFF) EXECUTE test(NULL, 3.14, '-1.5')
--
EXPLAIN (COSTS OFF) EXECUTE test(NULL, 3.14, '-1.5')
== 316
SET plan_cache_mode = 'force_generic_plan'
--
SET plan_cache_mode TO force_generic_plan
== 317
EXPLAIN (COSTS OFF) EXECUTE test(NULL, 3.14, '-1.5')
--
EXPLAIN (COSTS OFF) EXECUTE test(NULL, 3.14, '-1.5')
== 318
RESET plan_cache_mode
--
RESET plan_cache_mode
== 319
--  VtA doesn't support LIMIT, OFFSET, and ORDER BY clauses
EXPLAIN (COSTS OFF)
SELECT ten FROM onek WHERE unique1 IN (VALUES (1), (2) OFFSET 1)
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek WHERE unique1 IN (VALUES (1), (2) OFFSET 1)
== 320
EXPLAIN (COSTS OFF)
SELECT ten FROM onek WHERE unique1 IN (VALUES (1), (2) ORDER BY 1)
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek WHERE unique1 IN (VALUES (1), (2) ORDER BY 1)
== 321
EXPLAIN (COSTS OFF)
SELECT ten FROM onek WHERE unique1 IN (VALUES (1), (2) LIMIT 1)
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek WHERE unique1 IN (VALUES (1), (2) LIMIT 1)
== 322
EXPLAIN (COSTS OFF)
SELECT ten FROM onek t
WHERE unique1 IN (VALUES (0), ((2 IN (SELECT unique2 FROM onek c
  WHERE c.unique2 = t.unique1))::integer))
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), (2 IN (SELECT unique2 FROM onek c WHERE c.unique2 = t.unique1)::int))
== 323
EXPLAIN (COSTS OFF)
SELECT ten FROM onek t
WHERE unique1 IN (VALUES (0), ((2 IN (SELECT unique2 FROM onek c
  WHERE c.unique2 IN (VALUES (sin(0.5)), (2))))::integer))
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), (2 IN (SELECT unique2 FROM onek c WHERE c.unique2 IN (VALUES (sin(0.5)), (2)))::int))
== 324
-- VtA is not allowed with subqueries
EXPLAIN (COSTS OFF)
SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), ((2 IN
  (SELECT (3)))::integer)
)
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), (2 IN (SELECT 3)::int))
== 325
-- VtA is not allowed with non-constant expressions
EXPLAIN (COSTS OFF)
SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), (unique2))
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), (unique2))
== 326
EXPLAIN (COSTS OFF)
SELECT * FROM onek t1, lateral (SELECT * FROM onek t2 WHERE t2.ten IN (values (t1.ten), (1)))
--
EXPLAIN (COSTS OFF) SELECT * FROM onek t1, LATERAL (SELECT * FROM onek t2 WHERE t2.ten IN (VALUES (t1.ten), (1)))
== 327
-- VtA causes the whole expression to be evaluated as a constant
EXPLAIN (COSTS OFF)
SELECT ten FROM onek t WHERE 1.0::integer IN ((VALUES (1), (3)))
--
EXPLAIN (COSTS OFF) SELECT ten FROM onek t WHERE (1.0)::int IN (VALUES (1), (3))
