|--
-- Test that we don't try to use a hashed subplan if the simplified
-- testexpr isn't of the right shape
|--

-- this fails by default, of course
select * from int8_tbl where q1 in (select c1 from inner_text)
--
SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 164
begin
--
BEGIN
== 165
-- make an operator to allow it to succeed
create function bogus_int8_text_eq(int8, text) returns boolean
language sql as 'select $1::text = $2'
--
CREATE FUNCTION bogus_int8_text_eq(int8, text) RETURNS boolean LANGUAGE sql AS $$select $1::text = $2$$
== 166
create operator = (procedure=bogus_int8_text_eq, leftarg=int8, rightarg=text)
--
CREATE OPERATOR = (procedure = bogus_int8_text_eq, leftarg = int8, rightarg = text)
== 167
explain (costs off)
select * from int8_tbl where q1 in (select c1 from inner_text)
--
EXPLAIN (COSTS OFF) SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 168
select * from int8_tbl where q1 in (select c1 from inner_text)
--
SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 169
-- inlining of this function results in unusual number of hash clauses,
-- which we can still cope with
create or replace function bogus_int8_text_eq(int8, text) returns boolean
language sql as 'select $1::text = $2 and $1::text = $2'
--
CREATE OR REPLACE FUNCTION bogus_int8_text_eq(int8, text) RETURNS boolean LANGUAGE sql AS $$select $1::text = $2 and $1::text = $2$$
== 170
explain (costs off)
select * from int8_tbl where q1 in (select c1 from inner_text)
--
EXPLAIN (COSTS OFF) SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 171
select * from int8_tbl where q1 in (select c1 from inner_text)
--
SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 172
-- inlining of this function causes LHS and RHS to be switched,
-- which we can't cope with, so hashing should be abandoned
create or replace function bogus_int8_text_eq(int8, text) returns boolean
language sql as 'select $2 = $1::text'
--
CREATE OR REPLACE FUNCTION bogus_int8_text_eq(int8, text) RETURNS boolean LANGUAGE sql AS $$select $2 = $1::text$$
== 173
explain (costs off)
select * from int8_tbl where q1 in (select c1 from inner_text)
--
EXPLAIN (COSTS OFF) SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 174
select * from int8_tbl where q1 in (select c1 from inner_text)
--
SELECT * FROM int8_tbl WHERE q1 IN (SELECT c1 FROM inner_text)
== 175
rollback
--
ROLLBACK
== 176
