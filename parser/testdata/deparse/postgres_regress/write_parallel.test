--
CREATE UNIQUE INDEX ON parallel_mat_view USING btree (length)
== 015
refresh materialized view parallel_mat_view
--
REFRESH MATERIALIZED VIEW parallel_mat_view
== 016
refresh materialized view concurrently parallel_mat_view
--
REFRESH MATERIALIZED VIEW CONCURRENTLY parallel_mat_view
