== 001
|--
-- Tests to exercise the plan caching/invalidation mechanism
|--

CREATE TEMP TABLE pcachetest AS SELECT * FROM int8_tbl
--
CREATE TEMPORARY TABLE pcachetest AS SELECT * FROM int8_tbl
== 002
-- create and use a cached plan
PREPARE prepstmt AS SELECT * FROM pcachetest
--
PREPARE prepstmt AS SELECT * FROM pcachetest
== 003
EXECUTE prepstmt
--
EXECUTE prepstmt
== 004
-- and one with parameters
PREPARE prepstmt2(bigint) AS SELECT * FROM pcachetest WHERE q1 = $1
--
PREPARE prepstmt2(bigint) AS SELECT * FROM pcachetest WHERE q1 = $1
== 005
EXECUTE prepstmt2(123)
--
EXECUTE prepstmt2(123)
== 006
-- invalidate the plans and see what happens
DROP TABLE pcachetest
--
DROP TABLE pcachetest
== 007
EXECUTE prepstmt
--
EXECUTE prepstmt
== 008
EXECUTE prepstmt2(123)
--
EXECUTE prepstmt2(123)
== 009
-- recreate the temp table (this demonstrates that the raw plan is
-- purely textual and doesn't depend on OIDs, for instance)
CREATE TEMP TABLE pcachetest AS SELECT * FROM int8_tbl ORDER BY 2
--
CREATE TEMPORARY TABLE pcachetest AS SELECT * FROM int8_tbl ORDER BY 2
== 010
EXECUTE prepstmt
--
EXECUTE prepstmt
== 011
EXECUTE prepstmt2(123)
--
EXECUTE prepstmt2(123)
== 012
-- prepared statements should prevent change in output tupdesc,
-- since clients probably aren't expecting that to change on the fly
ALTER TABLE pcachetest ADD COLUMN q3 bigint
--
ALTER TABLE pcachetest ADD COLUMN q3 bigint
== 013
EXECUTE prepstmt
--
EXECUTE prepstmt
== 014
EXECUTE prepstmt2(123)
--
EXECUTE prepstmt2(123)
== 015
-- but we're nice guys and will let you undo your mistake
ALTER TABLE pcachetest DROP COLUMN q3
--
ALTER TABLE pcachetest DROP q3
== 016
EXECUTE prepstmt
--
EXECUTE prepstmt
== 017
EXECUTE prepstmt2(123)
--
EXECUTE prepstmt2(123)
== 018
-- Try it with a view, which isn't directly used in the resulting plan
-- but should trigger invalidation anyway
CREATE TEMP VIEW pcacheview AS
  SELECT * FROM pcachetest
--
CREATE TEMPORARY VIEW pcacheview AS SELECT * FROM pcachetest
== 019
PREPARE vprep AS SELECT * FROM pcacheview
--
PREPARE vprep AS SELECT * FROM pcacheview
== 020
EXECUTE vprep
--
EXECUTE vprep
== 021
CREATE OR REPLACE TEMP VIEW pcacheview AS
  SELECT q1, q2/2 AS q2 FROM pcachetest
--
CREATE OR REPLACE TEMPORARY VIEW pcacheview AS SELECT q1, q2 / 2 AS q2 FROM pcachetest
== 022
EXECUTE vprep
--
EXECUTE vprep
== 023
-- Check basic SPI plan invalidation

create function cache_test(int) returns int as $$
declare total int;
begin
	create temp table t1(f1 int);
	insert into t1 values($1);
	insert into t1 values(11);
	insert into t1 values(12);
	insert into t1 values(13);
	select sum(f1) into total from t1;
	drop table t1;
	return total;
end
$$ language plpgsql
--
CREATE FUNCTION cache_test(int) RETURNS int AS $$
declare total int;
begin
	create temp table t1(f1 int);
	insert into t1 values($1);
	insert into t1 values(11);
	insert into t1 values(12);
	insert into t1 values(13);
	select sum(f1) into total from t1;
	drop table t1;
	return total;
end
$$ LANGUAGE plpgsql
== 024
select cache_test(1)
--
SELECT cache_test(1)
== 025
select cache_test(2)
--
SELECT cache_test(2)
== 026
select cache_test(3)
--
SELECT cache_test(3)
== 027
-- Check invalidation of plpgsql "simple expression"

create temp view v1 as
  select 2+2 as f1
--
CREATE TEMPORARY VIEW v1 AS SELECT 2 + 2 AS f1
== 028
create function cache_test_2() returns int as $$
begin
	return f1 from v1;
end$$ language plpgsql
--
CREATE FUNCTION cache_test_2() RETURNS int AS $$
begin
	return f1 from v1;
end$$ LANGUAGE plpgsql
== 029
select cache_test_2()
--
SELECT cache_test_2()
== 030
create or replace temp view v1 as
