SELECT date_trunc( 'timezone', timestamp with time zone '2004-02-29 15:44:17.71393' ) AS notsupp_trunc
--
SELECT date_trunc('timezone', '2004-02-29 15:44:17.71393'::timestamp with time zone) AS notsupp_trunc
