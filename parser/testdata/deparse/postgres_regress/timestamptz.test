--
INSERT INTO timestamptz_tbl VALUES ('tomorrow zulu')
== 008
SELECT count(*) AS One FROM TIMESTAMPTZ_TBL WHERE d1 = timestamp with time zone 'today'
--
SELECT count(*) AS one FROM timestamptz_tbl WHERE d1 = 'today'::timestamp with time zone
== 009
SELECT count(*) AS One FROM TIMESTAMPTZ_TBL WHERE d1 = timestamp with time zone 'tomorrow'
--
SELECT count(*) AS one FROM timestamptz_tbl WHERE d1 = 'tomorrow'::timestamp with time zone
== 010
SELECT count(*) AS One FROM TIMESTAMPTZ_TBL WHERE d1 = timestamp with time zone 'yesterday'
--
SELECT count(*) AS one FROM timestamptz_tbl WHERE d1 = 'yesterday'::timestamp with time zone
== 011
SELECT count(*) AS One FROM TIMESTAMPTZ_TBL WHERE d1 = timestamp with time zone 'tomorrow EST'
