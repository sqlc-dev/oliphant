== 012
SELECT count(*) AS One FROM TIMESTAMPTZ_TBL WHERE d1 = timestamp with time zone 'tomorrow zulu'
--
SELECT count(*) AS one FROM timestamptz_tbl WHERE d1 = 'tomorrow zulu'::timestamp with time zone
== 013
COMMIT
