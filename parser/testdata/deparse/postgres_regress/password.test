== 001
|--
-- Tests for password types
|--

-- Tests for GUC password_encryption
SET password_encryption = 'novalue'
--
SET password_encryption TO novalue
== 002
-- error
SET password_encryption = true
--
SET password_encryption TO TRUE
== 003
-- error
SET password_encryption = 'md5'
--
SET password_encryption TO md5
== 004
-- ok
SET password_encryption = 'scram-sha-256'
--
SET password_encryption TO "scram-sha-256"
== 005
-- ok

-- consistency of password entries
SET password_encryption = 'md5'
--
SET password_encryption TO md5
== 006
CREATE ROLE regress_passwd1
--
CREATE ROLE regress_passwd1
== 007
ALTER ROLE regress_passwd1 PASSWORD 'role_pwd1'
--
ALTER ROLE regress_passwd1 WITH PASSWORD 'role_pwd1'
== 008
CREATE ROLE regress_passwd2
--
CREATE ROLE regress_passwd2
== 009
ALTER ROLE regress_passwd2 PASSWORD 'role_pwd2'
--
ALTER ROLE regress_passwd2 WITH PASSWORD 'role_pwd2'
== 010
SET password_encryption = 'scram-sha-256'
--
SET password_encryption TO "scram-sha-256"
== 011
CREATE ROLE regress_passwd3 PASSWORD 'role_pwd3'
--
CREATE ROLE regress_passwd3 WITH PASSWORD 'role_pwd3'
== 012
CREATE ROLE regress_passwd4 PASSWORD NULL
--
CREATE ROLE regress_passwd4 WITH PASSWORD NULL
== 013
-- check list of created entries
|--
-- The scram secret will look something like:
-- SCRAM-SHA-256$4096:E4HxLGtnRzsYwg==$6YtlR4t69SguDiwFvbVgVZtuz6gpJQQqUMZ7IQJK5yI=:ps75jrHeYU4lXCcXI4O8oIdJ3eO8o2jirjruw9phBTo=
|--
-- Since the salt is random, the exact value stored will be different on every test
-- run. Use a regular expression to mask the changing parts.
SELECT rolname, regexp_replace(rolpassword, '(SCRAM-SHA-256)\$(\d+):([a-zA-Z0-9+/=]+)\$([a-zA-Z0-9+=/]+):([a-zA-Z0-9+/=]+)', '\1$\2:<salt>$<storedkey>:<serverkey>') as rolpassword_masked
    FROM pg_authid
    WHERE rolname LIKE 'regress_passwd%'
    ORDER BY rolname, rolpassword
--
SELECT rolname, regexp_replace(rolpassword, E'(SCRAM-SHA-256)\\$(\\d+):([a-zA-Z0-9+/=]+)\\$([a-zA-Z0-9+=/]+):([a-zA-Z0-9+/=]+)', E'\\1$\\2:<salt>$<storedkey>:<serverkey>') AS rolpassword_masked FROM pg_authid WHERE rolname LIKE 'regress_passwd%' ORDER BY rolname, rolpassword
== 014
-- Rename a role
ALTER ROLE regress_passwd2 RENAME TO regress_passwd2_new
--
ALTER ROLE regress_passwd2 RENAME TO regress_passwd2_new
== 015
-- md5 entry should have been removed
SELECT rolname, rolpassword
    FROM pg_authid
    WHERE rolname LIKE 'regress_passwd2_new'
    ORDER BY rolname, rolpassword
--
SELECT rolname, rolpassword FROM pg_authid WHERE rolname LIKE 'regress_passwd2_new' ORDER BY rolname, rolpassword
== 016
ALTER ROLE regress_passwd2_new RENAME TO regress_passwd2
--
ALTER ROLE regress_passwd2_new RENAME TO regress_passwd2
== 017
-- Change passwords with ALTER USER. With plaintext or already-encrypted
-- passwords.
SET password_encryption = 'md5'
--
SET password_encryption TO md5
== 018
-- encrypt with MD5
ALTER ROLE regress_passwd2 PASSWORD 'foo'
--
ALTER ROLE regress_passwd2 WITH PASSWORD 'foo'
== 019
-- already encrypted, use as they are
ALTER ROLE regress_passwd1 PASSWORD 'md5cd3578025fe2c3d7ed1b9a9b26238b70'
--
ALTER ROLE regress_passwd1 WITH PASSWORD 'md5cd3578025fe2c3d7ed1b9a9b26238b70'
== 020
ALTER ROLE regress_passwd3 PASSWORD 'SCRAM-SHA-256$4096:VLK4RMaQLCvNtQ==$6YtlR4t69SguDiwFvbVgVZtuz6gpJQQqUMZ7IQJK5yI=:ps75jrHeYU4lXCcXI4O8oIdJ3eO8o2jirjruw9phBTo='
--
ALTER ROLE regress_passwd3 WITH PASSWORD 'SCRAM-SHA-256$4096:VLK4RMaQLCvNtQ==$6YtlR4t69SguDiwFvbVgVZtuz6gpJQQqUMZ7IQJK5yI=:ps75jrHeYU4lXCcXI4O8oIdJ3eO8o2jirjruw9phBTo='
== 021
SET password_encryption = 'scram-sha-256'
--
SET password_encryption TO "scram-sha-256"
== 022
-- create SCRAM secret
ALTER ROLE  regress_passwd4 PASSWORD 'foo'
--
ALTER ROLE regress_passwd4 WITH PASSWORD 'foo'
== 023
-- already encrypted with MD5, use as it is
CREATE ROLE regress_passwd5 PASSWORD 'md5e73a4b11df52a6068f8b39f90be36023'
--
CREATE ROLE regress_passwd5 WITH PASSWORD 'md5e73a4b11df52a6068f8b39f90be36023'
== 024
-- This looks like a valid SCRAM-SHA-256 secret, but it is not
-- so it should be hashed with SCRAM-SHA-256.
CREATE ROLE regress_passwd6 PASSWORD 'SCRAM-SHA-256$1234'
--
CREATE ROLE regress_passwd6 WITH PASSWORD 'SCRAM-SHA-256$1234'
== 025
-- These may look like valid MD5 secrets, but they are not, so they
-- should be hashed with SCRAM-SHA-256.
-- trailing garbage at the end
CREATE ROLE regress_passwd7 PASSWORD 'md5012345678901234567890123456789zz'
--
CREATE ROLE regress_passwd7 WITH PASSWORD 'md5012345678901234567890123456789zz'
== 026
-- invalid length
CREATE ROLE regress_passwd8 PASSWORD 'md501234567890123456789012345678901zz'
--
CREATE ROLE regress_passwd8 WITH PASSWORD 'md501234567890123456789012345678901zz'
== 027
-- Changing the SCRAM iteration count
SET scram_iterations = 1024
--
SET scram_iterations TO 1024
== 028
CREATE ROLE regress_passwd9 PASSWORD 'alterediterationcount'
--
CREATE ROLE regress_passwd9 WITH PASSWORD 'alterediterationcount'
== 029
SELECT rolname, regexp_replace(rolpassword, '(SCRAM-SHA-256)\$(\d+):([a-zA-Z0-9+/=]+)\$([a-zA-Z0-9+=/]+):([a-zA-Z0-9+/=]+)', '\1$\2:<salt>$<storedkey>:<serverkey>') as rolpassword_masked
    FROM pg_authid
    WHERE rolname LIKE 'regress_passwd%'
    ORDER BY rolname, rolpassword
--
SELECT rolname, regexp_replace(rolpassword, E'(SCRAM-SHA-256)\\$(\\d+):([a-zA-Z0-9+/=]+)\\$([a-zA-Z0-9+=/]+):([a-zA-Z0-9+/=]+)', E'\\1$\\2:<salt>$<storedkey>:<serverkey>') AS rolpassword_masked FROM pg_authid WHERE rolname LIKE 'regress_passwd%' ORDER BY rolname, rolpassword
== 030
-- An empty password is not allowed, in any form
CREATE ROLE regress_passwd_empty PASSWORD ''
--
CREATE ROLE regress_passwd_empty WITH PASSWORD ''
