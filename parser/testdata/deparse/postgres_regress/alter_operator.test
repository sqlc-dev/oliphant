CREATE FUNCTION alter_op_test_fn_real_bool(real, boolean) RETURNS boolean AS $$ SELECT NULL::BOOLEAN; $$ LANGUAGE sql IMMUTABLE
== 028
-- operator
CREATE OPERATOR === (
    LEFTARG = boolean,
    RIGHTARG = real,
    PROCEDURE = alter_op_test_fn_bool_real
)
--
CREATE OPERATOR === (leftarg = boolean, rightarg = real, procedure = alter_op_test_fn_bool_real)
== 029
-- commutator
CREATE OPERATOR ==== (
    LEFTARG = real,
    RIGHTARG = boolean,
    PROCEDURE = alter_op_test_fn_real_bool
)
--
CREATE OPERATOR ==== (leftarg = real, rightarg = boolean, procedure = alter_op_test_fn_real_bool)
== 030
-- negator
CREATE OPERATOR !==== (
    LEFTARG = boolean,
    RIGHTARG = real,
    PROCEDURE = alter_op_test_fn_bool_real
)
--
CREATE OPERATOR !==== (leftarg = boolean, rightarg = real, procedure = alter_op_test_fn_bool_real)
== 031
-- No-op setting already false hashes and merges to false works
ALTER OPERATOR === (boolean, real) SET (MERGES = false)
--
ALTER OPERATOR ===(boolean, real) SET (merges = false)
== 032
ALTER OPERATOR === (boolean, real) SET (HASHES = false)
--
ALTER OPERATOR ===(boolean, real) SET (hashes = false)
== 033
-- Test setting merges and hashes
ALTER OPERATOR === (boolean, real) SET (MERGES)
--
ALTER OPERATOR ===(boolean, real) SET (merges = NONE)
== 034
ALTER OPERATOR === (boolean, real) SET (HASHES)
--
ALTER OPERATOR ===(boolean, real) SET (hashes = NONE)
== 035
SELECT oprcanmerge, oprcanhash
FROM pg_operator WHERE oprname = '==='
  AND oprleft = 'boolean'::regtype AND oprright = 'real'::regtype
--
SELECT oprcanmerge, oprcanhash FROM pg_operator WHERE oprname = '===' AND oprleft = 'boolean'::regtype AND oprright = 'real'::regtype
== 036
-- Test setting commutator
ALTER OPERATOR === (boolean, real) SET (COMMUTATOR = ====)
--
ALTER OPERATOR ===(boolean, real) SET (commutator = ====)
== 037
-- Check that oprcom has been set on both the operator and commutator,
-- that they reference each other, and that the operator used is the existing
-- one we created and not a new shell operator.
SELECT op.oprname AS operator_name, com.oprname AS commutator_name,
  com.oprcode AS commutator_func
  FROM pg_operator op
  INNER JOIN pg_operator com ON (op.oid = com.oprcom AND op.oprcom = com.oid)
  WHERE op.oprname = '==='
  AND op.oprleft = 'boolean'::regtype AND op.oprright = 'real'::regtype
--
SELECT op.oprname AS operator_name, com.oprname AS commutator_name, com.oprcode AS commutator_func FROM pg_operator op JOIN pg_operator com ON op.oid = com.oprcom AND op.oprcom = com.oid WHERE op.oprname = '===' AND op.oprleft = 'boolean'::regtype AND op.oprright = 'real'::regtype
== 038
-- Cannot set self as negator
ALTER OPERATOR === (boolean, real) SET (NEGATOR = ===)
--
ALTER OPERATOR ===(boolean, real) SET (negator = ===)
== 039
-- Test setting negator
ALTER OPERATOR === (boolean, real) SET (NEGATOR = !====)
--
ALTER OPERATOR ===(boolean, real) SET (negator = !====)
== 040
-- Check that oprnegate has been set on both the operator and negator,
-- that they reference each other, and that the operator used is the existing
-- one we created and not a new shell operator.
SELECT op.oprname AS operator_name, neg.oprname AS negator_name,
  neg.oprcode AS negator_func
  FROM pg_operator op
  INNER JOIN pg_operator neg ON (op.oid = neg.oprnegate AND op.oprnegate = neg.oid)
  WHERE op.oprname = '==='
  AND op.oprleft = 'boolean'::regtype AND op.oprright = 'real'::regtype
--
SELECT op.oprname AS operator_name, neg.oprname AS negator_name, neg.oprcode AS negator_func FROM pg_operator op JOIN pg_operator neg ON op.oid = neg.oprnegate AND op.oprnegate = neg.oid WHERE op.oprname = '===' AND op.oprleft = 'boolean'::regtype AND op.oprright = 'real'::regtype
== 041
-- Test that no-op set succeeds
ALTER OPERATOR === (boolean, real) SET (NEGATOR = !====)
--
ALTER OPERATOR ===(boolean, real) SET (negator = !====)
== 042
ALTER OPERATOR === (boolean, real) SET (COMMUTATOR = ====)
--
ALTER OPERATOR ===(boolean, real) SET (commutator = ====)
== 043
ALTER OPERATOR === (boolean, real) SET (MERGES)
--
ALTER OPERATOR ===(boolean, real) SET (merges = NONE)
== 044
ALTER OPERATOR === (boolean, real) SET (HASHES)
--
ALTER OPERATOR ===(boolean, real) SET (hashes = NONE)
== 045
-- Check that the final state of the operator is as we expect
SELECT oprcanmerge, oprcanhash,
       pg_describe_object('pg_operator'::regclass, oprcom, 0) AS commutator,
       pg_describe_object('pg_operator'::regclass, oprnegate, 0) AS negator
  FROM pg_operator WHERE oprname = '==='
  AND oprleft = 'boolean'::regtype AND oprright = 'real'::regtype
--
SELECT oprcanmerge, oprcanhash, pg_describe_object('pg_operator'::regclass, oprcom, 0) AS commutator, pg_describe_object('pg_operator'::regclass, oprnegate, 0) AS negator FROM pg_operator WHERE oprname = '===' AND oprleft = 'boolean'::regtype AND oprright = 'real'::regtype
== 046
-- Cannot change commutator, negator, merges, and hashes when already set

CREATE OPERATOR @= (
    LEFTARG = real,
    RIGHTARG = boolean,
    PROCEDURE = alter_op_test_fn_real_bool
)
--
CREATE OPERATOR @= (leftarg = real, rightarg = boolean, procedure = alter_op_test_fn_real_bool)
== 047
