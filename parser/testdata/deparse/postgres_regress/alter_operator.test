== 003
CREATE OPERATOR === (
    LEFTARG = boolean,
    RIGHTARG = boolean,
    PROCEDURE = alter_op_test_fn,
    COMMUTATOR = ===,
    NEGATOR = !==,
    RESTRICT = customcontsel,
    JOIN = contjoinsel,
    HASHES, MERGES
)
--
CREATE OPERATOR === (leftarg = boolean, rightarg = boolean, procedure = alter_op_test_fn, commutator = ===, negator = !==, restrict = customcontsel, "join" = contjoinsel, hashes, merges)
