== 001
SELECT getdatabaseencoding() <> 'UTF8' AS skip_test
--
SELECT getdatabaseencoding() <> 'UTF8' AS skip_test
== 002
SELECT U&'\0061\0308bc' <> U&'\00E4bc' COLLATE "C" AS sanity_check
--
SELECT 'äbc' <> 'äbc' COLLATE "C" AS sanity_check
== 003
SELECT unicode_version() IS NOT NULL
--
SELECT unicode_version() IS NOT NULL
== 004
