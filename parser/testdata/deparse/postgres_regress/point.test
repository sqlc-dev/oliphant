SELECT p.* FROM POINT_TBL p
   WHERE box '(0,0,100,100)' @> p.f1
--
SELECT p.* FROM point_tbl p WHERE '(0,0,100,100)'::box @> p.f1
== 015
SELECT p.* FROM POINT_TBL p
   WHERE not p.f1 <@ box '(0,0,100,100)'
--
SELECT p.* FROM point_tbl p WHERE NOT p.f1 <@ '(0,0,100,100)'::box
