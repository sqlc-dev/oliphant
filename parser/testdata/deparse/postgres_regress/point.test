== 008
-- left of
SELECT p.* FROM POINT_TBL p WHERE p.f1 << '(0.0, 0.0)'
--
SELECT p.* FROM point_tbl p WHERE p.f1 << '(0.0, 0.0)'
== 009
-- right of
SELECT p.* FROM POINT_TBL p WHERE '(0.0,0.0)' >> p.f1
--
SELECT p.* FROM point_tbl p WHERE '(0.0,0.0)' >> p.f1
== 010
-- above
SELECT p.* FROM POINT_TBL p WHERE '(0.0,0.0)' |>> p.f1
--
SELECT p.* FROM point_tbl p WHERE '(0.0,0.0)' |>> p.f1
== 011
-- below
SELECT p.* FROM POINT_TBL p WHERE p.f1 <<| '(0.0, 0.0)'
