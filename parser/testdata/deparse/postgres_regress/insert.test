-- have a BR trigger modify the row such that the check_b is violated
create function mlparted11_trig_fn()
returns trigger AS
$$
begin
  NEW.b := 4;
  return NEW;
end;
$$
language plpgsql
--
CREATE FUNCTION mlparted11_trig_fn() RETURNS trigger AS $$
begin
  NEW.b := 4;
  return NEW;
end;
$$ LANGUAGE plpgsql
