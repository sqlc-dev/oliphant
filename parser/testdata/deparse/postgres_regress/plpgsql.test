-- test access to exception data
create function zero_divide() returns int as $$
declare v int := 0;
begin
  return 10 / v;
end;
$$ language plpgsql parallel safe
--
CREATE FUNCTION zero_divide() RETURNS int AS $$
declare v int := 0;
begin
  return 10 / v;
end;
$$ LANGUAGE plpgsql PARALLEL safe
== 655
create or replace function raise_test() returns void as $$
