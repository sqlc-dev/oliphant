== 010
CREATE TABLE prevstats AS
SELECT t.seq_scan, t.seq_tup_read, t.idx_scan, t.idx_tup_fetch,
       (b.heap_blks_read + b.heap_blks_hit) AS heap_blks,
       (b.idx_blks_read + b.idx_blks_hit) AS idx_blks,
       pg_stat_get_snapshot_timestamp() as snap_ts
  FROM pg_catalog.pg_stat_user_tables AS t,
       pg_catalog.pg_statio_user_tables AS b
 WHERE t.relname='tenk2' AND b.relname='tenk2'
--
CREATE TABLE prevstats AS SELECT t.seq_scan, t.seq_tup_read, t.idx_scan, t.idx_tup_fetch, b.heap_blks_read + b.heap_blks_hit AS heap_blks, b.idx_blks_read + b.idx_blks_hit AS idx_blks, pg_stat_get_snapshot_timestamp() AS snap_ts FROM pg_catalog.pg_stat_user_tables t, pg_catalog.pg_statio_user_tables b WHERE t.relname = 'tenk2' AND b.relname = 'tenk2'
