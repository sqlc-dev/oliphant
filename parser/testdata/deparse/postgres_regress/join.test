 text_tbl t0
 left join
   (select case t1.ten when 0 then 'doh!'::text else null::text end as case1,
           t1.stringu2
     from tenk1 t1
     join int4_tbl i4 ON i4.f1 = t1.unique2
     left join uniquetbl u1 ON u1.f1 = t1.string4) ss
  on t0.f1 = ss.case1
where ss.stringu2 !~* ss.case1
--
SELECT t0.* FROM text_tbl t0 LEFT JOIN (SELECT CASE t1.ten WHEN 0 THEN 'doh!'::text ELSE NULL::text END AS case1, t1.stringu2 FROM tenk1 t1 JOIN int4_tbl i4 ON i4.f1 = t1.unique2 LEFT JOIN uniquetbl u1 ON u1.f1 = t1.string4) ss ON t0.f1 = ss.case1 WHERE ss.stringu2 !~* ss.case1
== 501
rollback
