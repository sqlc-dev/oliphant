== 036
SELECT tx.ii, tx.jj, tx.kk
  FROM (J1_TBL t1 (a, b, c) CROSS JOIN J2_TBL t2 (d, e))
    AS tx (ii, jj, tt, ii2, kk)
--
SELECT tx.ii, tx.jj, tx.kk FROM (j1_tbl t1(a, b, c) CROSS JOIN j2_tbl t2(d, e) ) tx(ii, jj, tt, ii2, kk)
