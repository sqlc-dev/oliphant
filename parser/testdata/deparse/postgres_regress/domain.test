-- Check enforcement of array-level domain constraints
|--

create domain orderedpair as int[2] check (value[1] < value[2])
--
CREATE DOMAIN orderedpair AS int[2] CHECK (value[1] < value[2])
== 278
select array[1,2]::orderedpair
--
SELECT ARRAY[1, 2]::orderedpair
== 279
select array[2,1]::orderedpair
--
SELECT ARRAY[2, 1]::orderedpair
== 280
-- fail

create temp table op (f1 orderedpair)
--
CREATE TEMPORARY TABLE op (f1 orderedpair)
== 281
insert into op values (array[1,2])
--
INSERT INTO op VALUES (ARRAY[1, 2])
== 282
insert into op values (array[2,1])
--
INSERT INTO op VALUES (ARRAY[2, 1])
== 283
-- fail

update op set f1[2] = 3
--
UPDATE op SET f1[2] = 3
== 284
update op set f1[2] = 0
--
UPDATE op SET f1[2] = 0
== 285
-- fail
select * from op
--
SELECT * FROM op
== 286
create or replace function array_elem_check(int) returns int as $$
declare
  x orderedpair := '{1,2}';
begin
  x[2] := $1;
  return x[2];
end$$ language plpgsql
--
CREATE OR REPLACE FUNCTION array_elem_check(int) RETURNS int AS $$
declare
  x orderedpair := '{1,2}';
begin
  x[2] := $1;
  return x[2];
end$$ LANGUAGE plpgsql
== 287
select array_elem_check(3)
--
SELECT array_elem_check(3)
== 288
select array_elem_check(-1)
--
SELECT array_elem_check(-1)
== 289
drop function array_elem_check(int)
--
DROP FUNCTION array_elem_check(int)
== 290
|--
-- Check enforcement of changing constraints in plpgsql
|--

create domain di as int
--
CREATE DOMAIN di AS int
== 291
create function dom_check(int) returns di as $$
declare d di;
begin
  d := $1::di;
  return d;
end
$$ language plpgsql immutable
--
CREATE FUNCTION dom_check(int) RETURNS di AS $$
declare d di;
begin
  d := $1::di;
  return d;
end
$$ LANGUAGE plpgsql IMMUTABLE
== 292
select dom_check(0)
--
SELECT dom_check(0)
== 293
alter domain di add constraint pos check (value > 0)
--
ALTER DOMAIN di ADD CONSTRAINT pos CHECK (value > 0)
== 294
select dom_check(0)
--
SELECT dom_check(0)
== 295
-- fail

alter domain di drop constraint pos
--
ALTER DOMAIN di DROP CONSTRAINT pos
== 296
select dom_check(0)
--
SELECT dom_check(0)
== 297
-- implicit cast during assignment is a separate code path, test that too

create or replace function dom_check(int) returns di as $$
declare d di;
begin
  d := $1;
  return d;
end
$$ language plpgsql immutable
--
CREATE OR REPLACE FUNCTION dom_check(int) RETURNS di AS $$
declare d di;
begin
  d := $1;
  return d;
end
$$ LANGUAGE plpgsql IMMUTABLE
== 298
select dom_check(0)
--
SELECT dom_check(0)
== 299
alter domain di add constraint pos check (value > 0)
--
ALTER DOMAIN di ADD CONSTRAINT pos CHECK (value > 0)
== 300
select dom_check(0)
--
SELECT dom_check(0)
== 301
-- fail

alter domain di drop constraint pos
--
ALTER DOMAIN di DROP CONSTRAINT pos
== 302
select dom_check(0)
--
SELECT dom_check(0)
== 303
drop function dom_check(int)
--
DROP FUNCTION dom_check(int)
== 304
drop domain di
--
DROP DOMAIN di
== 305
|--
-- Check use of a (non-inline-able) SQL function in a domain constraint;
-- this has caused issues in the past
|--

create function sql_is_distinct_from(anyelement, anyelement)
returns boolean language sql
as 'select $1 is distinct from $2 limit 1'
--
CREATE FUNCTION sql_is_distinct_from(anyelement, anyelement) RETURNS boolean LANGUAGE sql AS $$select $1 is distinct from $2 limit 1$$
== 306
create domain inotnull int
  check (sql_is_distinct_from(value, null))
--
CREATE DOMAIN inotnull AS int CHECK (sql_is_distinct_from(value, NULL))
== 307
select 1::inotnull
--
SELECT 1::inotnull
== 308
select null::inotnull
--
SELECT NULL::inotnull
== 309
create table dom_table (x inotnull)
--
CREATE TABLE dom_table (x inotnull)
== 310
insert into dom_table values ('1')
--
INSERT INTO dom_table VALUES ('1')
== 311
insert into dom_table values (1)
--
INSERT INTO dom_table VALUES (1)
== 312
insert into dom_table values (null)
--
INSERT INTO dom_table VALUES (NULL)
== 313
drop table dom_table
--
DROP TABLE dom_table
== 314
drop domain inotnull
--
DROP DOMAIN inotnull
== 315
drop function sql_is_distinct_from(anyelement, anyelement)
--
DROP FUNCTION sql_is_distinct_from(anyelement, anyelement)
== 316
