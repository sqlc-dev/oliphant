== 276
|--
-- Check enforcement of changing constraints in plpgsql
|--

create domain di as int
--
CREATE DOMAIN di AS int
== 277
create function dom_check(int) returns di as $$
declare d di;
begin
  d := $1::di;
  return d;
end
$$ language plpgsql immutable
--
CREATE FUNCTION dom_check(int) RETURNS di AS $$
declare d di;
begin
  d := $1::di;
  return d;
end
$$ LANGUAGE plpgsql IMMUTABLE
== 278
select dom_check(0)
--
SELECT dom_check(0)
== 279
alter domain di add constraint pos check (value > 0)
--
ALTER DOMAIN di ADD CONSTRAINT pos CHECK (value > 0)
== 280
select dom_check(0)
--
SELECT dom_check(0)
== 281
-- fail

alter domain di drop constraint pos
--
ALTER DOMAIN di DROP CONSTRAINT pos
== 282
select dom_check(0)
--
SELECT dom_check(0)
== 283
-- implicit cast during assignment is a separate code path, test that too

create or replace function dom_check(int) returns di as $$
declare d di;
begin
  d := $1;
  return d;
end
$$ language plpgsql immutable
--
CREATE OR REPLACE FUNCTION dom_check(int) RETURNS di AS $$
declare d di;
begin
  d := $1;
  return d;
end
$$ LANGUAGE plpgsql IMMUTABLE
== 284
select dom_check(0)
--
SELECT dom_check(0)
== 285
alter domain di add constraint pos check (value > 0)
--
ALTER DOMAIN di ADD CONSTRAINT pos CHECK (value > 0)
== 286
select dom_check(0)
--
SELECT dom_check(0)
== 287
-- fail

alter domain di drop constraint pos
--
ALTER DOMAIN di DROP CONSTRAINT pos
== 288
select dom_check(0)
--
SELECT dom_check(0)
== 289
drop function dom_check(int)
--
DROP FUNCTION dom_check(int)
== 290
drop domain di
--
DROP DOMAIN di
== 291
|--
-- Check use of a (non-inline-able) SQL function in a domain constraint;
-- this has caused issues in the past
|--

create function sql_is_distinct_from(anyelement, anyelement)
returns boolean language sql
as 'select $1 is distinct from $2 limit 1'
--
CREATE FUNCTION sql_is_distinct_from(anyelement, anyelement) RETURNS boolean LANGUAGE sql AS $$select $1 is distinct from $2 limit 1$$
== 292
create domain inotnull int
  check (sql_is_distinct_from(value, null))
--
CREATE DOMAIN inotnull AS int CHECK (sql_is_distinct_from(value, NULL))
== 293
select 1::inotnull
--
SELECT 1::inotnull
== 294
select null::inotnull
--
SELECT NULL::inotnull
== 295
create table dom_table (x inotnull)
--
CREATE TABLE dom_table (x inotnull)
== 296
insert into dom_table values ('1')
--
INSERT INTO dom_table VALUES ('1')
== 297
insert into dom_table values (1)
--
INSERT INTO dom_table VALUES (1)
== 298
insert into dom_table values (null)
--
INSERT INTO dom_table VALUES (NULL)
== 299
drop table dom_table
--
DROP TABLE dom_table
== 300
drop domain inotnull
--
DROP DOMAIN inotnull
== 301
drop function sql_is_distinct_from(anyelement, anyelement)
--
DROP FUNCTION sql_is_distinct_from(anyelement, anyelement)
== 302
