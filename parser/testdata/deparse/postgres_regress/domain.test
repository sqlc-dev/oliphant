--
CREATE DOMAIN int_domain1 AS int CONSTRAINT nn1 NOT NULL CONSTRAINT nn2 NOT NULL
== 209
create domain str_domain2 as text check (value <> 'foo') default 'foo'
--
CREATE DOMAIN str_domain2 AS text CHECK (value <> 'foo') DEFAULT 'foo'
== 210
-- should fail
alter table domain_test add column d str_domain2
--
ALTER TABLE domain_test ADD COLUMN d str_domain2
== 211
-- Check that domain constraints on prepared statement parameters of
-- unknown type are enforced correctly.
create domain pos_int as int4 check (value > 0) not null
--
CREATE DOMAIN pos_int AS int4 CHECK (value > 0) NOT NULL
== 212
prepare s1 as select $1::pos_int = 10 as "is_ten"
--
PREPARE s1 AS SELECT $1::pos_int = 10 AS is_ten
== 213
execute s1(10)
--
EXECUTE s1(10)
== 214
execute s1(0)
--
EXECUTE s1(0)
== 215
-- should fail
execute s1(NULL)
--
EXECUTE s1(NULL)
== 216
-- should fail

-- Check that domain constraints on plpgsql function parameters, results,
-- and local variables are enforced correctly.

create function doubledecrement(p1 pos_int) returns pos_int as $$
declare v pos_int;
begin
    return p1;
end$$ language plpgsql
--
CREATE FUNCTION doubledecrement(p1 pos_int) RETURNS pos_int AS $$
declare v pos_int;
begin
    return p1;
end$$ LANGUAGE plpgsql
== 217
select doubledecrement(3)
--
SELECT doubledecrement(3)
== 218
-- fail because of implicit null assignment

create or replace function doubledecrement(p1 pos_int) returns pos_int as $$
declare v pos_int := 0;
begin
    return p1;
end$$ language plpgsql
--
CREATE OR REPLACE FUNCTION doubledecrement(p1 pos_int) RETURNS pos_int AS $$
declare v pos_int := 0;
begin
    return p1;
end$$ LANGUAGE plpgsql
== 219
select doubledecrement(3)
--
SELECT doubledecrement(3)
== 220
-- fail at initialization assignment

create or replace function doubledecrement(p1 pos_int) returns pos_int as $$
declare v pos_int := 1;
begin
    v := p1 - 1;
    return v - 1;
end$$ language plpgsql
--
CREATE OR REPLACE FUNCTION doubledecrement(p1 pos_int) RETURNS pos_int AS $$
declare v pos_int := 1;
begin
    v := p1 - 1;
    return v - 1;
end$$ LANGUAGE plpgsql
== 221
select doubledecrement(null)
--
SELECT doubledecrement(NULL)
== 222
-- fail before call
select doubledecrement(0)
--
SELECT doubledecrement(0)
== 223
-- fail before call
select doubledecrement(1)
--
SELECT doubledecrement(1)
== 224
-- fail at assignment to v
select doubledecrement(2)
--
SELECT doubledecrement(2)
== 225
-- fail at return
select doubledecrement(3)
--
SELECT doubledecrement(3)
== 226
-- good

-- Check that ALTER DOMAIN tests columns of derived types

create domain posint as int4
--
CREATE DOMAIN posint AS int4
== 227
-- Currently, this doesn't work for composite types, but verify it complains
create type ddtest1 as (f1 posint)
--
CREATE TYPE ddtest1 AS (f1 posint)
== 228
create table ddtest2(f1 ddtest1)
--
CREATE TABLE ddtest2 (f1 ddtest1)
== 229
insert into ddtest2 values(row(-1))
--
INSERT INTO ddtest2 VALUES (ROW(-1))
== 230
alter domain posint add constraint c1 check(value >= 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c1 CHECK (value >= 0)
== 231
drop table ddtest2
--
DROP TABLE ddtest2
== 232
-- Likewise for domains within arrays of composite
create table ddtest2(f1 ddtest1[])
--
CREATE TABLE ddtest2 (f1 ddtest1[])
== 233
insert into ddtest2 values('{(-1)}')
--
INSERT INTO ddtest2 VALUES ('{(-1)}')
== 234
alter domain posint add constraint c1 check(value >= 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c1 CHECK (value >= 0)
== 235
drop table ddtest2
--
DROP TABLE ddtest2
== 236
-- Likewise for domains within domains over composite
create domain ddtest1d as ddtest1
--
CREATE DOMAIN ddtest1d AS ddtest1
== 237
create table ddtest2(f1 ddtest1d)
--
CREATE TABLE ddtest2 (f1 ddtest1d)
== 238
insert into ddtest2 values('(-1)')
--
INSERT INTO ddtest2 VALUES ('(-1)')
== 239
alter domain posint add constraint c1 check(value >= 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c1 CHECK (value >= 0)
== 240
drop table ddtest2
--
DROP TABLE ddtest2
== 241
drop domain ddtest1d
--
DROP DOMAIN ddtest1d
== 242
-- Likewise for domains within domains over array of composite
create domain ddtest1d as ddtest1[]
--
CREATE DOMAIN ddtest1d AS ddtest1[]
== 243
create table ddtest2(f1 ddtest1d)
--
CREATE TABLE ddtest2 (f1 ddtest1d)
== 244
insert into ddtest2 values('{(-1)}')
--
INSERT INTO ddtest2 VALUES ('{(-1)}')
== 245
alter domain posint add constraint c1 check(value >= 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c1 CHECK (value >= 0)
== 246
drop table ddtest2
--
DROP TABLE ddtest2
== 247
drop domain ddtest1d
--
DROP DOMAIN ddtest1d
== 248
-- Doesn't work for ranges, either
create type rposint as range (subtype = posint)
--
CREATE TYPE rposint AS RANGE (subtype = posint)
== 249
create table ddtest2(f1 rposint)
--
CREATE TABLE ddtest2 (f1 rposint)
== 250
insert into ddtest2 values('(-1,3]')
--
INSERT INTO ddtest2 VALUES ('(-1,3]')
== 251
alter domain posint add constraint c1 check(value >= 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c1 CHECK (value >= 0)
== 252
drop table ddtest2
--
DROP TABLE ddtest2
== 253
drop type rposint
--
DROP TYPE rposint
== 254
alter domain posint add constraint c1 check(value >= 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c1 CHECK (value >= 0)
== 255
create domain posint2 as posint check (value % 2 = 0)
--
CREATE DOMAIN posint2 AS posint CHECK ((value % 2) = 0)
== 256
create table ddtest2(f1 posint2)
--
CREATE TABLE ddtest2 (f1 posint2)
== 257
insert into ddtest2 values(11)
--
INSERT INTO ddtest2 VALUES (11)
== 258
-- fail
insert into ddtest2 values(-2)
--
INSERT INTO ddtest2 VALUES (-2)
== 259
-- fail
insert into ddtest2 values(2)
--
INSERT INTO ddtest2 VALUES (2)
== 260
alter domain posint add constraint c2 check(value >= 10)
--
ALTER DOMAIN posint ADD CONSTRAINT c2 CHECK (value >= 10)
== 261
-- fail
alter domain posint add constraint c2 check(value > 0)
--
ALTER DOMAIN posint ADD CONSTRAINT c2 CHECK (value > 0)
== 262
-- OK

drop table ddtest2
--
DROP TABLE ddtest2
== 263
drop type ddtest1
--
DROP TYPE ddtest1
== 264
drop domain posint cascade
--
DROP DOMAIN posint CASCADE
== 265
