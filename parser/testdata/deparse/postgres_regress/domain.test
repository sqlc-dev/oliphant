create or replace function array_elem_check(numeric) returns numeric as $$
declare
  x numeric(4,2)[1];
begin
  x[1] := $1;
  return x[1];
end$$ language plpgsql
--
CREATE OR REPLACE FUNCTION array_elem_check(numeric) RETURNS numeric AS $$
declare
  x numeric(4,2)[1];
begin
  x[1] := $1;
  return x[1];
end$$ LANGUAGE plpgsql
== 266
select array_elem_check(121.00)
--
SELECT array_elem_check(121.00)
== 267
select array_elem_check(1.23456)
