-- check rounding when casting from float
SELECT x, x::int8 AS int8_value
FROM (VALUES (-2.5::float8),
             (-1.5::float8),
             (-0.5::float8),
             (0.0::float8),
             (0.5::float8),
             (1.5::float8),
             (2.5::float8)) t(x)
--
SELECT x, x::int8 AS int8_value FROM (VALUES (- (2.5)::float8), (- (1.5)::float8), (- (0.5)::float8), ((0.0)::float8), ((0.5)::float8), ((1.5)::float8), ((2.5)::float8)) t(x)
== 135
-- check rounding when casting from numeric
SELECT x, x::int8 AS int8_value
FROM (VALUES (-2.5::numeric),
             (-1.5::numeric),
             (-0.5::numeric),
             (0.0::numeric),
             (0.5::numeric),
             (1.5::numeric),
             (2.5::numeric)) t(x)
--
SELECT x, x::int8 AS int8_value FROM (VALUES (- (2.5)::numeric), (- (1.5)::numeric), (- (0.5)::numeric), ((0.0)::numeric), ((0.5)::numeric), ((1.5)::numeric), ((2.5)::numeric)) t(x)
== 136
-- test gcd()
SELECT a, b, gcd(a, b), gcd(a, -b), gcd(b, a), gcd(-b, a)
FROM (VALUES (0::int8, 0::int8),
             (0::int8, 29893644334::int8),
             (288484263558::int8, 29893644334::int8),
             (-288484263558::int8, 29893644334::int8),
             ((-9223372036854775808)::int8, 1::int8),
             ((-9223372036854775808)::int8, 9223372036854775807::int8),
             ((-9223372036854775808)::int8, 4611686018427387904::int8)) AS v(a, b)
--
