== 050
-- Test with non-strict equality function.
-- We need to create our own type for this.

begin
--
BEGIN
== 051
create type myint
--
CREATE TYPE myint
== 052
create function myintin(cstring) returns myint strict immutable language
  internal as 'int4in'
--
CREATE FUNCTION myintin(cstring) RETURNS myint RETURNS NULL ON NULL INPUT IMMUTABLE LANGUAGE internal AS $$int4in$$
== 053
create function myintout(myint) returns cstring strict immutable language
  internal as 'int4out'
--
CREATE FUNCTION myintout(myint) RETURNS cstring RETURNS NULL ON NULL INPUT IMMUTABLE LANGUAGE internal AS $$int4out$$
== 054
create function myinthash(myint) returns integer strict immutable language
  internal as 'hashint4'
--
CREATE FUNCTION myinthash(myint) RETURNS int RETURNS NULL ON NULL INPUT IMMUTABLE LANGUAGE internal AS $$hashint4$$
== 055
create type myint (input = myintin, output = myintout, like = int4)
--
CREATE TYPE myint (input = myintin, output = myintout, "like" = int4)
== 056
create cast (int4 as myint) without function
--
CREATE CAST (int4 AS myint) WITHOUT FUNCTION
== 057
create cast (myint as int4) without function
--
CREATE CAST (myint AS int4) WITHOUT FUNCTION
== 058
create function myinteq(myint, myint) returns bool as $$
begin
  if $1 is null and $2 is null then
    return true;
  else
    return $1::int = $2::int;
  end if;
end;
$$ language plpgsql immutable
--
CREATE FUNCTION myinteq(myint, myint) RETURNS bool AS $$
begin
  if $1 is null and $2 is null then
    return true;
  else
    return $1::int = $2::int;
  end if;
end;
$$ LANGUAGE plpgsql IMMUTABLE
== 059
create function myintne(myint, myint) returns bool as $$
begin
  return not myinteq($1, $2);
end;
$$ language plpgsql immutable
--
CREATE FUNCTION myintne(myint, myint) RETURNS bool AS $$
begin
  return not myinteq($1, $2);
end;
$$ LANGUAGE plpgsql IMMUTABLE
== 060
create operator = (
  leftarg    = myint,
  rightarg   = myint,
  commutator = =,
  negator    = <>,
  procedure  = myinteq,
  restrict   = eqsel,
  join       = eqjoinsel,
  merges
)
--
CREATE OPERATOR = (leftarg = myint, rightarg = myint, commutator = =, negator = <>, procedure = myinteq, restrict = eqsel, "join" = eqjoinsel, merges)
== 061
create operator <> (
  leftarg    = myint,
  rightarg   = myint,
  commutator = <>,
  negator    = =,
  procedure  = myintne,
  restrict   = eqsel,
  join       = eqjoinsel,
  merges
)
--
CREATE OPERATOR <> (leftarg = myint, rightarg = myint, commutator = <>, negator = =, procedure = myintne, restrict = eqsel, "join" = eqjoinsel, merges)
== 062
create operator class myint_ops
default for type myint using hash as
  operator    1   =  (myint, myint),
  function    1   myinthash(myint)
--
CREATE OPERATOR CLASS myint_ops DEFAULT FOR TYPE myint USING hash AS OPERATOR 1 =(myint, myint), FUNCTION 1 myinthash(myint)
== 063
create table inttest (a myint)
--
CREATE TABLE inttest (a myint)
== 064
insert into inttest values(1::myint),(null)
--
INSERT INTO inttest VALUES (1::myint), (NULL)
== 065
-- try an array with enough elements to cause hashing
select * from inttest where a in (1::myint,2::myint,3::myint,4::myint,5::myint,6::myint,7::myint,8::myint,9::myint, null)
--
SELECT * FROM inttest WHERE a IN (1::myint, 2::myint, 3::myint, 4::myint, 5::myint, 6::myint, 7::myint, 8::myint, 9::myint, NULL)
== 066
select * from inttest where a not in (1::myint,2::myint,3::myint,4::myint,5::myint,6::myint,7::myint,8::myint,9::myint, null)
--
SELECT * FROM inttest WHERE a NOT IN (1::myint, 2::myint, 3::myint, 4::myint, 5::myint, 6::myint, 7::myint, 8::myint, 9::myint, NULL)
== 067
select * from inttest where a not in (0::myint,2::myint,3::myint,4::myint,5::myint,6::myint,7::myint,8::myint,9::myint, null)
--
SELECT * FROM inttest WHERE a NOT IN (0::myint, 2::myint, 3::myint, 4::myint, 5::myint, 6::myint, 7::myint, 8::myint, 9::myint, NULL)
== 068
-- ensure the result matched with the non-hashed version.  We simply remove
-- some array elements so that we don't reach the hashing threshold.
select * from inttest where a in (1::myint,2::myint,3::myint,4::myint,5::myint, null)
--
SELECT * FROM inttest WHERE a IN (1::myint, 2::myint, 3::myint, 4::myint, 5::myint, NULL)
== 069
select * from inttest where a not in (1::myint,2::myint,3::myint,4::myint,5::myint, null)
--
SELECT * FROM inttest WHERE a NOT IN (1::myint, 2::myint, 3::myint, 4::myint, 5::myint, NULL)
== 070
select * from inttest where a not in (0::myint,2::myint,3::myint,4::myint,5::myint, null)
--
SELECT * FROM inttest WHERE a NOT IN (0::myint, 2::myint, 3::myint, 4::myint, 5::myint, NULL)
== 071
rollback
--
ROLLBACK
