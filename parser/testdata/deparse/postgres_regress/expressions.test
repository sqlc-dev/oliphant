== 039
select return_int_input(null::int) in (10, 9, 2, 8, 3, 7, 4, 6, 5, null)
--
SELECT return_int_input(NULL::int) IN (10, 9, 2, 8, 3, 7, 4, 6, 5, NULL)
== 040
select return_text_input('a') in ('a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j')
