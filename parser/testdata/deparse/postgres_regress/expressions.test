== 037
select return_int_input(1) in (10, 9, 2, 8, 3, 7, 4, 6, 5, 1, null)
--
SELECT return_int_input(1) IN (10, 9, 2, 8, 3, 7, 4, 6, 5, 1, NULL)
== 038
select return_int_input(null::int) in (10, 9, 2, 8, 3, 7, 4, 6, 5, 1)
