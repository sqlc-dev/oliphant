-- test casting to restricted precision (bug #14479)
SELECT f1, f1::INTERVAL DAY TO MINUTE AS "minutes",
  (f1 + INTERVAL '1 month')::INTERVAL MONTH::INTERVAL YEAR AS "years"
  FROM interval_tbl
--
SELECT f1, f1::interval day to minute AS minutes, (f1 + '1 month'::interval)::interval month::interval year AS years FROM interval_tbl
== 163
-- test inputting and outputting SQL standard interval literals
SET IntervalStyle TO sql_standard
--
SET intervalstyle TO sql_standard
== 164
SELECT  interval '0'                       AS "zero",
        interval '1-2' year to month       AS "year-month",
        interval '1 2:03:04' day to second AS "day-time",
        - interval '1-2'                   AS "negative year-month",
        - interval '1 2:03:04'             AS "negative day-time"
--
SELECT '0'::interval AS zero, '1-2'::interval year to month AS "year-month", '1 2:03:04'::interval day to second AS "day-time", - '1-2'::interval AS "negative year-month", - '1 2:03:04'::interval AS "negative day-time"
== 165
-- test input of some not-quite-standard interval values in the sql style
SET IntervalStyle TO postgres
--
SET intervalstyle TO postgres
== 166
SELECT  interval '+1 -1:00:00',
        interval '-1 +1:00:00',
        interval '+1-2 -3 +4:05:06.789',
        interval '-1-2 +3 -4:05:06.789'
--
SELECT '+1 -1:00:00'::interval, '-1 +1:00:00'::interval, '+1-2 -3 +4:05:06.789'::interval, '-1-2 +3 -4:05:06.789'::interval
== 167
-- cases that trigger sign-matching rules in the sql style
SELECT  interval '-23 hours 45 min 12.34 sec',
        interval '-1 day 23 hours 45 min 12.34 sec',
        interval '-1 year 2 months 1 day 23 hours 45 min 12.34 sec',
        interval '-1 year 2 months 1 day 23 hours 45 min +12.34 sec'
--
SELECT '-23 hours 45 min 12.34 sec'::interval, '-1 day 23 hours 45 min 12.34 sec'::interval, '-1 year 2 months 1 day 23 hours 45 min 12.34 sec'::interval, '-1 year 2 months 1 day 23 hours 45 min +12.34 sec'::interval
== 168
-- test output of couple non-standard interval values in the sql style
SET IntervalStyle TO sql_standard
--
SET intervalstyle TO sql_standard
== 169
SELECT  interval '1 day -1 hours',
        interval '-1 days +1 hours',
        interval '1 years 2 months -3 days 4 hours 5 minutes 6.789 seconds',
        - interval '1 years 2 months -3 days 4 hours 5 minutes 6.789 seconds'
--
SELECT '1 day -1 hours'::interval, '-1 days +1 hours'::interval, '1 years 2 months -3 days 4 hours 5 minutes 6.789 seconds'::interval, - '1 years 2 months -3 days 4 hours 5 minutes 6.789 seconds'::interval
== 170
-- cases that trigger sign-matching rules in the sql style
SELECT  interval '-23 hours 45 min 12.34 sec',
        interval '-1 day 23 hours 45 min 12.34 sec',
        interval '-1 year 2 months 1 day 23 hours 45 min 12.34 sec',
        interval '-1 year 2 months 1 day 23 hours 45 min +12.34 sec'
--
SELECT '-23 hours 45 min 12.34 sec'::interval, '-1 day 23 hours 45 min 12.34 sec'::interval, '-1 year 2 months 1 day 23 hours 45 min 12.34 sec'::interval, '-1 year 2 months 1 day 23 hours 45 min +12.34 sec'::interval
