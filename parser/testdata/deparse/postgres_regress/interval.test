-- test basic arithmetic
CREATE FUNCTION eval(expr text)
RETURNS text AS
$$
DECLARE
  result text;
BEGIN
  EXECUTE 'select '||expr INTO result;
  RETURN result;
EXCEPTION WHEN OTHERS THEN
  RETURN SQLERRM;
END
$$
LANGUAGE plpgsql
--
CREATE FUNCTION eval(expr text) RETURNS text AS $$
DECLARE
  result text;
BEGIN
  EXECUTE 'select '||expr INTO result;
  RETURN result;
EXCEPTION WHEN OTHERS THEN
  RETURN SQLERRM;
END
$$ LANGUAGE plpgsql
== 380
SELECT d AS date, i AS interval,
       eval(format('date %L + interval %L', d, i)) AS plus,
       eval(format('date %L - interval %L', d, i)) AS minus
FROM (VALUES (date '-infinity'),
             (date '1995-08-06'),
             (date 'infinity')) AS t1(d),
     (VALUES (interval '-infinity'),
             (interval 'infinity')) AS t2(i)
--
SELECT d AS date, i AS "interval", eval(format('date %L + interval %L', d, i)) AS plus, eval(format('date %L - interval %L', d, i)) AS minus FROM (VALUES ('-infinity'::date), ('1995-08-06'::date), ('infinity'::date)) t1(d), (VALUES ('-infinity'::interval), ('infinity'::interval)) t2(i)
