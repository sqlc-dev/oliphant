== 001
SELECT *
FROM generate_series(1, 10) i
WHERE
    i > ANY (
        SELECT generate_series(1, 8, 2)
    )
    AND i <> ALL (
        SELECT generate_series(3, 7, 2)
    )
--
SELECT * FROM generate_series(1, 10) i WHERE i > ANY (SELECT generate_series(1, 8, 2)) AND i <> ALL (SELECT generate_series(3, 7, 2))
