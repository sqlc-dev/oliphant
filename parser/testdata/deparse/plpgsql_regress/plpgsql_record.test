== 049
-- check repeated assignments to composite fields
create table some_table (id int, data text)
--
CREATE TABLE some_table (id int, data text)
== 050
do $$
declare r some_table;
begin
  r := (23, 'skidoo');
  for i in 1 .. 10 loop
    r.id := r.id + i;
    r.data := r.data || ' ' || i;
  end loop;
  raise notice 'r = %', r;
end$$
--
DO $$
declare r some_table;
begin
  r := (23, 'skidoo');
  for i in 1 .. 10 loop
    r.id := r.id + i;
    r.data := r.data || ' ' || i;
  end loop;
  raise notice 'r = %', r;
end$$
== 051
-- check behavior of function declared to return "record"

create function returnsrecord(int) returns record language plpgsql as
$$ begin return row($1,$1+1); end $$
--
CREATE FUNCTION returnsrecord(int) RETURNS record LANGUAGE plpgsql AS $$ begin return row($1,$1+1); end $$
