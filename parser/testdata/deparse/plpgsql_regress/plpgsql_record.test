CREATE FUNCTION sillytrig() RETURNS trigger LANGUAGE plpgsql AS $$begin
  raise notice 'old.ctid = %', old.ctid;
  raise notice 'old.tableoid = %', old.tableoid::regclass;
  return new;
end$$
