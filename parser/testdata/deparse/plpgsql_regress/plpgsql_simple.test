== 018
-- Check case where called function changes from non-SRF to SRF (bug #18497)

create or replace function simplecaller() returns int language plpgsql
as $$
declare x int;
begin
  x := simplesql();
  return x;
end$$
--
CREATE OR REPLACE FUNCTION simplecaller() RETURNS int LANGUAGE plpgsql AS $$
declare x int;
begin
  x := simplesql();
  return x;
end$$
== 019
select simplecaller()
--
SELECT simplecaller()
== 020
