== 258
-- avoid mergejoins
SET LOCAL from_collapse_limit = 1
--
e005d344bf61841e
== 259
-- allows easy changing of join order

CREATE TABLE hjtest_1 (a text, b int, id int, c bool)
--
e374a541eeed2988
== 260
CREATE TABLE hjtest_2 (a bool, id int, b text, c int)
