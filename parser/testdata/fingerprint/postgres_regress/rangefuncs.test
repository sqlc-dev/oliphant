create temp table tt(f1 serial, data text)
--
e7cfe4898efcc663
== 280
create function insert_tt(text) returns int as
$$ insert into tt(data) values($1) returning f1 $$
language sql
--
6461ffa9d46d8eba
== 281
select insert_tt('foo')
--
9e5f164bd15162e0
== 282
select insert_tt('bar')
--
9e5f164bd15162e0
== 283
select * from tt
--
bb479da77b547617
