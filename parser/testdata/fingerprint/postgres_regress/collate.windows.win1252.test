-- nondeterministic collations
-- (not supported with libc provider)
do $$
BEGIN
  EXECUTE 'CREATE COLLATION ctest_det (locale = ' ||
          quote_literal((SELECT collcollate FROM pg_collation WHERE
          collname = 'en_US')) || ', deterministic = true);';
  END
