-- NULLs in the range cannot return tuples
SELECT ctid FROM tidrangescan WHERE ctid >= (SELECT NULL::tid)
--
2e170930c7779a22
== 033
-- rescans
EXPLAIN (COSTS OFF)
SELECT t.ctid,t2.c FROM tidrangescan t,
LATERAL (SELECT count(*) c FROM tidrangescan t2 WHERE t2.ctid <= t.ctid) t2
WHERE t.ctid < '(1,0)'
--
36b135d081ba1b25
== 034
SELECT t.ctid,t2.c FROM tidrangescan t,
LATERAL (SELECT count(*) c FROM tidrangescan t2 WHERE t2.ctid <= t.ctid) t2
WHERE t.ctid < '(1,0)'
--
50cf79f85106f8d6
== 035
-- cursors

-- Ensure we get a TID Range scan without a Materialize node.
EXPLAIN (COSTS OFF)
DECLARE c SCROLL CURSOR FOR SELECT ctid FROM tidrangescan WHERE ctid < '(1,0)'
--
895d4fad07f27543
== 036
BEGIN
--
b16b431979fc3e05
== 037
DECLARE c SCROLL CURSOR FOR SELECT ctid FROM tidrangescan WHERE ctid < '(1,0)'
--
34b422cfc95dc1d3
== 038
FETCH NEXT c
--
81daee5623e71d72
== 039
FETCH NEXT c
--
81daee5623e71d72
== 040
FETCH PRIOR c
--
c1db20292effe803
== 041
FETCH FIRST c
--
f311bc209888b596
== 042
FETCH LAST c
--
7250b9cbcd7cf751
== 043
COMMIT
--
7bbcde9cfab6c79c
== 044
DROP TABLE tidrangescan
--
77cda7980e3f1f2e
== 045
RESET enable_seqscan
