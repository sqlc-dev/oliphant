== 001
|--
-- Enum tests
|--

CREATE TYPE rainbow AS ENUM ('red', 'orange', 'yellow', 'green', 'blue', 'purple')
--
3486536487f43c00
== 002
|--
-- Did it create the right number of rows?
|--
SELECT COUNT(*) FROM pg_enum WHERE enumtypid = 'rainbow'::regtype
--
ede7ff699d252958
== 003
|--
-- I/O functions
|--
SELECT 'red'::rainbow
--
50fde20626009aba
== 004
SELECT 'mauve'::rainbow
--
50fde20626009aba
== 005
-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('red', 'rainbow')
--
15f508bf2432ed80
== 006
SELECT pg_input_is_valid('mauve', 'rainbow')
--
15f508bf2432ed80
== 007
SELECT * FROM pg_input_error_info('mauve', 'rainbow')
--
3498aded7ef03791
== 008
SELECT * FROM pg_input_error_info(repeat('too_long', 32), 'rainbow')
--
8580bf01a43392ff
== 009
|--
-- adding new values
|--

CREATE TYPE planets AS ENUM ( 'venus', 'earth', 'mars' )
--
c24135119f993cd9
== 010
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'planets'::regtype
ORDER BY 2
--
977a0735a879d615
== 011
ALTER TYPE planets ADD VALUE 'uranus'
--
53defeefbb90a16a
== 012
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'planets'::regtype
ORDER BY 2
--
977a0735a879d615
== 013
ALTER TYPE planets ADD VALUE 'mercury' BEFORE 'venus'
--
044e7d95d01d38d5
== 014
ALTER TYPE planets ADD VALUE 'saturn' BEFORE 'uranus'
--
66cbb96f14e63fea
== 015
ALTER TYPE planets ADD VALUE 'jupiter' AFTER 'mars'
--
a9468adb69ceca1b
== 016
ALTER TYPE planets ADD VALUE 'neptune' AFTER 'uranus'
--
e598061c2014ef56
== 017
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'planets'::regtype
ORDER BY 2
--
977a0735a879d615
== 018
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'planets'::regtype
ORDER BY enumlabel::planets
--
f5fef7913242fb3e
== 019
-- errors for adding labels
ALTER TYPE planets ADD VALUE
  'plutoplutoplutoplutoplutoplutoplutoplutoplutoplutoplutoplutoplutopluto'
--
f01341af1f48e4dd
== 020
ALTER TYPE planets ADD VALUE 'pluto' AFTER 'zeus'
--
9956204ef5bd9da0
== 021
-- if not exists tests

--  existing value gives error
ALTER TYPE planets ADD VALUE 'mercury'
--
4c33f36bab797b45
== 022
-- unless IF NOT EXISTS is specified
ALTER TYPE planets ADD VALUE IF NOT EXISTS 'mercury'
--
daed2d46916a42eb
== 023
-- should be neptune, not mercury
SELECT enum_last(NULL::planets)
--
27c7c0ddd0017582
== 024
ALTER TYPE planets ADD VALUE IF NOT EXISTS 'pluto'
--
b4d4fc89fcadce72
== 025
-- should be pluto, i.e. the new value
SELECT enum_last(NULL::planets)
--
27c7c0ddd0017582
== 026
