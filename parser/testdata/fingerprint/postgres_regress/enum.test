215897f587fe1010
== 063
SELECT * FROM enumtest WHERE col <> 'orange' ORDER BY col
--
25fc5db9867a38b1
== 064
SELECT * FROM enumtest WHERE col > 'yellow' ORDER BY col
--
0a27018ad4227089
== 065
SELECT * FROM enumtest WHERE col >= 'yellow' ORDER BY col
--
c5266b24e0d027f3
== 066
