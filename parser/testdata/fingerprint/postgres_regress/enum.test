|--
-- User functions, can't test perl/python etc here since may not be compiled.
|--
CREATE FUNCTION echo_me(anyenum) RETURNS text AS $$
BEGIN
RETURN $1::text || 'omg';
END
$$ LANGUAGE plpgsql
--
6a1fb0134ae6c0b0
== 110
SELECT echo_me('red'::rainbow)
--
8caafb2cd67b8566
== 111
|--
-- Concrete function should override generic one
|--
CREATE FUNCTION echo_me(rainbow) RETURNS text AS $$
BEGIN
RETURN $1::text || 'wtf';
END
$$ LANGUAGE plpgsql
--
488e23b3572654f0
== 112
SELECT echo_me('red'::rainbow)
--
8caafb2cd67b8566
== 113
|--
-- If we drop the original generic one, we don't have to qualify the type
-- anymore, since there's only one match
|--
DROP FUNCTION echo_me(anyenum)
--
ac9592da03728250
== 114
SELECT echo_me('red')
--
8caafb2cd67b8566
== 115
DROP FUNCTION echo_me(rainbow)
--
b2c5436c2fcf99d9
== 116
|--
-- RI triggers on enum types
|--
CREATE TABLE enumtest_parent (id rainbow PRIMARY KEY)
--
58145665bae43bc3
== 117
CREATE TABLE enumtest_child (parent rainbow REFERENCES enumtest_parent)
--
fe8c497408680a10
== 118
INSERT INTO enumtest_parent VALUES ('red')
--
0f9cb4391de45ecb
== 119
INSERT INTO enumtest_child VALUES ('red')
--
1e17d7afec6317a1
== 120
INSERT INTO enumtest_child VALUES ('blue')
--
1e17d7afec6317a1
== 121
-- fail
DELETE FROM enumtest_parent
--
b156db4208a592e8
== 122
-- fail
|--
-- cross-type RI should fail
|--
CREATE TYPE bogus AS ENUM('good', 'bad', 'ugly')
--
fd506f26602b15ef
== 123
CREATE TABLE enumtest_bogus_child(parent bogus REFERENCES enumtest_parent)
--
2786f0b2478d10fe
== 124
DROP TYPE bogus
--
cdef1cc178ae6767
== 125
-- check renaming a value
ALTER TYPE rainbow RENAME VALUE 'red' TO 'crimson'
--
a0dfb7aa5ee3a85b
== 126
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'rainbow'::regtype
ORDER BY 2
--
977a0735a879d615
== 127
-- check that renaming a non-existent value fails
ALTER TYPE rainbow RENAME VALUE 'red' TO 'crimson'
--
a0dfb7aa5ee3a85b
== 128
-- check that renaming to an existent value fails
ALTER TYPE rainbow RENAME VALUE 'blue' TO 'green'
--
bf4d48173cdb1aab
== 129
|--
-- check transactional behaviour of ALTER TYPE ... ADD VALUE
|--
CREATE TYPE bogus AS ENUM('good')
--
835bb0b04ec4ef01
== 130
-- check that we can add new values to existing enums in a transaction
-- but we can't use them
BEGIN
--
b16b431979fc3e05
== 131
ALTER TYPE bogus ADD VALUE 'new'
--
b6b3ed9af1d2b841
== 132
SAVEPOINT x
--
8ebd566ea1bf947b
== 133
SELECT 'new'::bogus
--
50fde20626009aba
== 134
-- unsafe
ROLLBACK TO x
--
ede7bfabb934a1db
== 135
SELECT enum_first(null::bogus)
--
2f27bbbd1dc861fd
== 136
-- safe
SELECT enum_last(null::bogus)
--
27c7c0ddd0017582
== 137
-- unsafe
ROLLBACK TO x
--
ede7bfabb934a1db
== 138
SELECT enum_range(null::bogus)
--
ea0c3c0193911e43
== 139
-- unsafe
ROLLBACK TO x
--
ede7bfabb934a1db
== 140
COMMIT
--
7bbcde9cfab6c79c
== 141
SELECT 'new'::bogus
--
50fde20626009aba
== 142
-- now safe
SELECT enumlabel, enumsortorder
FROM pg_enum
WHERE enumtypid = 'bogus'::regtype
ORDER BY 2
--
977a0735a879d615
== 143
-- check that we recognize the case where the enum already existed but was
-- modified in the current txn; this should not be considered safe
BEGIN
--
b16b431979fc3e05
== 144
ALTER TYPE bogus RENAME TO bogon
--
617fefcbbd2ae5c3
== 145
ALTER TYPE bogon ADD VALUE 'bad'
--
e976d4f168374d24
== 146
SELECT 'bad'::bogon
--
50fde20626009aba
== 147
ROLLBACK
--
a46081a556fda027
== 148
-- but a renamed value is safe to use later in same transaction
BEGIN
--
b16b431979fc3e05
== 149
ALTER TYPE bogus RENAME VALUE 'good' to 'bad'
--
4d10b151237973c5
== 150
SELECT 'bad'::bogus
--
50fde20626009aba
== 151
ROLLBACK
--
a46081a556fda027
== 152
DROP TYPE bogus
--
cdef1cc178ae6767
== 153
-- check that values created during CREATE TYPE can be used in any case
BEGIN
--
b16b431979fc3e05
== 154
CREATE TYPE bogus AS ENUM('good','bad','ugly')
--
fd506f26602b15ef
== 155
ALTER TYPE bogus RENAME TO bogon
--
617fefcbbd2ae5c3
== 156
select enum_range(null::bogon)
--
ea0c3c0193911e43
== 157
ROLLBACK
--
a46081a556fda027
== 158
-- we must allow this usage to support pg_dump in binary upgrade mode
BEGIN
--
b16b431979fc3e05
== 159
CREATE TYPE bogus AS ENUM('good')
--
835bb0b04ec4ef01
== 160
ALTER TYPE bogus RENAME TO bogon
--
617fefcbbd2ae5c3
== 161
ALTER TYPE bogon ADD VALUE 'bad'
--
e976d4f168374d24
== 162
ALTER TYPE bogon ADD VALUE 'ugly'
--
d97800329a34275f
== 163
select enum_range(null::bogon)
--
ea0c3c0193911e43
== 164
ROLLBACK
--
a46081a556fda027
== 165
|--
-- Cleanup
|--
DROP TABLE enumtest_child
--
12e915d8b590498a
== 166
DROP TABLE enumtest_parent
--
87d9b4bbd390cf19
== 167
DROP TABLE enumtest
--
af1ab507d4943a71
== 168
DROP TYPE rainbow
--
516f12665bae7852
== 169
|--
-- Verify properly cleaned up
|--
SELECT COUNT(*) FROM pg_type WHERE typname = 'rainbow'
--
d390c71f793cbefd
== 170
SELECT * FROM pg_enum WHERE NOT EXISTS
  (SELECT 1 FROM pg_type WHERE pg_type.oid = enumtypid)
--
de7796a445dc8488
