c5266b24e0d027f3
== 080
SELECT * FROM enumtest WHERE col < 'green' ORDER BY col
--
ffed8050d93cf312
== 081
SELECT * FROM enumtest WHERE col <= 'green' ORDER BY col
--
85de2bef499d1423
== 082
SELECT min(col) FROM enumtest
--
1bd0ad6555ef0f40
== 083
SELECT max(col) FROM enumtest
--
29e00ab18d8451c5
== 084
SELECT max(col) FROM enumtest WHERE col < 'green'
--
5f6323d6ca3ce51a
== 085
DROP INDEX enumtest_btree
