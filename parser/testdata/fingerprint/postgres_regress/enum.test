|--
-- Basic table creation, row selection
|--
CREATE TABLE enumtest (col rainbow)
--
7df67084bda29b19
== 059
INSERT INTO enumtest values ('red'), ('orange'), ('yellow'), ('green')
--
5c81fac301d95e12
== 060
COPY enumtest FROM stdin
--
b37a28d24e873977
== 061
SELECT * FROM enumtest
--
196bb9791f50b724
== 062
|--
-- Operators, no index
|--
SELECT * FROM enumtest WHERE col = 'orange'
