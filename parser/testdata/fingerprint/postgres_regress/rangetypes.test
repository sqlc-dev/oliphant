== 001
-- Tests for range data types.

|--
-- test input parser
-- (type textrange was already made in test_setup.sql)
|--

-- negative tests; should fail
select ''::textrange
--
50fde20626009aba
== 002
select '-[a,z)'::textrange
--
50fde20626009aba
== 003
select '[a,z) - '::textrange
--
50fde20626009aba
== 004
select '(",a)'::textrange
--
50fde20626009aba
== 005
select '(,,a)'::textrange
--
50fde20626009aba
== 006
select '(),a)'::textrange
--
50fde20626009aba
== 007
select '(a,))'::textrange
--
50fde20626009aba
== 008
select '(],a)'::textrange
--
50fde20626009aba
== 009
select '(a,])'::textrange
--
50fde20626009aba
== 010
select '[z,a]'::textrange
--
50fde20626009aba
== 011
