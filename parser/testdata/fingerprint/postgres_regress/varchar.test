== 001
|--
-- VARCHAR
|--

|--
-- Build a table for testing
-- (This temporarily hides the table created in test_setup.sql)
|--

CREATE TEMP TABLE VARCHAR_TBL(f1 varchar(1))
--
d9d54e61c93c9fce
== 002
INSERT INTO VARCHAR_TBL (f1) VALUES ('a')
--
6086b7a3b55b1996
== 003
INSERT INTO VARCHAR_TBL (f1) VALUES ('A')
--
6086b7a3b55b1996
== 004
-- any of the following three input formats are acceptable
INSERT INTO VARCHAR_TBL (f1) VALUES ('1')
--
6086b7a3b55b1996
== 005
INSERT INTO VARCHAR_TBL (f1) VALUES (2)
--
6086b7a3b55b1996
== 006
INSERT INTO VARCHAR_TBL (f1) VALUES ('3')
--
6086b7a3b55b1996
== 007
-- zero-length char
INSERT INTO VARCHAR_TBL (f1) VALUES ('')
--
6086b7a3b55b1996
== 008
-- try varchar's of greater than 1 length
INSERT INTO VARCHAR_TBL (f1) VALUES ('cd')
--
6086b7a3b55b1996
== 009
INSERT INTO VARCHAR_TBL (f1) VALUES ('c     ')
--
6086b7a3b55b1996
== 010
SELECT * FROM VARCHAR_TBL
--
24671c5a8c47d2e5
== 011
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 <> 'a'
--
d62a8d0df96335fd
== 012
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 = 'a'
--
47218b1580ac369e
== 013
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 < 'a'
--
bd217b46ad196ac6
== 014
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 <= 'a'
--
cdfa0cab9a8894f4
== 015
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 > 'a'
--
1d358f73c08fb66a
== 016
SELECT c.*
   FROM VARCHAR_TBL c
   WHERE c.f1 >= 'a'
--
0a39aa265819b073
== 017
DROP TABLE VARCHAR_TBL
--
6034637024ae375d
== 018
|--
-- Now test longer arrays of char
|--
-- This varchar_tbl was already created and filled in test_setup.sql.
-- Here we just try to insert bad values.
|--

INSERT INTO VARCHAR_TBL (f1) VALUES ('abcde')
--
6086b7a3b55b1996
== 019
SELECT * FROM VARCHAR_TBL
--
24671c5a8c47d2e5
== 020
-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('abcd  ', 'varchar(4)')
--
15f508bf2432ed80
== 021
SELECT pg_input_is_valid('abcde', 'varchar(4)')
--
15f508bf2432ed80
== 022
SELECT * FROM pg_input_error_info('abcde', 'varchar(4)')
--
3498aded7ef03791
