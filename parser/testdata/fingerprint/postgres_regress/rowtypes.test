== 176
select fcompos1(row(1,'one'))
--
df16437733ffdd97
== 177
select fcompos2(row(2,'two'))
--
9c2f74c545dc3575
== 178
select fcompos3(row(3,'three'))
--
01ba0f8738b91ed9
== 179
select * from compos
--
a586252cd19d2ef6
