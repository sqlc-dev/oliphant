== 001
-- Strings.
SELECT '""'::json
--
50fde20626009aba
== 002
-- OK.
SELECT $$''$$::json
--
50fde20626009aba
== 003
-- ERROR, single quotes are not allowed
SELECT '"abc"'::json
--
50fde20626009aba
== 004
-- OK
SELECT '"abc'::json
--
50fde20626009aba
== 005
-- ERROR, quotes not closed
SELECT '"abc
def"'::json
--
50fde20626009aba
== 006
-- ERROR, unescaped newline in string constant
SELECT '"\n\"\\"'::json
--
50fde20626009aba
== 007
-- OK, legal escapes
SELECT '"\v"'::json
--
50fde20626009aba
== 008
-- ERROR, not a valid JSON escape

-- Check fast path for longer strings (at least 16 bytes long)
SELECT ('"'||repeat('.', 12)||'abc"')::json
--
2a14fe449c213d91
== 009
-- OK
SELECT ('"'||repeat('.', 12)||'abc\n"')::json
--
2a14fe449c213d91
== 010
-- OK, legal escapes

-- see json_encoding test for input with unicode escapes

-- Numbers.
SELECT '1'::json
--
50fde20626009aba
== 011
-- OK
SELECT '0'::json
--
50fde20626009aba
== 012
-- OK
SELECT '01'::json
--
50fde20626009aba
== 013
-- ERROR, not valid according to JSON spec
SELECT '0.1'::json
--
50fde20626009aba
== 014
-- OK
SELECT '9223372036854775808'::json
--
50fde20626009aba
== 015
-- OK, even though it's too large for int8
SELECT '1e100'::json
--
50fde20626009aba
== 016
-- OK
SELECT '1.3e100'::json
--
50fde20626009aba
== 017
-- OK
SELECT '1f2'::json
--
50fde20626009aba
== 018
-- ERROR
SELECT '0.x1'::json
--
50fde20626009aba
== 019
-- ERROR
SELECT '1.3ex100'::json
--
50fde20626009aba
== 020
-- ERROR

-- Arrays.
SELECT '[]'::json
--
50fde20626009aba
== 021
-- OK
SELECT '[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]'::json
--
50fde20626009aba
== 022
-- OK
SELECT '[1,2]'::json
--
50fde20626009aba
== 023
-- OK
SELECT '[1,2,]'::json
--
50fde20626009aba
== 024
-- ERROR, trailing comma
SELECT '[1,2'::json
--
50fde20626009aba
== 025
-- ERROR, no closing bracket
SELECT '[1,[2]'::json
--
50fde20626009aba
== 026
-- ERROR, no closing bracket

-- Objects.
SELECT '{}'::json
--
50fde20626009aba
== 027
-- OK
SELECT '{"abc"}'::json
--
50fde20626009aba
== 028
-- ERROR, no value
SELECT '{"abc":1}'::json
--
50fde20626009aba
== 029
-- OK
SELECT '{1:"abc"}'::json
--
50fde20626009aba
== 030
-- ERROR, keys must be strings
SELECT '{"abc",1}'::json
--
50fde20626009aba
== 031
-- ERROR, wrong separator
SELECT '{"abc"=1}'::json
--
50fde20626009aba
== 032
-- ERROR, totally wrong separator
SELECT '{"abc"::1}'::json
--
50fde20626009aba
== 033
-- ERROR, another wrong separator
SELECT '{"abc":1,"def":2,"ghi":[3,4],"hij":{"klm":5,"nop":[6]}}'::json
--
50fde20626009aba
== 034
-- OK
SELECT '{"abc":1:2}'::json
--
50fde20626009aba
== 035
-- ERROR, colon in wrong spot
SELECT '{"abc":1,3}'::json
--
50fde20626009aba
== 036
-- ERROR, no value

-- Recursion.
SET max_stack_depth = '100kB'
--
1ca796e55e145255
== 037
SELECT repeat('[', 10000)::json
--
40f7c15a4c738e41
== 038
SELECT repeat('{"a":', 10000)::json
