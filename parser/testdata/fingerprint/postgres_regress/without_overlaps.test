|--
-- test PRIMARY KEY and UNIQUE constraints' interaction with domains
|--

-- range over domain:
CREATE DOMAIN int4_d as integer check (value <> 10)
--
607c9840c83a455f
== 052
CREATE TYPE int4_d_range as range (subtype = int4_d)
--
15a27e0d9140582c
== 053
CREATE TABLE temporal_rng4 (
  id int4range,
  valid_at int4_d_range,
  CONSTRAINT temporal_rng4_pk PRIMARY KEY(id, valid_at WITHOUT OVERLAPS)
)
--
c7f93c0024bb3335
== 054
INSERT INTO temporal_rng4 VALUES ('[1,11)', '[9,10)')
--
94c715829f6172ca
== 055
-- start bound violates domain
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[10,11)')
--
94c715829f6172ca
== 056
-- end bound violates domain
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[1,13)'), ('[1,2)', '[2,5)')
--
94c715829f6172ca
== 057
-- overlaps
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[1,13)'), ('[1,2)', '[20,23)')
--
94c715829f6172ca
== 058
-- okay
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[30,)')
--
94c715829f6172ca
== 059
-- null bound is okay
DROP TABLE temporal_rng4
--
f6237ad454bb457c
== 060
-- domain over range:
CREATE DOMAIN int4range_d AS int4range CHECK (VALUE <> '[10,11)')
--
9e858cef81ce7f82
== 061
CREATE TABLE temporal_rng4 (
  id int4range,
  valid_at int4range_d,
  CONSTRAINT temporal_rng4_pk UNIQUE (id, valid_at WITHOUT OVERLAPS)
)
--
5c543e43764e91f1
== 062
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[10,11)')
--
94c715829f6172ca
== 063
-- violates domain
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[1,13)'), ('[1,2)', '[2,13)')
--
94c715829f6172ca
== 064
-- overlaps
INSERT INTO temporal_rng4 VALUES ('[1,2)', '[1,13)'), ('[1,2)', '[20,23)')
--
94c715829f6172ca
== 065
-- okay
DROP TABLE temporal_rng4
--
f6237ad454bb457c
