-- Check that domain constraints on prepared statement parameters of
-- unknown type are enforced correctly.
create domain pos_int as int4 check (value > 0) not null
--
1cc97ba74842207a
== 198
prepare s1 as select $1::pos_int = 10 as "is_ten"
--
450d7080935d6b22
== 199
execute s1(10)
--
44ef1d2beabd53e8
== 200
execute s1(0)
--
44ef1d2beabd53e8
== 201
-- should fail
execute s1(NULL)
--
44ef1d2beabd53e8
== 202
-- should fail

-- Check that domain constraints on plpgsql function parameters, results,
-- and local variables are enforced correctly.

create function doubledecrement(p1 pos_int) returns pos_int as $$
declare v pos_int;
begin
    return p1;
end$$ language plpgsql
--
254dd21288d2950a
== 203
select doubledecrement(3)
--
36b5aa9ab204ca9c
== 204
-- fail because of implicit null assignment

create or replace function doubledecrement(p1 pos_int) returns pos_int as $$
declare v pos_int := 0;
begin
    return p1;
end$$ language plpgsql
--
3c4e15c4367e4abb
== 205
select doubledecrement(3)
--
36b5aa9ab204ca9c
== 206
-- fail at initialization assignment

create or replace function doubledecrement(p1 pos_int) returns pos_int as $$
declare v pos_int := 1;
begin
    v := p1 - 1;
    return v - 1;
end$$ language plpgsql
--
3c4e15c4367e4abb
== 207
select doubledecrement(null)
--
36b5aa9ab204ca9c
== 208
-- fail before call
select doubledecrement(0)
--
36b5aa9ab204ca9c
== 209
-- fail before call
select doubledecrement(1)
--
36b5aa9ab204ca9c
== 210
-- fail at assignment to v
select doubledecrement(2)
--
36b5aa9ab204ca9c
== 211
-- fail at return
select doubledecrement(3)
--
36b5aa9ab204ca9c
== 212
-- good

