|--
-- Check enforcement of changing constraints in plpgsql
|--

create domain di as int
--
941ab23d10083b21
== 291
create function dom_check(int) returns di as $$
declare d di;
begin
  d := $1::di;
  return d;
end
$$ language plpgsql immutable
--
f8ec0a5b96b0ac78
== 292
select dom_check(0)
--
79a2dac16c41863b
== 293
alter domain di add constraint pos check (value > 0)
--
dd10152844a57a4a
== 294
select dom_check(0)
--
79a2dac16c41863b
== 295
-- fail

alter domain di drop constraint pos
--
c27a3ffdd5b816a3
== 296
select dom_check(0)
--
79a2dac16c41863b
== 297
-- implicit cast during assignment is a separate code path, test that too

create or replace function dom_check(int) returns di as $$
declare d di;
begin
  d := $1;
  return d;
end
$$ language plpgsql immutable
--
6c486eb7a41b9753
== 298
select dom_check(0)
--
79a2dac16c41863b
== 299
alter domain di add constraint pos check (value > 0)
--
dd10152844a57a4a
== 300
select dom_check(0)
--
79a2dac16c41863b
== 301
-- fail

alter domain di drop constraint pos
--
c27a3ffdd5b816a3
== 302
select dom_check(0)
--
79a2dac16c41863b
== 303
drop function dom_check(int)
--
0329fab9cce9bffa
== 304
drop domain di
