|--
-- Check enforcement of changing constraints in plpgsql
|--

create domain di as int
--
941ab23d10083b21
== 277
create function dom_check(int) returns di as $$
declare d di;
begin
  d := $1::di;
  return d;
end
$$ language plpgsql immutable
--
f8ec0a5b96b0ac78
== 278
select dom_check(0)
--
79a2dac16c41863b
== 279
alter domain di add constraint pos check (value > 0)
--
21d47768a18f5650
== 280
select dom_check(0)
--
79a2dac16c41863b
== 281
-- fail

alter domain di drop constraint pos
--
c27a3ffdd5b816a3
== 282
select dom_check(0)
--
79a2dac16c41863b
== 283
-- implicit cast during assignment is a separate code path, test that too

create or replace function dom_check(int) returns di as $$
declare d di;
begin
  d := $1;
  return d;
end
$$ language plpgsql immutable
--
6c486eb7a41b9753
== 284
select dom_check(0)
--
79a2dac16c41863b
== 285
alter domain di add constraint pos check (value > 0)
--
21d47768a18f5650
== 286
select dom_check(0)
--
79a2dac16c41863b
== 287
-- fail

alter domain di drop constraint pos
--
c27a3ffdd5b816a3
== 288
select dom_check(0)
--
79a2dac16c41863b
== 289
drop function dom_check(int)
--
0329fab9cce9bffa
== 290
drop domain di
--
35bcdfcfa5d7f184
