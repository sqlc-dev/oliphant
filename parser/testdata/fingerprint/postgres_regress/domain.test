|--
-- Check enforcement of domain-related typmod in plpgsql (bug #5717)
|--

create or replace function array_elem_check(numeric) returns numeric as $$
declare
  x numeric(4,2)[1];
begin
  x[1] := $1;
  return x[1];
end$$ language plpgsql
--
3590e964de4de3ca
== 252
select array_elem_check(121.00)
