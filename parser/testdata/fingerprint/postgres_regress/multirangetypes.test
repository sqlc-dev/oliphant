== 001
-- Tests for multirange data types.

|--
-- test input parser
|--

-- negative tests; should fail
select ''::textmultirange
--
50fde20626009aba
== 002
select '{,}'::textmultirange
--
50fde20626009aba
== 003
select '{(,)}.'::textmultirange
--
50fde20626009aba
== 004
select '{[a,c),}'::textmultirange
--
50fde20626009aba
== 005
select '{,[a,c)}'::textmultirange
--
50fde20626009aba
== 006
select '{-[a,z)}'::textmultirange
--
50fde20626009aba
== 007
select '{[a,z) - }'::textmultirange
--
50fde20626009aba
== 008
select '{(",a)}'::textmultirange
--
50fde20626009aba
== 009
select '{(,,a)}'::textmultirange
--
50fde20626009aba
== 010
select '{(),a)}'::textmultirange
--
50fde20626009aba
== 011
select '{(a,))}'::textmultirange
--
50fde20626009aba
== 012
select '{(],a)}'::textmultirange
--
50fde20626009aba
== 013
select '{(a,])}'::textmultirange
--
50fde20626009aba
== 014
select '{[z,a]}'::textmultirange
--
50fde20626009aba
== 015
-- should succeed
select '{}'::textmultirange
--
50fde20626009aba
== 016
select '  {}  '::textmultirange
--
50fde20626009aba
== 017
select ' { empty, empty }  '::textmultirange
--
50fde20626009aba
== 018
select ' {( " a " " a ", " z " " z " )  }'::textmultirange
--
50fde20626009aba
== 019
select textrange('\\\\', repeat('a', 200))::textmultirange
--
4a21dba712b4e801
== 020
select '{(,z)}'::textmultirange
--
50fde20626009aba
== 021
select '{(a,)}'::textmultirange
--
50fde20626009aba
== 022
select '{[,z]}'::textmultirange
--
50fde20626009aba
== 023
