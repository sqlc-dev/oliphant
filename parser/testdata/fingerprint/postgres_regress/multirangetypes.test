50fde20626009aba
== 042
select '{[a,a], [b,b], [c,c]}'::textmultirange
--
50fde20626009aba
== 043
select '{[a,d], [b,e]}'::textmultirange
--
50fde20626009aba
== 044
select '{[a,d), [d,e)}'::textmultirange
--
50fde20626009aba
== 045
-- these are allowed but normalize to empty:
select '{[a,a)}'::textmultirange
--
50fde20626009aba
== 046
select '{(a,a]}'::textmultirange
--
50fde20626009aba
== 047
select '{(a,a)}'::textmultirange
--
50fde20626009aba
== 048
