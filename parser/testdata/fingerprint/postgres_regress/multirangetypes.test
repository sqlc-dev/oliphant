50fde20626009aba
== 040
-- without canonicalization, we can't join these:
select '{[a,a], [b,b]}'::textmultirange
--
50fde20626009aba
== 041
-- with canonicalization, we can join these:
select '{[1,2], [3,4]}'::int4multirange
