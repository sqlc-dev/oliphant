--
50fde20626009aba
== 031
select '{((,z)}'::textmultirange
--
50fde20626009aba
== 032
select '{([,z)}'::textmultirange
--
50fde20626009aba
== 033
select '{(!,()}'::textmultirange
--
50fde20626009aba
== 034
select '{(!,[)}'::textmultirange
--
50fde20626009aba
== 035
select '{[a,a]}'::textmultirange
--
50fde20626009aba
== 036
