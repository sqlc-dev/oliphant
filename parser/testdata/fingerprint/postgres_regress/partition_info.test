-- Test table partition trees
CREATE TABLE ptif_test (a int, b int) PARTITION BY range (a)
--
b1a029a6838963ce
== 008
CREATE TABLE ptif_test0 PARTITION OF ptif_test
  FOR VALUES FROM (minvalue) TO (0) PARTITION BY list (b)
