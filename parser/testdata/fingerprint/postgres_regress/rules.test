|--
-- RULES
-- From Jan's original setup_ruletest.sql and run_ruletest.sql
-- - thomas 1998-09-13
|--

|--
-- Tables and rules for the view test
|--
create table rtest_t1 (a int4, b int4)
--
f0c7158ce57e37c6
== 002
create table rtest_t2 (a int4, b int4)
--
ff2269f1ea965bbc
== 003
create table rtest_t3 (a int4, b int4)
--
2414c7e20119ce43
== 004
create view rtest_v1 as select * from rtest_t1
--
0e58abcde17fcdab
== 005
create rule rtest_v1_ins as on insert to rtest_v1 do instead
	insert into rtest_t1 values (new.a, new.b)
--
15f97325023a2062
== 006
create rule rtest_v1_upd as on update to rtest_v1 do instead
	update rtest_t1 set a = new.a, b = new.b
	where a = old.a
--
174ffe2484758c1f
== 007
create rule rtest_v1_del as on delete to rtest_v1 do instead
	delete from rtest_t1 where a = old.a
--
45dbda5cc28f7202
== 008
-- Test comments
COMMENT ON RULE rtest_v1_bad ON rtest_v1 IS 'bad rule'
--
6ab9d80285c541d1
== 009
COMMENT ON RULE rtest_v1_del ON rtest_v1 IS 'delete rule'
--
ed816ec6c837b4e9
== 010
COMMENT ON RULE rtest_v1_del ON rtest_v1 IS NULL
--
b73f9f973ddfdf23
== 011
|--
-- Tables and rules for the constraint update/delete test
|--
-- Note:
-- 	Now that we have multiple action rule support, we check
-- 	both possible syntaxes to define them (The last action
--  can but must not have a semicolon at the end).
|--
create table rtest_system (sysname text, sysdesc text)
--
c884e6428f03bd56
== 012
create table rtest_interface (sysname text, ifname text)
--
c64163577879d6c9
== 013
create table rtest_person (pname text, pdesc text)
--
b033ec83d4f3fbdf
== 014
create table rtest_admin (pname text, sysname text)
--
214747e9312b93e0
== 015
create rule rtest_sys_upd as on update to rtest_system do also (
	update rtest_interface set sysname = new.sysname
		where sysname = old.sysname;
	update rtest_admin set sysname = new.sysname
		where sysname = old.sysname
	)
--
3a35c17176a482ad
== 016
create rule rtest_sys_del as on delete to rtest_system do also (
	delete from rtest_interface where sysname = old.sysname;
	delete from rtest_admin where sysname = old.sysname;
	)
--
a69995b2f7f5314f
== 017
create rule rtest_pers_upd as on update to rtest_person do also
	update rtest_admin set pname = new.pname where pname = old.pname
--
dc7a6d1b060c8e41
== 018
create rule rtest_pers_del as on delete to rtest_person do also
	delete from rtest_admin where pname = old.pname
--
7a8721b53da9204c
== 019
|--
-- Tables and rules for the logging test
|--
create table rtest_emp (ename char(20), salary numeric)
--
f0058c3a4466847e
== 020
create table rtest_emplog (ename char(20), who name, action char(10), newsal numeric, oldsal numeric)
--
cadc88ea54d97364
== 021
create table rtest_empmass (ename char(20), salary numeric)
--
77244339caa2632a
== 022
create rule rtest_emp_ins as on insert to rtest_emp do
	insert into rtest_emplog values (new.ename, current_user,
			'hired', new.salary, '0.00')
--
23e02692412dc5d5
== 023
create rule rtest_emp_upd as on update to rtest_emp where new.salary != old.salary do
	insert into rtest_emplog values (new.ename, current_user,
			'honored', new.salary, old.salary)
--
ac1261b7236a0004
== 024
create rule rtest_emp_del as on delete to rtest_emp do
	insert into rtest_emplog values (old.ename, current_user,
			'fired', '0.00', old.salary)
--
98c054335aea30ad
== 025
