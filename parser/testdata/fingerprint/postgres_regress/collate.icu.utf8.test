WHERE t1.x = t2.x COLLATE case_insensitive
ORDER BY 1, 2
--
6ec9aa78e206b21f
== 311
-- Ensure that left-join is not removed
EXPLAIN (COSTS OFF)
SELECT t1.* FROM test3cs t1
       LEFT JOIN test3cs t2 ON t1.x = t2.x COLLATE case_insensitive
ORDER BY 1
--
cee6d60ae6e7e71e
== 312
