fcc6a41e62e773cc
== 012
SELECT * FROM BOX_TBL
--
28d3d5d1256b373d
== 013
SELECT b.*, area(b.f1) as barea
   FROM BOX_TBL b
--
efbe8950dce39be7
== 014
-- overlap
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 && box '(2.5,2.5,1.0,1.0)'
--
2bd8d9fd80b0b7eb
== 015
-- left-or-overlap (x only)
SELECT b1.*
   FROM BOX_TBL b1
   WHERE b1.f1 &< box '(2.0,2.0,2.5,2.5)'
--
dc866f8a3310c419
== 016
-- right-or-overlap (x only)
SELECT b1.*
   FROM BOX_TBL b1
   WHERE b1.f1 &> box '(2.0,2.0,2.5,2.5)'
--
88a10896789ec1e5
== 017
-- left of
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 << box '(3.0,3.0,5.0,5.0)'
--
0762d13fad1a2457
== 018
-- area <=
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 <= box '(3.0,3.0,5.0,5.0)'
--
fdfe0afc78b1e9ee
== 019
-- area <
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 < box '(3.0,3.0,5.0,5.0)'
--
ecfa03e971110e0f
== 020
-- area =
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 = box '(3.0,3.0,5.0,5.0)'
--
6088aa55196ff832
== 021
-- area >
SELECT b.f1
   FROM BOX_TBL b				-- zero area
   WHERE b.f1 > box '(3.5,3.0,4.5,3.0)'
--
056061811fe23e47
== 022
-- area >=
SELECT b.f1
   FROM BOX_TBL b				-- zero area
   WHERE b.f1 >= box '(3.5,3.0,4.5,3.0)'
--
64c4b0e9dd2f0709
== 023
-- right of
SELECT b.f1
   FROM BOX_TBL b
   WHERE box '(3.0,3.0,5.0,5.0)' >> b.f1
--
9264f2fd5c173566
== 024
-- contained in
SELECT b.f1
   FROM BOX_TBL b
   WHERE b.f1 <@ box '(0,0,3,3)'
--
1f6bf213c73098af
== 025
-- contains
SELECT b.f1
   FROM BOX_TBL b
   WHERE box '(0,0,3,3)' @> b.f1
--
3ad0e3b787af48d0
== 026
-- box equality
SELECT b.f1
   FROM BOX_TBL b
   WHERE box '(1,1,3,3)' ~= b.f1
--
281564ebe19bc623
== 027
-- center of box, left unary operator
SELECT @@(b1.f1) AS p
   FROM BOX_TBL b1
--
7363a9246354c60d
== 028
-- wholly-contained
SELECT b1.*, b2.*
   FROM BOX_TBL b1, BOX_TBL b2
   WHERE b1.f1 @> b2.f1 and not b1.f1 ~= b2.f1
--
acbe5630ca455ff4
== 029
SELECT height(f1), width(f1) FROM BOX_TBL
--
afbbe80434937b3e
== 030
