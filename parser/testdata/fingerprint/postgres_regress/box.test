== 001
|--
-- BOX
|--

|--
-- box logic
--	     o
-- 3	  o--|X
--	  |  o|
-- 2	+-+-+ |
--	| | | |
-- 1	| o-+-o
--	|   |
-- 0	+---+
|--
--	0 1 2 3
|--

-- boxes are specified by two points, given by four floats x1,y1,x2,y2


CREATE TABLE BOX_TBL (f1 box)
--
24e3726ee06ebd05
== 002
INSERT INTO BOX_TBL (f1) VALUES ('(2.0,2.0,0.0,0.0)')
--
fcc6a41e62e773cc
== 003
