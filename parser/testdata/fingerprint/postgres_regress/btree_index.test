aa90c60f48f4fef4
== 048
explain (costs off)
select hundred, twenty from tenk1 where hundred < 48 order by hundred desc limit 1
--
8fe5befd470c83b4
== 049
select hundred, twenty from tenk1 where hundred < 48 order by hundred desc limit 1
--
4e532a92b9529494
== 050
