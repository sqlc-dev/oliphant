== 001
/*
 * This test is for collations and character operations when using the
 * builtin provider with the C.UTF-8 locale.
 */

/* skip test if not UTF8 server encoding */
SELECT getdatabaseencoding() <> 'UTF8' AS skip_test
--
439befbf57e4f730
== 002
SET client_encoding TO UTF8
--
0c529bd70ef90fb4
== 003
|--
-- Test builtin "C"
|--
CREATE COLLATION regress_builtin_c (
  provider = builtin, locale = 'C')
--
ce78927503d4da15
== 004
-- non-ASCII characters are unchanged
SELECT LOWER(U&'\00C1' COLLATE regress_builtin_c) = U&'\00C1'
--
e97f7d1489e87605
== 005
SELECT UPPER(U&'\00E1' COLLATE regress_builtin_c) = U&'\00E1'
--
507f984a92440683
== 006
-- non-ASCII characters are not alphabetic
SELECT U&'\00C1\00E1' !~ '[[:alpha:]]' COLLATE regress_builtin_c
--
7b9fc8c548079675
== 007
DROP COLLATION regress_builtin_c
--
ad9b436b56361aaa
== 008
|--
-- Test PG_C_UTF8
|--

CREATE COLLATION regress_pg_c_utf8 (
  provider = builtin, locale = 'C_UTF8')
--
5067a9f1bd6b69cc
== 009
-- fails
CREATE COLLATION regress_pg_c_utf8 (
  provider = builtin, locale = 'C.UTF8')
--
1109714f46fd7fd3
== 010
DROP COLLATION regress_pg_c_utf8
--
7f7ac52641cb09ca
== 011
CREATE COLLATION regress_pg_c_utf8 (
  provider = builtin, locale = 'C.UTF-8')
--
c99f3e63353e92b5
== 012
CREATE TABLE test_pg_c_utf8 (
  t TEXT COLLATE PG_C_UTF8
)
--
1174183d50bcf2a0
== 013
INSERT INTO test_pg_c_utf8 VALUES
  ('abc DEF 123abc'),
  ('ábc sßs ßss DÉF'),
  ('ǄxxǄ ǆxxǅ ǅxxǆ'),
  (U&'Λλ 1a \FF11a'),
  ('ȺȺȺ'),
  ('ⱥⱥⱥ'),
  ('ⱥȺ')
--
aaba8a6955c5da8d
== 014
SELECT
    t, lower(t), initcap(t), upper(t),
    length(convert_to(t, 'UTF8')) AS t_bytes,
    length(convert_to(lower(t), 'UTF8')) AS lower_t_bytes,
    length(convert_to(initcap(t), 'UTF8')) AS initcap_t_bytes,
    length(convert_to(upper(t), 'UTF8')) AS upper_t_bytes
  FROM test_pg_c_utf8
--
049dda040074f4be
== 015
DROP TABLE test_pg_c_utf8
--
6de7eb2a57f5f073
== 016
-- negative test: Final_Sigma not used for builtin locale C.UTF-8
SELECT lower('ΑΣ' COLLATE PG_C_UTF8)
--
d81c9858bdcb7ecc
== 017
SELECT lower('ΑͺΣͺ' COLLATE PG_C_UTF8)
--
d81c9858bdcb7ecc
== 018
SELECT lower('Α΄Σ΄' COLLATE PG_C_UTF8)
--
d81c9858bdcb7ecc
== 019
-- properties

SELECT 'xyz' ~ '[[:alnum:]]' COLLATE PG_C_UTF8
--
a1adcf99f0b038af
== 020
SELECT 'xyz' !~ '[[:upper:]]' COLLATE PG_C_UTF8
--
4b760149cb2ed6bb
== 021
SELECT '@' !~ '[[:alnum:]]' COLLATE PG_C_UTF8
--
4b760149cb2ed6bb
== 022
SELECT '=' ~ '[[:punct:]]' COLLATE PG_C_UTF8
--
a1adcf99f0b038af
== 023
-- symbols are punctuation in posix
SELECT 'a8a' ~ '[[:digit:]]' COLLATE PG_C_UTF8
--
a1adcf99f0b038af
== 024
SELECT '൧' !~ '\d' COLLATE PG_C_UTF8
--
4b760149cb2ed6bb
== 025
-- only 0-9 considered digits in posix

-- case mapping

SELECT 'xYz' ~* 'XyZ' COLLATE PG_C_UTF8
--
980010ed0bf7bbd5
== 026
SELECT 'xAb' ~* '[W-Y]' COLLATE PG_C_UTF8
--
980010ed0bf7bbd5
== 027
SELECT 'xAb' !~* '[c-d]' COLLATE PG_C_UTF8
--
73754f73c91a44f0
== 028
SELECT 'Δ' ~* '[γ-λ]' COLLATE PG_C_UTF8
--
980010ed0bf7bbd5
== 029
SELECT 'δ' ~* '[Γ-Λ]' COLLATE PG_C_UTF8
--
980010ed0bf7bbd5
== 030
-- same as above with cases reversed

-- case folding
select casefold('AbCd 123 #$% ıiIİ ẞ ß Ǆǅǆ Σσς' collate PG_C_UTF8)
--
5d4a574d0101e266
== 031
|--
-- Test PG_UNICODE_FAST
|--

CREATE COLLATION regress_pg_unicode_fast (
  provider = builtin, locale = 'unicode')
--
8e9787998619924d
== 032
-- fails
CREATE COLLATION regress_pg_unicode_fast (
  provider = builtin, locale = 'PG_UNICODE_FAST')
--
641899b7b78f7ea1
== 033
CREATE TABLE test_pg_unicode_fast (
  t TEXT COLLATE PG_UNICODE_FAST
)
--
ec4e6f9879794b12
== 034
INSERT INTO test_pg_unicode_fast VALUES
  ('abc DEF 123abc'),
  ('ábc sßs ßss DÉF'),
  ('ǄxxǄ ǆxxǅ ǅxxǆ'),
  (U&'Λλ 1a \FF11a'),
  ('ȺȺȺ'),
  ('ⱥⱥⱥ'),
  ('ⱥȺ')
--
851f35391dc26e0b
== 035
SELECT
    t, lower(t), initcap(t), upper(t),
    length(convert_to(t, 'UTF8')) AS t_bytes,
    length(convert_to(lower(t), 'UTF8')) AS lower_t_bytes,
    length(convert_to(initcap(t), 'UTF8')) AS initcap_t_bytes,
    length(convert_to(upper(t), 'UTF8')) AS upper_t_bytes
  FROM test_pg_unicode_fast
--
c80cbbd95b4ab1af
== 036
DROP TABLE test_pg_unicode_fast
--
63496cca71f40325
== 037
-- test Final_Sigma
SELECT lower('ΑΣ' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 038
-- 0391 03A3
SELECT lower('ΑΣ0' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 039
-- 0391 03A3 0030
SELECT lower('ἈΣ̓' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 040
-- 0391 0343 03A3 0343
SELECT lower('ᾼΣͅ' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 041
-- 0391 0345 03A3 0345

-- test !Final_Sigma
SELECT lower('Σ' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 042
-- 03A3
SELECT lower('0Σ' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 043
-- 0030 03A3
SELECT lower('ΑΣΑ' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 044
-- 0391 03A3 0391
SELECT lower('ἈΣ̓Α' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 045
-- 0391 0343 03A3 0343 0391
SELECT lower('ᾼΣͅΑ' COLLATE PG_UNICODE_FAST)
--
d01e76af1b3b7519
== 046
-- 0391 0345 03A3 0345 0391

-- properties

SELECT 'xyz' ~ '[[:alnum:]]' COLLATE PG_UNICODE_FAST
--
0574cfb705abf5c5
== 047
SELECT 'xyz' !~ '[[:upper:]]' COLLATE PG_UNICODE_FAST
--
452d8b45f931f4d7
== 048
SELECT '@' !~ '[[:alnum:]]' COLLATE PG_UNICODE_FAST
--
452d8b45f931f4d7
== 049
SELECT '=' !~ '[[:punct:]]' COLLATE PG_UNICODE_FAST
--
452d8b45f931f4d7
== 050
-- symbols are not punctuation
SELECT 'a8a' ~ '[[:digit:]]' COLLATE PG_UNICODE_FAST
--
0574cfb705abf5c5
== 051
SELECT '൧' ~ '\d' COLLATE PG_UNICODE_FAST
--
0574cfb705abf5c5
== 052
-- case mapping

SELECT 'xYz' ~* 'XyZ' COLLATE PG_UNICODE_FAST
--
286dddd387f52de9
== 053
SELECT 'xAb' ~* '[W-Y]' COLLATE PG_UNICODE_FAST
--
286dddd387f52de9
== 054
SELECT 'xAb' !~* '[c-d]' COLLATE PG_UNICODE_FAST
--
3a05f25e7c6deacf
== 055
