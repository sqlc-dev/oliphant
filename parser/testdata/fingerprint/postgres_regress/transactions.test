--
6f5720134fbc8bee
== 242
select * from xacttest
--
135898a81cb6ab7c
== 243
rollback
--
a46081a556fda027
== 244
create or replace function max_xacttest() returns smallint language plpgsql as
'begin return max(a) from xacttest; end' volatile
