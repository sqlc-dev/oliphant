-- check non-transactional behavior of cursors
BEGIN
--
b16b431979fc3e05
== 211
DECLARE c CURSOR FOR SELECT unique2 FROM tenk1 ORDER BY unique2
--
98baeb9b27e89f01
== 212
SAVEPOINT one
--
8ebd566ea1bf947b
== 213
FETCH 10 FROM c
--
c1c83f9339df242c
== 214
ROLLBACK TO SAVEPOINT one
--
ede7bfabb934a1db
== 215
FETCH 10 FROM c
--
c1c83f9339df242c
== 216
RELEASE SAVEPOINT one
--
60d618658252d2af
== 217
FETCH 10 FROM c
--
c1c83f9339df242c
== 218
CLOSE c
--
2c7963684fc2bad9
== 219
DECLARE c CURSOR FOR SELECT unique2/0 FROM tenk1 ORDER BY unique2
--
b5221651373e518f
== 220
SAVEPOINT two
--
8ebd566ea1bf947b
== 221
FETCH 10 FROM c
--
c1c83f9339df242c
== 222
ROLLBACK TO SAVEPOINT two
--
ede7bfabb934a1db
== 223
-- c is now dead to the world ...
		FETCH 10 FROM c
--
c1c83f9339df242c
== 224
ROLLBACK TO SAVEPOINT two
--
ede7bfabb934a1db
== 225
RELEASE SAVEPOINT two
--
60d618658252d2af
== 226
FETCH 10 FROM c
--
c1c83f9339df242c
== 227
COMMIT
