--
e77671dc274ae56d
== 289
-- null key error

select jsonb_object('{a,b,NULL,"d e f"}','{1,2,3,"a b c"}')
--
e77671dc274ae56d
== 290
-- empty key is allowed

select jsonb_object('{a,b,"","d e f"}','{1,2,3,"a b c"}')
