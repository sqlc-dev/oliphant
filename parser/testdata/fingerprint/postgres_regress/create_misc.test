== 001
|--
-- CREATE_MISC
|--

|--
-- a is the type root
-- b and c inherit from a (one-level single inheritance)
-- d inherits from b and c (two-level multiple inheritance)
-- e inherits from c (two-level single inheritance)
-- f inherits from e (three-level single inheritance)
|--
CREATE TABLE a_star (
	class		char,
	a 			int4
)
--
dcfd517f59ee8208
== 002
CREATE TABLE b_star (
	b 			text
) INHERITS (a_star)
--
54810b26c2ff24b1
== 003
CREATE TABLE c_star (
	c 			name
) INHERITS (a_star)
--
c529e84c8a54fcf4
== 004
CREATE TABLE d_star (
	d 			float8
) INHERITS (b_star, c_star)
--
ad2a13cc73f63906
== 005
CREATE TABLE e_star (
	e 			int2
) INHERITS (c_star)
--
887051ff7632111e
== 006
CREATE TABLE f_star (
	f 			polygon
) INHERITS (e_star)
