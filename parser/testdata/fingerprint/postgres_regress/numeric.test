-- Check rounding, it should round ties away from zero.
SELECT i as pow,
	round((-2.5 * 10 ^ i)::numeric, -i),
	round((-1.5 * 10 ^ i)::numeric, -i),
	round((-0.5 * 10 ^ i)::numeric, -i),
	round((0.5 * 10 ^ i)::numeric, -i),
	round((1.5 * 10 ^ i)::numeric, -i),
	round((2.5 * 10 ^ i)::numeric, -i)
FROM generate_series(-5,5) AS t(i)
--
8a19816594d8363b
== 641
-- Check limits of rounding before the decimal point
SELECT round(4.4e131071, -131071) = 4e131071
--
4dda0f91811ac9dc
== 642
SELECT round(4.5e131071, -131071) = 5e131071
--
4dda0f91811ac9dc
== 643
SELECT round(4.5e131071, -131072)
--
9ac2432f4be829d9
== 644
-- loses all digits
SELECT round(5.5e131071, -131072)
--
9ac2432f4be829d9
== 645
-- rounds up and overflows
SELECT round(5.5e131071, -131073)
--
9ac2432f4be829d9
== 646
-- loses all digits
SELECT round(5.5e131071, -1000000)
--
9ac2432f4be829d9
== 647
-- loses all digits

-- Check limits of rounding after the decimal point
SELECT round(5e-16383, 1000000) = 5e-16383
--
4dda0f91811ac9dc
== 648
SELECT round(5e-16383, 16383) = 5e-16383
--
4dda0f91811ac9dc
== 649
SELECT round(5e-16383, 16382) = 1e-16382
--
4dda0f91811ac9dc
== 650
SELECT round(5e-16383, 16381) = 0
--
4dda0f91811ac9dc
== 651
-- Check limits of trunc() before the decimal point
SELECT trunc(9.9e131071, -131071) = 9e131071
--
e4560ce0f2aa07ad
== 652
SELECT trunc(9.9e131071, -131072)
--
18d601c9870a69bf
== 653
-- loses all digits
SELECT trunc(9.9e131071, -131073)
--
18d601c9870a69bf
== 654
-- loses all digits
SELECT trunc(9.9e131071, -1000000)
--
18d601c9870a69bf
== 655
-- loses all digits

-- Check limits of trunc() after the decimal point
SELECT trunc(5e-16383, 1000000) = 5e-16383
--
e4560ce0f2aa07ad
== 656
