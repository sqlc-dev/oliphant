-- normal operation
CREATE TABLE width_bucket_test (operand_num numeric, operand_f8 float8)
--
f0d8e255ec4997a1
== 669
COPY width_bucket_test (operand_num) FROM stdin
--
f9fa50729deac2f7
== 670
