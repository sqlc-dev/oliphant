b8650215f1040160
== 900
-- cases that used to return inaccurate results
select 3.789 ^ 21.0000000000000000
--
b8650215f1040160
== 901
select 3.789 ^ 35.0000000000000000
--
b8650215f1040160
== 902
select 1.2 ^ 345
--
b8650215f1040160
== 903
select 0.12 ^ (-20)
--
b8650215f1040160
== 904
select 1.000000000123 ^ (-2147483648)
--
b8650215f1040160
== 905
