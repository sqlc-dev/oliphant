--
973ee885c31a5c24
== 957
select * from generate_series(1::numeric, 3::numeric) i, generate_series(1,i) j
--
973ee885c31a5c24
== 958
select * from generate_series(1::numeric, 3::numeric) i, generate_series(1,5,i) j
--
973ee885c31a5c24
== 959
