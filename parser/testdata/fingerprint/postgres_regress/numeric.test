|--
-- Tests for scale()
|--

select scale(numeric 'NaN')
--
f7fbc28c52fe3ad6
== 988
select scale(numeric 'inf')
--
f7fbc28c52fe3ad6
== 989
select scale(NULL::numeric)
--
f7fbc28c52fe3ad6
== 990
select scale(1.12)
--
f7fbc28c52fe3ad6
== 991
select scale(0)
--
f7fbc28c52fe3ad6
== 992
select scale(0.00)
--
f7fbc28c52fe3ad6
== 993
select scale(1.12345)
--
f7fbc28c52fe3ad6
== 994
select scale(110123.12475871856128)
--
f7fbc28c52fe3ad6
== 995
select scale(-1123.12471856128)
--
f7fbc28c52fe3ad6
== 996
select scale(-13.000000000000000)
--
f7fbc28c52fe3ad6
== 997
|--
-- Tests for min_scale()
|--

select min_scale(numeric 'NaN') is NULL
--
fa29e5ff27fc7d61
== 998
-- should be true
select min_scale(numeric 'inf') is NULL
--
fa29e5ff27fc7d61
== 999
-- should be true
select min_scale(0)
--
05efdef0d386b07b
== 1000
-- no digits
select min_scale(0.00)
--
05efdef0d386b07b
== 1001
-- no digits again
select min_scale(1.0)
--
05efdef0d386b07b
== 1002
-- no scale
select min_scale(1.1)
--
05efdef0d386b07b
== 1003
-- scale 1
select min_scale(1.12)
--
05efdef0d386b07b
== 1004
-- scale 2
select min_scale(1.123)
--
05efdef0d386b07b
== 1005
-- scale 3
select min_scale(1.1234)
--
05efdef0d386b07b
== 1006
-- scale 4, filled digit
select min_scale(1.12345)
--
05efdef0d386b07b
== 1007
-- scale 5, 2 NDIGITS
select min_scale(1.1000)
--
05efdef0d386b07b
== 1008
-- 1 pos in NDIGITS
select min_scale(1e100)
--
05efdef0d386b07b
== 1009
-- very big number

