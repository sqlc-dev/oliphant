97e3ed8060661147
== 044
-- but it's OK when the identity is FULL
ALTER TABLE test_replica_identity3 REPLICA IDENTITY FULL
--
d52db5a2107cfaeb
== 045
ALTER TABLE test_replica_identity3 ALTER COLUMN id DROP NOT NULL
--
97e3ed8060661147
== 046
