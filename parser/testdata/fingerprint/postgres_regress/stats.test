== 001
|--
-- Test cumulative stats system
|--
-- Must be run after tenk2 has been created (by create_table),
-- populated (by create_misc) and indexed (by create_index).
|--

-- conditio sine qua non
SHOW track_counts
--
fbb6436db9305d48
== 002
-- must be on

-- ensure that both seqscan and indexscan plans are allowed
SET enable_seqscan TO on
--
b6355b32597ef7db
== 003
SET enable_indexscan TO on
--
c95f6a280f5be733
== 004
-- for the moment, we don't want index-only scans here
SET enable_indexonlyscan TO off
--
47be5370954a5b0f
== 005
-- not enabled by default, but we want to test it...
SET track_functions TO 'all'
--
72436baa8be98370
== 006
-- record dboid for later use
SELECT oid AS dboid from pg_database where datname = current_database()
--
97477b0ea10b6d07
== 007
-- save counters
BEGIN
--
b16b431979fc3e05
== 008
SET LOCAL stats_fetch_consistency = snapshot
--
9e56ffc9226ca2c5
== 009
CREATE TABLE prevstats AS
SELECT t.seq_scan, t.seq_tup_read, t.idx_scan, t.idx_tup_fetch,
       (b.heap_blks_read + b.heap_blks_hit) AS heap_blks,
       (b.idx_blks_read + b.idx_blks_hit) AS idx_blks,
       pg_stat_get_snapshot_timestamp() as snap_ts
  FROM pg_catalog.pg_stat_user_tables AS t,
       pg_catalog.pg_statio_user_tables AS b
 WHERE t.relname='tenk2' AND b.relname='tenk2'
--
038e91e4f734865b
== 010
COMMIT
--
7bbcde9cfab6c79c
== 011
-- test effects of TRUNCATE on n_live_tup/n_dead_tup counters
CREATE TABLE trunc_stats_test(id serial)
--
1ffcf045adc35f1f
== 012
CREATE TABLE trunc_stats_test1(id serial, stuff text)
--
55d50f57d2f886c2
== 013
CREATE TABLE trunc_stats_test2(id serial)
--
b2098c9bfa9b1fd0
== 014
CREATE TABLE trunc_stats_test3(id serial, stuff text)
--
29776ffea20067ed
== 015
CREATE TABLE trunc_stats_test4(id serial)
