-- Check edge cases
SELECT '23:59:59.999999'::time
--
50fde20626009aba
== 019
SELECT '23:59:59.9999999'::time
--
50fde20626009aba
== 020
-- rounds up
SELECT '23:59:60'::time
--
50fde20626009aba
== 021
-- rounds up
SELECT '24:00:00'::time
--
50fde20626009aba
== 022
-- allowed
SELECT '24:00:00.01'::time
--
50fde20626009aba
== 023
-- not allowed
SELECT '23:59:60.01'::time
--
50fde20626009aba
== 024
-- not allowed
SELECT '24:01:00'::time
--
50fde20626009aba
== 025
-- not allowed
SELECT '25:00:00'::time
--
50fde20626009aba
== 026
-- not allowed

