create function int8alias1eq(int8alias1, int8alias1) returns bool
  strict immutable language internal as 'int8eq'
--
79d79600495803c7
== 014
create operator = (
    procedure = int8alias1eq,
    leftarg = int8alias1, rightarg = int8alias1,
    commutator = =,
    restrict = eqsel, join = eqjoinsel,
    merges
)
