== 001
|--
-- PREPARED TRANSACTIONS (two-phase commit)
|--
-- We can't readily test persistence of prepared xacts within the
-- regression script framework, unfortunately.  Note that a crash
-- isn't really needed ... stopping and starting the postmaster would
-- be enough, but we can't even do that here.


-- create a simple table that we'll use in the tests
CREATE TABLE pxtest1 (foobar VARCHAR(10))
--
5605e96d73a91b3c
== 002
INSERT INTO pxtest1 VALUES ('aaa')
--
70ff18a78cd5de7b
== 003
-- Test PREPARE TRANSACTION
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 004
UPDATE pxtest1 SET foobar = 'bbb' WHERE foobar = 'aaa'
--
6d14cf5fa85e3f9a
== 005
SELECT * FROM pxtest1
--
97547aebde719e73
== 006
PREPARE TRANSACTION 'regress_foo1'
--
d993959a33d627d4
== 007
SELECT * FROM pxtest1
--
97547aebde719e73
== 008
-- Test pg_prepared_xacts system view
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 009
-- Test ROLLBACK PREPARED
ROLLBACK PREPARED 'regress_foo1'
--
d1a052eac2b86394
== 010
SELECT * FROM pxtest1
--
97547aebde719e73
== 011
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 012
-- Test COMMIT PREPARED
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 013
INSERT INTO pxtest1 VALUES ('ddd')
--
70ff18a78cd5de7b
== 014
SELECT * FROM pxtest1
--
97547aebde719e73
== 015
PREPARE TRANSACTION 'regress_foo2'
--
d993959a33d627d4
== 016
SELECT * FROM pxtest1
--
97547aebde719e73
== 017
COMMIT PREPARED 'regress_foo2'
--
cc4872a4cb05ed79
== 018
SELECT * FROM pxtest1
--
97547aebde719e73
== 019
-- Test duplicate gids
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 020
UPDATE pxtest1 SET foobar = 'eee' WHERE foobar = 'ddd'
--
6d14cf5fa85e3f9a
== 021
SELECT * FROM pxtest1
--
97547aebde719e73
== 022
PREPARE TRANSACTION 'regress_foo3'
--
d993959a33d627d4
== 023
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 024
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 025
INSERT INTO pxtest1 VALUES ('fff')
--
70ff18a78cd5de7b
== 026
-- This should fail, because the gid foo3 is already in use
PREPARE TRANSACTION 'regress_foo3'
--
d993959a33d627d4
== 027
SELECT * FROM pxtest1
--
97547aebde719e73
== 028
ROLLBACK PREPARED 'regress_foo3'
--
d1a052eac2b86394
== 029
SELECT * FROM pxtest1
--
97547aebde719e73
== 030
-- Test serialization failure (SSI)
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 031
UPDATE pxtest1 SET foobar = 'eee' WHERE foobar = 'ddd'
--
6d14cf5fa85e3f9a
== 032
SELECT * FROM pxtest1
--
97547aebde719e73
== 033
PREPARE TRANSACTION 'regress_foo4'
--
d993959a33d627d4
== 034
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 035
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 036
SELECT * FROM pxtest1
--
97547aebde719e73
== 037
-- This should fail, because the two transactions have a write-skew anomaly
INSERT INTO pxtest1 VALUES ('fff')
--
70ff18a78cd5de7b
== 038
PREPARE TRANSACTION 'regress_foo5'
--
d993959a33d627d4
== 039
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 040
ROLLBACK PREPARED 'regress_foo4'
--
d1a052eac2b86394
== 041
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 042
-- Clean up
DROP TABLE pxtest1
--
354cf05d9a58bce5
== 043
-- Test detection of session-level and xact-level locks on same object
BEGIN
--
b16b431979fc3e05
== 044
SELECT pg_advisory_lock(1)
--
8fdef1ef96fa697f
== 045
SELECT pg_advisory_xact_lock_shared(1)
--
b73b3a360943fa73
== 046
PREPARE TRANSACTION 'regress_foo6'
--
d993959a33d627d4
== 047
-- fails

-- Test subtransactions
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 048
CREATE TABLE pxtest2 (a int)
--
685a108e54b1b0f1
== 049
INSERT INTO pxtest2 VALUES (1)
--
e83741530a4ffde5
== 050
SAVEPOINT a
--
8ebd566ea1bf947b
== 051
INSERT INTO pxtest2 VALUES (2)
--
e83741530a4ffde5
== 052
ROLLBACK TO a
--
ede7bfabb934a1db
== 053
SAVEPOINT b
--
8ebd566ea1bf947b
== 054
INSERT INTO pxtest2 VALUES (3)
--
e83741530a4ffde5
== 055
PREPARE TRANSACTION 'regress_sub1'
--
d993959a33d627d4
== 056
CREATE TABLE pxtest3(fff int)
--
d28902d3df369dc2
== 057
-- Test shared invalidation
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE
--
b16b431979fc3e05
== 058
DROP TABLE pxtest3
--
a77d4c53f4caae58
== 059
CREATE TABLE pxtest4 (a int)
--
e2b1a7521fb91ee9
== 060
INSERT INTO pxtest4 VALUES (1)
--
9f46e1e529d38255
== 061
INSERT INTO pxtest4 VALUES (2)
--
9f46e1e529d38255
== 062
DECLARE foo CURSOR FOR SELECT * FROM pxtest4
--
c90941591c52a54c
== 063
-- Fetch 1 tuple, keeping the cursor open
  FETCH 1 FROM foo
--
81daee5623e71d72
== 064
PREPARE TRANSACTION 'regress_sub2'
--
d993959a33d627d4
== 065
-- No such cursor
FETCH 1 FROM foo
--
81daee5623e71d72
== 066
-- Table doesn't exist, the creation hasn't been committed yet
SELECT * FROM pxtest2
--
e2eea054afe40bcd
== 067
-- There should be two prepared transactions
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 068
-- pxtest3 should be locked because of the pending DROP
begin
--
b16b431979fc3e05
== 069
lock table pxtest3 in access share mode nowait
--
db8ab19351350adc
== 070
rollback
--
a46081a556fda027
== 071
-- Disconnect, we will continue testing in a different backend

-- There should still be two prepared transactions
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 072
-- pxtest3 should still be locked because of the pending DROP
begin
--
b16b431979fc3e05
== 073
lock table pxtest3 in access share mode nowait
--
db8ab19351350adc
== 074
rollback
--
a46081a556fda027
== 075
-- Commit table creation
COMMIT PREPARED 'regress_sub1'
--
cc4872a4cb05ed79
== 076
SELECT * FROM pxtest2
--
e2eea054afe40bcd
== 077
-- There should be one prepared transaction
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 078
-- Commit table drop
COMMIT PREPARED 'regress_sub2'
--
cc4872a4cb05ed79
== 079
SELECT * FROM pxtest3
--
a0341d2a0b825eae
== 080
-- There should be no prepared transactions
SELECT gid FROM pg_prepared_xacts WHERE gid ~ '^regress_' ORDER BY gid
--
a72026d6c7b83793
== 081
-- Clean up
DROP TABLE pxtest2
--
641ac8cd605b22d5
== 082
DROP TABLE pxtest3
--
a77d4c53f4caae58
== 083
-- will still be there if prepared xacts are disabled
DROP TABLE pxtest4
--
7e2de823d716c0f1
