|--
-- test infinity
|--
select 'infinity'::date, '-infinity'::date
--
50fde20626009aba
== 239
select 'infinity'::date > 'today'::date as t
--
8f700ef947c2b614
== 240
select '-infinity'::date < 'today'::date as t
--
87903f384833c5bc
== 241
select isfinite('infinity'::date), isfinite('-infinity'::date), isfinite('today'::date)
--
821109df00fcff96
== 242
select 'infinity'::date = '+infinity'::date as t
--
e28080085d6341f8
== 243
|--
