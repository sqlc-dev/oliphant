== 001
-- regression test for the uuid datatype
-- creating test tables
CREATE TABLE guid1
(
	guid_field UUID,
	text_field TEXT DEFAULT(now())
)
--
11c7738c99d8365d
== 002
CREATE TABLE guid2
(
	guid_field UUID,
	text_field TEXT DEFAULT(now())
)
--
993485879922d01a
== 003
-- inserting invalid data tests
-- too long
INSERT INTO guid1(guid_field) VALUES('11111111-1111-1111-1111-111111111111F')
--
0135367b49a0df6c
== 004
-- too short
INSERT INTO guid1(guid_field) VALUES('{11111111-1111-1111-1111-11111111111}')
--
0135367b49a0df6c
== 005
-- valid data but invalid format
INSERT INTO guid1(guid_field) VALUES('111-11111-1111-1111-1111-111111111111')
--
0135367b49a0df6c
== 006
INSERT INTO guid1(guid_field) VALUES('{22222222-2222-2222-2222-222222222222 ')
--
0135367b49a0df6c
== 007
-- invalid data
INSERT INTO guid1(guid_field) VALUES('11111111-1111-1111-G111-111111111111')
--
0135367b49a0df6c
== 008
INSERT INTO guid1(guid_field) VALUES('11+11111-1111-1111-1111-111111111111')
