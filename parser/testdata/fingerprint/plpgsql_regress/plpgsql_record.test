-- check repeated assignments to composite fields
create table some_table (id int, data text)
--
3d5673c2182fd703
== 050
do $$
declare r some_table;
begin
  r := (23, 'skidoo');
  for i in 1 .. 10 loop
    r.id := r.id + i;
    r.data := r.data || ' ' || i;
  end loop;
  raise notice 'r = %', r;
end$$
